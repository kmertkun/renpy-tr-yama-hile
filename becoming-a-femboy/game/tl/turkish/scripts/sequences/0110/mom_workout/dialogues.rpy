# game/scripts/sequences/0110/mom_workout/dialogues.rpy:216
translate turkish D_mom_workout_together_02_ending_c6da95db:

    mom "Tekrar söyle! Gerçekten oldukça kabaydı. Birçok insan bana iliklerine kadar kin besledi."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:217
translate turkish D_mom_workout_together_02_ending_0dafb529:

    mom "Ama özellikle gücenenlerden bazıları mezuniyete kadar daha fazlası için geri gelmeye devam etti..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:218
translate turkish D_mom_workout_together_02_ending_3b35644a:

    player "Ah, bu çok ilginç geliyor..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:219
translate turkish D_mom_workout_together_02_ending_e93ab77d:

    mom "Hıh, bu kadar ilgileniyorsan benimle duşa gelebilirsin, sana göstereceğim..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:231
translate turkish D_mom_workout_together_02_ending_accept_e24210e7:

    "Anneciğinin geçmişteki partnerlerinin yerinde olmaya can atarak, fazla uzatmadan Anneciğinin ardından duşa giriyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:232
translate turkish D_mom_workout_together_02_ending_accept_837a5512:

    "Duşa birlikte girince Anneciğin sana \"yerin\" nerede olduğunu göstermeye başlıyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:233
translate turkish D_mom_workout_together_02_ending_accept_8e2d8c84:

    "Önünde diz çökmeni söylüyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:234
translate turkish D_mom_workout_together_02_ending_accept_418b6941:

    mom "Gözlerini kapat ve ağzını sonuna kadar aç tatlım."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:235
translate turkish D_mom_workout_together_02_ending_accept_2cb86f58:

    "Anneciğine itaat ediyorsun ve ağzına sertçe sokulacağını bekliyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:236
translate turkish D_mom_workout_together_02_ending_accept_094797c1:

    "Hazırlıklı bir şekilde ciğerlerine dolusu hava çekiyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:237
translate turkish D_mom_workout_together_02_ending_accept_d32e82e2:

    "Ağzın heyecandan salya akıtmaya başlıyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:238
translate turkish D_mom_workout_together_02_ending_accept_d2e279ee:

    "Ancak Anneciğinin sana doğru geldiğini hissetmiyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:239
translate turkish D_mom_workout_together_02_ending_accept_39a0fbbd:

    "Sadece onun rahatlama iç çekişini duyuyorsun ve bir an sonra dilinin üstüne yağmur gibi..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:242
translate turkish D_mom_workout_together_02_ending_accept_0eb3f42a:

    extend " işeme boşalıyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:243
translate turkish D_mom_workout_together_02_ending_accept_29cfe986:

    "Olanlara şaşkına dönmüş halde gözlerini kocaman açıp şaşkınlıkla Anneciğine bakıyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:244
translate turkish D_mom_workout_together_02_ending_accept_7d8d5f51:

    mom "Kıpırdama bile, oğlum..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:245
translate turkish D_mom_workout_together_02_ending_accept_c3f7249b:

    "Dizlerinin üstünde hareketsiz duruyorsun, Anneciğinin bu sabah biriktirdiği her şeyi kabul ediyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:246
translate turkish D_mom_workout_together_02_ending_accept_95613958:

    "Nasıl tepki vereceğini bilemeden bu aşağılanmayı kabullenmeye devam ediyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:247
translate turkish D_mom_workout_together_02_ending_accept_427f0817:

    mom "Ah, biraz daha tatlım."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:248
translate turkish D_mom_workout_together_02_ending_accept_f93516d2:

    "Bir kısmı kaçınılmaz olarak ağzına düşüyor ve boğulmamak için yutmaktan başka çaresi kalmıyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:251
translate turkish D_mom_workout_together_02_ending_accept_3e201d7f:

    mom "Mmm... İşte böyle..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:252
translate turkish D_mom_workout_together_02_ending_accept_1636f299:

    mom "Ah, çok güzel hissettiriyor..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:253
translate turkish D_mom_workout_together_02_ending_accept_b0cf66e6:

    mom "Sen ucuz kurtuldun Austy..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:254
translate turkish D_mom_workout_together_02_ending_accept_5fdc88e8:

    mom "Okulda femboy'lar son damlasına kadar yutmak zorundaydı, çünkü kirlenirlerse derslerine dönemezlerdi."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:255
translate turkish D_mom_workout_together_02_ending_accept_cd15e491:

    player "Aman Tanrım... bu gerçekten aşağılayıcı..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:256
translate turkish D_mom_workout_together_02_ending_accept_65d365c9:

    mom "Ama sevgili Anneciğine kızgın değilsin, değil mi?"

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:257
translate turkish D_mom_workout_together_02_ending_accept_2251c6a5:

    mom "Bence buna gerçekten alışabilirsin."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:258
translate turkish D_mom_workout_together_02_ending_accept_369d6352:

    player "Ah, ama hoşuma gitmediğini söylemedim..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:259
translate turkish D_mom_workout_together_02_ending_accept_9de737bf:

    player "Sadece henüz karar vermedim."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:260
translate turkish D_mom_workout_together_02_ending_accept_32a22f3f:

    mom "Sorun değil, nasıl hissettiğine karar verince bana söyle."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:261
translate turkish D_mom_workout_together_02_ending_accept_f7faedb9:

    player "T-tamam."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:264
translate turkish D_mom_workout_together_02_ending_accept_95c42e17:

    "Anneciğinle duş almaya devam ettin ve birlikte eve gittiniz."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:285
translate turkish D_mom_workout_together_02_ending_refuse_73c35872:

    player "Ah, beni gücendirebilecek bir şeyden bahsediyorsun... Dürüst olmak gerekirse hayal kırıklığına uğramaktan korkuyorum."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:286
translate turkish D_mom_workout_together_02_ending_refuse_4f8bef80:

    mom "Bunun için seni yargılamayacağım. Bu senin seçimin Austy."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:287
translate turkish D_mom_workout_together_02_ending_refuse_3775aea9:

    "Anneciğinin yine duşlara doğru yürüyüşünü izliyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:297
translate turkish D_mom_workout_together_03_01712b0d:

    "Annen bu sefer kendini tamamen farklı bir ışıkta sunuyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:298
translate turkish D_mom_workout_together_03_c98d6901:

    "Anneciğinin bu kadar esnek olacağını hiç bilmiyordun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:299
translate turkish D_mom_workout_together_03_280cdb12:

    "Ama bütün bunların bir sebebi var. Çünkü bu sefer gerçekten özel."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:300
translate turkish D_mom_workout_together_03_5d46913d:

    mom "Ah tatlım, tam zamanında geldin."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:301
translate turkish D_mom_workout_together_03_22dd747a:

    player "Vay canına Anne. Harika gidiyorsun!"

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:302
translate turkish D_mom_workout_together_03_71c0ae47:

    mom "Gerçekten mi? Peki, sen de aynısını yapabilirsin desem?"

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:303
translate turkish D_mom_workout_together_03_f3990917:

    player "Yapabilir miyim? Hazır olduğumu mu düşünüyorsun?"

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:304
translate turkish D_mom_workout_together_03_7bb5996f:

    mom "Bence bir süredir hazırsın."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:307
translate turkish D_mom_workout_together_03_7d85bb5f:

    mom "Ne kadar kolay yapabileceğine şaşıracaksın..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:308
translate turkish D_mom_workout_together_03_1dbe552b:

    player "Ah, tabii, sana inanıyorum Anneciğim."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:319
translate turkish D_mom_workout_together_03_ending_54409bee:

    "Egzersizden sonra esnekliğine inanılmaz derecede güvenir oldun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:320
translate turkish D_mom_workout_together_03_ending_139b6f60:

    "Böyle bir başarıya inanamayarak, inanılmaz neşeli bir ruh halindesin."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:321
translate turkish D_mom_workout_together_03_ending_6fc0c876:

    "Spor salonu duşunda Anneciğinle baş başa kalınca bunu denemekten kendini alamadın."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:322
translate turkish D_mom_workout_together_03_ending_33e0d486:

    "Anneciğin bacağını kaldırıp tutarak işe girişmek için bir saniye bile beklemiyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:323
translate turkish D_mom_workout_together_03_ending_6b47a6dd:

    "Ve tüm bu zaman boyunca beklediğin şey de tam olarak bu."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:324
translate turkish D_mom_workout_together_03_ending_ff09e648:

    "Fazla direnç göstermeden Anneciğinin sikini kolayca içine alıyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:325
translate turkish D_mom_workout_together_03_ending_c4f29204:

    mom "Ah... İşte böyle..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:326
translate turkish D_mom_workout_together_03_ending_0c7794a0:

    "Dedi Anneciğin farkında olmadan, sikinin yarısından fazlası içine girerken."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:327
translate turkish D_mom_workout_together_03_ending_73197c12:

    player "Aman Tanrım..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:328
translate turkish D_mom_workout_together_03_ending_08a98b9f:

    "İçine ne kadar kolay kaydığına dayanamayıp bağırdın."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:329
translate turkish D_mom_workout_together_03_ending_4d890dba:

    "Duş duvarına yaslanarak zevkten çıldırmamaya çalışıyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:330
translate turkish D_mom_workout_together_03_ending_3f49045d:

    "Anneciğinle göz teması kurarak gününün bundan daha iyi başlayamayacağını fark ediyorsun."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:331
translate turkish D_mom_workout_together_03_ending_05512619:

    "Anneciğin uzun süre kendini tutamıyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:332
translate turkish D_mom_workout_together_03_ending_67f0b2d1:

    "Sikini bütünüyle içine soktuğunda boşalıyor."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:337
translate turkish D_mom_workout_together_03_ending_d82bd715:

    mom "Ahh... Çok güzel..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:338
translate turkish D_mom_workout_together_03_ending_b1e10144:

    player "Mmm..."

# game/scripts/sequences/0110/mom_workout/dialogues.rpy:339
translate turkish D_mom_workout_together_03_ending_69452dc2:

    "Tek kelime edemeyecek halde, duşa dönmeden önce o pozisyonda birkaç saniye daha kalıyorsun."

