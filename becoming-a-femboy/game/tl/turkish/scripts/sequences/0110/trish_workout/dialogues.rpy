# game/scripts/sequences/0110/trish_workout/dialogues.rpy:5
translate turkish D_trish_workout_together_bcb22bd2:

    "Trish'e yaklaşmaya karar veriyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:6
translate turkish D_trish_workout_together_e354e9a9:

    "Artık burada yarı zamanlı eğitmen."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:7
translate turkish D_trish_workout_together_80408a79:

    "Ve bunu takip eden bazı değişimler de oldu. Yeni kıyafeti de dahil."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:8
translate turkish D_trish_workout_together_c8b88ab2:

    "Hâlâ nasıl yırtılmadığını bilmiyorum."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:9
translate turkish D_trish_workout_together_807c2706:

    "Önde çok derin bir yaka, kasıkta çok dar, kalçalar tamamen açıkta."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:10
translate turkish D_trish_workout_together_bc6fda20:

    "Sapıkların rüyası, spor profesyonelinin kıyafeti değil."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:18
translate turkish D_trish_workout_together_9df560da:

    trish "Selam Austy."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:19
translate turkish D_trish_workout_together_06668163:

    trish "Sonunda forma girmeye karar verdin, ha?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:20
translate turkish D_trish_workout_together_4372a925:

    player "Ah, çok..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:21
translate turkish D_trish_workout_together_d3383e40:

    trish "Gülünç mü görünüyorum?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:22
translate turkish D_trish_workout_together_f94ff24f:

    trish "Tanrım, bu kıyafetler o kadar pratik değil ki..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:23
translate turkish D_trish_workout_together_81ddc58b:

    player "Hayır, öyle değil! Çok..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:24
translate turkish D_trish_workout_together_98e754d2:

    extend " Çok seksi görünüyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:25
translate turkish D_trish_workout_together_4bbfc4a7:

    trish "Ah, hadi ama. Her yerim sıkışık."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:26
translate turkish D_trish_workout_together_5e06ea68:

    trish "İçinde gerçekten rahatsızım."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:27
translate turkish D_trish_workout_together_165be744:

    trish "Ah. Sanki çıplak gibiyim..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:28
translate turkish D_trish_workout_together_f9b4976d:

    player "Ve burada kimse umursamıyor gibi, he-he."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:29
translate turkish D_trish_workout_together_0b333818:

    trish "Haklısın. Sonuçta kelimenin tam anlamıyla çıplak değilim."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:30
translate turkish D_trish_workout_together_71101a94:

    trish "Gerçi sikim her zamankinden daha da belli oluyor, he-he."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:31
translate turkish D_trish_workout_together_7df30d9c:

    trish "Peki? Egzersize başlayalım mı?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:32
translate turkish D_trish_workout_together_a2fe215a:

    player "Evet tabii, ben bunun için buradayım!"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:40
translate turkish D_trish_workout_together_e26793a7:

    trish "Ah, benim için mi geldin?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:41
translate turkish D_trish_workout_together_06e3600d:

    player "Ah, e-evet, sorun yok, değil mi?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:42
translate turkish D_trish_workout_together_94402cef:

    trish "Hayır, tabii ki yok... Zaten pek müşteri yok."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:43
translate turkish D_trish_workout_together_eb7810e8:

    trish "Kimse bir koçla çalışmak istemiyor gibi. Hepsi daha iyi bildiğini sanıyor..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:68
translate turkish D_trish_workout_together_01_c68df21f:

    "Basit bir şeyle başlamaya karar verdin."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:69
translate turkish D_trish_workout_together_01_dc19aa2c:

    "Trish sadece tek bir dambılla başlamanı önerdi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:70
translate turkish D_trish_workout_together_01_9152912b:

    "Kendini herhangi bir şekilde sakatlamaman için seni dikkatle izliyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:73
translate turkish D_trish_workout_together_01_05dcee93:

    "Ne kadar iyi yaptığını görünce Trish daha hafif bir ağırlık önerdi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:74
translate turkish D_trish_workout_together_01_20c7f039:

    "Ancak bu sefer daha fazla hareket etmen gerekiyordu."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:75
translate turkish D_trish_workout_together_01_e8999186:

    "Karşında böyle seksi bir antrenör olması seni çok motive etti."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:76
translate turkish D_trish_workout_together_01_69ffb97d:

    "Yüzüstü yere kapaklanamazdın, bu yüzden elinden gelenin en iyisini yapmaya çalışıyordun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:87
translate turkish D_trish_workout_together_01_ending_fb7956cf:

    "İlk egzersizden sonra Trish sana buradaki en sevdiği yeri göstermeye karar veriyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:88
translate turkish D_trish_workout_together_01_ending_b5227baa:

    "Soyunmuş halde, sırada ne olacağı hakkında hiçbir fikrin yok."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:89
translate turkish D_trish_workout_together_01_ending_ccba791a:

    "Beklentiler yüksek yine de, çünkü birbirinizin önünde çıplak kaldığınız her seferde iyi sonuçlanmıştı."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:90
translate turkish D_trish_workout_together_01_ending_6a9d9320:

    "Ancak sıcağı hissedince biraz tereddüt ediyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:91
translate turkish D_trish_workout_together_01_ending_1b4cd415:

    "Kendini spor salonu eğitmenlerinin özel saunasında buluyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:96
translate turkish D_trish_workout_together_01_ending_60ce2dd8:

    trish "Ah evet... Vay be..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:97
translate turkish D_trish_workout_together_01_ending_e1b138d3:

    player "Ah... Buna dayanabiliyor musun?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:98
translate turkish D_trish_workout_together_01_ending_6c5540b6:

    player "Sanki derim soyulacak gibi hissediyorum..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:99
translate turkish D_trish_workout_together_01_ending_d25e8f7e:

    player "Dayanılmaz derecede sıcak."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:100
translate turkish D_trish_workout_together_01_ending_a8724d4f:

    trish "Olay da bu zaten!"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:101
translate turkish D_trish_workout_together_01_ending_7a2661ec:

    trish "Sadece rahatla... Sauna kasların toparlanmasına yardımcı olur."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:102
translate turkish D_trish_workout_together_01_ending_def2a7a4:

    trish "Ayrıca iyi bir dayanıklılık antrenmanı."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:103
translate turkish D_trish_workout_together_01_ending_6d4724c9:

    player "Ah... T-tamam..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:104
translate turkish D_trish_workout_together_01_ending_4720d5c7:

    "Rahatlamak için elinden geleni yapıyorsun ama vücudun bu ortama alışık değil gibi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:105
translate turkish D_trish_workout_together_01_ending_d827e0d7:

    "Trish yorgunluğunu fark etmeden bırakmıyor ve sana bir çözüm öneriyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:106
translate turkish D_trish_workout_together_01_ending_54908749:

    trish "Sana çok zor geliyorsa yere oturabilirsin."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:107
translate turkish D_trish_workout_together_01_ending_fd1581eb:

    trish "Orada sıcaklık çok daha düşük. Hemen daha iyi hissedeceksin."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:114
translate turkish D_trish_workout_together_01_ending_525afc68:

    "Yere inip dizlerinin üstüne oturuyorsun ve önünde yeni manzaralar açılıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:115
translate turkish D_trish_workout_together_01_ending_34794d24:

    trish "Nasıl? Daha iyi mi?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:116
translate turkish D_trish_workout_together_01_ending_f6634284:

    player "E-evet, bu ç-çok daha iyi..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:117
translate turkish D_trish_workout_together_01_ending_28b1ba12:

    "Diyorsun, odanın sıcaklığının vücudunun sıcaklığıyla tezat oluşturduğunu hissederken."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:118
translate turkish D_trish_workout_together_01_ending_3b43de65:

    "Biraz nefeslenirsin ve saunadaki vaktin Trish'in şunu söylemesiyle sona eriyor..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:119
translate turkish D_trish_workout_together_01_ending_fb7296d8:

    trish "Ah, bu spor salonu ne harika bir yer..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:120
translate turkish D_trish_workout_together_01_ending_a06680d0:

    trish "Ama bacaklarımın arasındaki bu gerginlikle tek bir vardiya bile çalışmak çok zor, he-he."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:121
translate turkish D_trish_workout_together_01_ending_46133765:

    player "Evet, bununla gerçekten bir şeyler yapmaları lazım..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:122
translate turkish D_trish_workout_together_01_ending_518275ae:

    "Ya da belki bununla bir şeyler yapması gereken sensin, ama o antrenman seansı sana fazla zor gelmiş gibi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:133
translate turkish D_trish_workout_together_02_ca44dc45:

    "Bu sefer egzersizinin yoğunluğu arttı."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:134
translate turkish D_trish_workout_together_02_7c9bf46a:

    "Geçen sefer seni hafife aldığı için Trish sana daha zorlu bir antrenman öneriyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:135
translate turkish D_trish_workout_together_02_23ed2c8d:

    "İnsanların sana bakıyor olabileceği hissini atlatman biraz zaman alıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:136
translate turkish D_trish_workout_together_02_62f3d015:

    "Ama sen sonuca odaklanmışsın."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:139
translate turkish D_trish_workout_together_02_8c752ace:

    "Sıradaki olarak göğüs kaslarına biraz ilgi gösterdin."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:140
translate turkish D_trish_workout_together_02_581c0b6e:

    "Bunu daha önce Trish'le yapmıştın, bu yüzden bu zorluk senin için sorun olmuyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:149
translate turkish D_trish_workout_together_02_ending_756cd932:

    "Bir antrenman daha sonra yine Trish'le saunaya gidiyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:150
translate turkish D_trish_workout_together_02_ending_d98d3585:

    trish "Ah, Austy, benimle buraya gelmek zorunda değilsin..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:151
translate turkish D_trish_workout_together_02_ending_d8fc1035:

    trish "Geçen sefer kendini iyi hissetmemiş gibiydin."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:152
translate turkish D_trish_workout_together_02_ending_e620fb2f:

    player "Sorun değil. En azından artık ne bekleyeceğimi biliyorum."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:153
translate turkish D_trish_workout_together_02_ending_4ff9b00a:

    "Birlikte saunadayken sıcak o kadar da büyük bir sorun gibi gelmiyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:154
translate turkish D_trish_workout_together_02_ending_3cdc0142:

    "Görünüşe göre bu antrenmanlar gerçekten sana {i}işliyor{/i}!"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:155
translate turkish D_trish_workout_together_02_ending_87c7b259:

    trish "Ah, Austy, harika gidiyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:156
translate turkish D_trish_workout_together_02_ending_b6f13889:

    player "E-evet, burada durmak gerçekten kolaylaşıyor..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:157
translate turkish D_trish_workout_together_02_ending_2477d8ca:

    trish "Ah, işe yaradığımı bilmek güzel."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:160
translate turkish D_trish_workout_together_02_ending_24234e4a:

    "Yere inip Trish'in bacaklarının arasına oturuyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:161
translate turkish D_trish_workout_together_02_ending_fef0915d:

    trish "Ah, yine kendini iyi hissetmiyor musun?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:162
translate turkish D_trish_workout_together_02_ending_c7f84697:

    player "Hayır... Senin daha iyi hissetmeni istiyorum..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:165
translate turkish D_trish_workout_together_02_ending_f0c6418a:

    "Bir saniye bile düşünmeden Trish'in sikini ağzına alıyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:166
translate turkish D_trish_workout_together_02_ending_ad0480b7:

    trish "Ah, Austy..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:167
translate turkish D_trish_workout_together_02_ending_8fcab369:

    "Minnettarlıkla dolup taşarak, bunu göstermenin en iyi yolunun bu olduğuna karar veriyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:168
translate turkish D_trish_workout_together_02_ending_2847224c:

    trish "Ah, buna gerçekten ihtiyacım vardı..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:169
translate turkish D_trish_workout_together_02_ending_9a233bfd:

    trish "Mm... Evet..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:176
translate turkish D_trish_workout_together_02_ending_f55cd969:

    "Trish ağır elini ensene koyuyor ve itaatkârlığından tamamen yararlanarak tempoyu kendisi belirlemeye başlıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:177
translate turkish D_trish_workout_together_02_ending_68d41c4b:

    trish "Ah... Çok güzel..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:178
translate turkish D_trish_workout_together_02_ending_4ac8daa4:

    trish "Sana hiç en iyisi olduğunu söylemiş miydim Austy?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:183
translate turkish D_trish_workout_together_02_ending_a009c4a3:

    player "[[tatmin olmuş inleme]"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:184
translate turkish D_trish_workout_together_02_ending_6b2a7984:

    trish "Evet..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:185
translate turkish D_trish_workout_together_02_ending_33319aba:

    trish "Biraz daha..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:186
translate turkish D_trish_workout_together_02_ending_8c8cef7a:

    trish "Ah..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:191
translate turkish D_trish_workout_together_02_ending_4b214dad:

    "Trish boşalıyor ve seni tohumuyla dolduruyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:192
translate turkish D_trish_workout_together_02_ending_dc680276:

    "Başını sikinin üstünde sımsıkı tutmaya devam ediyor, midenin bulanabileceğini hiç düşünmeden."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:193
translate turkish D_trish_workout_together_02_ending_1fbb180a:

    "Sen de karşı koymayı aklına bile getirmiyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:194
translate turkish D_trish_workout_together_02_ending_e24b5125:

    "Sanki Trish'in sikinin başında bir yerdeki kendini koruma sorumlusu olan bir düğmeye dokunmuş gibi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:219
translate turkish D_trish_workout_together_03_0c74e21f:

    "Bugün Trish seni spor salonunda bir femboy'un yapabileceği en önemli şeyle meşgul etmeye karar verdi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:220
translate turkish D_trish_workout_together_03_d934a872:

    "Bunlar kalçanı güçlendirmeye yönelik egzersizler."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:221
translate turkish D_trish_workout_together_03_ff2da188:

    "Aletleri zaten iyi biliyorsun, bu yüzden bu egzersizlere nasıl yaklaşman gerektiğini biliyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:222
translate turkish D_trish_workout_together_03_905b0dd4:

    "Trish bu sefer sadece seni izlemekten memnun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:225
translate turkish D_trish_workout_together_03_9be07075:

    "Çömelmeye başladığında Trish gözlerini kalçandan ayıramadı."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:226
translate turkish D_trish_workout_together_03_8e1c3315:

    "Doğru yaptığını görünce seni cesaretlendirdi ve övdü."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:235
translate turkish D_trish_workout_together_03_ending_b9259a62:

    "Bu sefer ikiniz de saunaya neden gittiğinizi çok iyi biliyorsunuz."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:236
translate turkish D_trish_workout_together_03_ending_feeeb209:

    "Sanki antrenmanın kendisi sadece sonrasında olacaklar için bir bahane gibi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:237
translate turkish D_trish_workout_together_03_ending_059e2558:

    "Bu sefer Trish'in kendisi bile pek uğraşmadı, sanki enerjisini daha önemli bir şey için saklıyormuş gibi."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:238
translate turkish D_trish_workout_together_03_ending_f2457f4a:

    trish "Ah, Austy, bugün çok yorgun olmalısın..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:239
translate turkish D_trish_workout_together_03_ending_06b64c54:

    player "Evet, bugün özellikle zordu."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:240
translate turkish D_trish_workout_together_03_ending_288daa3f:

    trish "Peki, bu sefer her şeyle ben ilgilenirim."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:243
translate turkish D_trish_workout_together_03_ending_1d828295:

    player "N-ne demek istiyorsun?"

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:244
translate turkish D_trish_workout_together_03_ending_d133878d:

    trish "Rahat ol Austy. Gereksiz hareket yapma."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:247
translate turkish D_trish_workout_together_03_ending_bc3f2256:

    "Trish bu gün sana ulaşmak için özellikle istekli."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:248
translate turkish D_trish_workout_together_03_ending_c0fc9103:

    "Seninle antrenman yaparak ısındıktan sonra özel bir egzersiz yapmaya karar veriyor..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:249
translate turkish D_trish_workout_together_03_ending_2ccb7b0f:

    extend " vücudunun spor aleti olarak kullanıldığı bir egzersiz."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:256
translate turkish D_trish_workout_together_03_ending_e2d60118:

    "Vücudunu çok kolay bir şekilde kollarına alıyor ve seni bir seks oyuncağı gibi sikmeye başlıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:257
translate turkish D_trish_workout_together_03_ending_c2e8a716:

    "Tamamen güçsüz ve direnemez halde, hiç karşı koymaya çalışmadan Trish'in iradesine boyun eğiyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:258
translate turkish D_trish_workout_together_03_ending_85903b39:

    player "Ah, b-böyle bir pozisyonda nasıl rahatlayabilirim ki..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:259
translate turkish D_trish_workout_together_03_ending_3d82b2bc:

    "Trish şu an bu egzersize aşırı odaklanmış gibi görünüyor ve metodik bir şekilde bir seti ardından diğerini yapıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:260
translate turkish D_trish_workout_together_03_ending_36849fc4:

    "Trish'in sikinin kalem açacağındaki bir kalem gibi her seferinde götünün içinde tamamen kaybolması..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:261
translate turkish D_trish_workout_together_03_ending_78293d07:

    player "Tanrım, çok derin... Ah..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:262
translate turkish D_trish_workout_together_03_ending_57613afb:

    player "Hepsi içimde..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:263
translate turkish D_trish_workout_together_03_ending_f9c89dc5:

    player "Trish... Ah..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:264
translate turkish D_trish_workout_together_03_ending_08375a74:

    "Trish'in ellerinin yorgunluktan titremeye başladığını hissedebiliyorsun."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:265
translate turkish D_trish_workout_together_03_ending_e68c34cf:

    "Ve senin güçsüz inlemelerine rağmen temposunu hızlandırmaya başlıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:266
translate turkish D_trish_workout_together_03_ending_7a4c8f5f:

    "Kendini sınırına getirerek son setine başlıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:277
translate turkish D_trish_workout_together_03_ending_32719e9e:

    "Seni sıkıca sıkıp götünün içine boşalıyor, orayı hızla dolduruyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:280
translate turkish D_trish_workout_together_03_ending_aba71e52:

    "Hiç gücü kalmadığı için seni umursamazca yere bırakıyor."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:281
translate turkish D_trish_workout_together_03_ending_a52db41e:

    trish "Ah, lütfen beni affet..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:282
translate turkish D_trish_workout_together_03_ending_14f2dc54:

    "Diyor Trish, tamamen nefessiz kalmış halde, yaptığına pişman olarak."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:283
translate turkish D_trish_workout_together_03_ending_1e7218be:

    player "S-sorun yok... H-her şey n-normal..."

# game/scripts/sequences/0110/trish_workout/dialogues.rpy:284
translate turkish D_trish_workout_together_03_ending_0caa3d0a:

    "Tamamen bitkin olduğun için kelimeleri ağzından zorla çıkarıyorsun."

