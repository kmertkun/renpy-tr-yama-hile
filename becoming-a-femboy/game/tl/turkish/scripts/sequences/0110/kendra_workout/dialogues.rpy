# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:70
translate turkish D_kendra_workout_together_01_a7eb1ebe:

    "Kendra, nefes nefese kalmadan konuşabildiğini söyleyip seninle alay etmekten vazgeçmiyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:71
translate turkish D_kendra_workout_together_01_cd351c9b:

    "Ama sen konuşmaya kalksan hemen nefesin tükeniyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:75
translate turkish D_kendra_workout_together_01_aa1f53b6:

    "Sana şehvetli bir bakış atarak antrenmanın geri kalanını sessizce geçirmeni öneriyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:81
translate turkish D_kendra_workout_together_01_ending_8a0314f1:

    "Antrenmandan sonra sen ve Kendra, ter içinde, soyunma odasına gidiyorsunuz."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:82
translate turkish D_kendra_workout_together_01_ending_f04514bf:

    "Çok çalışmış ve yorgunluktan bütün edebini unutmuş olarak, birbirinizin önünde üstünüzü değiştiriyorsunuz."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:85
translate turkish D_kendra_workout_together_01_ending_e9e31156:

    "Kendra sana sırtını dönüp şortunu tam önünde indiriyor ve mükemmel kalçalarını gözlerinin önüne seriyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:86
translate turkish D_kendra_workout_together_01_ending_a46939d1:

    "Bunun ne kadar harika bir manzara olacağından haberin yoktu."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:87
translate turkish D_kendra_workout_together_01_ending_9e0cc49e:

    "Üstünü çıkarırken şakacı bir şekilde sana doğru dönüyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:88
translate turkish D_kendra_workout_together_01_ending_8b4a21b1:

    kendra "Hey, bu bakışlarınla arkamı delip geçeceksin, he-he."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:89
translate turkish D_kendra_workout_together_01_ending_043e7df7:

    player "Ö-özür dilerim, kasıtlı değildi."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:90
translate turkish D_kendra_workout_together_01_ending_79ed80a0:

