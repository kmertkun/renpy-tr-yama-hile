translate turkish D_kendra_workout_together_4ae7abbc:

    kendra "Ah, Austy, selam. Sen de mi buraya geliyorsun?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:17
translate turkish D_kendra_workout_together_1204cb73:

    player "Ah, evet. Bir süredir spor salonuna gidiyorum ama Trish'le birlikte."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:18
translate turkish D_kendra_workout_together_97de889e:

    player "Bir de tek başıma gelmeye başlamam gerektiğini düşündüm..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:19
translate turkish D_kendra_workout_together_ab4c8b94:

    kendra "Doğru. Bugünlerde gençler hiç hareket etmiyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:20
translate turkish D_kendra_workout_together_90053943:

    kendra "Bilgisayarlarının başında oturup yağ biriktiriyorlar."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:21
translate turkish D_kendra_workout_together_ff27caed:

    "Bu konuda nutuk atacağını tahmin etmiştin zaten."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:22
translate turkish D_kendra_workout_together_91834f93:

