translate turkish D_kendra_workout_together_c9da0ce7:

    "Üstelik okul dışında sadece birkaç saniyelik bir sohbete mal olmuştu."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:36
translate turkish D_kendra_workout_together_44d6b4ba:

    kendra "Hey, geçen seferden sonra yine gelmişsin!"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:37
translate turkish D_kendra_workout_together_41c88154:

    kendra "O kadar da kötü bir spor arkadaşı değilim, değil mi? He-he."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:38
translate turkish D_kendra_workout_together_fe283a94:

    player "Evet, tabii! Yine birlikte çalışalım..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:57
translate turkish D_kendra_workout_together_6714a3f6:

    kendra "Yine eğlenmek ister misin?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:67
translate turkish D_kendra_workout_together_01_ed44c494:

    "Sen ve Kendra egzersiz bisikletlerine biniyorsunuz."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:68
translate turkish D_kendra_workout_together_01_fbc4460e:

    "Kendra bunu gerçek antrenmandan önce ısınmanın harika bir yolu olarak önermişti."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:69
translate turkish D_kendra_workout_together_01_9d188a41:

