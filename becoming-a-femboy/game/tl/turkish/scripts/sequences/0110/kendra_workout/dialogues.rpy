    "Sırada ne olacağını göremediğin için bunun senin için ne kadar zor olacağını tahmin edemiyorsun."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:207
translate turkish D_kendra_workout_together_03_ending_3c83af0f:

    "Şehvet ve kendini bir şeyle doldurma isteği seni sürüklüyor. Hangi delik olduğu bile önemli değil..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:208
translate turkish D_kendra_workout_together_03_ending_3c55a6de:

    player "Zorluklardan korkmam..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:209
translate turkish D_kendra_workout_together_03_ending_76382312:

    kendra "Öyle mi?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:210
translate turkish D_kendra_workout_together_03_ending_25fb88c1:

    extend " O halde sana neden yumuşak davranmam gerektiğini anlamıyorum, he-he."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:211
translate turkish D_kendra_workout_together_03_ending_16479d8f:

    player "K-Kendra... N-ne yapıyorsun!?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:212
translate turkish D_kendra_workout_together_03_ending_5f7a3633:

    player "Ah..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:213
translate turkish D_kendra_workout_together_03_ending_8f7822ea:

    extend " Aman Tanrım, hayır..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:218
translate turkish D_kendra_workout_together_03_ending_392acb2f:

    "Birkaç hızlı hareketle Kendra seni hiç tören yapmadan yere yatırıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:219
translate turkish D_kendra_workout_together_03_ending_da9708dc:

    "Aynı şekilde, yavaş yavaş soyunma odasının tam ortasında Kendra'nın tüm ağırlığı altında eğilmiş buluyorsun kendini."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:222
translate turkish D_kendra_workout_together_03_ending_0262b8c5:

    "Spor salonunun boş olduğu andan faydalanan Kendra, senin üzerinde tam hâkimiyet kuruyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:225
translate turkish D_kendra_workout_together_03_ending_1c49ea29:

    "Sırtın yere sımsıkı yapışmış halde, yer karolarının serinliğinden başka bir şey hissetmiyorsun..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:226
translate turkish D_kendra_workout_together_03_ending_169ca3c4:

    "Vücudunun geri kalanı ise Kendra'nın kaslı vücudunun sıcaklığıyla ısınıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:227
translate turkish D_kendra_workout_together_03_ending_118d5dc3:

    "Bir saniye bile rahat bırakmıyor, hâlâ antrenman yapıyormuşsun gibi vücuduna bir dayanıklılık testi daha yaptırıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:228
translate turkish D_kendra_workout_together_03_ending_5f7a3633_1:

    player "Ah..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:229
translate turkish D_kendra_workout_together_03_ending_82ca31d2:

    "Tek bir hızlı hamleyle Kendra sikini sana tamamen sokuyor, sana hiç şans bırakmıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:230
translate turkish D_kendra_workout_together_03_ending_f6008fdd:

    "Sonraki birkaç dakika boyunca Kendra'nın elinde sadece bir oyuncaksın."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:231
translate turkish D_kendra_workout_together_03_ending_9bf9293d:

    "Arzularını ve onda uyandırmayı başardığın sınırsız görünen şehvetini tatmin eden bir oyuncak."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:232
translate turkish D_kendra_workout_together_03_ending_32aafca1:

    "Nefesin kesiliyor ve onun acımasız hamleleri altında tamamen dilsiz kalıyorsun."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:233
translate turkish D_kendra_workout_together_03_ending_13a298b9:

    "Sadece defalarca içine girdiğini hissediyorsun, bu kadar çok istediğin şeyi sana veriyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:234
translate turkish D_kendra_workout_together_03_ending_771fb27c:

    kendra "Ah..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:239
translate turkish D_kendra_workout_together_03_ending_39faf10e:

    kendra "Evet!"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:242
translate turkish D_kendra_workout_together_03_ending_4570c8a3:

    "Kendra sikini derinlere sürüyor, taşakları girişine sertçe bastırırken içine boşalıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:243
translate turkish D_kendra_workout_together_03_ending_3425ccbf:

    "Meniyle hızla doluyorsun ve içinde yer kalmadığı için çoğu dışarı taşıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:244
translate turkish D_kendra_workout_together_03_ending_e3c05e1e:

    kendra "Tanrım... İçinde çok güzel hissettiriyor..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:245
translate turkish D_kendra_workout_together_03_ending_b0629355:

    kendra "Mmm..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:248
translate turkish D_kendra_workout_together_03_ending_605da826:

    "Kendra üzerinden kalkıp seni yerde bırakıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:249
translate turkish D_kendra_workout_together_03_ending_f0579c9f:

    kendra "Arkandan temizle..."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:250
translate turkish D_kendra_workout_together_03_ending_2fe286f3:

