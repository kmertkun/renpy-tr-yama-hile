# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:23
translate turkish D_kendra_workout_together_b78883d7:

    "Diye düşündün."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:24
translate turkish D_kendra_workout_together_5b2c8719:

    kendra "Peki, bana eşlik eder misin?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:25
translate turkish D_kendra_workout_together_812d3b08:

    kendra "Zaten birlikte daha eğlenceli."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:26
translate turkish D_kendra_workout_together_303ee870:

    player "Ben mi? Seninle mi?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:27
translate turkish D_kendra_workout_together_57223b52:

    "Teklifin ani oluşu seni şaşırtıyor."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:28
translate turkish D_kendra_workout_together_3b2a315f:

    kendra "Başka kim? Etrafta yardımıma ihtiyacı olabilecek başka kimseyi görmüyorum."

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:29
translate turkish D_kendra_workout_together_82122763:

    player "Hmm... Neden olmasın?"

# game/scripts/sequences/0110/kendra_workout/dialogues.rpy:30
translate turkish D_kendra_workout_together_eaf666e0:

    "Kendra seni rahat ettirmekte çok hızlıydı."

