# game/scripts/sequences/0120/chores/dialogues.rpy:2
translate turkish D_home_chores_start_b480c179:

    "Paraya ihtiyacın olduğunu fark ediyorsun. Kendi evrenindeyken ev işlerine yardım edince harçlık aldığını hatırlıyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:3
translate turkish D_home_chores_start_4d18a6c2:

    "Anneye bunu umursamaz bir tavırla sormaya karar veriyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:4
translate turkish D_home_chores_start_15ec2c14:

    player "Dinle... Ev işlerinde sana yardımcı olabileceğim bir şey var mı?"

# game/scripts/sequences/0120/chores/dialogues.rpy:5
translate turkish D_home_chores_start_7595ee2c:

    mom "Ah, tabii tatlım. Yardım edecek elim hep kıt."

# game/scripts/sequences/0120/chores/dialogues.rpy:6
translate turkish D_home_chores_start_a7cc7a61:

    mom "Astra'dan böyle bir şey beklenmez. O çok meşgul bir kız."

# game/scripts/sequences/0120/chores/dialogues.rpy:7
translate turkish D_home_chores_start_8804deaa:

    mom "Bu düşüncelilik için harçlık bile veririm. Ev boyunca sürekli çamaşırlarını toplamak zorunda kalmamak için her şey olur..."

# game/scripts/sequences/0120/chores/dialogues.rpy:8
translate turkish D_home_chores_start_5d3ba61a:

    mom "Bir de her yerde bir sürü toz var!"

# game/scripts/sequences/0120/chores/dialogues.rpy:9
translate turkish D_home_chores_start_e9c83004:

    mom "Süper! Kesinlikle sana yardım ederim!"

# game/scripts/sequences/0120/chores/dialogues.rpy:17
translate turkish D_home_chores_laundry_de04d7c3:

    "Anneciğine çamaşırlarda yardım etmeye karar veriyorsun. Bundan kolayı mı var?"

# game/scripts/sequences/0120/chores/dialogues.rpy:18
translate turkish D_home_chores_laundry_f5e7b2ea:

    "Tek yapman gereken kirli giysileri ayıklamak, koyuları renkliden ayırmak..."

# game/scripts/sequences/0120/chores/dialogues.rpy:19
translate turkish D_home_chores_laundry_fab6d029:

    "Havluları kıyafetlerden... Bu tarz şeyler."

# game/scripts/sequences/0120/chores/dialogues.rpy:20
translate turkish D_home_chores_laundry_609b7853:

    "Ama kirli çamaşırları karıştırma fikrinden bir türlü kurtulamıyorsun..."

# game/scripts/sequences/0120/chores/dialogues.rpy:47
translate turkish D_home_chores_laundry_mommy_panties_01_0baea981:

    "Bir çift kadın külotu buluyorsun, ama ayırt edici bir özelliği var."

# game/scripts/sequences/0120/chores/dialogues.rpy:48
translate turkish D_home_chores_laundry_mommy_panties_01_982117d3:

    player "Vay be, bu ne biçim bir kasık kısmı..."

# game/scripts/sequences/0120/chores/dialogues.rpy:49
translate turkish D_home_chores_laundry_mommy_panties_01_4758e06a:

    "Hayranlıkla düşüncelerini yüksek sesle söylüyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:50
translate turkish D_home_chores_laundry_mommy_panties_01_ceb0d3b0:

    "Merakın uyanınca onlarla oynamaya karar veriyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:51
translate turkish D_home_chores_laundry_mommy_panties_01_4e861ba5:

    "Sade, siyah bir külot. Günlük giyim gibi görünüyor."

# game/scripts/sequences/0120/chores/dialogues.rpy:52
translate turkish D_home_chores_laundry_mommy_panties_01_d0d79601:

    "Kolayca esniyorlar ve diğer kısımları epey ince olduğu için oldukça kaba görünüyorlar."

# game/scripts/sequences/0120/chores/dialogues.rpy:53
translate turkish D_home_chores_laundry_mommy_panties_01_f600b8f7:

    player "Anneciğim gerçekten bunları giyiyor mu..."

# game/scripts/sequences/0120/chores/dialogues.rpy:57
translate turkish D_home_chores_laundry_mommy_panties_01_79a24643:

    "Onları daha yakından incelerken koku seni sarmaya başladı."

# game/scripts/sequences/0120/chores/dialogues.rpy:58
translate turkish D_home_chores_laundry_mommy_panties_01_1ad14abd:

    "Farkında olmadan burnunu sıkıca bastırıp Anneciğinin varlığının her ayrıntısını içine çekiyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:59
translate turkish D_home_chores_laundry_mommy_panties_01_1ff2a401:

    "Ne kadar iğrenç göründüğünü fark edip külotları sepete geri atıyor ve işine bakıyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:69
translate turkish D_home_chores_laundry_mommy_panties_02_b43bd18e:

    "Yine bir külot buluyorsun ve yine Anneciğinin külotuna benziyor."

# game/scripts/sequences/0120/chores/dialogues.rpy:70
translate turkish D_home_chores_laundry_mommy_panties_02_c2e321e6:

    "Sadece kumaşı öncekinden çok farklı."

# game/scripts/sequences/0120/chores/dialogues.rpy:71
translate turkish D_home_chores_laundry_mommy_panties_02_9b61d133:

    "Bikini altına çok benziyorlar."

# game/scripts/sequences/0120/chores/dialogues.rpy:75
translate turkish D_home_chores_laundry_mommy_panties_02_2fdcd806:

    "Anneciğinin sahilde olduğunu hayal bile edemiyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:76
translate turkish D_home_chores_laundry_mommy_panties_02_89a617c3:

    "Gerçek annen o tür eğlencelerden hiç hoşlanmazdı."

# game/scripts/sequences/0120/chores/dialogues.rpy:77
translate turkish D_home_chores_laundry_mommy_panties_02_302edb06:

    "Ama bu... daha farklı bir tür eğlenceyi tercih ediyor gibi."

# game/scripts/sequences/0120/chores/dialogues.rpy:87
translate turkish D_home_chores_laundry_astra_panties_01_a42b6053:

    "Bir kez daha kadın iç çamaşırına rastlıyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:88
translate turkish D_home_chores_laundry_astra_panties_01_33db7740:

    "Tuzak yok! Bu sefer kesinlikle kız külotu."

# game/scripts/sequences/0120/chores/dialogues.rpy:89
translate turkish D_home_chores_laundry_astra_panties_01_c4e1f9d5:

    "Önde saçma sapan büyük bir kasık kısmı yok."

# game/scripts/sequences/0120/chores/dialogues.rpy:90
translate turkish D_home_chores_laundry_astra_panties_01_9e82086e:

    "Bunlar Astra'nın külotu olmalı..."

# game/scripts/sequences/0120/chores/dialogues.rpy:94
translate turkish D_home_chores_laundry_astra_panties_01_53e7ade5:

    "O, akraba olduğun Astra'ya hiç benzemiyor. Yani koklamakta da bir sakınca yok."

# game/scripts/sequences/0120/chores/dialogues.rpy:95
translate turkish D_home_chores_laundry_astra_panties_01_07693c85:

    "Sonuçta kendi kız kardeşinin külotunu koklayan hasta bir sapık değilsin!"

# game/scripts/sequences/0120/chores/dialogues.rpy:105
translate turkish D_home_chores_clean_room_mom_b8d13c5d:

    "Temizlenecek en mükemmel odanın sevgili Anneciğinin odası olduğuna karar veriyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:108
translate turkish D_home_chores_clean_room_mom_64410be3:

    "Odadaki her şey onun hiç düzenli olmadığını gösteriyor. Tıpkı gerçek annen gibi."

# game/scripts/sequences/0120/chores/dialogues.rpy:111
translate turkish D_home_chores_clean_room_mom_0fa91505:

    "Yatağı çok dağınık görünüyor, sen de yatağı toplamayı ve bütün odayı derleyip toplamayı kendine görev ediniyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:122
translate turkish D_home_chores_clean_room_mom_magazine_9d8e2188:

    "Temizlik seni odanın en dağınık yeri gibi görünen yere götürüyor."

# game/scripts/sequences/0120/chores/dialogues.rpy:123
translate turkish D_home_chores_clean_room_mom_magazine_0775b116:

    "Anne'nin yatağının altında, tanıdık bir kokusu olan bir yığın peçete buluyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:124
translate turkish D_home_chores_clean_room_mom_magazine_d5e9da34:

    player "{i}Oh, sakın düşündüğüm şey olmasın...{/i}"

# game/scripts/sequences/0120/chores/dialogues.rpy:125
translate turkish D_home_chores_clean_room_mom_magazine_ef05540f:

    "Biraz sinirlenerek onları bir yığın yapıp altlarında gömülü olan hazineyi çıkarıyorsun."

# game/scripts/sequences/0120/chores/dialogues.rpy:126
translate turkish D_home_chores_clean_room_mom_magazine_1ffe62fc:

    "Yetişkinlere özel bir dergi, PlayFuta."

# game/scripts/sequences/0120/chores/dialogues.rpy:127
translate turkish D_home_chores_clean_room_mom_magazine_060ad791:

    player "Bu da neyin nesi..."

# game/scripts/sequences/0120/chores/dialogues.rpy:128
translate turkish D_home_chores_clean_room_mom_magazine_6477e171:

    "Hiç tereddüt etmeden kapağını incelemeye koyuluyorsun."

