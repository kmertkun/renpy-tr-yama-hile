# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:6
translate turkish D_cafe_work_went_to_cafe_0eb1ed09:

    "Anna'nın istediği gibi, yerel kafenin girişine geldin."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:7
translate turkish D_cafe_work_went_to_cafe_75e5a23d:

    "Seni fazla bekletmeden, kısa süre sonra o da huzuruna çıktı."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:8
translate turkish D_cafe_work_went_to_cafe_030e2bb3:

    anna "Ah, işte buradasın Austyn. Seni görmek güzel."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:9
translate turkish D_cafe_work_went_to_cafe_cdf2b4a2:

    anna "Hastanede sana söylemediğim bir ince nokta vardı..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:10
translate turkish D_cafe_work_went_to_cafe_dfdec872:

    player "Çok da büyük bir sorun değildir umarım?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:11
translate turkish D_cafe_work_went_to_cafe_8c651d01:

    anna "Şey, o \"ince nokta\"ya birçok açıdan bakılabilir..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:12
translate turkish D_cafe_work_went_to_cafe_60252b2b:

    anna "Ama gerçekten bir işe ihtiyacın varsa, en iyisi bu."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:13
translate turkish D_cafe_work_went_to_cafe_1fa50fa0:

    "Haber kafanı epey karıştırdı."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:14
translate turkish D_cafe_work_went_to_cafe_5ac78cc6:

    player "{i}Umarım sapıkça bir şey değildir...{/i}"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:15
translate turkish D_cafe_work_went_to_cafe_6328b04a:

    "Kendi kendine düşündün, sonra sohbeti sürdürmen gerektiğini hatırladın."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:16
translate turkish D_cafe_work_went_to_cafe_d9fa9f99:

    "Yine de Anna'nın üstündeki sevimli kıyafeti fark etmeden duramadın."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:17
translate turkish D_cafe_work_went_to_cafe_b81cf110:

    player "B-bu arada elbisen çok güzel!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:18
translate turkish D_cafe_work_went_to_cafe_9d7fc684:

    anna "Hoşuna gitti mi? O zaman işin yarısı halloldu."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:19
translate turkish D_cafe_work_went_to_cafe_f315e46b:

    anna "Çünkü sen de aynısını giyeceksin."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:20
translate turkish D_cafe_work_went_to_cafe_b096170d:

    player "Ben... Bir düşüneyim."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:21
translate turkish D_cafe_work_went_to_cafe_fe73bd3c:

    anna "Olmaz, bu bir seçenek değil. Onu giymek zorundasın!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:22
translate turkish D_cafe_work_went_to_cafe_1c1ee858:

    anna "Yolun daha başında olduğunu biliyorum Austie."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:23
translate turkish D_cafe_work_went_to_cafe_863d7d0d:

    anna "Ama bak, ne kadar çabuk alışırsan o kadar kolay olur. İnan bana."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:24
translate turkish D_cafe_work_went_to_cafe_49838c21:

    player "Tamam..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:25
translate turkish D_cafe_work_went_to_cafe_a5ad7912:

    anna "Hadi, içeri girelim. Violet'le tanışman lazım."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:26
translate turkish D_cafe_work_went_to_cafe_34fd1488:

    anna "Patronumuz o."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:27
translate turkish D_cafe_work_went_to_cafe_c4112cd1:

    player "A, doğru. O zaman gerekli sanırım."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:35
translate turkish D_cafe_work_went_to_cafe_70a0cab2:

    "Birkaç koridoru ve bir soyunma odasını geçtikten sonra kendini şık görünümlü bir ofiste buluyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:36
translate turkish D_cafe_work_went_to_cafe_1564fc76:

    anna "Size bahsettiğim Austyn bu, Leydi Violet."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:37
translate turkish D_cafe_work_went_to_cafe_ed6004be:

    player "{i}Leydi mi?!{/i}"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:38
translate turkish D_cafe_work_went_to_cafe_6a318c56:

    anna "Ben işime döneyim! Bol şans, Austyn."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:42
translate turkish D_cafe_work_went_to_cafe_3fede71b:

    "Anna seni Violet denen biriyle baş başa bırakıp gidiyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:43
translate turkish D_cafe_work_went_to_cafe_ee31e17b:

    player "Bol şans mı? T-teşekkürler herhalde."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:44
translate turkish D_cafe_work_went_to_cafe_00c909d0:

    violet "Vay vay vay..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:45
translate turkish D_cafe_work_went_to_cafe_4e50a907:

    "Violet dramatik bir tavırla söylüyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:46
translate turkish D_cafe_work_went_to_cafe_6b5b463d:

    violet "Austyn demek..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:47
translate turkish D_cafe_work_went_to_cafe_672efd8c:

    "Karşında zarif bir kadın duruyor. Çok ciddi ve pahalı giyinmiş."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:48
translate turkish D_cafe_work_went_to_cafe_fdd550d3:

    "Bu evrende Scarlett'le ilk tanıştığında hissettiğin şeyi yine hissediyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:49
translate turkish D_cafe_work_went_to_cafe_b841df3f:

    "Sıradan bir aile kafesinden bu kadar lüks bir hava çıkabilmesine inanmak zor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:50
translate turkish D_cafe_work_went_to_cafe_28477fa5:

    "Sana baktığı andan itibaren ihtişamı apaçık ortada."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:51
translate turkish D_cafe_work_went_to_cafe_eca2874a:

    "Ya da bu hanımın seninle konuşma tarzı yüzünden kendini her zamankinden daha ufak ve aşağıda hissediyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:52
translate turkish D_cafe_work_went_to_cafe_d6e79826:

    "Mor saçlar, bir kolye ve kocaman göğüsleri ilk dikkatini çeken şeyler."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:53
translate turkish D_cafe_work_went_to_cafe_10dd2192:

    "Daha sana iş teklif etmemiş olsa da, itaat etmen gereken kişinin bu olduğunu şimdiden anlıyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:54
translate turkish D_cafe_work_went_to_cafe_50ec1b1c:

    violet "Bana kendinden bahset, Austyn."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:55
translate turkish D_cafe_work_went_to_cafe_333a442c:

    player "Ah, ben... Ben Austyn, benim..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:56
translate turkish D_cafe_work_went_to_cafe_75473c90:

    violet "Henüz bilmediğim bir şey söyle."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:57
translate turkish D_cafe_work_went_to_cafe_a1935712:

    player "{i}Doğru ya, adımın Austyn olduğunu zaten biliyor. Ne kadar aptalım!{/i}"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:58
translate turkish D_cafe_work_went_to_cafe_085e8812:

    player "Bu yıl yerel okuldan mezun oluyorum."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:59
translate turkish D_cafe_work_went_to_cafe_7d079564:

    player "Femboy olmaya daha yeni başladım."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:60
translate turkish D_cafe_work_went_to_cafe_ac8861ec:

    violet "Oh, mezun bir femboy demek. Ne ilginç! Devam et."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:61
translate turkish D_cafe_work_went_to_cafe_1b02d328:

    "Violet bir an için heyecanlanmış gibi göründü."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:62
translate turkish D_cafe_work_went_to_cafe_f35340fe:

    player "Ah, aslında, şey, kendim hakkında söyleyebileceğim bu kadar..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:63
translate turkish D_cafe_work_went_to_cafe_4e1cdc82:

    violet "Öyle mi? Ne yazık."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:64
translate turkish D_cafe_work_went_to_cafe_6bbe4f97:

    "Violet'in hevesi bir anda söndü."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:65
translate turkish D_cafe_work_went_to_cafe_7f615ec4:

    violet "Kimliğini neden bu kadar geç fark ettin?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:66
translate turkish D_cafe_work_went_to_cafe_c43a9a27:

    violet "Sana bakınca kadınsı görünmeye yeni başlamadığın çok açık."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:67
translate turkish D_cafe_work_went_to_cafe_c97a40df:

    "Violet sana şüpheyle yaklaştı. Sen ise bu dünyaya gelmeden önceki geçmişini bilmiyordun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:68
translate turkish D_cafe_work_went_to_cafe_0a993b73:

    player "Şey, olay şu ki ben... Çok uzun süre doğama karşı geldim ve..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:69
translate turkish D_cafe_work_went_to_cafe_a9b4b55f:

    violet "Sonra birden aklın başına gelip bunun harika bir fikir olduğuna mı karar verdin?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:74
translate turkish D_cafe_work_went_to_cafe_2741fcce:

    "Violet'in sözlerinde hafif bir alay sezsin ama sinirlendiğini belli etmemeye çalışıyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:75
translate turkish D_cafe_work_went_to_cafe_8e58da57:

    player "Ç-çevremdeki herkes ısrar etti, ben de en iyisinin bu olduğuna karar verdim..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:76
translate turkish D_cafe_work_went_to_cafe_172637f7:

    violet "Hmm. Ne destekleyici bir çevren varmış..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:77
translate turkish D_cafe_work_went_to_cafe_d5912853:

    violet "Pekala, yeterince dinledim."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:78
translate turkish D_cafe_work_went_to_cafe_75378bcb:

    violet "Şimdi işe gelelim. Soyun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:79
translate turkish D_cafe_work_went_to_cafe_65309763:

    player "{i}Ne?! Neden herkes beni soymak için bu kadar can atıyor?!{/i}"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:80
translate turkish D_cafe_work_went_to_cafe_23e143bd:

    player "Şey, ben... Ee..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:81
translate turkish D_cafe_work_went_to_cafe_45aa3367:

    violet "Kendimi net ifade edemedim mi?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:82
translate turkish D_cafe_work_went_to_cafe_98fc511c:

    player "H-hayır, gayet iyi duydum. Sadece ben..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:83
translate turkish D_cafe_work_went_to_cafe_6a3ddfc0:

    violet "Ah, anladım, utanıyorsun sadece..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:84
translate turkish D_cafe_work_went_to_cafe_c0f66212:

    violet "Bak, para kazanmak istiyorsan bu duyguyu üzerinden atman lazım, tatlım."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:85
translate turkish D_cafe_work_went_to_cafe_afdea699:

    violet "Madem femboy olmaya yeni başlıyorsun, sana yardım edeyim."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:93
translate turkish D_cafe_work_went_to_cafe_c7afd146:

    "Violet gözlerinin önünde giysilerini çıkarıp sadece iç çamaşırıyla kalıyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:94
translate turkish D_cafe_work_went_to_cafe_7d1031e0:

    "Saçı kadar mor olan şık iç çamaşırını görmek seni şaşırtıyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:95
translate turkish D_cafe_work_went_to_cafe_4239760b:

    "Bu iç çamaşırı belli ki bir şeyi tutmak ya da örtmek için değil. Gösteriş yapmak için giyiyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:96
translate turkish D_cafe_work_went_to_cafe_b3876b3e:

    "Bu özellikle külotunun, göğüsleri gibi neredeyse tamamen ortada olan kalın penisinin ağırlığını zar zor taşımasından belli oluyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:97
translate turkish D_cafe_work_went_to_cafe_71e6c0f6:

    violet "Gördün mü? Hiç de zor değil, Austyn."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:98
translate turkish D_cafe_work_went_to_cafe_e88c5c1c:

    violet "Ben, bu kadar önemli biri olarak bile gözümü kırpmadan yapabiliyorum."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:99
translate turkish D_cafe_work_went_to_cafe_15c00b31:

    violet "Sıra sende."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:100
translate turkish D_cafe_work_went_to_cafe_f2dff8ff:

    "Bunu bir tür destek jesti olarak görünce artık geri adım atamıyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:101
translate turkish D_cafe_work_went_to_cafe_aa0fc0e7:

    "Böyle bir durumda Violet'i reddetmenin hiç yakışık almayacağına karar verip onun örneğini izlemeye karar veriyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:109
translate turkish D_cafe_work_went_to_cafe_1ace1ef0:

    "Şortunu çıkarıyorsun. Hemen ardından üstünü de çıkarıyorsun."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:110
translate turkish D_cafe_work_went_to_cafe_d0143626:

    violet "Ah, işte böyle. Ben de bunu diyorum!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:111
translate turkish D_cafe_work_went_to_cafe_e7a73d44:

    violet "Gördün mü? O kadar da büyük mesele değilmiş."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:112
translate turkish D_cafe_work_went_to_cafe_04ae2a19:

    player "E-evet..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:113
translate turkish D_cafe_work_went_to_cafe_0eec056b:

    "Violet'te inanılmaz çekici bir şey var."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:114
translate turkish D_cafe_work_went_to_cafe_9e7fe8f7:

    "Çok sert görünüyor ama çalışanlarını da çok önemsiyor gibi."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:115
translate turkish D_cafe_work_went_to_cafe_82a6b32f:

    violet "Pekala, çalışma düzenimizin temel kurallarını unutma."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:116
translate turkish D_cafe_work_went_to_cafe_c4ae4e8e:

    violet "Müşteri her zaman haklıdır. Sen bir garsonsun, garson her zaman itaat etmelidir."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:117
translate turkish D_cafe_work_went_to_cafe_2fffaac9:

    violet "Şimdi giyin ve git! Üniformanı Anna verecek."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:118
translate turkish D_cafe_work_went_to_cafe_cc40b130:

    violet "Geçtim mi yani? Bu kadar mı?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:119
translate turkish D_cafe_work_went_to_cafe_12505b38:

    violet "Bir süre çalışabilirsin. Bakalım nasıl gidecek."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:120
translate turkish D_cafe_work_went_to_cafe_2d9b48e2:

    player "T-teşekkür ederim!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:128
translate turkish D_cafe_work_went_to_cafe_c20145f8:

    anna "Nasıl geçti?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:129
translate turkish D_cafe_work_went_to_cafe_dde0fbde:

    player "Şey... İyi geçti..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:130
translate turkish D_cafe_work_went_to_cafe_009326e0:

    anna "Harika! Sence Violet işini iyi yapıyor mu?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:131
translate turkish D_cafe_work_went_to_cafe_2bd910cc:

    player "E-evet, o sadece... harika."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:132
translate turkish D_cafe_work_went_to_cafe_3eb30eb1:

    anna "Biliyorum, değil mi!?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:133
translate turkish D_cafe_work_went_to_cafe_21052ea5:

    anna "Al, yeni üniforman!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:134
translate turkish D_cafe_work_went_to_cafe_9b016b82:

    anna "Vardiyana her geldiğinde, şuradaki dolabında seni bekliyor olacak."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:135
translate turkish D_cafe_work_went_to_cafe_6c6a5f97:

    player "B-bak, bu işle ilgili bilmem gereken bir özellik var mı?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:136
translate turkish D_cafe_work_went_to_cafe_d3ea71a4:

    anna "Özellik mi? Ne diyeceğimi bilemedim..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:137
translate turkish D_cafe_work_went_to_cafe_3268036d:

    anna "Her zamanki şeyler! Kıçına el atılır, şaplak atılır, çimdiklenir."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:138
translate turkish D_cafe_work_went_to_cafe_d51f694d:

    anna "Sen de gülümseyip itaat edersin! Haha!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:139
translate turkish D_cafe_work_went_to_cafe_9d0fb3ad:

    player "Öyle mi? Ya hoşuma gitmezse..?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:140
translate turkish D_cafe_work_went_to_cafe_7e1c180b:

    anna "Bak, parayı istiyor musun istemiyor musun?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:141
translate turkish D_cafe_work_went_to_cafe_524f66c5:

    anna "İnan bana, alışacaksın Austyn."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:142
translate turkish D_cafe_work_went_to_cafe_6967aa7b:

    anna "Çok geçmeden buraya sadece bunun için geleceksin."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:143
translate turkish D_cafe_work_went_to_cafe_599f586a:

    anna "Kıçının her türlü ilgiyi görmesine alışsan iyi edersin."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:144
translate turkish D_cafe_work_went_to_cafe_c64d90fe:

    player "T-tamam..."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:155
translate turkish D_cafe_work_anna_discuss_options_ef2b2223:

    player "Bana biraz bilgi verir misin... Burada müşterilerle nasıl çalışılıyor?"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:156
translate turkish D_cafe_work_anna_discuss_options_977841cc:

    anna "Ben de başta burada kaybolmuştum. Ama bir planım var."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:157
translate turkish D_cafe_work_anna_discuss_options_8b386269:

    player "Plan mı? Anlat bakalım!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:158
translate turkish D_cafe_work_anna_discuss_options_4e3bf27c:

    anna "Tabii! Hemen bana gelmen çok iyi."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:159
translate turkish D_cafe_work_anna_discuss_options_60b9f0cc:

    anna "Öncelikle her müşteriye kişiye özel yaklaşmak gerekiyor."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:160
translate turkish D_cafe_work_anna_discuss_options_12211dbc:

    anna "İnsanları davranışlarına bakarak tartmaya çalış."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:161
translate turkish D_cafe_work_anna_discuss_options_b8423941:

    anna "Mesela utangaç müşterilerde inisiyatifi senin almanda fayda var."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:162
translate turkish D_cafe_work_anna_discuss_options_9fb601db:

    anna "Daha gürültücü müşterilerde olabildiğince uyumlu olmak en iyisi. Ne istediklerini biliyorlar."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:163
translate turkish D_cafe_work_anna_discuss_options_1ab687c5:

    anna "Sadece yemek yemeye gelenleri de asla bunaltma."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:164
translate turkish D_cafe_work_anna_discuss_options_be05a7f6:

    anna "Bazen insanlar sadece en basit garson hizmetini ister."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:165
translate turkish D_cafe_work_anna_discuss_options_ef39687f:

    player "Hmm, karmaşık gibi ama deneyeceğim."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:166
translate turkish D_cafe_work_anna_discuss_options_c42a3d9b:

    anna "Hadi ama, roket bilimi değil ki!"

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:167
translate turkish D_cafe_work_anna_discuss_options_9da63b96:

    anna "Aslında dikkate alınacak birkaç şey daha var."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:168
translate turkish D_cafe_work_anna_discuss_options_35e65a6c:

    anna "Ama bence bunu anlamak için pratik yapman lazım."

# game/scripts/sequences/0120/cafe_work_interview/dialogues.rpy:169
translate turkish D_cafe_work_anna_discuss_options_f710fae5:

    anna "Sana temelleri verdim. Gerisi sana kalmış!"

