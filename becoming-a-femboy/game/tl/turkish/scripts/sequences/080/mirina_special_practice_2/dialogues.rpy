# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:164
translate turkish D_mirina_special_practice_2_b7ad20f9:

    mirina "Ah, daha fazla dayanamıyorum, Austy.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:165
translate turkish D_mirina_special_practice_2_fea58483:

    mirina "Bu boğaz içimdeki tüm suyu sıkıp çıkarıyor .."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:166
translate turkish D_mirina_special_practice_2_c84b0a8c:

    mirina "Senin açgözlü, şehvetli boğazın.. ah.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:167
translate turkish D_mirina_special_practice_2_a37f6bc4:

    "Mirina hızlanıyor.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:173
translate turkish D_mirina_special_practice_2_31201aa0:

    "Kendini tutamayarak - içine güçlü bir meni salvosu bırakıyor."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:179
translate turkish D_mirina_special_practice_2_adfd01eb:

    mirina "Ah, hepsini yut.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:183
translate turkish D_mirina_special_practice_2_ad62d856:

    mirina "Son damlasına kadar hepsini, Austy.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:187
translate turkish D_mirina_special_practice_2_6bb74ca0:

    "Sen, eğitmenine itaat ederek damla damla yutuyorsun."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:188
translate turkish D_mirina_special_practice_2_5b557f85:

    "Spermden dolayı dolu hissediyorsun."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:189
translate turkish D_mirina_special_practice_2_1255f87e:

    "Bundan önce bundan doyabileceğini düşünemezdin bile."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:194
translate turkish D_mirina_special_practice_2_cf1127e8:

    "Mirina sikini içinden çıkarıyor ve nefesini toparlamana izin veriyor."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:195
translate turkish D_mirina_special_practice_2_eb9b1709:

    mirina "Ah.. çok yoruldum, Austy.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:196
translate turkish D_mirina_special_practice_2_6cd85f87:

    mirina "Öğrencilerin bu kadar enerji alabileceğini unutmuşum.. mm.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:197
translate turkish D_mirina_special_practice_2_b9c07d1f:

    "Bu sırada tek kelime edemeden yatıyorsun."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:198
translate turkish D_mirina_special_practice_2_45619d4b:

    mirina "Tabii ki zorlanıyorsan kalabilirsin, Austy."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:199
translate turkish D_mirina_special_practice_2_c2b31554:

    mirina "Ben.. istersen.. sorun etmem.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:200
translate turkish D_mirina_special_practice_2_c0a66919:

    mirina "Yatağımı benimle paylaşmak istersen.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:201
translate turkish D_mirina_special_practice_2_7b915527:

    "Bu deneyimden sonra sessizce kabul ettin."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:225
translate turkish D_mirina_special_practice_2_c3dd34c1:

    "Gözlerini açtığında en sevdiğin eğitmeninin hoş görüntüsüyle karşılaşıyorsun."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:226
translate turkish D_mirina_special_practice_2_2403c079:

    "Yine büyük yumuşak göğüslerinin bu kıyafetten taşmak üzere olduğunu düşünürken yakalıyorsun kendini."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:228
translate turkish D_mirina_special_practice_2_a17c9a9b:

    mirina "Boğazın nasıl, Austy?"

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:229
translate turkish D_mirina_special_practice_2_c9a4be3a:

    player "İ-iyi gibi.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:230
translate turkish D_mirina_special_practice_2_5538b506:

    mirina "Mükemmel! Konuşabiliyorsun. Demek senin hakkında yanılmamışım, ha."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:231
translate turkish D_mirina_special_practice_2_1d3d7873:

    mirina "Antrenmanı bırakma.. böyle devam et!"

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:232
translate turkish D_mirina_special_practice_2_558ef1ad:

    mirina "Sadece.. Şey.. B-benim işe gitmem gerek, Austy.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:233
translate turkish D_mirina_special_practice_2_49adeee4:

    mirina "Seni burada yalnız bırakamam.."

# game/scripts/sequences/080/mirina_special_practice_2/dialogues.rpy:234
translate turkish D_mirina_special_practice_2_b5ee07ca:

    player "E-evet, tamam.."

