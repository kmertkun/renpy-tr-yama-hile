# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:11
translate turkish D_mirina_special_practice_1_013ccf75:

    mirina "Hiç ek derslerini düşündün mü, Austy?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:12
translate turkish D_mirina_special_practice_1_cce2cf39:

    player "Ek ders mi..? Hastanede yaptığımız yeterli değil mi?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:13
translate turkish D_mirina_special_practice_1_06b4ea2f:

    mirina "Sana açıkça söyleyeyim, Austy. Daha fazlasını yapabileceğini hissediyorum.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:14
translate turkish D_mirina_special_practice_1_6ea68420:

    mirina "Ve ben.. tüm potansiyelini fark etmeni istiyorum.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:15
translate turkish D_mirina_special_practice_1_b0da005d:

    player "Neden bahsediyorsun? Bu sadece seks."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:16
translate turkish D_mirina_special_practice_1_92e77691:

    mirina "Mesele de bu, Austy. Biraz fazla kolay alıyorsun."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:17
translate turkish D_mirina_special_practice_1_7954c63e:

    mirina "Çok faydacı, ne demek istediğimi anlıyorsun..?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:18
translate turkish D_mirina_special_practice_1_4f018c38:

    player "H-hayır.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:19
translate turkish D_mirina_special_practice_1_c5f05cf0:

    mirina "Bak... Seks sadece partnerini boşaltmak değildir."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:20
translate turkish D_mirina_special_practice_1_9d95b51d:

    mirina "Seks aynı zamanda kendini ifade etmektir. Ne kadar zengin olduğunu."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:21
translate turkish D_mirina_special_practice_1_acaa5696:

    player "Şey.. ben.. buna hiç emin değilim."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:22
translate turkish D_mirina_special_practice_1_b1d01bf2:

    mirina "Bu psikolojide çok popüler bir akım. Mesela."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:23
translate turkish D_mirina_special_practice_1_d5840f2a:

    mirina "Holy Raspberry. Annen. Sana şunu doğrulardı ki.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:24
translate turkish D_mirina_special_practice_1_edd148fc:

    mirina "Seks konusunda bu kadar iyi olmasaydı, ulaştığı yere ulaşamazdı."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:25
translate turkish D_mirina_special_practice_1_aaec9199:

    player "Şey.. önce.. O bir bilim insanı ve.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:26
translate turkish D_mirina_special_practice_1_9cd85b82:

    mirina "Evet, bilimsel ilerlemesi yüzünden ünlendiğini düşünebilirsin. Ama annenden bir mil öteden seks kokusu geliyor. Bu yüzden halka açık yerlerde görünmüyor."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:27
translate turkish D_mirina_special_practice_1_38c6080e:

    mirina "Bir tane daha var.. Scarlett Swanson. Yerel bir okulun öğretmeni. Yani sadece öğretmen değil.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:28
translate turkish D_mirina_special_practice_1_8c963ffd:

    mirina "Herkes onun her gün sevişiyor söylüyor. Hatta günde birkaç kez."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:29
translate turkish D_mirina_special_practice_1_27b8df11:

    mirina "İnsanlar onun için sıraya giriyor. Sadece seksle bürokrasiye girdi. Çılgınca."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:30
translate turkish D_mirina_special_practice_1_f9685fff:

    player "Bunu n-nereden biliyorsun?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:31
translate turkish D_mirina_special_practice_1_1eb1e41b:

    mirina "Hehe, bunu herkes biliyor, Austy."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:32
translate turkish D_mirina_special_practice_1_72075ee7:

    mirina "Örneğin çok kaliteli bir deepthroat seansı için - hatta iyi bir not bile verebilir."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:33
translate turkish D_mirina_special_practice_1_481d6990:

    player "Gerçekten mi?!"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:34
translate turkish D_mirina_special_practice_1_6052c842:

    mirina ". . ."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:35
translate turkish D_mirina_special_practice_1_01ccd300:

    player "Yani.. yani.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:36
translate turkish D_mirina_special_practice_1_846385f9:

    mirina "Mm.. Seni ilgilendirebildiğimi görüyorum..? Hehe."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:37
translate turkish D_mirina_special_practice_1_4d9dea9a:

    player "Pek sayılmaz.. Ben sadece.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:38
translate turkish D_mirina_special_practice_1_8d3a76fe:

    mirina "Evet, evet.. Gözlerinde görüyorum, Austy.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:39
translate turkish D_mirina_special_practice_1_301f0fb0:

    mirina "Rahat ol, küçük bir baş belası olmana rağmen yine de kabul ediyorum."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:40
translate turkish D_mirina_special_practice_1_5e266700:

    mirina "Yani.. Ah.. Olanakları artık görüyorsun, değil mi?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:41
translate turkish D_mirina_special_practice_1_637dc4b2:

    player "Ş-şunu kabul etmeliyim.. haklısın.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:42
translate turkish D_mirina_special_practice_1_83741def:

    mirina "Sorun değil, hepimiz hata yaparız, Austy, ama seni hiçbir şeyle suçlamıyorum."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:43
translate turkish D_mirina_special_practice_1_a001a610:

    mirina "Ben de bir nevi öğretmenim."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:44
translate turkish D_mirina_special_practice_1_640710c8:

    mirina "Başkalarının hayatını daha iyi hale getirmek için elimden geleni yapmak benim işim."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:45
translate turkish D_mirina_special_practice_1_51d19bdd:

    player "Peki bana ne önermek istiyorsun..?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:46
translate turkish D_mirina_special_practice_1_13be2b14:

    mirina "Özellikle deepthroat'tan bahsediyorsan.. O zaman bu konuda bir şey yapabiliriz."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:58
translate turkish D_mirina_special_practice_1_aa8dfcca:

    mirina "İşte geldik, rahatına bak.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:59
translate turkish D_mirina_special_practice_1_ea34e0dc:

    mirina "Ben.. daha evsel ve davetkâr bir şeye geçeceğim, tamam mı."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:66
translate turkish D_mirina_special_practice_1_19ce045e:

    mirina "Hazırım."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:67
translate turkish D_mirina_special_practice_1_02b1979f:

    mirina "Peki, hazır mısın?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:70
translate turkish D_mirina_special_practice_1_b8dfdd67:

    "Mirina karşında seksi bir kıyafetle beliriyor ve sana gösteriş yapıyor."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:72
translate turkish D_mirina_special_practice_1_a34513b8:

    player "Bunlar ev kıyafetlerin mi..?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:73
translate turkish D_mirina_special_practice_1_5d9de7dd:

    mirina "Şey, evet, ne olmuş? Seksi hissetmek güzel. Evde bile."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:74
translate turkish D_mirina_special_practice_1_e8ffd05c:

    mirina "Sen katılmıyor musun..?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:75
translate turkish D_mirina_special_practice_1_3cfbb4ce:

    player "Ah, ne diyebilirim ki.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:76
translate turkish D_mirina_special_practice_1_cb125f1b:

    mirina "Beğenmedin mi? Lütfen söyle Austy, anlayışlı olacağım.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:77
translate turkish D_mirina_special_practice_1_793e0441:

    player "{i}Ona ne söylemeliyim.. Beğenmediğimi söyleyemem.{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:78
translate turkish D_mirina_special_practice_1_527be45c:

    player "{i}Çünkü o zaman yalan söylemiş olurum. Ama öte yandan, yanlış anlayabilir ve..{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:79
translate turkish D_mirina_special_practice_1_f8d0029a:

    mirina "Yine düşünüyorsun.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:80
translate turkish D_mirina_special_practice_1_69de9ef0:

    player "Görünüşünü gerçekten beğeniyorum Mirina."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:83
translate turkish D_mirina_special_practice_1_2cdfcd62:

    "Mirina fazlasıyla kızarıyor"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:84
translate turkish D_mirina_special_practice_1_8e31096a:

    "Mirina kendi kendine fısıldamaya başlıyor"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:85
translate turkish D_mirina_special_practice_1_cf4c3d10:

    mirina "Oh, Austy beni beğeniyor. Tanrılar."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:86
translate turkish D_mirina_special_practice_1_353dfa43:

    mirina "Kendine hâkim ol, Mirina.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:87
translate turkish D_mirina_special_practice_1_02ea85bb:

    player "Her şey yolunda mı..?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:88
translate turkish D_mirina_special_practice_1_93916574:

    mirina "Her şey gayet yolunda. Başlayalım."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:89
translate turkish D_mirina_special_practice_1_edb6a5d9:

    mirina "Önce genel olarak ağzın esnekliği üzerinde çalışacağız."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:90
translate turkish D_mirina_special_practice_1_1567082f:

    mirina "İlk egzersiz için.. ben.. ben.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:91
translate turkish D_mirina_special_practice_1_7372d1d1:

    "Mirina yine yoğun bir şekilde kızarıyor."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:94
translate turkish D_mirina_special_practice_1_0edbd020:

    mirina "Senden s-sikimi almanı isteyeceğim.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:95
translate turkish D_mirina_special_practice_1_7018b129:

    mirina "Sikimi ağzına, Austy."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:96
translate turkish D_mirina_special_practice_1_3c13252f:

    player "{i}Çok gergin.. Ah..{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:97
translate turkish D_mirina_special_practice_1_0d69a0f9:

    player "{i}Söylediğini yapacağım.{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:100
translate turkish D_mirina_special_practice_1_6fb3a078:

    "Mirina'nın külotunu çıkarıyorsun ve henüz tam sertleşmemiş kalın sikinin önüne düşüyor."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:101
translate turkish D_mirina_special_practice_1_8ce0794c:

    "Ne kadar kalın olduğuna biraz şaşırıyorsun ve onunla nasıl çalışacağın hakkında hiçbir fikrin yok."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:102
translate turkish D_mirina_special_practice_1_b003c622:

    mirina "Ah.. Ondan önce.. s-sikimin çok sert olduğundan emin ol, Austy.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:103
translate turkish D_mirina_special_practice_1_9b46fee9:

    mirina "Y-yani, biliyorsun.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:106
translate turkish D_mirina_special_practice_1_15113231:

    "Onu sıkıca tabanından kavrıyor ve yatay şekilde kaldırıyorsun."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:107
translate turkish D_mirina_special_practice_1_d4ea7bdb:

    player "{i}Aman tanrım.. Görünüşünü seviyorum..{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:108
translate turkish D_mirina_special_practice_1_b1296865:

    player "{i}Çok ağır.{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:111
translate turkish D_mirina_special_practice_1_866837b9:

    mirina "Ah, başardın.. bu kadar kolay sertleştirdin, Austy.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:112
translate turkish D_mirina_special_practice_1_a3ecf1bd:

    mirina "Bu çok takdire şayan."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:113
translate turkish D_mirina_special_practice_1_d56d8756:

    "Mirina'nın sikinin gözle görülür şekilde sertleştiğini hissedebiliyorsun."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:114
translate turkish D_mirina_special_practice_1_d5ecc313:

    mirina "Göz teması kuruyorsun ve.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:115
translate turkish D_mirina_special_practice_1_c142760e:

    mirina "Ve bakışın yalvarıyor.. ah.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:116
translate turkish D_mirina_special_practice_1_9561d04a:

    mirina "Bu sikin içinde olması için.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:117
translate turkish D_mirina_special_practice_1_67ce226c:

    mirina "Zaten deneyimli olduğunu görüyorum."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:118
translate turkish D_mirina_special_practice_1_461d71bd:

    mirina "Bir kural var. Bu sırada kendine dokunmayı düşünme."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:119
translate turkish D_mirina_special_practice_1_e3472117:

    player "Dokunacak da değilim.. Ah, ama.. neden?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:120
translate turkish D_mirina_special_practice_1_7d4ac65f:

    mirina "Zevkine değil, tamamen sike odaklanmalısın,"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:121
translate turkish D_mirina_special_practice_1_03f19bc5:

    player "T-tamam.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:124
translate turkish D_mirina_special_practice_1_4340289b:

    mirina "Gördüğün gibi sikim oldukça kalın.. Ve bu tür egzersizler için harika."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:125
translate turkish D_mirina_special_practice_1_378781a1:

    mirina "Ağzını sonuna kadar aç."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:128
translate turkish D_mirina_special_practice_1_5e5675d4:

    mirina "Tamam.. Dilini mümkün olduğunca dışarı çıkar."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:129
translate turkish D_mirina_special_practice_1_92ec8142:

    mirina "Tamam.. Şimdi, ne kadar istemesen de, ağzını böyle açık tutmaya çalış."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:130
translate turkish D_mirina_special_practice_1_4200cacf:

    mirina "Penisimi ağzına sokacağım ve sanki bir genişletici gibi, ağzının rahat edebileceği maksimum boyutu dikkatlice genişletmeye çalışacağım."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:134
translate turkish D_mirina_special_practice_1_f140385d:

    mirina "Evet, şimdilik iyi gidiyor.. Nefes almayı unutma."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:135
translate turkish D_mirina_special_practice_1_316a7067:

    mirina "Bundan sonra daha zor olabilir.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:136
translate turkish D_mirina_special_practice_1_980d80c6:

    mirina "Ve şimdi egzersizin kendisi.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:137
translate turkish D_mirina_special_practice_1_7d69620f:

    mirina "Başımı yanağının iç tarafına olabildiğince sert bastırmalısın."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:141
translate turkish D_mirina_special_practice_1_0cf852b9:

    mirina "İşte böyle.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:144
translate turkish D_mirina_special_practice_1_35a534f2:

    player "{i}Ah, çok acıyor..{/i}"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:145
translate turkish D_mirina_special_practice_1_5289877f:

    mirina "Evet.. çabuk öğreniyorsun, Austy.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:146
translate turkish D_mirina_special_practice_1_d69440d8:

    mirina "Mm.. o gerilmeyi hissediyor musun..?"

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:147
translate turkish D_mirina_special_practice_1_747b4822:

    mirina "Gelecekte boğazına olacak olan da tam olarak bu, hehe.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:152
translate turkish D_mirina_special_practice_1_f3599afe:

    mirina "Ah.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:153
translate turkish D_mirina_special_practice_1_907ef229:

    mirina "Yanaklarını esnetmeyi bitirdik.. Sonraki adıma geçelim."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:157
translate turkish D_mirina_special_practice_1_78ec573d:

    mirina "Oh, gözyaşı mı? Daha şimdiden mi..? Daha başlamadık bile, Austy."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:158
translate turkish D_mirina_special_practice_1_89bb2fd2:

    "Mirina ağzını sikmeye başlıyor."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:159
translate turkish D_mirina_special_practice_1_6e169a43:

    mirina "Ah.. işte böyle.. Ağzında kusma refleksinin tam hangi noktada başladığını mükemmel hissedebiliyorum.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:160
translate turkish D_mirina_special_practice_1_ff15da01:

    mirina "Bu yeri iyi çalışacağız.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:163
translate turkish D_mirina_special_practice_1_b42fae10:

    mirina "Ah.. Evet.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:164
translate turkish D_mirina_special_practice_1_83e2967a:

    mirina "Bu.. zor.. ve zorlu bir iş.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:165
translate turkish D_mirina_special_practice_1_eaec1348:

    "Mirina süreçten çok zevk alıyor ve bu sırada sesli olmadan edemiyor."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:166
translate turkish D_mirina_special_practice_1_36020831:

    mirina "Gördün mü.. Ah.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:167
translate turkish D_mirina_special_practice_1_4268b684:

    mirina "Bu hisse alışana kadar.."

# game/scripts/sequences/080/mirina_special_practice_1/dialogues.rpy:168
translate turkish D_mirina_special_practice_1_43134e13:

    mirina "Bir sikin daha derinine asla alamazsın."

