    trish "Sana karşı bu saldırganlığının neye dayandığını söyleyebilir misin..?"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:184
translate turkish D_share_with_trish_4a326191:

    player "O-orada tam olarak ne olduğunu hemen hatırlamıyorsun ya.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:185
translate turkish D_share_with_trish_8e493018:

    player "Ama o sürekli benim nasıl.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:186
translate turkish D_share_with_trish_7e343239:

    trish "Ne dedi, Austy?"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:187
translate turkish D_share_with_trish_e07ccce7:

    player "Cinsel olarak aktif olduğum konusunu çok vurguladı.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:188
translate turkish D_share_with_trish_e88b487c:

    trish "Ah.. Kökler orada demek. Her şeyin bu kadar basit olduğunu düşünemezdim bile."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:189
translate turkish D_share_with_trish_404482d5:

    trish "Sadece sana kıskanıyor. Hehe."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:190
translate turkish D_share_with_trish_a8f50c79:

    player "Neden böyle yapsın ki.. Hiç ona benzemiyor."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:191
translate turkish D_share_with_trish_79a6316a:

    trish "Ah, Austy-Austy.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:192
translate turkish D_share_with_trish_7cd9c8db:

    trish "Kendi kardeşinin gerçekte nasıl biri olduğunu bile bilmiyorsun."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:193
translate turkish D_share_with_trish_8ddc054b:

    player "Ne diyorsun sen?"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:194
translate turkish D_share_with_trish_d8174f9a:

    trish "Ah, bu Astra yenilgiyi hep ağır karşılar, biliyor musun?"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:195
translate turkish D_share_with_trish_24bf5ce5:

    player "O bu durumda nerede.. yenildi ki?"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:196
translate turkish D_share_with_trish_f2b7c9d7:

    trish "Haha. Bekâretini ondan önce kaybettin."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:197
translate turkish D_share_with_trish_dcfba940:

    player "{i}Astra bakire mi?!{/i}"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:198
translate turkish D_share_with_trish_c9e5e719:

    trish "Görünüşe göre onu gerçekten çok kızdırdın. Ve bu çok kötü."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:199
translate turkish D_share_with_trish_1993931c:

    player "A-ama ben bir şey yapmadım.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:200
translate turkish D_share_with_trish_cc395d41:

    trish "Bence bu onu daha da çok kızdırıyor."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:201
translate turkish D_share_with_trish_4bb65788:

    player "Aslında bu çok garip, bu evrende bu konuda ne kadar iyi olduğunu düşünürsek.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:202
translate turkish D_share_with_trish_8a155e6e:

    trish "Kardeşin sadece çok kendinden emin görünüyor."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:203
translate turkish D_share_with_trish_902cce54:

    trish "Kesinlikle çok zeki. Ve özgüveni çok yüksek."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:204
translate turkish D_share_with_trish_74aea074:

    trish "Hatta oldukça çekici bir görünüşü de var, partner bulmak onun için zor olmaz."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:205
translate turkish D_share_with_trish_6e275f9e:

    trish "Ama hoşlandığı biriyle konuşunca.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:206
translate turkish D_share_with_trish_a90ac52e:

    trish "En klişe bakireden bile daha kötü davranıyor."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:207
translate turkish D_share_with_trish_c46e769a:

    trish "Ama düşününce.. Müsait bir kıza kim çekilmez ki?"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:208
translate turkish D_share_with_trish_af5b563c:

    trish "Asıl sorun şu ki, partnerinin ondan bir şekilde hoşlanmadığını görünce anında çok kızıyor."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:209
translate turkish D_share_with_trish_6d3b18b2:

    trish "Hatta birkaç kez olduğunu da gördüm. Vay be."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:210
translate turkish D_share_with_trish_1e6d9d6b:

    trish "Bu kızın başı dertte."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:211
translate turkish D_share_with_trish_35084988:

    player "Ah.. kötü şeyler.. Ya Astra bir psikoloğa gitmek isterse.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:212
translate turkish D_share_with_trish_6460670f:

    player "Ya da kafasında dönen bu saçmalık hakkında başka biriyle konuşursa."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:213
translate turkish D_share_with_trish_f3ff0e83:

    trish "Bu girişimler tomurcuk halindeyken kesilmeli."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:214
translate turkish D_share_with_trish_27d254e9:

    trish "Bir psikologdan bu bilginin başka kime gideceği hiç belli olmaz.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:215
translate turkish D_share_with_trish_39b25cfd:

    trish "Eminim bu evrende de insanlar bu tür olayları biliyor, çünkü makine var."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:216
translate turkish D_share_with_trish_4e8148c8:

    trish "Bir ara onunla bu konuda konuş.. Eminim yapabilirsin! Ama başka insanlarla olmasına izin verme! Bu çok önemli!"

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:217
translate turkish D_share_with_trish_03f19bc5:

    player "T-tamam.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:218
translate turkish D_share_with_trish_3a784dc1:

    trish "Ah.. Keşke her şey hakkında seninle daha çok konuşabilsem.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:219
translate turkish D_share_with_trish_e025b485:

    trish "Burada yaptıkların hakkında.. Ve.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:220
translate turkish D_share_with_trish_e389d49b:

    trish "Ve kıyafetin hakkında.. Muhteşem görünüyorsun. Keşke bende de bu kadar cesaret olsaydı."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:221
translate turkish D_share_with_trish_d69b71a7:

    player "T-teşekkürler."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:222
translate turkish D_share_with_trish_043bb9bb:

    trish "Uzanıp gideceğim.."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:223
translate turkish D_share_with_trish_9f08d1db:

    trish "Benimle uzan."

# game/scripts/sequences/080/share_with_trish/dialogues.rpy:224
translate turkish D_share_with_trish_abb0516e:

    player "G-görüşürüz."

