translate turkish D_mirina_special_practice_3_79cc1ab9:

    mirina "Ah.. Bu gece birlikte uyuyalım mı..?"

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:225
translate turkish D_mirina_special_practice_3_e7cf5bdc:

    mirina "Lütfen.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:226
translate turkish D_mirina_special_practice_3_98211b52:

    player "Eve gitmek için herhalde artık çok geç.. Tabii ki.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:227
translate turkish D_mirina_special_practice_3_895b21d1:

    mirina "Yaşasın!"

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:243
translate turkish D_mirina_special_practice_3_f5a2b7a7:

    mirina "Umarım kıçın ağrımıyordur.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:244
translate turkish D_mirina_special_practice_3_ceb4c6d3:

    mirina "Gerçi şaka yapıyorum.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:245
translate turkish D_mirina_special_practice_3_100fa38b:

    player "Ah, i-iyiyim."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:246
translate turkish D_mirina_special_practice_3_524ed72c:

    player "Ç-çok hoşuma gitti."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:247
translate turkish D_mirina_special_practice_3_ab12ac18:

    player "Ve hepsi beni iyi hazırladığın içindi.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:248
translate turkish D_mirina_special_practice_3_c65f767a:

    mirina "Evet.. Derste sikimin kalıbıyla uğraşmanı izledim.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:249
translate turkish D_mirina_special_practice_3_71d37a3d:

    mirina "Ve işte şimdi dedim.. tam zamanı, hihi."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:250
translate turkish D_mirina_special_practice_3_31470a6f:

    player "Ah.. Demek öyle.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:251
translate turkish D_mirina_special_practice_3_cbabcc70:

    mirina "Kızgın mısın..?"

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:254
translate turkish D_mirina_special_practice_3_b05edab5:

    player "Hayır, tabii ki hayır.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:255
translate turkish D_mirina_special_practice_3_933855eb:

    player "Uzun zamandır bunu hayal ediyordum.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:256
translate turkish D_mirina_special_practice_3_3a1f8ffb:

    mirina "Ah, sen ne kadar tatlısın.."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:258
translate turkish D_mirina_special_practice_3_5115d11c:

    "Mirina birden seni öpüyor ve yatağa sımsıkı bastırıyor."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:259
translate turkish D_mirina_special_practice_3_cf088288:

    "Sanki inanılmaz mutlu görünüyor."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:260
translate turkish D_mirina_special_practice_3_035c7cef:

    "Sen de öyle."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:262
translate turkish D_mirina_special_practice_3_3fd1be22:

    player "Beni yanlış anlama, olanlar gerçekten hoşuma gitti."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:263
translate turkish D_mirina_special_practice_3_5ea97a71:

    player "Ama yöntemlerin beni korkutuyor ve..."

# game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:264
translate turkish D_mirina_special_practice_3_0a056f4d:

    mirina "Daha fazla söyleme.. Anladım.. Özür dilerim."

translate turkish strings:

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:3
    old "This time, a special anal activity awaited you."
    new "Bu sefer seni özel bir anal etkinlik bekliyordu."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:7
    old "Mirina has prepared a surprise for you."
    new "Mirina senin için bir sürpriz hazırlamış."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:38
    old "You are not without problems experiencing this occupation."
    new "Bu işi yaşarken sorunsuz değilsin."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:55
    old "After class, you, already by tradition, go to dinner with Mirina."
    new "Dersten sonra, artık bir gelenek olarak, Mirina'yla akşam yemeğine gidiyorsun."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:59
    old "This time Mirina treats you to champagne."
    new "Bu sefer Mirina sana şampanya ısmarlıyor."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:136
    old "You finish your glass of champagne and together with Mirina, already by tradition, head to her house."
    new "Şampanyanı bitirip, artık gelenek olduğu üzere, Mirina'yla birlikte onun evine gidiyorsun."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:140
    old "As usual, in anticipation, you make yourself comfortable on the bed until Mirina appears before you."
    new "Her zamanki gibi, heyecanla bekleyerek Mirina karşına çıkana kadar yatağa rahatça yerleşiyorsun."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:144
    old "And your expectations are absolutely justified when you see her."
    new "Ve onu gördüğünde beklentilerin tamamen haklı çıkıyor."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:233
    old "Tonight you spent at Mirina."
    new "Bu geceyi Mirina'da geçirdin."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:238
    old "In the morning, the same picture awaits you as last time."
    new "Sabah, geçen seferki manzara seni bekliyor."

    # game/scripts/sequences/080/mirina_special_practice_3/dialogues.rpy:267
    old "After a beautiful morning, you pack up and go about your business."
    new "Güzel bir sabahtan sonra toparlanıp işlerinin başına gidiyorsun."

