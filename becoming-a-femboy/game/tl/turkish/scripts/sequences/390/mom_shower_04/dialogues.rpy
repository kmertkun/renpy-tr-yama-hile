# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:4
translate turkish D_mom_shower_04_b2f6c599:

    "Artan tahrike dayanamayarak kıçını sıkıca anneciğine bastırdın."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:5
translate turkish D_mom_shower_04_472c9d6a:

    "Yine de duş kabini o kadar büyük değildi ve anneciğinin sikini içine aldıktan sonra ancak onu duvara yaslayabildin."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:6
translate turkish D_mom_shower_04_d9f0cb7e:

    "Uzun, hüzünlü bir inlemeyle işe koyuldun."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:7
translate turkish D_mom_shower_04_dc6fcd13:

    "Dönüp baktığında yüzünde sadece saf bir tatmin gördün."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:8
translate turkish D_mom_shower_04_9205a462:

    "Sürece hiç katılmadan, seni elinden geldiğince tadını çıkardı."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:9
translate turkish D_mom_shower_04_a446c11f:

    "Islak, kocaman kıçının görüntüsü anneciğin üzerinde müthiş bir etki yaptı."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:10
translate turkish D_mom_shower_04_8b776e75:

    "Kıçının keskin, ıslak şaplaklarına eşlik ederek, annen... inlemelerini zor tutarak... zevkle başını geriye attı."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:11
translate turkish D_mom_shower_04_ee0aeb53:

    "Biraz daha dayanmaya çalıştığını hissedebiliyordun ama ona şans vermedin."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:12
translate turkish D_mom_shower_04_f1503084:

    "Anneciğinin taş gibi sertleşmiş sikinin içinde daha da şiştiğini hissedince, sadece hızlandın."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:13
translate turkish D_mom_shower_04_5aa99d9c:

    "Hızını artırırken annenin gözlerini kapattığını, ağzının koca koca açık kaldığını gördün."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:14
translate turkish D_mom_shower_04_cd9c8eb0:

    "Birkaç an sonra, duşun sesine eşlik eden tatlı inlemelerinin tadını çıkarıyordun bile."

# game/scripts/sequences/390/mom_shower_04/dialogues.rpy:15
translate turkish D_mom_shower_04_d739ed37:

    "Annenin seni sıcak ve koyu bir şeyle doldurduğunu hissettiğinde sonunda rahatladın."

