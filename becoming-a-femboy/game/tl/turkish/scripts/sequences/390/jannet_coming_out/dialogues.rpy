# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:12
translate turkish D_jannet_coming_out_80822390:

    jannet "Austyn, sana bir şey söylemem lazım."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:13
translate turkish D_jannet_coming_out_8792f567:

    jannet "Bence bunu bilmen önemli. Sadece... lütfen Astra'ya bunu sana söylediğimi söyleme, tamam mı?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:14
translate turkish D_jannet_coming_out_45b613fc:

    player "Tabii ki, Janny."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:15
translate turkish D_jannet_coming_out_5d7d294e:

    jannet "Mesele şu ki... hmm... nasıl nazikçe söylesem."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:16
translate turkish D_jannet_coming_out_955916b3:

    jannet "Astra sana yaptığının aynısını bana da yaptı, Austyn."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:17
translate turkish D_jannet_coming_out_1d828295:

    player "N-ne demek istiyorsun?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:18
translate turkish D_jannet_coming_out_9a336374:

    jannet "Astra'nın bütün sunumunu dinlediğimde fark ettim ki..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:19
translate turkish D_jannet_coming_out_3b8159dd:

    jannet "Aynı şeyi birkaç ay önce bana da yapmış."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:20
translate turkish D_jannet_coming_out_4367997e:

    jannet "S-ondan önce nasıl biri olduğumu hatırlıyorsun, değil mi?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:21
translate turkish D_jannet_coming_out_219350c9:

    player "{i}Hay aksi. Dürüst olmak gerekirse hiçbir fikrim yok...{/i}"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:22
translate turkish D_jannet_coming_out_b3131311:

    jannet "Ah, demek o kadar kötü. Astra'nın kullandığı onca numara hafızanı karıştırmış olmalı, hi-hi."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:23
translate turkish D_jannet_coming_out_5a78254b:

    player "G-görünüşe göre öyle, heh."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:26
translate turkish D_jannet_coming_out_dd5849b5:

    jannet "Neyse, yaklaşık üç ay önceydi, Astra'nın doğum günüydü ve odasında yan yana oturuyorduk."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:27
translate turkish D_jannet_coming_out_6070e620:

    jannet "Astra'nın benden başka pek arkadaşı yok, o yüzden odasında pasta yiyorduk."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:28
translate turkish D_jannet_coming_out_eb3799df:

    jannet "Hep melankolikti, hayatının ne kadar sıkıcı olduğundan sürekli yakınırdı."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:29
translate turkish D_jannet_coming_out_80a46977:

    jannet "Ben de her zamanki gibi iyi bir dinleyiciydim."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:30
translate turkish D_jannet_coming_out_fe73cd55:

    jannet "Ta ki Astra seks konusunu açana kadar."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:31
translate turkish D_jannet_coming_out_3bf6c0e3:

    astra "Anlamıyorum işte... Sen ve kardeşim hiç bir şey yaptınız mı henüz?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:32
translate turkish D_jannet_coming_out_5cf36872:

    jannet "N-ne demek istiyorsun?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:33
translate turkish D_jannet_coming_out_3ffb915b:

    astra "Sikiştiniz mi?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:34
translate turkish D_jannet_coming_out_71d5ad58:

    jannet "Ah, s-sen ne... H-hayır, yapmadık..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:35
translate turkish D_jannet_coming_out_35407cd0:

    astra "Evet, tahmin etmiştim. Eh..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:36
translate turkish D_jannet_coming_out_e00f83a7:

    astra "İkiniz çok tatlısınız. Çok benziyorsunuz birbirinize. İkiniz de utangaç..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:37
translate turkish D_jannet_coming_out_00656f7f:

    astra "İkiniz de şirin. Çekingen. Birlikte olmanıza şaşmamalı."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:38
translate turkish D_jannet_coming_out_6e53c201:

    astra "Ama böyle bir çift asla ilerleyemez."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:39
translate turkish D_jannet_coming_out_4c86ba0e:

    "O akşam gerçekten sinirime dokundu."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:40
translate turkish D_jannet_coming_out_0a3ee2ec:

    jannet "Ben de gerçekten ilerlemek istiyorum..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:41
translate turkish D_jannet_coming_out_cd67baf5:

    jannet "Bu konuda o kadar çok şey okudum ki."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:42
translate turkish D_jannet_coming_out_ed22afc2:

    jannet "İnternetten araştırdım."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:43
translate turkish D_jannet_coming_out_a7ee459a:

    jannet "Ve hepsi, yapmaya bir türlü cesaret edemediğim bir şeye çıkıyor... Hepsi çok... pis."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:44
translate turkish D_jannet_coming_out_94ed92e3:

    astra "Yani birinin biraz cesaret toplayıp deneyim kazanması lazım, doğru anlıyorsam..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:45
translate turkish D_jannet_coming_out_f3afdb6d:

    astra "Dinle, Austyn üzerinde denemek istediğim bir yöntem var."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:46
translate turkish D_jannet_coming_out_3a37dc01:

    astra "Gelişimiyle ilgili ne kadar zorlandığını biliyorsun."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:47
translate turkish D_jannet_coming_out_d9afa6b1:

    astra "Deneysel bir şey. Biraz aptalca ama yine de."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:48
translate turkish D_jannet_coming_out_095bab50:

    jannet "Ah, evet... Gerçekten çok zorlanıyor. A-ama..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:49
translate turkish D_jannet_coming_out_f067c7b8:

    astra "Evet?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:50
translate turkish D_jannet_coming_out_ef063e31:

    jannet "Eğer bu yöntem henüz kimse üzerinde denenmediyse, b-belki önce beni deneyebilirsin?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:51
translate turkish D_jannet_coming_out_11892bbf:

    astra "Seni mi? Femboylar için tasarlandı bu, Jannet. Sende bir sorun yok, yani, sadece..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:52
translate turkish D_jannet_coming_out_a44b36f4:

    jannet "Bende sorun yok derken ne demek istiyorsun? H-her şeyi zavallı küçük Austyn'e mi yıkıyorsun?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:53
translate turkish D_jannet_coming_out_f3b2fcec:

    astra "Öhöm..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:54
translate turkish D_jannet_coming_out_afa2278b:

    jannet "P-peki... bizim Austyn'imiz."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:55
translate turkish D_jannet_coming_out_3b068502:

    jannet "Ah. Tahmin etmiştim. Amaç Austyn'in yeni bir şeye hazır olmasıysa, bu beni de ilgilendiriyor."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:56
translate turkish D_jannet_coming_out_5c63b3e5:

    jannet "Ve bence ben de böyle bir işleme ihtiyaç duyabilirim."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:57
translate turkish D_jannet_coming_out_6b0f0542:

    jannet "Austyn'e dokunmadan önce, henüz hiç kimse üzerinde bile denemedin!"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:58
translate turkish D_jannet_coming_out_c7506f84:

    astra "Ama seni deney olarak kullanamam ki... Austyn'de kaybedecek bir şey yok."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:59
translate turkish D_jannet_coming_out_f798dcbd:

    jannet "Peki bende tam olarak ne kaybedeceksin?!"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:60
translate turkish D_jannet_coming_out_0144ef9f:

    "Seni savunmak için elimden gelen her şeyi yapıyordum."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:61
translate turkish D_jannet_coming_out_376f1a27:

    jannet "Ah, işe yararsa, Austyn'le kendi başıma baş edebilirim..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:62
translate turkish D_jannet_coming_out_6ebbb64a:

    jannet "Ama önce onunla yaparsan, işe yarasa bile ona yetişemem..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:63
translate turkish D_jannet_coming_out_3505ef17:

    jannet "Ve ben... onu kaybetmek istemiyorum gerçekten..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:65
translate turkish D_jannet_coming_out_825a2925:

    astra "Pekâlâ... Haklı bir noktaya değindin..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:66
translate turkish D_jannet_coming_out_6af7d9f9:

    astra "O zaman sana bir teklifim var."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:68
translate turkish D_jannet_coming_out_4eced88b:

    astra "Bundan sonra bunu giyeceksin..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:69
translate turkish D_jannet_coming_out_14b56e0c:

    "Bana, hayatta giyeceğimi hiç düşünmediğim, gülünç derecede minik bir tanga uzattı."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:70
translate turkish D_jannet_coming_out_e5fc5b9d:

    "Eve gittiğimde, sadece benimle dalga geçtiğini düşündüm."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:72
translate turkish D_jannet_coming_out_eb21fe26:

    "Ama yine de yapmaya karar verdim. Bol kıyafetlerimi çıkardım."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:73
translate turkish D_jannet_coming_out_2cc55148:

    "Şortumu indirdim..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:74
translate turkish D_jannet_coming_out_ab7eddcd:

    "Aynada kendimi gördüğümde şoke oldum..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:76
translate turkish D_jannet_coming_out_a0150cd3:

    "O iç çamaşırlarına öyle âşık oldum ki bir sürü tane daha sipariş ettim."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:77
translate turkish D_jannet_coming_out_e9a12133:

    "İnternette onlara bakarken, onları giyen bir sürü başka kız buldum."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:79
translate turkish D_jannet_coming_out_a7cd374e:

    "Ve onların tarzını kopyalamaya başladım... makyaj, kıyafetler."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:80
translate turkish D_jannet_coming_out_b827cde5:

    "Sonra Astra daha pratik dersler için Holly'yi önerdi ama ben ikimizin de tanıdığı biri olmaması konusunda ısrar ettim..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:82
translate turkish D_jannet_coming_out_b2b6aa4a:

    "Bunun üzerine beni üniversitesinden, benzer şeyler yapan ama femboylarla çalışan biriyle tanıştırdı..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:83
translate turkish D_jannet_coming_out_e84ecb99:

    "Tam ayrıntıları hatırlamıyorum ama Astra senin için tuttuğu notların aynısını benim için de tutmuştu, Austy..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:84
translate turkish D_jannet_coming_out_1fc66905:

    "Onda işe yaradı... ah..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:96
translate turkish D_jannet_coming_out_70f50299:

    jannet "Ve seninle... ve benimle..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:97
translate turkish D_jannet_coming_out_423f3013:

    jannet "Harika değil mi?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:98
translate turkish D_jannet_coming_out_9a4048ae:

    jannet "Dürüst olmak gerekirse, sana her şeyi anlattığım için kendimi çok daha iyi hissediyorum..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:99
translate turkish D_jannet_coming_out_5bcbd5a4:

    jannet "Ş-şimdi... ş-şimdi söyle bana... b-bütün bunlar hakkında ne düşünüyorsun?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:100
translate turkish D_jannet_coming_out_2de1df7d:

    jannet "Ah, çok gerginim..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:101
translate turkish D_jannet_coming_out_d4620275:

    "Jannet'i daha önce hiç böyle gördüğünü sanmıyorsun."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:102
translate turkish D_jannet_coming_out_a32340a7:

    "Gerçekten çok kırılgan ve savunmasız olabiliyordu."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:103
translate turkish D_jannet_coming_out_91a17054:

    player "Ah, bunların hepsi çok... beklenmedik. Dürüst olmak gerekirse, ne düşüneceğimi bile bilmiyorum."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:104
translate turkish D_jannet_coming_out_171108eb:

    player "Sanki birdenbire her şey anlam kazandı. Sanki her şey... bir şekilde adil."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:105
translate turkish D_jannet_coming_out_a2233179:

    player "Son birkaç ayda çok fazla cinsel deneyim yaşadım..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:106
translate turkish D_jannet_coming_out_9c0d7e83:

    player "Sen de öyle."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:107
translate turkish D_jannet_coming_out_c6c8d3f3:

    jannet "Ama ben tek bir femboyla bile olmadım! Peki sen hiç kızlarla oldun mu?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:108
translate turkish D_jannet_coming_out_976f2cff:

    player "Nasıl söylesem bilemiyorum... Sanırım Jessica Love, tanıştığımız ilk seferde elini kıçıma soktu..."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:109
translate turkish D_jannet_coming_out_ac3eedcf:

    jannet "Ah... şey, o kadar da kötü değil... Sadece bir el... özel bir şey yok... değil mi?"

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:110
translate turkish D_jannet_coming_out_fae3d2c8:

    "Jannet'in gözle görülür şekilde gerildiğini hissedebiliyorsun."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:111
translate turkish D_jannet_coming_out_4d258f31:

    player "E-evet, aramızda hiçbir şey yok. Gerçekten."

# game/scripts/sequences/390/jannet_coming_out/dialogues.rpy:113
translate turkish D_jannet_coming_out_3971c673:

    jannet "Bana yalan söylemesen iyi olur... O kadar kolay yırtamazsın, hi-hi."

