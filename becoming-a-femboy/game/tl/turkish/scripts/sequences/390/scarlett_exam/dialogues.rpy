    "Femboylar çıplak ayaklarının ağızlarına girmeden önce nerelerde bulunmuş olabileceğini hiç umursamadı."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:240
translate turkish D_scarlett_exam_reward_2d93365b:

    "Sanki buna çoktan alışmışlar gibi."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:241
translate turkish D_scarlett_exam_reward_8b4c6cb1:

    "Gıdıklanma hissi yavaş yavaş azalıyor gibiydi ve sen ıslak ayak hissine kapılmaya başladın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:242
translate turkish D_scarlett_exam_reward_3f42e8ff:

    "Scarlett kendisi önünde çömelerek alçaldı."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:244
translate turkish D_scarlett_exam_reward_bf482d05:

    scarlett "Ah, artık kendimi tutamıyorum..."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:245
translate turkish D_scarlett_exam_reward_e2e1edbf:

    "Bir elinde sikini tutuyor, hafif hareketlerle ovuşturuyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:246
translate turkish D_scarlett_exam_reward_6c1749fd:

    "Diğer eliyle kıç yanağını kavrıyor, anüsünü açıyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:247
translate turkish D_scarlett_exam_reward_2a8f3a09:

    "Bakışlarını hafifçe kaçırarak seni dikkatle inceliyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:248
translate turkish D_scarlett_exam_reward_88f00b5a:

    scarlett "Bu odada sadece sen ve ben birbirimizi anlıyoruz, hehe."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:249
translate turkish D_scarlett_exam_reward_b189d53e:

    "Scarlett şaka yapıyor, bu odada sadece ikinizin taş gibi sert ereksiyonu olduğunu ima ediyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:250
translate turkish D_scarlett_exam_reward_916d3fa8:

    scarlett "Mmm..."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:252
translate turkish D_scarlett_exam_reward_f3c423b3:

    "Scarlett hafifçe inledi ve minik dilini anüsüne sokmaya başladı."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:253
translate turkish D_scarlett_exam_reward_60c76084:

    "Onunla birlikte inledin."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:254
translate turkish D_scarlett_exam_reward_7b1d57be:

    "Anüsün baskısı altında açılmaya başladı, onun uzun, kaygan dilini içine alıyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:255
translate turkish D_scarlett_exam_reward_6c24437a:

    "Yedinci kattasın..."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:256
translate turkish D_scarlett_exam_reward_5fef7b24:

    "Şu anda bunu şüpheli bulacak durumda bile değilsin."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:257
translate turkish D_scarlett_exam_reward_62818356:

    "Sadece mutluluğa ve Scarlett'e duyduğun minnet hissine odaklanmışsın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:258
translate turkish D_scarlett_exam_reward_659f4eb8:

    "Senin için bu, buradaki tüm zamanın en beklenmedik sürprizi."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:259
translate turkish D_scarlett_exam_reward_b29a5882:

    "Scarlett'in dilinin içine gireceğini hayal bile edemezdin."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:260
translate turkish D_scarlett_exam_reward_48bc5deb:

    "Scarlett tanıştığınız andan itibaren o düşünceleri kökünden söküp attı."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:261
translate turkish D_scarlett_exam_reward_e5e1699d:

    "Scarlett senin altında olsa bile, yine de hâkimiyet gibi hissettirmiyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:262
translate turkish D_scarlett_exam_reward_fb87f1e5:

    "Yetiştirilmesi seni bu kadar güçlü etkiledi."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:263
translate turkish D_scarlett_exam_reward_40f2c386:

    "Bütün bunlar, dokunulmadan kalan sikin için büyük bir sınav gibi hissettiriyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:264
translate turkish D_scarlett_exam_reward_5d8130ba:

    "Aynı anda bu kadar çok hassas noktanın uyarılmasından çaresizce seğiriyor ve şişiyor!"

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:265
translate turkish D_scarlett_exam_reward_1ca6070e:

    "Şu anda tek bir dokunuşla boşalabileceğin izlenimine kapılıyorsun."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:266
translate turkish D_scarlett_exam_reward_72f76804:

    "Görünüşe göre Scarlett bunu çok iyi anlıyor. Sanki sınırınla oynuyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:267
translate turkish D_scarlett_exam_reward_1b76eb77:

    "Seni test ediyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:268
translate turkish D_scarlett_exam_reward_bedbdb57:

    "Kanepesinde zevkten eridiğini görüyor."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:269
translate turkish D_scarlett_exam_reward_f43e7193:

    "Yüzün tamamen kızarmış. Çaresizce gözlerini kapattın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:270
translate turkish D_scarlett_exam_reward_574515df:

    "Sadece kalın sikinin çoktan içinde olmasının ne kadar harika olacağını düşünüyorsun."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:271
translate turkish D_scarlett_exam_reward_a1bb2749:

    "O düşüncelerden kurtulmak imkânsız."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:272
translate turkish D_scarlett_exam_reward_cd06a20c:

    "Ne kadar gevşediğini hisseden Scarlett anı kaçırmadı."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:273
translate turkish D_scarlett_exam_reward_33e2f437:

    "Doğru anı bekliyordu..."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:277
translate turkish D_scarlett_exam_reward_a1db4060:

    "Avucuyla taşaklarına sertçe şaplak atmak için!"

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:278
translate turkish D_scarlett_exam_reward_da87e21c:

    "O an, patlarcasına boşaldın, karnına bir atış ardına bir atış fışkırttın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:279
translate turkish D_scarlett_exam_reward_ad16e792:

    "Aynı anda hem şok hem zevk hissettin, o soyut acıdan boşaldın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:280
translate turkish D_scarlett_exam_reward_b706a74f:

    "Sen inlemeyi bırakana kadar seni sıkıca tutuyorlar."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:281
translate turkish D_scarlett_exam_reward_77592f83:

    "Bundan ne kadar uzun süre boşalabildiğine şaşırdın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:282
translate turkish D_scarlett_exam_reward_92d5b65f:

    "Scarlett seni tek bir hafif hareketle cennetten yeryüzüne indirdi."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:284
translate turkish D_scarlett_exam_reward_2b191be9:

    scarlett "Mmm... Harika vakit geçirdim, Austin..."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:285
translate turkish D_scarlett_exam_reward_58b66a97:

    "Sanki hiçbir şey olmamış gibi söyledi."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:286
translate turkish D_scarlett_exam_reward_094fd41c:

    scarlett "Sınıftaki diğer tembeller sikimi yutmaya başlamadan önce giyinmen için sadece birkaç dakikan var."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:287
translate turkish D_scarlett_exam_reward_dd9cd7ff:

    scarlett "Görüşürüz..."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:288
translate turkish D_scarlett_exam_reward_e614e0dd:

    "Kanepeden kalkıp daha önce görülmemiş bir hızla giyinmeye başladın."

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:289
translate turkish D_scarlett_exam_reward_8abe76c1:

    player "{i}Ah... O... O deli...{/i}"

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:290
translate turkish D_scarlett_exam_reward_3ad011b5:

    player "{i}Her konuda deli...{/i}"

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:291
translate turkish D_scarlett_exam_reward_5fd26839:

    player "{i}N-neydi bu... Bunca zaman uyumuyordum, değil mi?!{/i}"

# game/scripts/sequences/390/scarlett_exam/dialogues.rpy:292
translate turkish D_scarlett_exam_reward_47b0a52e:

    "Olanlardan sonra düşüncelerinin tonu değişti ve işlerinin başına gittin."

translate turkish strings:

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:18
    old "You scored [score] out of 10"
    new "10 üzerinden [score] puan aldın"

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:36
    old "You stayed after class like Scarlett told you to."
    new "Scarlett'in söylediği gibi dersten sonra kaldın."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:39
    old "And you are not alone in your misery. There are plenty of other slackers like you in the classroom."
    new "Ve bu sefalette yalnız değilsin. Sınıfta senin gibi bir sürü tembel var."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:42
    old "Your mind keeps replaying thoughts about the gossip surrounding Scarlett's \"personal exam\"."
    new "Aklın sürekli Scarlett'in \"kişisel sınavı\" hakkındaki dedikodulara dönüyor."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:45
    old "You want to believe it’ll all boil down to a stern talk, and everything else is just lies."
    new "Hepsinin sert bir konuşmaya çıkacağına, gerisinin yalan olduğuna inanmak istiyorsun."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:48
    old "After all, the exam itself wasn’t as hard as you imagined."
    new "Sonuçta sınavın kendisi hayal ettiğin kadar zor değildi."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:53
    old "You heard Scarlett’s calm, yet clear and loud voice from her office."
    new "Scarlett'in sakin ama net ve yüksek sesini odasından duydun."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:56
    old "In an instant, you start trembling, and you obediently head into her office."
    new "Bir anda titremeye başlıyorsun ve itaatkâr bir şekilde odasına yöneliyorsun."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:121
    old "You see the assistant made the final note, and you left the room."
    new "Asistanın son notu yazdığını görüyorsun ve odadan çıktın."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:134
    old "Having finished the exam, you decide to walk past Scarlett's office."
    new "Sınavı bitirdikten sonra Scarlett'in odasının önünden geçmeye karar veriyorsun."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:137
    old "However, the closer you get, the more the sounds coming from inside scare you off."
    new "Ancak yaklaştıkça içeriden gelen sesler seni korkutup uzaklaştırıyor."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:140
    old "You hear someone straining with all their might, making muffled mooing noises."
    new "Birinin var gücüyle zorlandığını, boğuk inlemeler çıkardığını duyuyorsun."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:143
    old "The door was slightly ajar, and you decided to peek inside."
    new "Kapı hafifçe aralıktı ve içeri göz atmaya karar verdin."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:170
    old "After the exam ended, Scarlett ordered you to report to her office immediately."
    new "Sınav bittikten sonra Scarlett hemen odasına gelmeni emretti."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:173
    old "You are absolutely sure you haven't done anything wrong."
    new "Yanlış bir şey yapmadığından kesinlikle eminsin."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:176
    old "Fear and trembling overtake you at the anticipation of what Scarlett might come up with this time."
    new "Scarlett'in bu sefer neler uydurabileceğini beklerken korku ve titreme seni ele geçiriyor."

    # game/scripts/sequences/390/scarlett_exam/dialogues.rpy:179
    old "Entering her office, you found she wasn’t alone."
    new "Odasına girdiğinde yalnız olmadığını gördün."

