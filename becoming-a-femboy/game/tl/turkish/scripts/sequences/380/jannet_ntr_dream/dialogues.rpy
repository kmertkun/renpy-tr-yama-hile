# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:3
translate turkish D_jannet_ntr_dream_6d7bbc7e:

    "Güçlü bir kaygı hissiyle uykuya dalarken bu kadar çabuk bir rüya görebileceğini hiç bilmiyordun."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:4
translate turkish D_jannet_ntr_dream_d489f9f3:

    "Yerel giysi mağazandasın gibi görünüyor."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:5
translate turkish D_jannet_ntr_dream_c595fcfc:

    "Bir perdenin arkasından bir kamera deklanşörünün sesini net bir şekilde duyuyorsun, sanki biri aynanın önünde fotoğraf çekiyormuş gibi."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:6
translate turkish D_jannet_ntr_dream_9f2d7b04:

    "Fayans zeminde birkaç topuk sesi arkadan geliyor."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:8
translate turkish D_jannet_ntr_dream_1650b042:

    "Ve sonra yine birkaç kamera deklanşörü sesi."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:9
translate turkish D_jannet_ntr_dream_cc436e50:

    "Burada ne yaptığını anlamıyorsun..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:10
translate turkish D_jannet_ntr_dream_ccfaaa92:

    "Sadece gizlice mi bakıyorsun? Yoksa birini mi bekliyorsun?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:11
translate turkish D_jannet_ntr_dream_68a9d189:

    "Belki burada olmak için bir sebebin olmadığına karar verip gitmek üzereyken aniden birinin perdeyi açtığını duyuyorsun."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:12
translate turkish D_jannet_ntr_dream_99b24076:

    "Bunca zaman perdenin arkasındakinin kız arkadaşın Jannet olduğunu aniden fark ediyorsun!"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:14
translate turkish D_jannet_ntr_dream_d22de527:

    jannet "Eee? Ne düşünüyorsun?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:15
translate turkish D_jannet_ntr_dream_a90bda2a:

    "Ama bu senin evrenindeki Jannet! Senin Jannet'in!"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:16
translate turkish D_jannet_ntr_dream_2d18a0db:

    "Pembe tutamlı sarı saçları ve piercingsiz yüzü her şeyi hemen açıkladı."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:17
translate turkish D_jannet_ntr_dream_f203ab92:

    "Ancak ona baktıkça yakın zamanda tanıştığın yeni Jannet'i daha çok hatırlatıyor."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:18
translate turkish D_jannet_ntr_dream_6e7de723:

    player "{i}N-ne giymiş böyle...?{/i}"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:19
translate turkish D_jannet_ntr_dream_054f5ea5:

    "Tamamen şeffaf, bej-pembe renkli bir üst giymiş, soluk teniyle bütünleşiyor."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:20
translate turkish D_jannet_ntr_dream_c8b20074:

    "Ve görünümü tamamlamak için tasarlanmış gibi görünen minik şortlar."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:21
translate turkish D_jannet_ntr_dream_5edef59f:

    jannet "Neye bakıyorsun, aptal?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:22
translate turkish D_jannet_ntr_dream_737870da:

    jannet "Sessiz mi? Demek beğendin?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:23
translate turkish D_jannet_ntr_dream_3a94703b:

    jannet "Beni vazgeçirmeye çalışmayacak mısın bile?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:24
translate turkish D_jannet_ntr_dream_baee395c:

    jannet "\"Ah hayır, Jannet, hadi ama! Bu çok fazla!\""

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:25
translate turkish D_jannet_ntr_dream_e0748b9b:

    player "Ben... Ben sadece..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:26
translate turkish D_jannet_ntr_dream_18e58faa:

    jannet "Gözlerin senin yerine her şeyi söylüyor, çocuk..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:27
translate turkish D_jannet_ntr_dream_a8b15148:

    jannet "Seninle parkta böyle yürümemi ister misin?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:28
translate turkish D_jannet_ntr_dream_2df07169:

    jannet "Büyük, sulu memelerimi herkese göstererek?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:29
translate turkish D_jannet_ntr_dream_d73dc196:

    player "B-bunu kastetmedim... Ben sadece..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:30
translate turkish D_jannet_ntr_dream_4c89dcbf:

    jannet "Ne? Harika bir fikir gibi geliyor!"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:31
translate turkish D_jannet_ntr_dream_c85e29f4:

    jannet "Bana yönelen tüm bu ekstra ilgiyle nasıl başa çıkacağını görelim!"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:32
translate turkish D_jannet_ntr_dream_4f23ab56:

    jannet "Yine mi öylece duracaksın, ağzın açık ve sessiz?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:33
translate turkish D_jannet_ntr_dream_bd5fb5cc:

    jannet "Tanrım, ne kadar acınasısın..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:34
translate turkish D_jannet_ntr_dream_abdea204:

    player "Jannet, ben... Ben sadece..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:35
translate turkish D_jannet_ntr_dream_37eadaec:

    "Düşüncelerin tam bir karmaşa."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:36
translate turkish D_jannet_ntr_dream_16254193:

    "Çelişkiler ve soruların fırtınasında kayboldun."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:37
translate turkish D_jannet_ntr_dream_8b7d70ef:

    "Yine de tek yapabildiğin sert yutkunup bakmak."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:38
translate turkish D_jannet_ntr_dream_633e5e20:

    jannet "Aman tanrım, sakın yine sertleştiğini söyleme?"

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:39
translate turkish D_jannet_ntr_dream_7799ea28:

    "Jannet sesini yükseltiyor ve mağazada konuşmanızı duymayan kimse kalmamış gibi hissediyorsun."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:41
translate turkish D_jannet_ntr_dream_7092498f:

    jannet "Neyse, sorun değil. Arkadaşım da beğendi."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:42
translate turkish D_jannet_ntr_dream_64697d58:

    jannet "Hadi, onunla buluşmaya yine geç kalamam..."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:45
translate turkish D_jannet_ntr_dream_066fa830:

    "Soğuk terler içinde sabah güneşi altında uyanıyorsun, bunun sadece bir rüya olduğu gerçeğini kabullenemeden."

# game/scripts/sequences/380/jannet_ntr_dream/dialogues.rpy:46
translate turkish D_jannet_ntr_dream_d9456c6c:

    player "Ah... Ne rahatsız edici..."

