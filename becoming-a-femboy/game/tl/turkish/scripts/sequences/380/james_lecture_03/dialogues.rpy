# game/scripts/sequences/380/james_lecture_03/dialogues.rpy:27
translate turkish D_james_lecture_03_751b6ddc:

    player "Hadi ama, James. S-zaten yeterince verdin..."

# game/scripts/sequences/380/james_lecture_03/dialogues.rpy:29
translate turkish D_james_lecture_03_621462a9:

