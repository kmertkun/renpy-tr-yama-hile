# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:3
translate turkish D_billy_bully_bullying_02_e3dced1d:

    "Jannet ve Billy'nin tribünlerin arkasında yine birlikte vakit geçirdiğini görüyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:4
translate turkish D_billy_bully_bullying_02_b7a755d2:

    "Merakını yenemeyip bir kez daha kulak misafiri olmaya karar veriyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:5
translate turkish D_billy_bully_bullying_02_791f3406:

    "Tribünlerin diğer tarafına rahatça yerleşip kulağını tahtalara yaslıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:6
translate turkish D_billy_bully_bullying_02_e6b610c9:

    jannet "Ah, bugün ne harika bir gün, değil mi, Billy?"

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:7
translate turkish D_billy_bully_bullying_02_970afe29:

    billy "Seninle her gün harika oluyor, Jannet."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:8
translate turkish D_billy_bully_bullying_02_2c86e0ae:

    jannet "Mmm... Bugün çok romantiksin..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:9
translate turkish D_billy_bully_bullying_02_54f447cf:

    jannet "Biri belli ki istiyor..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:12
translate turkish D_billy_bully_bullying_02_fc019e5a:

    "Jannet elini Billy'nin kasığına koyuyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:13
translate turkish D_billy_bully_bullying_02_0bc7295f:

    jannet "Ah, demek mesele bu, hehe."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:16
translate turkish D_billy_bully_bullying_02_ab12d423:

    jannet "Bu zamanı iyi değerlendirelim..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:17
translate turkish D_billy_bully_bullying_02_c52812af:

    "Fermuarın açılışının yüksek sesini duyuyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:18
translate turkish D_billy_bully_bullying_02_a2a70af4:

    jannet "Bugün en sevdiğin olacak..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:21
translate turkish D_billy_bully_bullying_02_99c7a9ba:

    "Jannet memelerini tribünlere sıkıca bastırıp kıçını Billy'ye doğru uzatıyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:22
translate turkish D_billy_bully_bullying_02_89a370a3:

    billy "Oh evet... Mmm..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:24
translate turkish D_billy_bully_bullying_02_d01021d3:

    "Yüksek şaplak sesleri ve Jannet'in hafif inlemelerini duyuyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:27
translate turkish D_billy_bully_bullying_02_d7b98973:

    "Billy yarağını kalçalarının arasında kaydırıyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:28
translate turkish D_billy_bully_bullying_02_ae019100:

    jannet "Ne bekliyorsun, gir içeri... Hehe."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:31
translate turkish D_billy_bully_bullying_02_657da1fa:

    "Doğrudan daveti duyan Billy vakit kaybetmeden Jannet'in içine girmeye başlıyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:32
translate turkish D_billy_bully_bullying_02_6a2877e4:

    jannet "Ah... Evet..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:35
translate turkish D_billy_bully_bullying_02_a856e6e8:

    "Billy'nin yarağı Jannet'in kıçına yavaşça giriyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:36
translate turkish D_billy_bully_bullying_02_e82cdfa6:

    "Billy'nin kendine has inlemelerini duyuyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:43
translate turkish D_billy_bully_bullying_02_6320a09a:

    jannet "Tam öyle..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:44
translate turkish D_billy_bully_bullying_02_f15d8942:

    jannet "Mmm..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:45
translate turkish D_billy_bully_bullying_02_eb5e85e6:

    "İkisi de uzun, uyumlu bir şekilde inliyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:46
translate turkish D_billy_bully_bullying_02_4dd69eaa:

    "İnlemelerine Billy'nin kalçalarının Jannet'in büyük, yumuşak kıçına çarpma sesi eşlik ediyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:47
translate turkish D_billy_bully_bullying_02_46f57d73:

    "Olanlardan son derece azmış durumdasın, düşüncelerini nereye odaklayacağını bilemiyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:48
translate turkish D_billy_bully_bullying_02_23c00cde:

    "Kız arkadaşının duvarın hemen ötesinde becerildiğini düşünüyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:49
translate turkish D_billy_bully_bullying_02_6bea5982:

    "Ama Billy'nin kalın yarağının her girişte Jannet'in kıçını tamamen germesi düşüncesinden de kurtulamıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:50
translate turkish D_billy_bully_bullying_02_b55e6b8d:

    "Yarağının deliğini her hamlede biraz daha açışını zihninde canlı canlı hayal ediyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:51
translate turkish D_billy_bully_bullying_02_83a097f3:

    jannet "Ah..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:52
translate turkish D_billy_bully_bullying_02_ae609ff0:

    jannet "Evet, evet, evet..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:53
translate turkish D_billy_bully_bullying_02_86ae98d0:

    jannet "Sakın durma..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:54
translate turkish D_billy_bully_bullying_02_56ae7292:

    "Billy'nin hareketleri hızlanıyor gibi, bitiş çizgisine zaten yaklaşıyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:55
translate turkish D_billy_bully_bullying_02_e4739449:

    billy "Biraz daha..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:56
translate turkish D_billy_bully_bullying_02_17706c54:

    billy "Tanrım..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:62
translate turkish D_billy_bully_bullying_02_59a4abc4:

    "Billy'nin hafif soluklarından sonra uzun bir inleme geliyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:63
translate turkish D_billy_bully_bullying_02_a6dd440c:

    "Şaplak sesleri duruyor."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:64
translate turkish D_billy_bully_bullying_02_b93c9d1c:

    "Görünüşe göre Billy kız arkadaşının içine, okul tribünlerinin hemen arkasında boşaldı."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:65
translate turkish D_billy_bully_bullying_02_f15d8942_1:

    jannet "Mmm..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:66
translate turkish D_billy_bully_bullying_02_e640659c:

    jannet "Çok güzel... Çok sıcak..."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:67
translate turkish D_billy_bully_bullying_02_89cbc681:

    "Daha fazla dinlemeye dayanamıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_02/dialogues.rpy:68
translate turkish D_billy_bully_bullying_02_78a982bc:

    "Tribünlerden altüst bir halde ayrılıyorsun."

