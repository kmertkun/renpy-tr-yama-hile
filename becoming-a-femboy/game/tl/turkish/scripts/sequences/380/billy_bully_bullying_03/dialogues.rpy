# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:3
translate turkish D_billy_bully_bullying_03_91efe4ee:

    "Jannet ve Billy'nin yine tribünlerin arkasında olduğunu uzaktan görünce, en sevdiğin gizli dinleme noktasına yeniden yerleşiyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:4
translate turkish D_billy_bully_bullying_03_137d3ca3:

    "Tribünlerin hemen arkasında, onlardan sadece birkaç santim ötede."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:5
translate turkish D_billy_bully_bullying_03_acf806c7:

    billy "Ah, seni tekrar gördüğüme çok sevindim..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:6
translate turkish D_billy_bully_bullying_03_ba4c6f7b:

    jannet "Neden sevindiğini biliyorum..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:7
translate turkish D_billy_bully_bullying_03_f8442774:

    "Jannet, Billy'nin kasığını okşarken söylüyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:8
translate turkish D_billy_bully_bullying_03_5c5d207b:

    "Yarağı en başından beri zaten sert."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:9
translate turkish D_billy_bully_bullying_03_d0f24b83:

    billy "Sen de mutlusun..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:11
translate turkish D_billy_bully_bullying_03_1c72d927:

    jannet "Ah, günün her saati, hehe."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:12
translate turkish D_billy_bully_bullying_03_0361e46f:

    jannet "Ama bizim bu küçük 'ritüelimizin' bundan sonra özel bir şeye dönüşmesini istiyorum."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:13
translate turkish D_billy_bully_bullying_03_de1f76bc:

    billy "Neyi ima ediyorsun?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:18
translate turkish D_billy_bully_bullying_03_efb2859b:

    jannet "Sana Austyn'den bahsetmiştim, hatırlıyor musun..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:19
translate turkish D_billy_bully_bullying_03_7bb0798c:

    "Kalbin aniden daha hızlı çarpmaya başlıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:20
translate turkish D_billy_bully_bullying_03_b9d1b463:

    "Kendini çok gergin hissediyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:21
translate turkish D_billy_bully_bullying_03_8a08863e:

    billy "Ah, o femboy... Mmm..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:22
translate turkish D_billy_bully_bullying_03_0e22489b:

    billy "Onu davet etmek mi istiyorsun?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:23
translate turkish D_billy_bully_bullying_03_8f75b192:

    "Sırtından soğuk bir ter akıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:24
translate turkish D_billy_bully_bullying_03_924111ce:

    "Sanki korkunç bir şey olmak üzereymiş gibi."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:25
translate turkish D_billy_bully_bullying_03_5e7485e7:

    jannet "Ah, ona zaten mesaj atıyorum, hehe."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:29
translate turkish D_billy_bully_bullying_03_c6576a84:

    "Telefonun yüksek sesle yeni bir mesaj bildiriyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:30
translate turkish D_billy_bully_bullying_03_2c6b7b1a:

    billy "Bunu duydun mu?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:31
translate turkish D_billy_bully_bullying_03_d52d2e13:

    jannet "Neyi duydum? Bana bir şey duyulmadı gibi geldi..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:35
translate turkish D_billy_bully_bullying_03_4fce920d:

    "Titreyen ellerinle telefonunu kapıp çılgınca sessiz moda almaya çalışıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:36
translate turkish D_billy_bully_bullying_03_b1ba5160:

    "Mesajı okuyorsun..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:38
translate turkish D_billy_bully_bullying_03_9a3b6960:

    billy "Hayal etmiş olmalıyım."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:39
translate turkish D_billy_bully_bullying_03_00c9ffc5:

    billy "Ona mesaj attın mı zaten?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:40
translate turkish D_billy_bully_bullying_03_9dfa604e:

    jannet "Üstündeyim... Dikkatimi dağıtma..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:43
translate turkish D_billy_bully_bullying_03_d2361317:

    "Jannet sana bir mesaj daha atıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:44
translate turkish D_billy_bully_bullying_03_f7e41883:

    "Bu sefer yüksek titreşim sesi etrafta yankılanıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:45
translate turkish D_billy_bully_bullying_03_6af69218:

    "Ve tabii ki çevredeki her şey lanet gibi sessiz."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:46
translate turkish D_billy_bully_bullying_03_4a8cbf0d:

    billy "İşte yine. Duydun mu? Yakında bir şey titreşiyor..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:49
translate turkish D_billy_bully_bullying_03_818b7452:

    jannet "Evet, bu sefer ben de duydum..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:50
translate turkish D_billy_bully_bullying_03_47bd334a:

    billy "Ne, içinde... şu tıkaçlardan biri mi var?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:51
translate turkish D_billy_bully_bullying_03_bd241229:

    jannet "H-hayır, bugün kesinlikle öyle bir şey takmadım."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:52
translate turkish D_billy_bully_bullying_03_a52c1523:

    billy "Dinle, gelmek isteyeceğinden emin misin?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:53
translate turkish D_billy_bully_bullying_03_7110dd5f:

    jannet "Tabii ki gelecek! O iyi bir küçük femboy..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:56
translate turkish D_billy_bully_bullying_03_833355f0:

    "Jannet sana bir mesaj daha atıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:58
translate turkish D_billy_bully_bullying_03_316c969f:

    "Yüksek titreşim bir kez daha onlara yankılanıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:60
translate turkish D_billy_bully_bullying_03_17f9d543:

    "Panik seni ele geçiriyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:62
translate turkish D_billy_bully_bullying_03_3e9b535a:

    "Telefonunu kontrol edemeyip titreyen ellerinle yanlışlıkla düşürüyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:67
translate turkish D_billy_bully_bullying_03_ac434132:

    jannet "Vay vay... Sanırım neler olduğunu anlıyorum."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:77
translate turkish D_billy_bully_bullying_03_13d40d4f:

    jannet "Hey... Meraklı küçüğümüz kim burada, hm?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:78
translate turkish D_billy_bully_bullying_03_972abc91:

    "Jannet, tribünün kenarına doğru adım atarak alaycı bir şekilde sesleniyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:79
translate turkish D_billy_bully_bullying_03_ed2f9a6d:

    jannet "Vay, kim tahmin ederdi? Kulak misafiri olmak ayıp, sana öğretilmedi mi?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:80
translate turkish D_billy_bully_bullying_03_6e39c718:

    jannet "En azından izinsiz olmaz... hehe."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:81
translate turkish D_billy_bully_bullying_03_510d4a90:

    billy "Kim var orada, Jannet?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:82
translate turkish D_billy_bully_bullying_03_eb90f10c:

    jannet "Sence kim? Austy bu..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:83
translate turkish D_billy_bully_bullying_03_3434d16b:

    jannet "Hadi, utanma. Bunu istedin, değil mi?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:84
translate turkish D_billy_bully_bullying_03_ddee08e0:

    "Jannet sana sesleniyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:85
translate turkish D_billy_bully_bullying_03_69b5aabb:

    "Başını eğip suçlu suçlu ona doğru yürüyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:88
translate turkish D_billy_bully_bullying_03_250e2da6:

    "Billy yaklaşıp utanmazca Jannet'in kıçını tutuyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:89
translate turkish D_billy_bully_bullying_03_66e34c50:

    billy "Ona bir ders vermemi ister misin?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:90
translate turkish D_billy_bully_bullying_03_0599df52:

    jannet "Ah, tabii ki, hehe."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:97
translate turkish D_billy_bully_bullying_03_4bc0e8c8:

    "Jannet Billy'nin önünde diz çöküyor ve seni de kendisiyle birlikte aşağı çekiyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:98
translate turkish D_billy_bully_bullying_03_8bfe731f:

    "Yanında dizlerinin üstüne düşüyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:100
translate turkish D_billy_bully_bullying_03_b16a0fd3:

    jannet "Bugün çok şanslısın, çünkü her şeyi yakından göreceksin, hehe."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:103
translate turkish D_billy_bully_bullying_03_bf4744e3:

    "Jannet Billy'nin pantolonunun fermuarını açıp yarağını çıkarıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:104
translate turkish D_billy_bully_bullying_03_635a2db5:

    jannet "Kulak misafiri olurken böyle mi hayal ettin?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:105
translate turkish D_billy_bully_bullying_03_10991595:

    "Jannet'in önünde derin derin kızarıyorsun, tek kelime edemiyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:106
translate turkish D_billy_bully_bullying_03_92dcba9b:

    jannet "Sessiz mi? Utandın mı? Yoksa beni gözetlediğin için suçlu mu hissediyorsun?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:107
translate turkish D_billy_bully_bullying_03_8179c99c:

    jannet "Belki özür dilemek istersin? Hm?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:108
translate turkish D_billy_bully_bullying_03_6da6b713:

    "Jannet bir şey söyleyemediğini sezip sadece seninle dalga geçiyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:112
translate turkish D_billy_bully_bullying_03_adee6a3b:

    "Bakışlarını senden ayırıp onun yarağını ağzına alıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:116
translate turkish D_billy_bully_bullying_03_a1a98f06:

    "Yakından bakınca o ıslak şapırtı sesleri delice yüksek geliyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:119
translate turkish D_billy_bully_bullying_03_3e39622f:

    "Ne kadar keyif aldığını anlayabiliyorsun ve bu içinde kıskançlık uyandırıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:120
translate turkish D_billy_bully_bullying_03_9bf9c6ef:

    "Sana da sakso çekti ama hiç bu kadar tutkuyla değil."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:121
translate turkish D_billy_bully_bullying_03_f861504d:

    "Neden kıskandığını bile bilmiyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:122
translate turkish D_billy_bully_bullying_03_b5bf935e:

    "O kalın yarağı kendin emmek istediğin için mi, yoksa kız arkadaşın gözlerinin önünde seni aldattığı için mi."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:123
translate turkish D_billy_bully_bullying_03_332a581a:

    player "Ah, ben... Seni üzmek istemedim..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:124
translate turkish D_billy_bully_bullying_03_b5c189df:

    "Ona uzanmaya çalışıyorsun ama garip gelmeyen hiçbir şey söyleyemiyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:125
translate turkish D_billy_bully_bullying_03_141e7f53:

    player "L-lütfen beni affet..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:126
translate turkish D_billy_bully_bullying_03_0296598e:

    "Yine de içten özrüne rağmen Jannet'in ifadesi değişmiyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:127
translate turkish D_billy_bully_bullying_03_853b6518:

    "Ağzını hâlâ Billy'nin yarağından çekmiyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:128
translate turkish D_billy_bully_bullying_03_b75343d0:

    player "Ben... Ben... Gerçekten çok özür dilerim..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:129
translate turkish D_billy_bully_bullying_03_5058526a:

    "Sonunda Jannet'in dikkatini çekmiş gibisin."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:133
translate turkish D_billy_bully_bullying_03_116e8e4f:

    "Bir süre sonra bir anlığına yarağından çekiliyor, sanki sana bir şey söylemek istiyormuş gibi bakıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:134
translate turkish D_billy_bully_bullying_03_065dbe5d:

    "Ama bunun yerine seni yanına çekip öpüyor. Daha önce hiç hissetmediğin bir tutkuyla."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:135
translate turkish D_billy_bully_bullying_03_c0c0d36f:

    "Dilinden yarak tadından başka bir şey almıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:138
translate turkish D_billy_bully_bullying_03_18a1ff0a:

    jannet "Ah, sadece arkana yaslan ve tadını çıkar, tatlım... Bunu istedin, değil mi?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:142
translate turkish D_billy_bully_bullying_03_903bd1e5:

    "Jannet'in seni affedip affetmediğini bilmiyorsun ama Billy'yi emmeye geri dönüyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:144
translate turkish D_billy_bully_bullying_03_e6a604a8:

    "Sanki seni o tatla zehirlemiş ve şimdi sarhoş olmuşsun gibi her hareketine kilitlenmiş durumdasın."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:145
translate turkish D_billy_bully_bullying_03_3a3f29a9:

    "Ne hissedeceğini bilmiyorsun ama çaresizce izlemeye devam ediyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:146
translate turkish D_billy_bully_bullying_03_6c88aa06:

    "Gözlerini Jannet'in dudaklarının Billy'nin kalın, sert yarağına sımsıkı sarılışından ayıramıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:147
translate turkish D_billy_bully_bullying_03_88988e97:

    "Ağzından kalın tükürükle kaplı, parlak çıkmasına bakılırsa onu cilalıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:148
translate turkish D_billy_bully_bullying_03_75391cb8:

    "Bir süre sonra Jannet'in çok daha hızlı hareket etmeye başladığını fark ediyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:149
translate turkish D_billy_bully_bullying_03_65f210df:

    "Billy'nin inlemelerine bakılırsa son yaklaşıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:154
translate turkish D_billy_bully_bullying_03_95bd289c:

    "Uzun bir inlemeyle Billy boşalmaya başlıyor, Jannet ise sadece yarağının başına yapışmış."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:155
translate turkish D_billy_bully_bullying_03_5656ac3e:

    "Billy ağzını meniyle doldururken Jannet itaatkâr bir şekilde ona bakıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:156
translate turkish D_billy_bully_bullying_03_3c02759f:

    player "Ah... Her şey yolunda, değil mi?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:157
translate turkish D_billy_bully_bullying_03_0f60e844:

    player "B-beni affedecek misin?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:158
translate turkish D_billy_bully_bullying_03_52df7ef8:

    "Jannet sessizce sana bakıyor, durumu tartıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:159
translate turkish D_billy_bully_bullying_03_ed64d35f:

    "Neden bu kadar garip davrandığını anlamıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:160
translate turkish D_billy_bully_bullying_03_b6196f8e:

    "Zaten pişman oldun ve elinden geldiğince tatlı olmaya çalıştın."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:164
translate turkish D_billy_bully_bullying_03_b0c8b25a:

    "Barışmayı ne kadar çok istediğini görünce seni öpmeye başlıyor."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:165
translate turkish D_billy_bully_bullying_03_b82e9d09:

    "Ama bu sadece bir öpücük değil. Ağzına kalın ve keskin kokulu bir şey bıraktığını aniden hissediyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:166
translate turkish D_billy_bully_bullying_03_122d2b63:

    "Anında anlıyorsun... Billy'nin spermi bu. Tek damla bile yutmamış."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:167
translate turkish D_billy_bully_bullying_03_8b261d75:

    "Sessizdi çünkü ağzı sadece doluydu."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:168
translate turkish D_billy_bully_bullying_03_402f5720:

    "İşler zaten kırılgan olduğu için direnmemek için elinden geleni yapıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:169
translate turkish D_billy_bully_bullying_03_b44c669e:

    "Jannet seni beslerken porsiyon porsiyon yutuyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:170
translate turkish D_billy_bully_bullying_03_0c476bdb:

    "Sana çılgınca geliyor ama Jannet'in ne kadar keyif aldığını görüyorsun, bu yüzden onu memnun etmeye çalışıyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:171
translate turkish D_billy_bully_bullying_03_d2e4b672:

    "Bu kadar çok olacağını hiç düşünmemiştin."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:172
translate turkish D_billy_bully_bullying_03_9419db90:

    "Sonunda Jannet seni öpmeyi bitiriyor, bir tepki beklemeni bırakarak."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:182
translate turkish D_billy_bully_bullying_03_3da4f7ee:

    jannet "Aferin, Austy... Bir dahaki sefere kadar, hehe."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:183
translate turkish D_billy_bully_bullying_03_6a77d146:

    player "N-ne? Bu... bu affedildim demek mi?"

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:184
translate turkish D_billy_bully_bullying_03_cf0c3268:

    "Jannet ve Billy uzaklaşıyor ve duyduğun son şey şu oluyor..."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:185
translate turkish D_billy_bully_bullying_03_77a76ec6:

    jannet "Belki, Austy. Belki. Hoşça kal."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:188
translate turkish D_billy_bully_bullying_03_f1f8194b:

    "Seni arkalarında tek başına bırakıyorlar."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:189
translate turkish D_billy_bully_bullying_03_583972b0:

    "Bu kadar çok sperm yutup yarağa hiç dokunamadığın için kandırılmış gibi hissediyorsun."

# game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:190
translate turkish D_billy_bully_bullying_03_751907c5:

    "Kullanılmış ve tatminsiz bırakılmış olma hissi seni hazırlıksız yakalıyor. Sanki hiç yetmemiş gibi."

translate turkish strings:

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:34
    old "Hey, sweetie, I know you’re not too busy right now and you’re at school…"
    new "Hey, tatlım, şu an çok meşgul olmadığını ve okulda olduğunu biliyorum..."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:42
    old "Come to the bleachers, in the schoolyard."
    new "Okul bahçesindeki tribünlere gel."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:55
    old "I’ve got something special for you…"
    new "Senin için özel bir şeyim var..."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:65
    old "It hits a metal beam, making even more noise."
    new "Metal bir kirişe çarpıp daha da fazla gürültü çıkarıyor."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:69
    old "You hear footsteps approaching in your direction."
    new "Senin yönüne doğru yaklaşan ayak sesleri duyuyorsun."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:71
    old "Stunned by your own failure, you can’t even move."
    new "Kendi başarısızlığına şaşkın halde kıpırdayamıyorsun bile."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:73
    old "You just sit, waiting for your fate."
    new "Sadece oturup kaderini bekliyorsun."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:93
    old "You start trembling, expecting a beating from this brute."
    new "Bu hayvandan dayak yemeyi bekleyerek titremeye başlıyorsun."

    # game/scripts/sequences/380/billy_bully_bullying_03/dialogues.rpy:175
    old "You swallowed it all and now await her approval."
    new "Hepsini yuttun ve şimdi onun onayını bekliyorsun."

