    player "Ama sonra ona oral yaptırdı."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:146
translate turkish D_astra_research_03_interview_155a23d5:

    astra "Ah, Austie! Kendini kurban gibi göstermeyi bırak."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:147
translate turkish D_astra_research_03_interview_3a2fa054:

    astra "İstemeseydin bunların hiçbirinin olmayacağını çok iyi biliyorsun."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:148
translate turkish D_astra_research_03_interview_a7c8f17b:

    player "E-evet, haklısın."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:149
translate turkish D_astra_research_03_interview_e7586571:

    astra "Kolay manipüle ediliyorsun ve o bundan faydalanıyor."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:150
translate turkish D_astra_research_03_interview_5a13ef02:

    astra "Dört ayak üstüne çöküp sikilmeni söyleyeceği günü sabırsızlıkla bekliyor olmalısın..."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:151
translate turkish D_astra_research_03_interview_9c55fdfd:

    player "Dur artık... Ben... Bilmiyorum."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:152
translate turkish D_astra_research_03_interview_241ceed5:

    astra "Haha! Seni kızartmak çok komik. Tam bir ayaksın Austie."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:153
translate turkish D_astra_research_03_interview_f771f7fa:

    astra "Bu kadar kısa sürede tam bir..."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:154
translate turkish D_astra_research_03_interview_c0a19bfc:

    astra "Ehem... Çok faydalı ve nadir bir deneksin. Konseyin çok sevineceğine eminim."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:155
translate turkish D_astra_research_03_interview_02338e21:

    astra "Pekala, sanırım hazırız!"

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:156
translate turkish D_astra_research_03_interview_254674d9:

    player "Neye hazırız?"

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:157
translate turkish D_astra_research_03_interview_335a9922:

    astra "Oh, neden iki ile ikiyi bir türlü toplayamıyorsun? Her şeyi sana ayrı ayrı anlatmak gerekiyor..."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:158
translate turkish D_astra_research_03_interview_ece4827a:

    astra "Tabii ki projemi sunmaktan bahsediyorum!"

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:159
translate turkish D_astra_research_03_interview_9279fe75:

    astra "Sayende hibeler alacağım! Toplumumuza güzel bir katkı, değil mi?"

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:160
translate turkish D_astra_research_03_interview_9e68360e:

    astra "Ah, ben de... Sana çok minnettarım Austie. Ne kadar ilerleme kaydettiğin çıldırtıcı."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:161
translate turkish D_astra_research_03_interview_65b542fd:

    astra "Doğrusunu söylemek gerekirse, seni tamamen umutsuz vaka sanıyordum."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:162
translate turkish D_astra_research_03_interview_9d28d209:

    player "Şey... Pekala... Teşekkürler..."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:163
translate turkish D_astra_research_03_interview_bd965227:

    astra "Benimle üniversiteye gitmen gerektiğinde sana haber vereceğim."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:164
translate turkish D_astra_research_03_interview_9c13a4e9:

    astra "Bir şey daha var. Bu şekilde giyinmenden çok memnunum ama Tanrı aşkına, üniversiteye bunlarla gelmeye sakın cüret etme!"

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:165
translate turkish D_astra_research_03_interview_95a593ff:

    astra "Daha... resmi giyin."

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:166
translate turkish D_astra_research_03_interview_d0dae772:

    astra "Eminim Jessica Love'ın bu durum için bir şeyi vardır. Mutlaka onunla iletişime geç!"

# game/scripts/sequences/0130/astra_research_03/dialogues.rpy:167
translate turkish D_astra_research_03_interview_c64d90fe:

    player "T-tamam..."

