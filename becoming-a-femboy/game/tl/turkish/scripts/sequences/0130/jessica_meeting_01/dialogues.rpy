# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:3
translate turkish D_jessica_meeting_01_message_end_9471b12f:

    player "{i}Ah, bu çok bile kolaydı! Bir sürü işi olduğunu sanıyordum.{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:4
translate turkish D_jessica_meeting_01_message_end_7cb34b31:

    player "{i}Bu akşam ve keyifli bir ruh halinde... Hmm.{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:11
translate turkish D_jessica_meeting_01_approach_beach_apartment_06d16fff:

    "Jessica'nın en üst kattaki dairesine çıkıyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:12
translate turkish D_jessica_meeting_01_approach_beach_apartment_21d655e5:

    "Asansörün oraya ulaşması gerçekten uzun sürüyor ve bu da buluşmadan hemen önce seni iyice kızıştırıyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:13
translate turkish D_jessica_meeting_01_approach_beach_apartment_3ca4551e:

    "Bu, konuşmayı sekteye uğratmamak için keyifli bir ruh halinde gelmen sana açıkça söylenmiş olmasına rağmen oluyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:14
translate turkish D_jessica_meeting_01_approach_beach_apartment_7cc0da84:

    "Ya da belki hiç konuşma olmayacak. Jessica bu akşamki planlarını çoktan belirlemiş olabilir."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:18
translate turkish D_jessica_meeting_01_approach_beach_apartment_fd8c46e7:

    player "{i}Geri geldiğime göre onun için model olmaya kararlı olduğumu kesinlikle varsaydı.{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:19
translate turkish D_jessica_meeting_01_approach_beach_apartment_dbf6f641:

    player "{i}Üstelik belki de gerçekten kararlıyımdır. Kim bilir...{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:20
translate turkish D_jessica_meeting_01_approach_beach_apartment_7d180120:

    "Yine de bu gecenin macerasız bitmeyeceğinden tamamen eminsin."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:21
translate turkish D_jessica_meeting_01_approach_beach_apartment_ed66b5b2:

    "Tam macerayı düşünürken asansör bip sesiyle duruyor ve bir saniye sonra kapılar önünde kayarak açılıyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:25
translate turkish D_jessica_meeting_01_approach_beach_apartment_fcd9aa70:

    "Artık seninle Jessica'nın dairesini sadece küçük bir koridor ve orada görmeyi beklemediğin garip bir kişi ayırıyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:26
translate turkish D_jessica_meeting_01_approach_beach_apartment_e713de50:

    "Bu kişi, onun dairesine açılan kapıyı koruyan, uzun boylu, koyu tenli bir adam."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:27
translate turkish D_jessica_meeting_01_approach_beach_apartment_6fd31199:

    "Kim olduğunu ya da burada ne yaptığını bilmiyorsun ama rahat duruşu, bir süredir orada durduğunu düşündürüyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:28
translate turkish D_jessica_meeting_01_approach_beach_apartment_2147ee89:

    player "{i}Muhafız mı olmalı? Koruma mı? Benim gibi bir misafir mi?{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:29
translate turkish D_jessica_meeting_01_approach_beach_apartment_274569e8:

    "Asansör kapanıp tekrar aşağı inmeden önce çıkarken kendi kendine düşünüyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:33
translate turkish D_jessica_meeting_01_approach_beach_apartment_fef371dd:

    "Onu rahatsız etmemeye karar verip sakince kapıya yürüyor ve kapıyı çalıyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:34
translate turkish D_jessica_meeting_01_approach_beach_apartment_a3d3455f:

    "Bir süre kimse kapıyı açmayınca tekrar çalmaya karar veriyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:35
translate turkish D_jessica_meeting_01_approach_beach_apartment_9138674e:

    "Bu kadar iri bir adamın yanında pek rahat hissetmiyorsun ama sonunda çekinerek ona soruyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:36
translate turkish D_jessica_meeting_01_approach_beach_apartment_d0f26256:

    player "Ö-özür dilerim, Jessica Love'ın burada yaşayıp yaşamadığını biliyor musunuz?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:37
translate turkish D_jessica_meeting_01_approach_beach_apartment_ca929e9f:

    joseph "Tabii ki biliyorum bebeğim. Jessica burada yaşıyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:38
translate turkish D_jessica_meeting_01_approach_beach_apartment_d1ce7302:

    "Hoş, derin bir sesle sana cevap veriyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:44
translate turkish D_jessica_meeting_01_approach_beach_apartment_9b721b69:

    joseph "Adın?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:45
translate turkish D_jessica_meeting_01_approach_beach_apartment_702c4a6a:

    player "B-benim mi? Adım Austyn. Austyn Raspberry."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:46
translate turkish D_jessica_meeting_01_approach_beach_apartment_b43c1a3b:

    joseph "Dinle Austie. Senin gibi tatlı küçük bir şey ortalıkta tek başına dolaşmamalı."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:47
translate turkish D_jessica_meeting_01_approach_beach_apartment_44559aaf:

    joseph "Çünkü böyle güzel bir yüz burada kesinlikle dikkat çeker."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:48
translate turkish D_jessica_meeting_01_approach_beach_apartment_e438aa3f:

    "Sözlerinden gurur duyuyorsun ama bunu belli etmemeye çalışıyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:49
translate turkish D_jessica_meeting_01_approach_beach_apartment_92dc64cc:

    player "Oh, neden bahsediyorsunuz, Bay..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:50
translate turkish D_jessica_meeting_01_approach_beach_apartment_9c0e5a98:

    joseph "Adım Joseph. Soyadlarını boş verelim."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:51
translate turkish D_jessica_meeting_01_approach_beach_apartment_a0a39e07:

    player "Tanıştığıma memnun oldum, Bay Joseph. Peki ne diyordunuz?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:52
translate turkish D_jessica_meeting_01_approach_beach_apartment_64092293:

    joseph "Senin için sadece Joseph bebeğim. Ben senin öğretmenin değilim, haha."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:53
translate turkish D_jessica_meeting_01_approach_beach_apartment_cf4f4f31:

    player "Pekala. Bu akşam Jessica'yla görüşecektim. Beni evine davet etti."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:54
translate turkish D_jessica_meeting_01_approach_beach_apartment_fd6da210:

    joseph "Oh, evet. Böyle bir şey duymuştum. Modellikte şansını denemek isteyenlerden biri olmalısın."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:55
translate turkish D_jessica_meeting_01_approach_beach_apartment_16876d64:

    joseph "Ben başka bir iş için buradayım..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:56
translate turkish D_jessica_meeting_01_approach_beach_apartment_ae77776d:

    joseph "Onunla bir seansa mı yazıldın? Bunu konuştuğumuzu hatırlamıyorum..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:57
translate turkish D_jessica_meeting_01_approach_beach_apartment_4d854dc3:

    player "Seans mı? H-hayır, ben ondan bahsetmiyorum."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:58
translate turkish D_jessica_meeting_01_approach_beach_apartment_4cf5124f:

    joseph "O zaman hiç anlamıyorum. Buraya sadece etrafı koklamaya mı geldin?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:59
translate turkish D_jessica_meeting_01_approach_beach_apartment_3d85c13f:

    "Sözlerinden biraz gözün korkuyor ve gerilmeye başlıyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:60
translate turkish D_jessica_meeting_01_approach_beach_apartment_d915d87c:

    player "Ben mi? Etrafı koklamak mı? Ne demek istiyorsunuz? Hayır Joseph, kesinlikle hayır... Ben sadece..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:61
translate turkish D_jessica_meeting_01_approach_beach_apartment_9c93e841:

    joseph "Sanki bir koklayıcı itiraf edecekmiş gibi. Aptal mı sanıyorsun beni?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:62
translate turkish D_jessica_meeting_01_approach_beach_apartment_d4b4e082:

    "Kalbin hızla çarparken endişen arttı."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:63
translate turkish D_jessica_meeting_01_approach_beach_apartment_754cf8d3:

    "Koklanacak bir şey olduğu fikri seni daha da huzursuz ediyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:64
translate turkish D_jessica_meeting_01_approach_beach_apartment_0963d4c3:

    "Burada belli ki kimsenin bilmemesi gereken şüpheli bir şeyler dönüyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:65
translate turkish D_jessica_meeting_01_approach_beach_apartment_f4898f39:

    "İkiniz arasında oldukça yüksek sesli bir tartışma başlarken ön kapının gıcırdayarak açıldığını duyuyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:69
translate turkish D_jessica_meeting_01_approach_beach_apartment_d59a4ddf:

    "Jessica karşında beliriyor ama hissettiğin rahatlama karışık."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:70
translate turkish D_jessica_meeting_01_approach_beach_apartment_ceee80a8:

    "Ziyaretini hiç beklemiyor gibi görünüyor ve işe dirseklerine kadar gömülmüş gibi."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:71
translate turkish D_jessica_meeting_01_approach_beach_apartment_5608bd99:

    "Sağ elinde, kalın bir kayganlaştırıcı tabakasıyla kaplı bir lateks eldiven var."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:72
translate turkish D_jessica_meeting_01_approach_beach_apartment_7b29f662:

    jessica "Burada neler oluyor?! Bütün seansımı mahvediyorsunuz!"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:73
translate turkish D_jessica_meeting_01_approach_beach_apartment_06895dda:

    "Seni fark etmeden önce bağırıyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:74
translate turkish D_jessica_meeting_01_approach_beach_apartment_a7e181f3:

    jessica "Oh, Austie. Sensin! Tanrım, bir terslik olduğundan korktum!"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:75
translate turkish D_jessica_meeting_01_approach_beach_apartment_7bee9e60:

    jessica "Joseph, ne diye bağırıyordun?! Şu güzel çocuğu içeri al da sessiz olsun..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:76
translate turkish D_jessica_meeting_01_approach_beach_apartment_2d343587:

    joseph "Özür dilerim, Leydi. Sadece ben..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:77
translate turkish D_jessica_meeting_01_approach_beach_apartment_cc207dbe:

    jessica "Ah, bahane üretmeye kalkma. Bu saçmalığı dinleyecek vaktim yok."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:78
translate turkish D_jessica_meeting_01_approach_beach_apartment_866268a8:

    jessica "Gir içeri Austie. Kendi evin gibi davran. Seni dinleyeceğim, sadece birkaç dakika ver bana..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:79
translate turkish D_jessica_meeting_01_approach_beach_apartment_aa2a5f41:

    "Zafer hissi seni kısa bir an rahatlatıyor ve sessizce dairesine girip Joseph'i garip bir durumda bırakıyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:80
translate turkish D_jessica_meeting_01_approach_beach_apartment_ee0882fc:

    "Ona bakmıyorsun bile, kendini beğenmiş bir tavırla yanından geçiyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:85
translate turkish D_jessica_meeting_01_approach_beach_apartment_8562ff6d:

    "Bir an sonra kendini Jessica'nın dairesinin içinde buluyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:86
translate turkish D_jessica_meeting_01_approach_beach_apartment_93784702:

    "Partilerinde bulunma fırsatı yakaladığın plajın muhteşem manzarasına sahip, devasa panoramik pencerelerle dolu bir odaya giriyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:87
translate turkish D_jessica_meeting_01_approach_beach_apartment_2de9f299:

    "Daire kesinlikle lüks görünüyor. İç dekorasyonun çoğuna dokunmak bile korkutucu, çünkü bu şeylerin ne kadar tutabileceğini hayal bile edemiyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:88
translate turkish D_jessica_meeting_01_approach_beach_apartment_8d464211:

    "Ancak işin püf noktası, şu anda odada bulunan Jessica'nın müşterisini görmek."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:89
translate turkish D_jessica_meeting_01_approach_beach_apartment_5eec2c66:

    "Önceden tanıdığın biri, Riley. Bir tür masaya diz çökmüş halde sıkıca bağlanmış."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:90
translate turkish D_jessica_meeting_01_approach_beach_apartment_ecda0f35:

    "Elleri arkasından bağlı ve gözlerinde sıkıca bir göz bandı var."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:91
translate turkish D_jessica_meeting_01_approach_beach_apartment_75a71e04:

    "İki yanında, Mirina'nın ofisinde gördüklerin gibi cihazlar var. Ama bunlar daha önce hiç görmediğin boyutta dildolara bağlanmış."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:92
translate turkish D_jessica_meeting_01_approach_beach_apartment_b41bd79d:

    "Açık kalmış anüsünü gizlemeyen bir külot giymiş; anüs, meniyi taklit eden beyaz bir kayganlaştırıcıyla kaplı."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:93
translate turkish D_jessica_meeting_01_approach_beach_apartment_019b0af2:

    "Çok zor bir egzersizden sonra gibi derin derin nefes aldığını duyabiliyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:94
translate turkish D_jessica_meeting_01_approach_beach_apartment_88d18704:

    "Zor bela gücünü toplayıp kısık bir sesle konuşuyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:98
translate turkish D_jessica_meeting_01_approach_beach_apartment_89a239ea:

    riley "Ah, Leydim... Bir sorun mu var?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:99
translate turkish D_jessica_meeting_01_approach_beach_apartment_39d36646:

    riley "Joseph neden bağırıyordu?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:100
translate turkish D_jessica_meeting_01_approach_beach_apartment_2c853034:

    jessica "Merak etme tatlım. Artık her şey yolunda."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:101
translate turkish D_jessica_meeting_01_approach_beach_apartment_ad4488a7:

    jessica "Şimdilik biraz dinlen. Yakında yanına döneceğim."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:102
translate turkish D_jessica_meeting_01_approach_beach_apartment_0c3ab79b:

    riley "T-tamam Leydim..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:113
translate turkish D_jessica_meeting_01_approach_beach_apartment_2d6f8465:

    "Dairenin geri kalanı kadar lüks görünen küçük ofisine giriyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:114
translate turkish D_jessica_meeting_01_approach_beach_apartment_b8cf23cf:

    "Ofisin her türlü altın ödül, dergi ve gazete kupürüyle ne kadar dolu olduğu seni şaşırtıyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:115
translate turkish D_jessica_meeting_01_approach_beach_apartment_7a1b1b21:

    jessica "Oh, Austie... O günden beri seni ne kadar çok düşündüğümü bir bilsen, hmm."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:116
translate turkish D_jessica_meeting_01_approach_beach_apartment_feb2d259:

    player "G-gerçekten mi?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:117
translate turkish D_jessica_meeting_01_approach_beach_apartment_7fe49166:

    jessica "Çok masum, çok kırılgan... Gerçek bir mucize."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:118
translate turkish D_jessica_meeting_01_approach_beach_apartment_fce563a2:

    jessica "Teklifimi kabul etmene çok sevindim."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:119
translate turkish D_jessica_meeting_01_approach_beach_apartment_75a1ef8c:

    player "T-teklif mi? Hayır, aslında bu yüzden burada değilim, Jessica."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:120
translate turkish D_jessica_meeting_01_approach_beach_apartment_7bec9ea6:

    jessica "Oh, gerçekten mi... Hmm... Peki o zaman neden buradasın?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:121
translate turkish D_jessica_meeting_01_approach_beach_apartment_f3b37544:

    player "Mağazanızda resmi kıyafetler olup olmadığını merak ediyordum."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:122
translate turkish D_jessica_meeting_01_approach_beach_apartment_20d8083d:

    player "Normal koleksiyonunuzdan biraz daha resmi bir şey..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:123
translate turkish D_jessica_meeting_01_approach_beach_apartment_98d29704:

    jessica "Buna ne diyeceğimi bile bilmiyorum. Dürüst olmak gerekirse, şu an beni biraz üzüyorsun."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:124
translate turkish D_jessica_meeting_01_approach_beach_apartment_da386381:

    player "Özür dilerim, sadece ben..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:125
translate turkish D_jessica_meeting_01_approach_beach_apartment_cce78a46:

    jessica "Yani internetten bakıp bu tür şeyler yapmadığımı öğrenebilirdin."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:126
translate turkish D_jessica_meeting_01_approach_beach_apartment_5262a577:

    jessica "Ama bu kadar saçma soruları doğrudan sormak için doğru kurucuya, bana geldin..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:127
translate turkish D_jessica_meeting_01_approach_beach_apartment_ea6fb068:

    jessica "Bu epey küstahça. Başkalarının zamanına değer vermiyor gibisin."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:128
translate turkish D_jessica_meeting_01_approach_beach_apartment_444f6de7:

    player "Evet, özür dilerim, gerçekten hoş davranmadım ama..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:129
translate turkish D_jessica_meeting_01_approach_beach_apartment_727f7ffa:

    player "A-ama kıyafetlerinizin büyük bir hayranıyım. Benim gibi femboylar için güzel resmi kıyafetleriniz olduğundan emindim..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:130
translate turkish D_jessica_meeting_01_approach_beach_apartment_6d1bcc75:

    player "Olmasa bile..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:131
translate turkish D_jessica_meeting_01_approach_beach_apartment_0f1dc7a4:

    jessica "Olmazsa ne?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:132
translate turkish D_jessica_meeting_01_approach_beach_apartment_0f2cb927:

    player "Böyle bir kıyafeti nereden alabileceğimi söyler misiniz? Ya da belki bana benzer bir şey yapabilirsiniz?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:133
translate turkish D_jessica_meeting_01_approach_beach_apartment_ad41eda0:

    jessica "Birine yönlendirmek mi? Bir rakibe mi? Beni bunu yapacak kadar aptal mı sanıyorsun?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:134
translate turkish D_jessica_meeting_01_approach_beach_apartment_7ec6f36a:

    jessica "Yapabilir miyim diye mi? Tabii ki yaparım! Ne tuhaf soru, Austyn."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:135
translate turkish D_jessica_meeting_01_approach_beach_apartment_95b203cf:

    jessica "Basit bir şeyi anlaman lazım Austie. Ben en iyisiyim."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:136
translate turkish D_jessica_meeting_01_approach_beach_apartment_55e894ba:

    jessica "Ama bunu karşılayamayacaksın."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:137
translate turkish D_jessica_meeting_01_approach_beach_apartment_309622e0:

    player "Ah, b-belki karşılığında sizin için bir şey yapabilirim?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:138
translate turkish D_jessica_meeting_01_approach_beach_apartment_7617d6c6:

    jessica "Hmm... Şöyle olsa..."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:139
translate turkish D_jessica_meeting_01_approach_beach_apartment_fc7cb4b3:

    jessica "O kıyafeti sana yapayım, ama sen de benim için onunla poz ver?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:140
translate turkish D_jessica_meeting_01_approach_beach_apartment_e4afe63e:

    player "Ah... Pek seçeneğim yok gibi, değil mi?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:141
translate turkish D_jessica_meeting_01_approach_beach_apartment_9cb2ba12:

    jessica "Hadi ama, olabilecek en kötü şey ne ki? Haha!"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:142
translate turkish D_jessica_meeting_01_approach_beach_apartment_5c08694b:

    jessica "Pekala, anlaştık!"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:143
translate turkish D_jessica_meeting_01_approach_beach_apartment_c4008df4:

    jessica "Git. Riley beni bekliyor."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:144
translate turkish D_jessica_meeting_01_approach_beach_apartment_3489aceb:

    jessica "İşim bitince seninle iletişime geçeceğim! Ölçülerin zaten bende."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:153
translate turkish D_jessica_meeting_01_approach_beach_apartment_faccd69e:

    "Dünyanın en ünlü moda tasarımcısı neden böyle bir şey yapsın ki?"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:154
translate turkish D_jessica_meeting_01_approach_beach_apartment_63bf08a5:

    "Bir hobisi mi? Yoksa sadece kendi keyfi için mi yapıyor? Kafa karıştırıcı."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:155
translate turkish D_jessica_meeting_01_approach_beach_apartment_58bda5a0:

    "Ama muhtemelen bunu henüz öğrenmen gerekecek."

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:156
translate turkish D_jessica_meeting_01_approach_beach_apartment_f67122fc:

    player "{i}Eh, o zaman. Şimdi sadece beklemem gerek.{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:157
translate turkish D_jessica_meeting_01_approach_beach_apartment_c042ee90:

    player "{i}Zevklerini bildiğime göre nasıl bir resmi kıyafet çıkaracak... Çok merak ediyorum.{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:158
translate turkish D_jessica_meeting_01_approach_beach_apartment_bc4d7b21:

    player "{i}Umarım bunu gerçekten dışarıda ya da Astra'nın üniversitesi gibi saygın yerlerde giyebilirim.{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:159
translate turkish D_jessica_meeting_01_approach_beach_apartment_df23dd34:

    player "{i}Ah, Anna bana yine çok kıskanacak. Ya da belki ona hiçbir şey söylememeliyim?{/i}"

# game/scripts/sequences/0130/jessica_meeting_01/dialogues.rpy:160
translate turkish D_jessica_meeting_01_approach_beach_apartment_6f1b1094:

    player "{i}Ama kimi kandırıyorum? Ağzımı nasıl kapalı tutabilirim ki?!{/i}"

