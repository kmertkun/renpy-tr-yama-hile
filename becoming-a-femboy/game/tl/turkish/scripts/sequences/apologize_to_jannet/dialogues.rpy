translate turkish D_jannet_apologize_01_ntr_d9873cd6:

    player "{i}Şimdiden mi? Ah.. çok hızlı.. o bunu bu kadar iyi mi yapıyor?{/i}"

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:68
translate turkish D_jannet_apologize_01_7ece6eca:

    player "Ö-özür dilerim.. Jannet.. Ben.. Sana baskı yapmak falan istemedim.."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:69
translate turkish D_jannet_apologize_01_b0ac60f0:

