# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:37
translate turkish D_jannet_apologize_01_ntr_9592f006:

    "Dürtüne hâkim olamıyorsun ve ona bakmaya devam ediyorsun."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:39
translate turkish D_jannet_apologize_01_ntr_7939483c:

    player "Ah.. Janny.."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:42
translate turkish D_jannet_apologize_01_ntr_c0fec66e:

    "Kalbin küt küt atıyor ama izlemeyi bırakmaya cesaret edemiyorsun."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:43
translate turkish D_jannet_apologize_01_ntr_741b9e43:

    "Jannet'i bir şeyden bu kadar çok keyif alırken ilk kez görüyorsun."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:46
translate turkish D_jannet_apologize_01_ntr_b9efda49:

