translate turkish D_jannet_apologize_02_ntr_9cc5bb3c:

    jannet "Bak, senin suçun değil, tatlım."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:103
translate turkish D_jannet_apologize_02_ntr_c089dc0f:

    jannet "Sana karşı kin tutmuyorum."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:104
translate turkish D_jannet_apologize_02_ntr_5ca509fd:

    jannet "Biraz canım sıkılmıştı ama şimdi yine harika! Haha."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:105
translate turkish D_jannet_apologize_02_ntr_27f23e88:

    jannet "Nasılsın?"

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:106
translate turkish D_jannet_apologize_02_ntr_e76cd56d:

    player "Ben.. ne diyeceğimi bilmiyorum.."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:107
translate turkish D_jannet_apologize_02_ntr_39067fdf:

    jannet "Hee, boş ver, sana acele ettirmiyorum.."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:108
translate turkish D_jannet_apologize_02_ntr_41ba7d84:

    jannet "Ne hissettiğini anlamak için bolca vaktin var, Osty."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:109
translate turkish D_jannet_apologize_02_ntr_5b3e2524:

    jannet "Gördüklerimden sonra.. biraz daha ileri gidebileceğimizi düşünüyorum.. "

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:110
translate turkish D_jannet_apologize_02_ntr_9f61bf32:

    player "{i}Bundan bahsettiğinde neden biraz korkuyorum..{/i}"

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:115
translate turkish D_jannet_apologize_02_137206ba:

    player "Ben buna hiç yatkın değilim!"

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:116
translate turkish D_jannet_apologize_02_1641868e:

    jannet "Ah, bu senin seçimin, Austyn.."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:117
translate turkish D_jannet_apologize_02_8cc6eb10:

