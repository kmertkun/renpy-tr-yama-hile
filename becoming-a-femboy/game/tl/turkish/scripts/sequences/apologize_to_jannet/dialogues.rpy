translate turkish D_jannet_apologize_01_1912064d:

    player "{i}Bu da ne? Meni.. Ağzında o adamın menisi varken beni mi öpüyor?{/i}"

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:80
translate turkish D_jannet_apologize_01_f3a5beaa:

    "Dudaklarının arasında küçük bir tohum ipliği uzanıyor."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:84
translate turkish D_jannet_apologize_01_c6f042cc:

