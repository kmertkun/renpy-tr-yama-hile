translate turkish D_jannet_apologize_01_dcba06d0:

    player "S-sen.. s-sen.."

# game/scripts/sequences/apologize_to_jannet/dialogues.rpy:91
translate turkish D_jannet_apologize_01_ff8bdad8:

    jannet "Ne? Sadece benim hissettiğimi senin de hissetmeni istedim."

