# game/scripts/sequences/new_lingerie/dialogues.rpy:3
translate turkish D_anna_new_lingerie_00_3bfb47c2:

    player "100 dolar mı? Çamaşıra mı? Ciddi misin?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:4
translate turkish D_anna_new_lingerie_00_084bd26a:

    player "Çok fazla gibi!"

# game/scripts/sequences/new_lingerie/dialogues.rpy:14
translate turkish D_anna_new_lingerie_01_09cdd3b8:

    player "Ben bu işe öylece mi karar verdim.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:15
translate turkish D_anna_new_lingerie_01_810f5e73:

    player "Kimsenin görmediği birkaç paçavraya para harcamak.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:17
translate turkish D_anna_new_lingerie_01_085b1c7b:

    player "Bu hale mi geldim?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:24
translate turkish D_anna_new_lingerie_01_3bba5a72:

    anna "İşte buradasın! Seni burada bekliyordum!"

# game/scripts/sequences/new_lingerie/dialogues.rpy:25
translate turkish D_anna_new_lingerie_01_3f6859cc:

    player "Merhaba! Ah, seni bekletiyorum, kusura bakma, ben.. Öyle demek istemedim."

# game/scripts/sequences/new_lingerie/dialogues.rpy:26
translate turkish D_anna_new_lingerie_01_417f8949:

    anna "Sorun değil. Kıçını yeni bir şeylerle giydirmeye hazır mısın?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:27
translate turkish D_anna_new_lingerie_01_ac72bf9b:

    player "{i}Neden bu kadar yüksek sesle konuşuyorsun, bizi duyacaklar..{/i}"

# game/scripts/sequences/new_lingerie/dialogues.rpy:28
translate turkish D_anna_new_lingerie_01_948f45a9:

    anna "Oh, bu kadar utanma. Birinin duyması önemli değil."

# game/scripts/sequences/new_lingerie/dialogues.rpy:29
translate turkish D_anna_new_lingerie_01_fda6d726:

    anna "Oh, sana sormayı tamamen unutmuşum."

# game/scripts/sequences/new_lingerie/dialogues.rpy:30
translate turkish D_anna_new_lingerie_01_c1f6e8a2:

    anna "Bir isteğin var mı?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:31
translate turkish D_anna_new_lingerie_01_3b3cd2b5:

    player "İstek mi?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:32
translate turkish D_anna_new_lingerie_01_120979af:

    anna "Şey, belki yeni iç çamaşırının hayatın üzerinde özel bir etkisi olsun istersin.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:33
translate turkish D_anna_new_lingerie_01_e1d4385a:

    player "Ne diyorsun sen? Sadece paçavra bunlar.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:34
translate turkish D_anna_new_lingerie_01_a19bf1c2:

    anna "Ne dediğini bir düşün!"

# game/scripts/sequences/new_lingerie/dialogues.rpy:35
translate turkish D_anna_new_lingerie_01_b9abba1b:

    anna "Bu paçavraların hayatını nasıl etkileyebileceği hakkında hiçbir fikrin yok."

# game/scripts/sequences/new_lingerie/dialogues.rpy:36
translate turkish D_anna_new_lingerie_01_049ae65f:

    player "D-dediğin gibi olsun.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:37
translate turkish D_anna_new_lingerie_01_82527337:

    anna "Hmm.. madem belirli bir isteğin yok - soyunma odasına git.. Birazdan birkaç seçenekle geleceğim."

# game/scripts/sequences/new_lingerie/dialogues.rpy:45
translate turkish D_anna_new_lingerie_01_ec56712f:

    player "Orada benim için ne hazırladığını düşünmek bile korkutucu.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:46
translate turkish D_anna_new_lingerie_01_8be3fd1e:

    player "Umarım sadece bana gülmez.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:52
translate turkish D_anna_new_lingerie_01_34a0a759:

    anna "Hey hey, işte buradayım."

# game/scripts/sequences/new_lingerie/dialogues.rpy:56
translate turkish D_anna_new_lingerie_01_dc96ddcc:

    anna "Neden hâlâ kıyafetlerinle duruyorsun?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:57
translate turkish D_anna_new_lingerie_01_8acd2d94:

    player "Ah.. Ş-şey ben.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:58
translate turkish D_anna_new_lingerie_01_df7fecc6:

    anna "Bu kadar korkma, her şey yolunda olacak. Hadi giyin, ben yardım edeceğim."

# game/scripts/sequences/new_lingerie/dialogues.rpy:67
translate turkish D_anna_new_lingerie_01_2cbf863e:

    player "Ah, bunu komik mi buluyorsun? Gerçekten bunu giymemi mi istiyorsun?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:68
translate turkish D_anna_new_lingerie_01_0cb9160b:

    anna "Ama gerçekten çok güzel görünüyor! Genel olarak, bak, ileride hatırlarsın, kendi fotoğrafını çekmen daha iyi, belki sonra fikrini değiştirirsin.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:69
translate turkish D_anna_new_lingerie_01_049ae65f_1:

    player "D-dediğin gibi olsun.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:78
translate turkish D_anna_new_lingerie_01_bb0fa31e:

    anna "Çok popüler bir görünüm, ha-ha, çok insanın hoşuna gidiyor. Neyse, bilirsin.. Sıradakine geçelim."

# game/scripts/sequences/new_lingerie/dialogues.rpy:94
translate turkish D_anna_new_lingerie_01_36e2d601:

    anna "Aman tanrım, sen tam bir sefihsin! Kendine bir bak."

# game/scripts/sequences/new_lingerie/dialogues.rpy:95
translate turkish D_anna_new_lingerie_01_9db8200b:

    anna "Bir saniye.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:101
translate turkish D_anna_new_lingerie_01_5d33f389:

    anna "Genelde böyle giyerler.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:102
translate turkish D_anna_new_lingerie_01_61a8aca2:

    anna "Nasıl? Ne düşünüyorsun?"

# game/scripts/sequences/new_lingerie/dialogues.rpy:103
translate turkish D_anna_new_lingerie_01_86091c42:

    player "Ah.. ş-şey.. Bence.. bence benim için fazla sapkın.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:104
translate turkish D_anna_new_lingerie_01_a7dd58b5:

    anna "Fazla sapkın mı? Lingerie fazla sapkın olamaz."

# game/scripts/sequences/new_lingerie/dialogues.rpy:105
translate turkish D_anna_new_lingerie_01_6852fccd:

    anna "Tamam, muhtemelen sadece hazır değilsin, sorun değil."

# game/scripts/sequences/new_lingerie/dialogues.rpy:112
translate turkish D_anna_new_lingerie_01_bb4984d0:

    anna "Hızlı öğreniyorsun."

# game/scripts/sequences/new_lingerie/dialogues.rpy:113
translate turkish D_anna_new_lingerie_01_1c0dbf55:

    player "{i}Ah, doğruyu söylemek gerekirse, çok hoşuma gidiyor.. ama.. ama kendi üzerimde.. henüz..{/i}"

# game/scripts/sequences/new_lingerie/dialogues.rpy:114
translate turkish D_anna_new_lingerie_01_9bfcecb5:

    anna "Tamam, bir sonrakini reddetme hakkın yok.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:131
translate turkish D_anna_new_lingerie_01_5bd720fa:

    anna "Tam senin için! Çok gösterişli olmayan, ilk kişisel iç çamaşırın için harika bir seçenek."

# game/scripts/sequences/new_lingerie/dialogues.rpy:132
translate turkish D_anna_new_lingerie_01_44d20a77:

    player "{i}Gerçekten sandığım kadar kötü görünmüyor..{/i}"

# game/scripts/sequences/new_lingerie/dialogues.rpy:133
translate turkish D_anna_new_lingerie_01_49fde185:

    anna "Ha! Hoşuna gittiğini görüyorum, sadece sessiz kal! Tamam!"

# game/scripts/sequences/new_lingerie/dialogues.rpy:134
translate turkish D_anna_new_lingerie_01_111b4b6f:

    player "E-evet, gerçekten çok güzel görünüyor.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:135
translate turkish D_anna_new_lingerie_01_2dce5655:

    anna "Pekala, hadi, hazırlan ve git öde."

# game/scripts/sequences/new_lingerie/dialogues.rpy:142
translate turkish D_anna_new_lingerie_01_64160aac:

    player "Anna, sana çok minnettarım, çok teşekkür ederim.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:143
translate turkish D_anna_new_lingerie_01_65d9e821:

    anna "Hadi ya, her şey yolunda.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:144
translate turkish D_anna_new_lingerie_01_6d7d45b5:

    player "Karşılığında sana ne yapabileceğimi bile bilmiyorum."

# game/scripts/sequences/new_lingerie/dialogues.rpy:145
translate turkish D_anna_new_lingerie_01_e7a76e36:

    anna "Mm .. Kesinlikle bir şey düşünürüm, borçlu kalmazsın."

# game/scripts/sequences/new_lingerie/dialogues.rpy:146
translate turkish D_anna_new_lingerie_01_2a43d2ee:

    player "İ-iyi! Mutlaka haber ver."

# game/scripts/sequences/new_lingerie/dialogues.rpy:158
translate turkish D_anna_new_lingerie_01_8aac5b2f:

    player "Herhalde, yakın zamanda, Astra'ya göstereceğim.."

# game/scripts/sequences/new_lingerie/dialogues.rpy:165
translate turkish D_anna_new_lingerie_01_771b29e6:

    player "Aslında, güzel görünüyor.."

