translate turkish D_mom_beach_party_invite_c2dd2c4f:

    player "Plaj partisi hakkında bir şey duydun mu?"

# game/scripts/sequences/090/2-beach_party_invite/dialogues.rpy:36
translate turkish D_mom_beach_party_invite_dfcec99f:

