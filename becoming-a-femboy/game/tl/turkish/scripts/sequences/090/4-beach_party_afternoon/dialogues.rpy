translate turkish D_beach_party_afternoon_astra_9612267b:

    "Seni böyle bir sandviçin arasına sıkıştırdıkları için çok mutlulardı."

# game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:441
translate turkish D_beach_party_afternoon_astra_df6abf7d:

    "Normalde kendini garip hissedebilirdin ama burada öyle değil."

# game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:442
translate turkish D_beach_party_afternoon_astra_83a4be32:

    "Birçok kişi şu an senin yerinde, iki seksi kızın arasında olmak isterdi."

translate turkish strings:

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:7
    old "No, I will try another one."
    new "Hayır, başka birini deneyeceğim."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:120
    old "You spent a little more time in the water and then went on to do what you were doing before."
    new "Suda biraz daha zaman geçirdikten sonra önceki işine döndün."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:237
    old "When you finish your business, you leave with thanks from Trish."
    new "İşin bitince Trish'in teşekkürleriyle yanından ayrılıyorsun."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:266
    old "You sit down at the bar next to your mommy."
    new "Barda anneciğinin yanına oturuyorsun."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:269
    old "You have a view of 5 shots sitting untouched."
    new "Dokunulmamış 5 shot'ın manzarası karşında duruyor."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:272
    old "They look like two-layer drinks. They’re all white on top and different colors on the bottom."
    new "İki katmanlı içkilere benziyorlar. Üstleri bembeyaz, altları farklı renklerde."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:326
    old "After exchanging pleasantries, you continued your walk along the beach."
    new "Selamlaşmanın ardından sahildeki yürüyüşüne devam ettin."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:393
    old "You spent some time together talking uselessly."
    new "Bir süre birlikte havadan sudan konuşarak vakit geçirdiniz."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:406
    old "You’re entering the dance floor."
    new "Dans pistine giriyorsun."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:409
    old "Before you get used to the loud music, you feel like something is dragging you along with it."
    new "Yüksek müziğe alışmana fırsat kalmadan bir şeyin seni de kendisiyle sürüklediğini hissediyorsun."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:412
    old "Suddenly, you find yourself sandwiched between two bodies."
    new "Birden kendini iki bedenin arasında sıkışmış buluyorsun."

    # game/scripts/sequences/090/4-beach_party_afternoon/dialogues.rpy:445
    old "Together, you danced your animal dances until the end of the song, and then went about your business."
    new "Birlikte, şarkının sonuna kadar hayvani danslarınızı yaptınız, sonra kendi işinize gittiniz."

