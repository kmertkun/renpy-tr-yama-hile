translate turkish strings:

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:29
    old "After that, you came to the beach to find some fun!"
    new "Bunun ardından biraz eğlence bulmak için sahile geldin!"

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:55
    old "You’re walking and exchanging the latest news."
    new "Yürüyor ve son haberleri paylaşıyorsunuz."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:58
    old "Walking in circles, after a while, Trish brings up an interesting topic."
    new "Bir süre daireler çizerek yürüdükten sonra Trish ilginç bir konu açıyor."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:96
    old "Take on a challenge with Astra"
    new "Astra'yla bir meydan okumaya katıl"

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:102
    old "Have a good time with Jannet"
    new "Jannet'le iyi vakit geçir"

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:126
    old "You spend time with mommy walking on the beach."
    new "Anneciğinle sahilde yürüyerek vakit geçiriyorsun."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:129
    old "Your conversations never really went anywhere because she was always distracted."
    new "Konuşmalarınız hiçbir yere varmadı çünkü o hep dalgındı."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:197
    old "Reprimand Anna harder."
    new "Anna'yı daha sert azarla."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:213
    old "Try to calm Anna down."
    new "Anna'yı sakinleştirmeye çalış."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:265
    old "You spend time with Mirina walking along the beach."
    new "Mirina'yla sahilde yürüyerek vakit geçiriyorsun."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:268
    old "A lot of the time is spent  in silence."
    new "Zamanın çoğu sessizlik içinde geçiyor."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:271
    old "Until Mirina tries to start a conversation."
    new "Mirina bir sohbet başlatmaya çalışana kadar."

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:336
    old "Stand with Mirina"
    new "Mirina'nın yanında dur"

    # game/scripts/sequences/090/3-beach_party_talks/dialogues.rpy:351
    old "Stand with Tiffany"
    new "Tiffany'nin yanında dur"

