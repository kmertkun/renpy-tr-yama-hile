# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:2
translate turkish D_trish_time_together_d0d44f88:

    "Son gelişmeleri Trish'e de anlatmaya değer olduğunu düşünüyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:3
translate turkish D_trish_time_together_a893e145:

    "Sonuçta sadece çok yakın olmanız değil, o aynı zamanda senin 'dönüşümünün' önemli bir parçası."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:4
translate turkish D_trish_time_together_6356428c:

    "Ona Astra ve araştırma sunumunla ilgili her şeyi anlattıktan sonra, sohbetin şöyle gelişeceğinden habersizsin..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:5
translate turkish D_trish_time_together_4617ba0f:

    trish "Harika. Çok çabuk olmuş. Astra'yı büyük bir başarı bekliyor olmalı!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:6
translate turkish D_trish_time_together_94b5283a:

    player "Kesinlikle! Gerçi benim rolüm pek de önemli değildi."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:7
translate turkish D_trish_time_together_3720ca73:

    trish "Kendini küçümseme, Austie! Sen onun için gerçekten nadir ve değerli bir örneksin."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:8
translate turkish D_trish_time_together_dd23d99c:

    trish "Böyle kısa sürede bambaşka biri olmuşsun!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:9
translate turkish D_trish_time_together_05e4e7b7:

    trish "Şuna bak! Üstündeki kıyafetlere bak! Bir yıl önce biri bana Austyn'in karşıma bunu giyip çıkacağını söyleseydi asla inanmazdım."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:10
translate turkish D_trish_time_together_975c31b7:

    player "Hadi ama... O kadar da değişmedim..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:11
translate turkish D_trish_time_together_931464c4:

    "Takas edilmeden önce ne olduğunu tamamen unutmuş halde söylüyorsun bunu."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:12
translate turkish D_trish_time_together_06b1ef04:

    trish "Heh, keşke biri bunun için seni kaç kere ikna etmeye çalıştığımı bilseydi..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:13
translate turkish D_trish_time_together_81e1bca9:

    trish "Anneciğin de tamamen çaresizdi. Ona ne kadar zor zamanlar yaşattığının farkında mısın?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:14
translate turkish D_trish_time_together_1b32a631:

    trish "Seni öyle kabullenmek onun için zordu... Tam bir asi gibiydin, kimsenin seni femboy olarak düşünmesine bile izin vermiyordun!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:15
translate turkish D_trish_time_together_e2016d89:

    trish "Söylemeliyim ki, sonunda kendini kabullenmen gerçekten etkileyici. Seninle böyle vakit geçireceğimi hiç hayal etmemiştim..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:16
translate turkish D_trish_time_together_4864c7ec:

    trish "Sonuçta sen harika bir sevgilisin. Sadece muhteşem."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:17
translate turkish D_trish_time_together_62baf07a:

    trish "Bir süre sadece kendin olarak durarak şimdiden o kadar çok seksi futayı ayarttın ki! Tabii ben bahsetmiyorum, hehe..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:18
translate turkish D_trish_time_together_112713cc:

    player "Ama sen de en az onlar kadar ayartılmış durumdasın, değil mi?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:19
translate turkish D_trish_time_together_757816a4:

    trish "Kesinlikle. Ben 'seksi' kısmından bahsediyorum..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:20
translate turkish D_trish_time_together_b9b5fc20:

    player "Ne demek istiyorsun? Harika görünüyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:21
translate turkish D_trish_time_together_5bb23de0:

    trish "Bunu söylediğin için sağ ol. Ama sanırım sadece sözlerin bunu düzeltemeyeceğini sen de biliyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:22
translate turkish D_trish_time_together_db5b3364:

    trish "Anlıyorsun ya, ben de kendimi kabullenmekte biraz zorlanıyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:23
translate turkish D_trish_time_together_4cfa984e:

    trish "Kendimi oldukça... sıradan hissediyorum. Ne olmam gerektiğini hiçbir zaman çözemedim."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:24
translate turkish D_trish_time_together_334d87a7:

    trish "O bol unisex kıyafetlerin hepsi... Sen de aynısını giydiğin sürece kendimi rahat hissediyordum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:25
translate turkish D_trish_time_together_579056d8:

    trish "Şimdi ise... Bence artık benim de bir yöne doğru ilerlemeye başlamam gerekirdi."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:26
translate turkish D_trish_time_together_03e37e54:

    trish "Ne demek istediğimi anladın mı?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:27
translate turkish D_trish_time_together_3fb5fb01:

    player "Pek değil... Dürüst olmam gerekirse, bu sohbet beni biraz ürkütüyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:28
translate turkish D_trish_time_together_d8466b52:

    trish "Pardon. Boş ver..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:29
translate turkish D_trish_time_together_2babaeb5:

    player "Hayır, olmaz! Devam et, sana yardım etmek istiyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:30
translate turkish D_trish_time_together_a6a3edac:

    trish "Austie, sen çok tatlı birisin. Seni sevmemek mümkün mü...? Teşekkür ederim."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:31
translate turkish D_trish_time_together_3ea29f29:

    trish "Bak, olay şu... Dürüst olmak gerekirse sana oldukça gıpta ediyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:34
translate turkish D_trish_time_together_703cc40c:

    "Ciddi bir konuya girerken, alkol olmadan bunun yürümeyeceği sonucuna varıyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:35
translate turkish D_trish_time_together_129893bc:

    "Çok geçmeden elinizde kırmızı, yarı tatlı şarapla dolu kadehler oluyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:36
translate turkish D_trish_time_together_73e177fe:

    "Trish'in odasının zemininde yayılmış halde sohbetinize devam ediyorsunuz."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:37
translate turkish D_trish_time_together_ba63d50c:

    "Trish son zamanlarda aklından geçenleri anlatmaya başlıyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:38
translate turkish D_trish_time_together_9fc634b8:

    trish "Biliyor musun, içimde uçtan uca gidip geliyorum!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:39
translate turkish D_trish_time_together_3e96154b:

    trish "Etrafımdaki her şey bana futanari olduğumu, sahip olmam ve hükmetmem gerektiğini haykırıyor!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:40
translate turkish D_trish_time_together_71999ddd:

    trish "Ve bu beni delice tahrik ediyor. Sonuçta bunun için gereken her şeye sahibim..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:41
translate turkish D_trish_time_together_61108196:

    trish "Kocaman bir sik, büyük göğüsler, kaslı bir vücut."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:42
translate turkish D_trish_time_together_30a5b8f6:

    trish "Ama... Kendra gibi insanlar bana hep itaatkâr olmak istiyormuşum gibi hissettirdi."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:43
translate turkish D_trish_time_together_455f90d9:

    trish "Poposuna şaplak yemek isteyen... ve düzülmek isteyen, ve..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:44
translate turkish D_trish_time_together_1daea72a:

    trish "Ah... Ara sıra bunu hayal ediyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:45
translate turkish D_trish_time_together_3314e192:

    player "Vay, bunu duymayı beklemiyordum..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:46
translate turkish D_trish_time_together_bf955e81:

    trish "Hayal kırıklığına mı uğradın?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:47
translate turkish D_trish_time_together_b9d2f6f0:

    player "Hayır, hiç de değil... Sadece çok şaşırtıcı."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:48
translate turkish D_trish_time_together_ab68a3eb:

    player "Senin gibi birinin bunu isteyeceğini hiç düşünmezdim."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:49
translate turkish D_trish_time_together_91e0ba3d:

    trish "Heh, haklı olmalısın. Benim için de hayal etmesi zor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:50
translate turkish D_trish_time_together_dd2af012:

    trish "Ayrıca o kadar feminen olabileceğimi de sanmıyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:51
translate turkish D_trish_time_together_7b82fc42:

    trish "Kendimi elbise, etek ve bunun gibi şeyler giyerken göremiyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:52
translate turkish D_trish_time_together_8ed6b255:

    player "Hmm... Bunda garip bir şey olduğunu sanmıyorum. Vücudun harika!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:53
translate turkish D_trish_time_together_121437c9:

    trish "Sağ ol, Austie..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:54
translate turkish D_trish_time_together_080ccfba:

    trish "Ama mesele şu ki, birinin beni bir şeye zorlamasını hep istiyorum..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:55
translate turkish D_trish_time_together_87f93e1b:

    trish "Daha kararlı bir şeye."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:56
translate turkish D_trish_time_together_d7cf681a:

    trish "Ah, keşke böyle birim olsaydı."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:57
translate turkish D_trish_time_together_06fe6656:

    player "Ya ben? O kişi ben olabilirim."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:58
translate turkish D_trish_time_together_94393558:

    trish "Hadi ama, Austie. Zaten başında yeterince iş var."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:59
translate turkish D_trish_time_together_d35f0af9:

    trish "Sunumun yaklaşıyor! Son isteyeceğim şey ilişkinize bir şekilde zarar vermek."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:60
translate turkish D_trish_time_together_8de49ef8:

    player "Ama seni elimden geldiğince biraz daha mutlu etmek istiyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:61
translate turkish D_trish_time_together_88fc5dfa:

    player "En azından her iki durumda da önümüzdeki seçeneklere bir bakalım..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:63
translate turkish D_trish_time_together_fe474259:

    player "Baskın tarafını ortaya çıkarmana nasıl yardım edebilirim?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:64
translate turkish D_trish_time_together_6d31b5b7:

    trish "Hmm... Bir düşüneyim..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:65
translate turkish D_trish_time_together_5e6b408e:

    trish "Sanırım baskın olsaydım, eşimin aklıma gelen her çılgın şeye katlanması gerekirdi."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:66
translate turkish D_trish_time_together_fba60bc1:

    trish "Hatta belki kendisi daha fazlasını isterdi!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:67
translate turkish D_trish_time_together_5c53afc6:

    player "M-mesela ne gibi?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:68
translate turkish D_trish_time_together_9a2679bf:

    trish "Ona bir kafes takardım! Anahtarı da yanımda taşırdım."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:69
translate turkish D_trish_time_together_ea52bb26:

    trish "Mmm... evet. Sadece benim emrimle boşalırdı!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:70
translate turkish D_trish_time_together_5a569515:

    trish "Ona malım gibi davranırdım..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:71
translate turkish D_trish_time_together_0fe303ef:

    trish "Ah, onu öyle bir kışkırtırdım ki! Aman Tanrım..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:72
translate turkish D_trish_time_together_67a2e446:

    trish "Merhamet dileyerek çığlık atmasını sağlardım! Hehe."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:73
translate turkish D_trish_time_together_eae149f7:

    player "Kafes... ve bütün bu işkence. Hmm."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:74
translate turkish D_trish_time_together_345ba3b4:

    player "Biraz ürkütücü geliyor. Ehehe..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:75
translate turkish D_trish_time_together_b1f9e5f3:

    trish "Evet, muhtemelen biraz. Yine de sana herhangi bir şekilde zarar vermekten çok korkuyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:76
translate turkish D_trish_time_together_282836f6:

    trish "Geri dönüşü olmayacağının farkındasın, değil mi? Heh."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:78
translate turkish D_trish_time_together_90c4dafd:

    player "Peki ya itaatkâr tarafın?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:79
translate turkish D_trish_time_together_314d46e1:

    trish "Hmm... Her şeyden önce, sanırım partnerimin bu konularda zaten deneyimli olması gerekir..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:80
translate turkish D_trish_time_together_c7d22307:

    trish "Böylece beni itaatkâr bir hizmetçi olarak eğitebilir. Ne demek istediğimi anlıyorsun, değil mi?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:81
translate turkish D_trish_time_together_51b0ea81:

    trish "Başkalarına olabildiğince iyi hizmet etmeyi öğrenmeye hazırım!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:82
translate turkish D_trish_time_together_8645d022:

    trish "Oral mı istiyorsun? Sadece dibine kadar ve gözlerim yaşarana dek."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:83
translate turkish D_trish_time_together_c269ba5c:

    trish "Anal mı istiyorsun? Sadece merhamet için çığlık attıracak türden."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:84
translate turkish D_trish_time_together_6175998f:

    trish "Ah, sadece düşününce bile sırılsıklam oluyorum... buna öyle denebilirse, hehe."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:85
translate turkish D_trish_time_together_17df3662:

    trish "Ama ne kadar alçalabileceğimi görmek isteyeceğinden emin değilim."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:86
translate turkish D_trish_time_together_c51a3082:

    trish "Ayrıca bana baş edebileceğini de sanmıyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:87
translate turkish D_trish_time_together_0d199ffb:

    trish "Sen her zaman çok tatlısın sonuçta!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:88
translate turkish D_trish_time_together_ccead488:

    trish "Ama yine de senin itaatkâr öğrencin olmayı çok isterim, hehe."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:89
translate turkish D_trish_time_together_3bf92996:

    player "Evet Trish, yol bu."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:90
translate turkish D_trish_time_together_48c0d18b:

    trish "Aslında her iki senaryo da ikimizin büyük değişimler geçirmesini gerektiriyor..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:91
translate turkish D_trish_time_together_16011a82:

    trish "Ama yine de bunu çok istiyorum."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:92
translate turkish D_trish_time_together_c34bcf0e:

    trish "Gerçekten bir değişim için can atıyorum..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:93
translate turkish D_trish_time_together_c283b965:

    trish "Ve bu süreçte birbirimize daha da yakınlaşmak için."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:94
translate turkish D_trish_time_together_eb329cf3:

    trish "Bunun sadece eğlence için ortalıkta sürtmek olmasını istemiyorum. Kendini geliştirmekle ilgili olmasını istiyorum... daha iyi versiyonlarımız olmakla, anlıyor musun?"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:95
translate turkish D_trish_time_together_fa29c30e:

    trish "Hah, ne kibirli bir söz! Bu içimdeki şarap konuşuyor olmalı..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:96
translate turkish D_trish_time_together_5af6d222:

    player "Heh, şarap olamaz. Bu sensin, gerçek sen."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:97
translate turkish D_trish_time_together_2780eaab:

    player "Mmm... İtiraf etmeliyim ki, ikisi de bana oldukça cazip geliyor..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:98
translate turkish D_trish_time_together_ce6fae39:

    trish "Acele etme. İyice düşün."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:99
translate turkish D_trish_time_together_1cfabe66:

    trish "Karar verdiğinde bana haber ver!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:100
translate turkish D_trish_time_together_01993dcf:

    trish "Bütün bunlar hakkında ne düşündüğünü gerçekten bilmek isterim..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:103
translate turkish D_trish_time_together_aafdd559:

    "Biraz daha yaklaşıp fısıldıyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:104
translate turkish D_trish_time_together_ee86dc1a:

    player "Elbette vereceğim..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:105
translate turkish D_trish_time_together_0ef89b42:

    player "Nasıl sonuçlanırsa sonuçlansın seni sevmeye devam edeceğim. Sonuçta yine sen olacaksın..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:106
translate turkish D_trish_time_together_5d17548e:

    trish "Ah, Austie."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:109
translate turkish D_trish_time_together_0d7ef231:

    "Bir an sonra birbirinizi yumuşakça öpüyorsunuz."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:110
translate turkish D_trish_time_together_f401e102:

    "Dudaklarından bir an ayrılan Trish tutkuyla ekliyor..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:111
translate turkish D_trish_time_together_12088241:

    trish "Aşağıda taş gibi olmuşum... ve hepsi senin yüzünden..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:112
translate turkish D_trish_time_together_1319fa45:

    trish "Seni yaramaz şey, hehe."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:115
translate turkish D_trish_time_together_8da1a9e8:

    "Yol boyunca kıyafetlerinizden kurtulup işi yatağa taşıyorsunuz."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:116
translate turkish D_trish_time_together_a2b59c4d:

    "Kısa süre sonra kendini en sevdiğin pozisyonda buluyorsun..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:117
translate turkish D_trish_time_together_c9c5e996:

    "Arkadaşının kocaman siki götünde!"

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:118
translate turkish D_trish_time_together_9577b565:

    "Trish seni sıkıca kavrıyor ve sertliğini bütün gücüyle içine sürüyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:119
translate turkish D_trish_time_together_0bc80c2d:

    "Delicesine ıslak olduğun için siki sonuna kadar içine girebiliyor. Girdikçe girdikçe."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:120
translate turkish D_trish_time_together_7671ed76:

    "Çaresizce çarşafları kavrarken dişlerini sıkarak inliyor ve ona doğru itiyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:121
translate turkish D_trish_time_together_5f35eec3:

    "Sikini içinde sürekli yer değiştirirken taşakları götüne çarpıyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:122
translate turkish D_trish_time_together_00c3eed3:

    "Ara sıra Trish'in tatmin olmuş iç çekişlerini duyabiliyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:123
translate turkish D_trish_time_together_5f2f362f:

    "Sanki vücudunu bir spor aleti gibi kullanıyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:124
translate turkish D_trish_time_together_da470419:

    "Hızını artırdıkça nefeslerine yumuşak inlemeler karışıyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:125
translate turkish D_trish_time_together_17474bd9:

    "Bundan boşalabileceğini fark ediyorsun, bu da hevesini daha da artırıyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:126
translate turkish D_trish_time_together_60d4c956:

    "Kendini bırakıyorsun, çarşaftan uzaklaşıp ağzın sonuna kadar açık inliyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:129
translate turkish D_trish_time_together_aee17be0:

    "Zevkten gözlerin devriliyor, sanki internette görebileceğin o yapmacık porno videolarından birindeymişsin gibi."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:130
translate turkish D_trish_time_together_b002c258:

    "Sevgili Trish'in de aynı durumda. İkiniz de aynı frekanstasınız gibi görünüyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:131
translate turkish D_trish_time_together_fef18a5e:

    "Orgazmın yükseldikçe götünü daha sıkı kasmaya başlıyorsun ve daha hassaslaşıyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:132
translate turkish D_trish_time_together_9c84bfde:

    "Trish'in ucunun içinde girip çıkmasının verdiği histen kendini uçurumun kenarında buluyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:133
translate turkish D_trish_time_together_455047dc:

    "Hızlanmak için son bir hamle yaparak, anüsünü sıkamadan altına şiddetle boşalıyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:134
translate turkish D_trish_time_together_5fcd7987:

    "Trish direncini kolayca aşıyor ve sikini deli gibi içine sokmaya devam ediyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:135
translate turkish D_trish_time_together_9d3601d3:

    "İnce bir çığlıkla sikini sonuna kadar içine gömüyor ve sıcak spermiyle seni dolduruyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:136
translate turkish D_trish_time_together_e49a189d:

    "Tamamen içindeyken inlemeyi kesmiyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:141
translate turkish D_trish_time_together_54ba2b92:

    "Onu ne kadar sıkı kavradığını hissedince sikini çıkarıp sırtına boşalmaya başlıyor."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:142
translate turkish D_trish_time_together_beefe770:

    trish "Ah, evet... Siktir..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:143
translate turkish D_trish_time_together_8080bb10:

    "Seks sırasında Trish'e küfrettirmiş olmana biraz şaşırıyorsun."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:144
translate turkish D_trish_time_together_b6b7537b:

    trish "Ah... Siktir, evet..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:145
translate turkish D_trish_time_together_8c8cef7a:

    trish "Ah..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:146
translate turkish D_trish_time_together_d4d08b30:

    trish "Bu... Bu muhteşemdi..."

# game/scripts/sequences/0150/trish_time_together/dialogues.rpy:167
translate turkish D_trish_time_together_62d9cfab:

    trish "Ah... Austie..."

