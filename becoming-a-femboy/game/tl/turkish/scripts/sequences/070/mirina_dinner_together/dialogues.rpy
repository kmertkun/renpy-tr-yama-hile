# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:5
translate turkish D_mirina_dinner_together_f595340c:

    mirina "Peki, birlikte yemek yiyeceğimizi hatırladın mı..?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:6
translate turkish D_mirina_dinner_together_e8de328d:

    player "Şey.."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:22
translate turkish D_mirina_dinner_together_yes_566edbd7:

    mirina "Ah, benimle yemeğe çıkmayı kabul etmene çok sevindim."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:23
translate turkish D_mirina_dinner_together_yes_79708354:

    mirina "Hemen dönerim, sadece üstümü değiştirmem lazım."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:32
translate turkish D_mirina_dinner_together_yes_e3211bd0:

    "Mirina karşında bir bodysuit ile beliriyor."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:33
translate turkish D_mirina_dinner_together_yes_5a739f77:

    "Büyük memeleri neredeyse dışarı taşıyor."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:34
translate turkish D_mirina_dinner_together_yes_935e5081:

    "Bacaklarının arasında ise kalın bir sik dışarı fırlamış."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:36
translate turkish D_mirina_dinner_together_yes_8003ecee:

    mirina "Peki, nasıl buldun beni?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:37
translate turkish D_mirina_dinner_together_yes_85a03db3:

    player "Ü-üniformandan başka bir şeyle görmek çok alışılmadık.."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:38
translate turkish D_mirina_dinner_together_yes_025a400a:

    mirina "Haha, evet, doktor olmanın yanı sıra ben aynı zamanda sıradan bir futanariyim."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:39
translate turkish D_mirina_dinner_together_yes_38669889:

    player "{i}Hem de çok kalın bir sikle...{/i}"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:40
translate turkish D_mirina_dinner_together_yes_6bc18a62:

    player "{i}Bunu fark etmeye başlayacağımı asla düşünmezdim!{/i}"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:41
translate turkish D_mirina_dinner_together_yes_c6cb7f2f:

    player "{i}Daha önce de güzel memeleri olduğunu fark etmiştim.{/i}"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:42
translate turkish D_mirina_dinner_together_yes_f1a0a99e:

    player "{i}Tamamen değişmiş miyim...?{/i}"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:43
translate turkish D_mirina_dinner_together_yes_374aac44:

    mirina "Her şey yolunda mı? Bir şey mi düşünüyorsun?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:44
translate turkish D_mirina_dinner_together_yes_df1165ec:

    player "T-tamam, bir şey yok.. Nereye gidiyoruz?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:51
translate turkish D_mirina_dinner_together_yes_29a3c09b:

    mirina "Bir yerlere çıkmak ve böyle hoş bir şirkette olmak ne güzel."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:52
translate turkish D_mirina_dinner_together_yes_93fa8d1a:

    player "Ah... evet. Dürüst olmak gerekirse bunun olacağını hiç düşünmezdim."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:53
translate turkish D_mirina_dinner_together_yes_c3bb4a67:

    mirina "Ne demek istiyorsun?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:54
translate turkish D_mirina_dinner_together_yes_8dc8a302:

    player "Yanlış anlama... Seninle yemek yemekten bahsediyorum, Doktor Mirina."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:55
translate turkish D_mirina_dinner_together_yes_6b8b33d0:

    mirina "Aman, yapma. Hastane dışında senin için sadece Mirina'yım. Resmiyeti bırakalım, Austy."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:56
translate turkish D_mirina_dinner_together_yes_a908cd08:

    player "T-tamam, Doktor... yani Mirina."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:57
translate turkish D_mirina_dinner_together_yes_48851f99:

    mirina "Hee, hiyerarşiye karşı gelmek senin için ne kadar zor. Çok terbiyeli bir genç adamsın."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:58
translate turkish D_mirina_dinner_together_yes_f45848ad:

    mirina "Ama biliyor musun, senin böyle gelişeceğini ben de beklemiyordum."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:59
translate turkish D_mirina_dinner_together_yes_44aa02d1:

    player "Başka seçeneğim yoktu."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:60
translate turkish D_mirina_dinner_together_yes_c4068c50:

    mirina "Her zaman bir seçenek vardır, Austy. Sen de seçimini yaptın zaten."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:61
translate turkish D_mirina_dinner_together_yes_ce1bdfd2:

    mirina "Üstelik bu tavır sana daha çok yakışıyor."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:62
translate turkish D_mirina_dinner_together_yes_ab5f0737:

    mirina "Eskiden öyle yaramaz, kendini beğenmiş bir çocuktun."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:63
translate turkish D_mirina_dinner_together_yes_68381497:

    mirina "Cinsiyetinle ilgili her kanıta karşı binlerce argümanın vardı."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:64
translate turkish D_mirina_dinner_together_yes_f90fad61:

    mirina "Şimdi ise... çok itaatkâr ve uyumlusun. Ah, her şey tam benim sevdiğim gibi..."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:65
translate turkish D_mirina_dinner_together_yes_cde9cea9:

    player "T-teşekkür ederim, Mirina."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:66
translate turkish D_mirina_dinner_together_yes_3ac4fa2e:

    mirina "Çok sevimlisin, sana bunu söyleyen oldu mu?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:67
translate turkish D_mirina_dinner_together_yes_eefea80c:

    player "Ah... ben... emin değilim..."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:68
translate turkish D_mirina_dinner_together_yes_1ef6f371:

    mirina "Bana açılmaya başladın ve..."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:69
translate turkish D_mirina_dinner_together_yes_b299d28e:

    mirina "Ben... ben de karşılığında sana karşı dürüst ve açık olmak istiyorum, Austy."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:70
translate turkish D_mirina_dinner_together_yes_9da2196a:

    player "{i}O... beni baştan mı çıkarmaya çalışıyor..?{/i}"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:71
translate turkish D_mirina_dinner_together_yes_c8473a08:

    mirina "Kalçandaki o açık deliği gördükten sonra..."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:72
translate turkish D_mirina_dinner_together_yes_a82a6e85:

    mirina "Ve salyalı ağzını..."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:73
translate turkish D_mirina_dinner_together_yes_175c5538:

    mirina "O görüntüler kafamdan çıkmıyor. Bütün aklımı doldurdun, Austy."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:74
translate turkish D_mirina_dinner_together_yes_8b1d7d98:

    player "{i}Mirina bana deli olmalı... Bana karşı ne hissettiğini bile bilmiyordum..{/i}"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:75
translate turkish D_mirina_dinner_together_yes_1720216e:

    mirina "Bir sorun mu var? Üzerine fazla mı gidiyorum?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:76
translate turkish D_mirina_dinner_together_yes_d3a230a7:

    player "Hayır, hayır, sorun yok Mirina.."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:77
translate turkish D_mirina_dinner_together_yes_c2be3281:

    mirina "Üzgünüm, çok heyecanlandım, bunları sana bu kadar erken söylememeliydim."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:78
translate turkish D_mirina_dinner_together_yes_7fe81cd8:

    mirina "Muhtemelen hafif meşrep ve saçma biri olduğumu düşünüyorsun.."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:79
translate turkish D_mirina_dinner_together_yes_40c308d1:

    player "Hayır, Mirina. Sorun değil. Sadece çok nazik ve sevgi dolusun, o kadar."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:80
translate turkish D_mirina_dinner_together_yes_b998ef50:

    player "Bunu gerçekten takdir ediyorum."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:81
translate turkish D_mirina_dinner_together_yes_ee6ce24d:

    mirina "Yine de benimle yemeğe çıkacak mısın..?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:82
translate turkish D_mirina_dinner_together_yes_46aad7da:

    player "Evet, tabii ki.. Seninle birlikte olmaktan gerçekten keyif alıyorum, Mirina."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:83
translate turkish D_mirina_dinner_together_yes_8cbd7ecb:

    mirina "Oh, çok sevindim, bu akşam için çok teşekkür ederim, Austy."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:96
translate turkish D_mirina_dinner_together_no_4cd3de5d:

    mirina sad "B-bir dahaki sefere mi?"

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:97
translate turkish D_mirina_dinner_together_no_329be496:

    mirina "Ah, tabii, senin gibi yakışıklı çocukların yapacak başka işleri vardır..."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:98
translate turkish D_mirina_dinner_together_no_d7924ed7:

    player "Düşündüğün gibi değil, seninle gerçekten yemek yemek istiyorum. Sadece bugün olmaz."

# game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:99
translate turkish D_mirina_dinner_together_no_4cd4a5ee:

    mirina happy "Yakaladım! O zaman bir dahaki sefere görüşürüz!"

translate turkish strings:

    # game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:47
    old "After a little discussion about where to go, you set off."
    new "Nereye gideceğinizi biraz konuştuktan sonra yola çıkıyorsunuz."

    # game/scripts/sequences/070/mirina_dinner_together/dialogues.rpy:86
    old "After that, you spent the evening talking on many diverse topics."
    new "Ardından akşamı çeşitli konular hakkında sohbet ederek geçiriyorsunuz."

