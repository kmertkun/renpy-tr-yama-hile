# game/scripts/sequences/070/trish_date_4/dialogues.rpy:7
translate turkish D_trish_date_4_c510db75:

    "Fazla uzatmadan Trish hemen seni yakalıyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:8
translate turkish D_trish_date_4_668eccb2:

    "Tek, kararlı bir hareketle şortunu çekip çıkarıyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:9
translate turkish D_trish_date_4_f7ee52ac:

    trish "Ah.. o kıçı o kadar çok istiyorum ki, Austy.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:10
translate turkish D_trish_date_4_4f22c9fb:

    trish "Kendimi hiç tutamıyorum.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:11
translate turkish D_trish_date_4_6d2d5fbd:

    "Bu kadar çok tahrik olmuşken kendini tehdit altında hissetmiyorsun.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:12
translate turkish D_trish_date_4_a455ab32:

    "Anal seks konusunda oldukça acemi olsan da."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:13
translate turkish D_trish_date_4_a1add095:

    "Seni külotunla bırakan Trish, seni yatağa oturtuyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:20
translate turkish D_trish_date_4_3cf333e2:

    "Trish sertliğine dar gelen şortunu kendisi çıkarıyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:23
translate turkish D_trish_date_4_a9c7e086:

    "Sonra üstünü çıkarıyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:26
translate turkish D_trish_date_4_c12dac07:

    "Dirseklerinin üzerinde biraz geriye kayarak yatakta ona yer açıyorsun."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:27
translate turkish D_trish_date_4_eefaa9e5:

    "Bacakların onun önünde ardına kadar açık."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:30
translate turkish D_trish_date_4_057c3502:

    "Trish karşına oturup sertliğini sana doğru bastırıyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:31
translate turkish D_trish_date_4_563602f3:

    "Bu hissi zaten biliyorsun."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:32
translate turkish D_trish_date_4_bbc138dd:

    "Bacaklarının arasındaki yoğun kaşıntı ve anüsüne çok sıkı bastıran sert, sıcak bir şey hissi."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:33
translate turkish D_trish_date_4_66c80b7c:

    "Onun için nasıl olacağını önceden hayal bile etmiyorsun, ama kafanda mantıklı düşünmeye yer kalmadı."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:34
translate turkish D_trish_date_4_8618fc56:

    "Beklerken Trish'in külotunu çoktan kenara ittiğini fark etmiyorsun.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:35
translate turkish D_trish_date_4_d68529c6:

    "Ve mantar şeklindeki başı deliğine dayamış bile."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:36
translate turkish D_trish_date_4_c04c1fdc:

    "Çok kalın olduğunu hissediyorsun - bacaklarını daha da açman ve kollarınla yanlara iterek tutman gerektiğini görüyorsun."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:37
translate turkish D_trish_date_4_28c39ede:

    player "Ah.. tanrım.. tanrım.. Ne kadar büyük.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:41
translate turkish D_trish_date_4_254c555b:

    "Bu seslerle birlikte Trish içine girdi."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:42
translate turkish D_trish_date_4_bc91d995:

    "Bir saniye bile duraksamadan, içine daha da derine ilerledi."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:43
translate turkish D_trish_date_4_5012b010:

    player "Trish.. Ah.. Tanrım.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:44
translate turkish D_trish_date_4_9951cccc:

    "İnlemelerin onu sadece daha çok tahrik etti ve basit bir ön sevişmeden aktif şekilde içinde hareket etmeye başladı."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:45
translate turkish D_trish_date_4_7e07bdb4:

    trish "Ah.. çok iyisin, Austy.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:46
translate turkish D_trish_date_4_88d57dda:

    "Sikini tamamen içine sokmayı başaramadı."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:47
translate turkish D_trish_date_4_2348dc36:

    "Ama buna da razı oldu."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:48
translate turkish D_trish_date_4_aa5b7311:

    "Daha önce kıçında gerçek bir sikle bu kadar iyi hissedeceğini düşünemezdin."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:49
translate turkish D_trish_date_4_2efc91b8:

    "Küçük bir bağımlılığa dönüşebilecek gibi görünüyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:51
translate turkish D_trish_date_4_7223e0e6:

    "Trish hızını iyice artırıyor ve düzensiz sıçramalarla içine boşalıyor."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:61
translate turkish D_trish_date_4_50bf5f5f:

    player "{i}Ah.. Tanrım.. içimdeki bu sıcaklık ne kadar güzel..{/i}"

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:64
translate turkish D_trish_date_4_afd18b52:

    "Çok yorulmuş olan Trish sikini çıkarıyor ve seninle sarılıp uyumaya yerleşiyor.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:67
translate turkish D_trish_date_4_38f9a938:

    trish "Seni seviyorum.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:68
translate turkish D_trish_date_4_f97d2470:

    "Söylediği şeyle kalbin bir an durdu ve kıpırdayamıyorsun bile - Trish'in yanında bayılıp kalıyorsun."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:79
translate turkish D_trish_date_4_68d695f3:

    trish "Hey.. hey.. pşt.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:80
translate turkish D_trish_date_4_d0eb546d:

    trish "Uyan.. Austy.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:81
translate turkish D_trish_date_4_417f53a3:

    trish "Benim.. arkadaşın.. Trish.. Ana evrenden.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:86
translate turkish D_trish_date_4_77a84375:

    player "Oh.. M-merhaba.. Trish.. Ben.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:87
translate turkish D_trish_date_4_498557e4:

    player "Her şeyi açıklayacağım.. Garip görünebilir ve.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:88
translate turkish D_trish_date_4_154ea342:

    trish "Ah, rahat ol, Austy.. Sorun yok.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:89
translate turkish D_trish_date_4_91f4c8eb:

    trish "Çok mutluyum.. aramızın.. senin.. bu kadar yakınlaşmış olmasına."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:90
translate turkish D_trish_date_4_a6dc2ba6:

    trish "Ben.. her gece seninle konuşmaya geliyorum ve sonunda seni yakınımda buldum.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:91
translate turkish D_trish_date_4_221b9ee7:

    player "Oh.. Özür dilerim.. Ben-ben onu daha sık ziyaret etmeliyim herhalde, ha."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:92
translate turkish D_trish_date_4_84e4648d:

    trish "Hayır, hayır, işler kendi akışında gitsin."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:93
translate turkish D_trish_date_4_e535e7dc:

    trish "Bunu sana söyleyeceğimi hiç düşünmezdim, Austy.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:94
translate turkish D_trish_date_4_24b162bc:

    trish "Ama iç çamaşırıyla çok iyi görünüyorsun."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:95
translate turkish D_trish_date_4_c645eb07:

    trish "Geniş kalçaların çok doğal duruyor.. Ah.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:96
translate turkish D_trish_date_4_0ff98905:

    trish "Ve buradaki Trish.. dev bir sikin varmış gibi görünüyor.. tanrım.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:97
translate turkish D_trish_date_4_7f27c825:

    trish "Senden hoşlanmasına şaşırmıyorum.. yani.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:98
translate turkish D_trish_date_4_f13c167a:

    player "E-evet.. bugün onunla.. ilk anal seksimizi yaptık.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:99
translate turkish D_trish_date_4_ade807ab:

    trish "Ugh.. Onu içine sokmuş.. Nasıl hâlâ hayattasın, haha!"

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:100
translate turkish D_trish_date_4_ab88863e:

    player "Şey.. bunun için biraz antrenman yapıyordum.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:101
translate turkish D_trish_date_4_c450b58f:

    trish "Tanrım, bu çok havalı.. Mm.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:102
translate turkish D_trish_date_4_ac005313:

    trish "Fazla vaktim yok, Austy.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:103
translate turkish D_trish_date_4_0ff3b46b:

    trish "Annen seninle hiç iletişime geçmedi mi..?"

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:104
translate turkish D_trish_date_4_d5965e70:

    player "Maalesef hayır."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:105
translate turkish D_trish_date_4_73795746:

    trish "Ah, biliyor musun, bu bir kez daha olan her şeyin gerekliliği üzerine düşündürüyor.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:106
translate turkish D_trish_date_4_3f769058:

    trish "Çok fazla şey söylemek istemiyorum ama sanki bu hikâyenin tamamında sen sadece bir pazarlık kozu gibisin.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:107
translate turkish D_trish_date_4_2b30d2a2:

    player "Neden bunu söylüyorsun?"

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:108
translate turkish D_trish_date_4_44cec945:

    trish "Seni buradan çıkaramıyorlar çünkü burada suda balık gibi hissediyorsun! Mesele elimizde böyle bir imkân olmaması değil - mesele bunun sadece imkânsız olması."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:109
translate turkish D_trish_date_4_b60ffed8:

    trish "Buradaki ortama çok doğal uyum sağlıyorsun, etrafındaki herkes seninle eski Austin'den çok daha memnun. Bu evren seni hiç bırakmayabilir."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:110
translate turkish D_trish_date_4_5c9fc557:

    player "N-ne..? Ama mutlaka bir çıkış yolu olmalı, değil mi?"

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:111
translate turkish D_trish_date_4_f0dbebdc:

    trish "Bir çıkış yolu olabilir ve olacak.. Anneciğin umursuyorsa.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:112
translate turkish D_trish_date_4_31dcf3e9:

    trish "Dediğim gibi, fazla vaktim yok.. Ben gidiyorum, Austy.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:113
translate turkish D_trish_date_4_c128cc93:

    player "Geri döneceğim.."

# game/scripts/sequences/070/trish_date_4/dialogues.rpy:114
translate turkish D_trish_date_4_481785a1:

    trish "Gerçekten umarım."

translate turkish strings:

    # game/scripts/sequences/070/trish_date_4/dialogues.rpy:3
    old "In high spirits, you make it to Trish's house."
    new "Keyfin yerinde bir şekilde Trish'in evine varıyorsun."

    # game/scripts/sequences/070/trish_date_4/dialogues.rpy:75
    old "You fall asleep soundly after very heavy physical exertion.."
    new "Çok ağır bir fiziksel eforun ardından deliksiz uykuya dalıyorsun.."

    # game/scripts/sequences/070/trish_date_4/dialogues.rpy:117
    old "Trish leaves you and you go back to sleep."
    new "Trish seni bırakıyor ve sen tekrar uyuyorsun."

    # game/scripts/sequences/070/trish_date_4/dialogues.rpy:121
    old "In the morning you have breakfast together and Trish walks you home."
    new "Sabah birlikte kahvaltı ediyorsunuz ve Trish seni eve bırakıyor."

