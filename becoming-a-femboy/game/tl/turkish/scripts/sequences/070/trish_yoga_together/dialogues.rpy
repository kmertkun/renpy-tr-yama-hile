    player "Bundan ne çıkacak acaba?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:8
translate turkish D_trish_yoga_together_334160e5:

    player "En azından o gelmeden ısınmalıyım."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:37
translate turkish D_trish_yoga_together_83106eb1:

    mom "Austy, misafirlerin var!"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:38
translate turkish D_trish_yoga_together_61b64ab7:

    player "Tamam, geliyorum."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:53
translate turkish D_trish_yoga_together_1a1c80e1:

    mom "Oh, şu ikinize bakın!"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:54
translate turkish D_trish_yoga_together_f89e81a7:

    mom "Ne kadar tatlı! Birlikte egzersiz yapmayı mı planlıyorsunuz?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:55
translate turkish D_trish_yoga_together_6ecb5cd1:

    player "Oh, evet... Daha doğrusu yoga..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:56
translate turkish D_trish_yoga_together_ca99a52b:

    mom "Ne güzel! Trish gibi bir arkadaşın olduğu için çok şanslısın!"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:57
translate turkish D_trish_yoga_together_9894ae28:

    mom "Sana kesinlikle çok ilginç bir şey öğretecek."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:58
translate turkish D_trish_yoga_together_5975d5dc:

    trish "Oh, bu konuda endişelenmene gerek yok."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:59
translate turkish D_trish_yoga_together_9757cb6f:

    trish "Peki ya sen? Bir uzman olarak Austin'e bir şey öğrettin mi?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:60
translate turkish D_trish_yoga_together_45728cf4:

    mom "Oh, yapma, ben sadece amatörüm... Böyle yetenekli bir gence ne öğretebilirim ki?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:61
translate turkish D_trish_yoga_together_a4d96b26:

    player "{i}Annem de mi yoga yapıyor? Bir ara onunla birlikte pratik yapmayı denemeliyim...{/i}"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:62
translate turkish D_trish_yoga_together_080e2afd:

    mom "Neyse, boş ver, seni daha fazla tutmayayım... İyi eğlenceler, hehe."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:73
translate turkish D_trish_yoga_together_0815ed76:

    trish "Vay, ne havalı spor kıyafetlerin var!"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:75
translate turkish D_trish_yoga_together_352eefdb:

    trish "İçinde kesinlikle muhteşem görünüyorsun!"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:76
translate turkish D_trish_yoga_together_54d239ef:

    trish "Özellikle kıçın.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:77
translate turkish D_trish_yoga_together_a9d062c3:

    player "Ehehe, sağ ol, Trish. Ben de seni daha önce bu kıyafetle görmemiştim..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:79
translate turkish D_trish_yoga_together_c760fd76:

    trish "Şaşılacak bir şey yok, yeni! Onu ilk gören sensin."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:80
translate turkish D_trish_yoga_together_b0d4e5bf:

    trish "Sence bu mavi tonu bana yakışıyor mu?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:82
translate turkish D_trish_yoga_together_426746aa:

    player "Ah... e-evet, tabii ki, Trish. Harika görünüyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:83
translate turkish D_trish_yoga_together_15ed4183:

    trish "Ne kadar tatlısın! Gerçi iltifatı kendim istedim..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:85
translate turkish D_trish_yoga_together_05f5bb06:

    player "Oh, yapma... Ben... bazen böyle şeyleri yüksek sesle söylemekten utanıyorum ve..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:86
translate turkish D_trish_yoga_together_32f3890c:

    trish "Sorun değil, Austin. Antrenmana başlayalım."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:92
translate turkish D_trish_yoga_together_3915531c:

    trish "Her şeyden önce şu an ne kadar esnek olduğunu bilmem benim için çok önemli."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:94
translate turkish D_trish_yoga_together_358bf604:

    "Sen ve Trish bir dizi esneme egzersizi yapıyorsunuz."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:97
translate turkish D_trish_yoga_together_1b5ca9a1:

    "Seni çok kapsamlı bir şekilde test ediyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:99
translate turkish D_trish_yoga_together_d1354453:

    trish "Şimdiden fena değil, hiç yüzünü buruşturmuyorsun bile.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:100
translate turkish D_trish_yoga_together_e35cf981:

    trish "Nasıl hissediyorsun? Devam edebilir misin?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:101
translate turkish D_trish_yoga_together_f87945ba:

    "Bu güne iyi hazırlandığını hissediyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:102
translate turkish D_trish_yoga_together_bb667c92:

    "Bir anlık kibir seni bir süreliğine körleştiriyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:103
translate turkish D_trish_yoga_together_d3f6c3d2:

    "Trish daha yeni başlamış olmasına rağmen."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:104
translate turkish D_trish_yoga_together_00209323:

    player "Oh, başladık mı bile?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:105
translate turkish D_trish_yoga_together_6d39bf35:

    trish "Hehe, tavrını beğendim, yaramaz şey.. Devam edelim.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:106
translate turkish D_trish_yoga_together_c019544a:

    "Trish yaramaz davranışına yorum yapıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:107
translate turkish D_trish_yoga_together_e116bc05:

    "Ama bunu iyi anlamda yapıyor, sana karşı kin tutmuyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:108
translate turkish D_trish_yoga_together_9d5ae66d:

    "Sadece onunla oynadığını çok iyi anlıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:115
translate turkish D_trish_yoga_together_0839de1e:

    trish "Bir şey yolunda değilse söylemekten çekinme, Austin.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:116
translate turkish D_trish_yoga_together_4b94215d:

    "Kaslarının hafifçe yanmaya başladığını hissediyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:117
translate turkish D_trish_yoga_together_af93d59f:

    "Ama bu hâlâ Trish'ten durmasını istemek için yeterli değil."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:118
translate turkish D_trish_yoga_together_4cd7e1d7:

    "Aynı hevesle bir nükteli laf daha çıkarıyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:119
translate turkish D_trish_yoga_together_c6b6cc1c:

    player "Her şey yolunda.. Biraz daha zorlarsan dağılmam.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:120
translate turkish D_trish_yoga_together_15956f7c:

    "Trish son yorumu ciddiye aldı."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:121
translate turkish D_trish_yoga_together_c74940b9:

    "Ama görünüşe göre zaten ince buz üzerinde yürüyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:122
translate turkish D_trish_yoga_together_aa617e51:

    "Belki biraz daha ve oyunlar sona erer."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:123
translate turkish D_trish_yoga_together_22bff85f:

    trish "Ehm.. peki.. tamam.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:126
translate turkish D_trish_yoga_together_6f315fa6:

    "Trish ağırlığını bacağına bastırıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:128
translate turkish D_trish_yoga_together_1be916bb:

    trish "Oh.. Ben.. senin için endişeleniyorum, Austin.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:129
translate turkish D_trish_yoga_together_1b6ea770:

    trish "Bu kadar esnek olmana sevindim.. ama.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:130
translate turkish D_trish_yoga_together_46266be5:

    trish "Bu işte bu kadar iyi olduğunu hiç hayal edemezdim.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:131
translate turkish D_trish_yoga_together_fbda756b:

    "Trish'in yeteneklerinin sınırını bulduğunu hissediyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:132
translate turkish D_trish_yoga_together_237e5074:

    "Ama orada durmak için fazla iyi bir moddasın."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:133
translate turkish D_trish_yoga_together_04071b5d:

    player "Sonuçta bugün bana yeni bir şey göstereceğini sanıyordum.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:134
translate turkish D_trish_yoga_together_d0e8c3a5:

    "Trish davranışından biraz rahatsız oluyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:135
translate turkish D_trish_yoga_together_6d8a948e:

    "Ama kendini toparlar toparlamaz, seni nasıl dizginleyeceğini hemen düşünüyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:138
translate turkish D_trish_yoga_together_bf047931:

    "Trish sana çok yakın eğiliyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:139
translate turkish D_trish_yoga_together_a7d7e5bc:

    trish "Yeni bir şey... hmm... bir düşüneyim.."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:140
translate turkish D_trish_yoga_together_d155212b:

    "Seni ikiye katlıyor ve hazırlıksız yakalıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:143
translate turkish D_trish_yoga_together_8763cf82:

    trish "Gerçekten, yeni bir şeye ne dersin... ikimiz için de..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:144
translate turkish D_trish_yoga_together_f4bc1169:

    player "N-ne yapıyorsun... Trish... Oh..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:147
translate turkish D_trish_yoga_together_004c6487:

    "Trish taytını aşağı çekiyor ve kalçalarını önünde açığa çıkarıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:148
translate turkish D_trish_yoga_together_840a1378:

    trish "Oh, ne güzel bir manzara..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:149
translate turkish D_trish_yoga_together_da4caa62:

    "Trish'in önünde senin el değmemiş, pembe ama çok yaramaz deliğin görünüyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:150
translate turkish D_trish_yoga_together_94b0cfa3:

    "Bu anda Trish'ten tam olarak ne bekleyeceğini bilmiyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:151
translate turkish D_trish_yoga_together_5d9fbf15:

    "Trish orada sana bakarken derin bir nefes alıyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:152
translate turkish D_trish_yoga_together_893d4385:

    "Buna hazırlıklı değildin ve nasıl göründüğünden emin değilsin."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:155
translate turkish D_trish_yoga_together_086e18ab:

    "Trish dilini çıkarıp anüsünü yalamaya başlıyor, bol miktarda tükürük bırakıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:156
translate turkish D_trish_yoga_together_10c88333:

    "Üzüntüne ya da belki şansına, orada durmuyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:157
translate turkish D_trish_yoga_together_a5b5ee69:

    "Dilini içeri itmeye başlıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:160
translate turkish D_trish_yoga_together_f0050ba8:

    "Ve sinir bozucu şekilde, Trish diliyle çok derine ulaşabiliyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:161
translate turkish D_trish_yoga_together_789fe505:

    "Daha önce hissettiğin hiçbir şeye benzemeyen bir istila hissi yaşıyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:162
translate turkish D_trish_yoga_together_f8e2461a:

    "Trish'in dili, bunca zamandır içinde bulunmuş en büyük şey."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:163
translate turkish D_trish_yoga_together_235c30b0:

    "Küçük ve yavaş hareketlerle seni delmeye devam ediyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:166
translate turkish D_trish_yoga_together_47b6d61a:

    "Bol tükürüğe rağmen yine de belirgin bir esneme acısı hissediyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:167
translate turkish D_trish_yoga_together_d8973d44:

    "Ama zamanla bu, daha önce tanımadığın bir hisse dönüşüyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:168
translate turkish D_trish_yoga_together_dcd7f976:

    "Penisinin çok sertleştiğini hissediyorsun ve Trish onu sıkıca kavrıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:169
translate turkish D_trish_yoga_together_988a0c04:

    "Kıçına girişlerin derinliğini artırırken seni elle işi yapıyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:170
translate turkish D_trish_yoga_together_632369e8:

    player "{i}Oh, Tanrım... çok güzel hissettiriyor...{/i}"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:171
translate turkish D_trish_yoga_together_5c2ad896:

    player "L-lütfen... dur... ben... ben..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:172
translate turkish D_trish_yoga_together_0ca898f6:

    "Trish dilini tamamen kıçına dolduruyor ve acımasızca seni masaj yapmaya devam ediyor."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:173
translate turkish D_trish_yoga_together_beeb3fed:

    player "Ben... ben..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:174
translate turkish D_trish_yoga_together_a143c89b:

    "Yoğun bir şekilde boşalıyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:177
translate turkish D_trish_yoga_together_169e3ab1:

    "Yüzüne boşalıyorsun, ağzına ve burnuna da kaçıyor, ama en azından gözlerini kapatmayı başardın."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:184
translate turkish D_trish_yoga_together_d3bb19a3:

    trish "Peki, nasıldı? Senin için yeterince yeni miydi?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:185
translate turkish D_trish_yoga_together_234c56b7:

    "Yüzün kendi spermine bulanmış halde ayağa kalkıyor, kendini toparlamaya çalışıyorsun."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:186
translate turkish D_trish_yoga_together_17cf0105:

    player "Ah... şey... k-kıçım ağrıyor..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:187
translate turkish D_trish_yoga_together_195623ad:

    trish "Hehe. Öyle olması gerekir. Yakında alışırsın."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:188
translate turkish D_trish_yoga_together_e680d821:

    player "{i}Bunu bana yine yapmak mı istiyor?{/i}"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:189
translate turkish D_trish_yoga_together_05f07138:

    trish "Rahat ol. Rızan olmadan bir daha öyle bir şey yapmayacağım."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:190
translate turkish D_trish_yoga_together_de8fc03c:

    trish "Gerçi bu sefer sen istedin. Üzgün değilsin, değil mi?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:191
translate turkish D_trish_yoga_together_b90c6693:

    player "H-hayır, tabii ki hayır! Gerçekten çok hoşuma gitti... Çok... alışılmadıktı."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:192
translate turkish D_trish_yoga_together_8b67dd54:

    trish "Oh evet, benim de... Daha önce bu kadar esnek olduğunu hiç düşünmezdim."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:193
translate turkish D_trish_yoga_together_02d11e47:

    trish "Dinle... benimle spor salonuna gitmeye başlamak ister misin?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:194
translate turkish D_trish_yoga_together_7de987b1:

    trish "Ev antrenmanları iyi, ama bir noktada sınıra ulaşırsın."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:195
translate turkish D_trish_yoga_together_d9b6ab8a:

    player "Spor salonuna... şey... oh... emin değilim, ben... başka insanların yanında çok utangacım ve..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:196
translate turkish D_trish_yoga_together_78185c90:

    trish "Oh, bu konuda endişelenme. Her zaman seninle olacağım!"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:197
translate turkish D_trish_yoga_together_68a89bb5:

    trish "Ayrıca bunu, benim rehberliğimde antrenman yapabilesin diye öneriyorum."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:198
translate turkish D_trish_yoga_together_2c2fae9b:

    trish "Şu an bir öğrencim olması benim için çok önemli. Ben talimat veririm, sen de sonuçları getirirsin."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:199
translate turkish D_trish_yoga_together_8a4844e9:

    trish "Tabii ki hizmetlerim için hiç ödeme yapmak zorunda kalmayacaksın."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:200
translate turkish D_trish_yoga_together_4d3098fd:

    player "{i}Ona hiç hayır diyemeyecekmişim gibi hissediyorum...{/i}"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:201
translate turkish D_trish_yoga_together_fc9a546d:

    player "Peki, Trish. Anlaştık."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:202
translate turkish D_trish_yoga_together_1721bf48:

    trish "Oh, inanamıyorum! Çok mutluyum! Aman Tanrım..."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:203
translate turkish D_trish_yoga_together_6841a7a7:

    player "Hadi ama, abartma."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:204
translate turkish D_trish_yoga_together_29f938f6:

    trish "Benim için çok şey ifade ediyor! Teşekkür ederim, Austin."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:205
translate turkish D_trish_yoga_together_6a98c73c:

    player "Sorun değil... Ne zaman başlıyoruz?"

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:206
translate turkish D_trish_yoga_together_3bbb2734:

    trish "Öğleden sonra bana gel, sana uygun olduğu zaman, birlikte gideriz."

# game/scripts/sequences/070/trish_yoga_together/dialogues.rpy:207
translate turkish D_trish_yoga_together_0c34820c:

    player "T-tamam! O zaman görüşürüz."

