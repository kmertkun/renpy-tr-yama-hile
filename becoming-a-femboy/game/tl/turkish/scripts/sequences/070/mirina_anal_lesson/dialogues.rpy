    mirina "Asıl mesele korkmamak, her şey kontrolümüz altında."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:221
translate turkish D_mirina_anal_lesson_first_time_841ca886:

    mirina "İlk dakika biraz rahatsız edici olabilir ama çabucak alışırsın."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:222
translate turkish D_mirina_anal_lesson_first_time_ee8e7a74:

    mirina "İçine girerken hoş şeyler düşün."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:223
translate turkish D_mirina_anal_lesson_first_time_44179131:

    mirina "Ve deliğini germe!"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:224
translate turkish D_mirina_anal_lesson_first_time_1790a1e9:

    mirina "3... 2... 1..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:225
translate turkish D_mirina_anal_lesson_first_time_1bd2ef8b:

    mirina "İlk ders modunu açtım. Makineyi çok öğretici bulacağını düşünüyorum."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:226
translate turkish D_mirina_anal_lesson_first_time_cca8dcc8:

    mirina "İyi eğlenceler, hee."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:227
translate turkish D_mirina_anal_lesson_first_time_b000b29f:

    "Milin hareket ederken çıkardığı yumuşak, mekanik sesi duyuyorsun"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:228
translate turkish D_mirina_anal_lesson_first_time_1b52557c:

    "Kaçınılmaz olanı ve her şeyin ne kadar yavaş olduğunu düşünürken kendini yakalıyorsun - beklenti hissi gitgide artıyor .."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:231
translate turkish D_mirina_anal_lesson_first_time_4de685b8:

    "Oyuncağın başı anüsüne ulaştı ve içine girmeye başlıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:234
translate turkish D_mirina_anal_lesson_first_time_7ea04757:

    "Oyuncağın çapı çok küçük olmasına rağmen oldukça rahatsız edici bir gerilme hissediyorsun ama kayganlaştırıcı durumu çok çabuk düzeltiyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:235
translate turkish D_mirina_anal_lesson_first_time_6ee58cb3:

    player "Ah... Tanrım... Tanrım..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:236
translate turkish D_mirina_anal_lesson_first_time_d5808490:

    "Kalbin daha hızlı atıyor, nefesini kontrol etmek zorlaşıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:237
translate turkish D_mirina_anal_lesson_first_time_03720ebd:

    "Baş tamamen içine giriyor"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:238
translate turkish D_mirina_anal_lesson_first_time_2278d7fa:

    player "Bu daha ne kadar sürecek... Ah... ah... Dayanamıyorum.."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:241
translate turkish D_mirina_anal_lesson_first_time_b5e40e4c:

    "Ama bu sadece başlangıçtı. Oyuncak içine doğru ilerlemeye devam etti."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:242
translate turkish D_mirina_anal_lesson_first_time_9d1f88d6:

    player "{i}Bu aynı oyuncak mı? Hatırladığımdan çok daha uzun hissettiriyor!{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:245
translate turkish D_mirina_anal_lesson_first_time_80441ca6:

    "Oyuncak yarıdan fazlası içine girdi ve geri dönüş yolculuğuna başladı."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:246
translate turkish D_mirina_anal_lesson_first_time_94054c1f:

    player "{i}Ah... ne... ne güzel bir his... Tanrım... sonunda...{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:247
translate turkish D_mirina_anal_lesson_first_time_620f7b3a:

    player "{i}Ne rahatlama..{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:248
translate turkish D_mirina_anal_lesson_first_time_0de13508:

    "Oyuncak dışarı çıktı. Tamamen kayganlaştırıcıyla kaplı olduğu için deliğinden ince bir iplik izi taşıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:249
translate turkish D_mirina_anal_lesson_first_time_6d0a264b:

    "Deliğin neredeyse hemen büzülüp kapandı."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:252
translate turkish D_mirina_anal_lesson_first_time_08b7c033:

    "Makine biraz daha hızlı bir tempoyla yeniden girmeye başladı, deliğini daha kolay açıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:253
translate turkish D_mirina_anal_lesson_first_time_a4d87351:

    player "Güzel şeyler düşün... Ah... Güzel şeyler düşün..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:257
translate turkish D_mirina_anal_lesson_first_time_92ac9dd9:

    "Makine tempoyu yavaş yavaş artırıyor, girişleri birbiri ardına tekrarlıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:258
translate turkish D_mirina_anal_lesson_first_time_a51826e9:

    "Kafanı bulutlarda tutup hoş şeyler düşünmeye çalışırken, götündeki oyuncak sik her seferinde seni yere bastırıp sana kendini hatırlatıyordu."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:262
translate turkish D_mirina_anal_lesson_first_time_591c1297:

    "Oyuncak geri hareketine başlarken ritmik bir şekilde inlemeye devam ediyorsun."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:269
translate turkish D_mirina_anal_lesson_first_time_d60ff53a:

    "Bir süredir kontrolsüzce inliyorsun."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:270
translate turkish D_mirina_anal_lesson_first_time_92e0dddf:

    "Makine bunca zaman boyunca ivme kazanıyordu ama aniden durdu, seninle işi bitirdi."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:273
translate turkish D_mirina_anal_lesson_first_time_4d68074f:

    "Deliğin artık hemen kapanmıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:274
translate turkish D_mirina_anal_lesson_first_time_ce519f65:

    "Nefesinle uyumlu olarak daralıyor."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:275
translate turkish D_mirina_anal_lesson_first_time_83dac622:

    player "Ah... Tanrım... Tanrım... Hayatta kaldım.."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:282
translate turkish D_mirina_anal_lesson_first_time_99079be4:

    mirina "Ah, makinenin zaten bitirdiğini görüyorum."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:283
translate turkish D_mirina_anal_lesson_first_time_6ddecfbd:

    mirina "Nasılsın, Austy?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:284
translate turkish D_mirina_anal_lesson_first_time_50f2255b:

    "Birkaç kelimeyi bir araya getirmeyecek kadar yorgun olduğun için hiçbir şey söylemiyorsun."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:287
translate turkish D_mirina_anal_lesson_first_time_f0492e5f:

    mirina "Vay, seni bu kadar yormuş! Sadece 10 dakika sürdü."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:288
translate turkish D_mirina_anal_lesson_first_time_6588e6d4:

    mirina "Sorun değil... git biraz dinlen."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:299
translate turkish D_mirina_anal_lesson_first_time_86c7e8db:

    mirina "Ah, sonunda uyandın..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:300
translate turkish D_mirina_anal_lesson_first_time_55858d1a:

    mirina "Öyle tatlı uyudun ki, tam bir göz ziyafeti!"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:301
translate turkish D_mirina_anal_lesson_first_time_d48ca907:

    player "Ah, ne kadar oldu?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:302
translate turkish D_mirina_anal_lesson_first_time_d58980fe:

    mirina "Şimdi gece, Austy."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:303
translate turkish D_mirina_anal_lesson_first_time_6209d1de:

    player "Tanrım... Özür dilerim. Yüzümden birkaç müşteri kaybetmiş olmalısın..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:304
translate turkish D_mirina_anal_lesson_first_time_d8ab2f41:

    mirina "Önemli değil. Hasta sağlığı her şeyden önce gelir."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:305
translate turkish D_mirina_anal_lesson_first_time_ff2a28bd:

    mirina "Seni böyle bir halde eve gönderemezdim. Yorgunluktan yığılabilirdin!"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:306
translate turkish D_mirina_anal_lesson_first_time_7566b1f6:

    player "Teşekkürler. Bana karşı çok naziksin."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:307
translate turkish D_mirina_anal_lesson_first_time_6ca93032:

    player "S-senin için bir şey... yapabilir miyim?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:308
translate turkish D_mirina_anal_lesson_first_time_468f7126:

    mirina "Bir şey yapmak mı? Benim için mi...? Ah..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:309
translate turkish D_mirina_anal_lesson_first_time_fa7f2997:

    player "{i}Dr. Mirina ne düşünüyordu acaba?{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:310
translate turkish D_mirina_anal_lesson_first_time_67c81b8a:

    player "{i}Ben de çok kızardım...{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:311
translate turkish D_mirina_anal_lesson_first_time_9e36acb1:

    mirina "Biliyor musun Austy... Sanırım senden bir şey isteyebilirim..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:312
translate turkish D_mirina_anal_lesson_first_time_8fba71ca:

    player "Evet, tabii ki, her şeyi.."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:313
translate turkish D_mirina_anal_lesson_first_time_1e2e967d:

    mirina "Şey... biliyorsun... Biriyle birlikte olmayı çok özledim."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:314
translate turkish D_mirina_anal_lesson_first_time_b155da47:

    mirina "Bir ara... bir şekilde... şey... ah... gelebilir misin?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:315
translate turkish D_mirina_anal_lesson_first_time_0fec83e8:

    player "Ne yapabilir miyim?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:316
translate turkish D_mirina_anal_lesson_first_time_82acafa1:

    mirina "Bir ara iş vardiyamdan sonra gelip benimle akşam yemeği yer misin?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:317
translate turkish D_mirina_anal_lesson_first_time_b6d402b5:

    player "{i}Sadece Mirina'yla akşam yemeği mi?{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:318
translate turkish D_mirina_anal_lesson_first_time_cb708fd0:

    player "{i}Bana gösterdiği nezaket için küçük bir bedel gibi görünüyor{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:319
translate turkish D_mirina_anal_lesson_first_time_93816674:

    player "Bence bir yere gidebiliriz..."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:320
translate turkish D_mirina_anal_lesson_first_time_00605b2e:

    mirina "Ah! İnanamıyorum... Kabul ettin! Çok sevindim."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:321
translate turkish D_mirina_anal_lesson_first_time_0f3ba503:

    mirina "İş çıkışı akşamları ... her gün boşum."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:322
translate turkish D_mirina_anal_lesson_first_time_19b5b6f5:

    mirina "Bir sonraki eğitime gel ve sonrasında bir yere gideriz, tamam mı?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:323
translate turkish D_mirina_anal_lesson_first_time_69cb2aa1:

    player "Evet... tamam."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:324
translate turkish D_mirina_anal_lesson_first_time_d6ed8a2c:

    mirina "Ah, çok sevindim! Yalnız yenen yemekler çok iç karartıcı. Teşekkürler!"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:325
translate turkish D_mirina_anal_lesson_first_time_b379b51c:

    player "{i}Onu bu kadar kolay heyecanlandırabileceğimi düşünmemiştim.{/i}"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:341
translate turkish D_mirina_anal_lesson_regular_c79eb4d6:

    player "Bu sefer olmaz, sanırım."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:342
translate turkish D_mirina_anal_lesson_regular_359cc1ae:

    mirina "Sorun değil, tatlım."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:346
translate turkish D_mirina_anal_lesson_regular_4d7f38ce:

    mirina "Şu anda anal tıkaç takıyor musun?"

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:347
translate turkish D_mirina_anal_lesson_regular_2de44380:

    player "Ah.. h-hayır..? Unutmuşum.."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:348
translate turkish D_mirina_anal_lesson_regular_080854d1:

    mirina "Bir dahaki sefere tıkaç takıyor olduğundan emin ol. Bu dersler için şart."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:352
translate turkish D_mirina_anal_lesson_regular_ea157fe5:

    mirina "Bence bugünlük sana yeter."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:353
translate turkish D_mirina_anal_lesson_regular_7cf446d5:

    mirina "Abartma."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:394
translate turkish D_mirina_anal_lesson_regular_26f0a792:

    player "Ah, bu sefer her şey yolunda gitti.."

# game/scripts/sequences/070/mirina_anal_lesson/dialogues.rpy:431
translate turkish D_mirina_anal_lesson_regular_26f0a792_1:

    player "Ah, bu sefer her şey yolunda gitti.."

