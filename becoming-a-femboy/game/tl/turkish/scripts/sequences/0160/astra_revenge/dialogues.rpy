# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:7
translate turkish D_astra_revenge_7d0e2f05:

    "Astra seni odandan dışarı fırlatıp duvara yaslıyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:8
translate turkish D_astra_revenge_4d0d4b89:

    astra "Bu kadar kolay değil, seni sapık."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:9
translate turkish D_astra_revenge_f8d0cf85:

    "Astra seni bir anda ciddi şekilde geriyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:10
translate turkish D_astra_revenge_6529415c:

    "Gizlilik becerini fazla abartmışsın gibi görünüyor, bu yüzden aptalı oynamaya karar veriyorsun."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:11
translate turkish D_astra_revenge_c818f5a7:

    player "Ne oldu? Ben pek a-anlamadım."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:12
translate turkish D_astra_revenge_28b248a4:

    astra "Durumu kendine daha da kötüleştirme, aptal."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:13
translate turkish D_astra_revenge_02d0f455:

    astra "Zaten yeterince acınası görünüyorsun."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:14
translate turkish D_astra_revenge_99b5f4f7:

    astra "Ah, l-lütfen beni affet, ben... Seni kırmak gibi bir niyetim yoktu."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:15
translate turkish D_astra_revenge_e1bf378b:

    astra "Hadi ama, çok doğal bir şey."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:16
translate turkish D_astra_revenge_6a70c3e9:

    astra "Önünde bir kızın kendini tatmin etmesini izlemekten zevk almış olmalısın..."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:17
translate turkish D_astra_revenge_912781ca:

    astra "Ama izinsiz böyle şeyler yapan femboyları nelerin beklediğinden haberin yok."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:20
translate turkish D_astra_revenge_1765f5ff:

    "Astra seni odasına sürüklüyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:21
translate turkish D_astra_revenge_28b5ed02:

    "Bu gerginlik dizlerini titretiyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:24
translate turkish D_astra_revenge_75166afa:

    "Birkaç kendinden emin adım atıp seni saçından kavrıyor ve dizlerinin üstüne çöktürüyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:25
translate turkish D_astra_revenge_14330b12:

    "Acıdan çığlık atmak için ağzını açmak üzereyken..."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:28
translate turkish D_astra_revenge_f15d2267:

    "Astra ustaca ağzını uzun bir dildoyla dolduruyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:29
translate turkish D_astra_revenge_d3f3d99d:

    "Direncini kolayca aşarak dildoyu neredeyse boğazının dibine kadar kaydırıyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:30
translate turkish D_astra_revenge_62d1a1d4:

    "Anında çabalamayı bırakıyorsun."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:33
translate turkish D_astra_revenge_d662790c:

    astra "İşte böyle. Aferin oğlum..."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:34
translate turkish D_astra_revenge_ddd59598:

    "Astra sana ders vermeye çalışırken sen anlaşılmaz bir şeyler mırıldanıyorsun."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:35
translate turkish D_astra_revenge_c0301b46:

    astra "Ne? Daha derin mi istiyorsun, ha?"

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:36
translate turkish D_astra_revenge_dfed54df:

    "Astra başını daha da yukarı kaldırıp dildoyu daha derine zorluyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:37
translate turkish D_astra_revenge_a9fe02ad:

    "Gözlerinin içine kendini beğenmiş bir şekilde bakıp içlerindeki kaygının silinişini izliyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:38
translate turkish D_astra_revenge_bdecdb85:

    "Gözyaşlı ifaden yavaş yavaş boyun eğmiş bir ifadeye dönüşüyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:39
translate turkish D_astra_revenge_8e9ee2eb:

    astra "Bizim tatlı Austie'nin ne kadar uysal bir ağzı var..."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:40
translate turkish D_astra_revenge_1dfff0d3:

    astra "Etraftaki herkes sana hayran kalıyor olmalı."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:43
translate turkish D_astra_revenge_b9f8dc40:

    "Astra baskıyı bir an bile gevşetmiyor. Kısa süre sonra ayağını bacaklarının arasında hissediyorsun."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:44
translate turkish D_astra_revenge_68259378:

    astra "Ah, evet. Bundan hiç utanmıyorsun bile."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:45
translate turkish D_astra_revenge_b3ef174b:

    "Ayağını sertçe bastırarak erkekliğini eziyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:46
translate turkish D_astra_revenge_6758c10a:

    astra "Zevk alıyorsan bu pek de ceza sayılmaz."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:47
translate turkish D_astra_revenge_676795a1:

    astra "Ugh... Bunun ne anlamı var ki?"

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:50
translate turkish D_astra_revenge_0031023b:

    "Astra dildoyu ağzından çekip çıkarıyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:51
translate turkish D_astra_revenge_51548a0d:

    "İşlerin gidişatından hiç memnun görünmüyor..."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:52
translate turkish D_astra_revenge_5f42aa30:

    "Gerçi sana hakaret ederek öfkesini tüketmiş gibi görünüyor."

# game/scripts/sequences/0160/astra_revenge/dialogues.rpy:53
translate turkish D_astra_revenge_693ffed5:

    "Seni şaşkınlık içinde bırakıp gidiyor."

