# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:7
translate turkish D_mirina_time_together_9e273dcb:

    mirina "Ah, kulağa harika geliyor, Austyn!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:8
translate turkish D_mirina_time_together_61c2d612:

    mirina "Bütün bunlara nasıl yetişiyorsun?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:9
translate turkish D_mirina_time_together_f10b0464:

    player "Emin değilim. Buna pek yetişmek denemez aslında."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:10
translate turkish D_mirina_time_together_04ac5939:

    mirina "Ah, lütfen! Okula gidiyorsun, spor yapıyorsun, bir çalışmaya katılıyorsun ve şimdi de modellik şansı kazandın."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:11
translate turkish D_mirina_time_together_4589518b:

    mirina "Benim gibi biriyle yemek yemeye vakit bulman gurur verici."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:12
translate turkish D_mirina_time_together_d3e9ef6c:

    mirina "Uhh..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:13
translate turkish D_mirina_time_together_11b4b3a8:

    "Mirina derin, hüzünlü bir iç çekiyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:14
translate turkish D_mirina_time_together_42c6a822:

    player "Ne oldu, Mirina? Seni üzen bir şey mi var?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:15
translate turkish D_mirina_time_together_7d6eba46:

    mirina "Belki..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:16
translate turkish D_mirina_time_together_aec399c4:

    mirina "Bazen bir döngüde sıkışıp kalmışım gibi hissediyorum."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:17
translate turkish D_mirina_time_together_cb76a31b:

    mirina "Uyanıyorum. İşe gidiyorum. Hep aynı aptallar önemsiz bir şeyi öğrenmeye çabalıyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:18
translate turkish D_mirina_time_together_c7ea2e98:

    mirina "Gelirim artmıyor, uzmanlığım gelişmiyor..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:19
translate turkish D_mirina_time_together_0af01f6d:

    mirina "Bir de şu sürekli yalnızlık var."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:20
translate turkish D_mirina_time_together_89d2fbd6:

    mirina "Bazen yalnız yatıp yalnız uyanmaktan bıktığımı fark ediyorum."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:21
translate turkish D_mirina_time_together_4d49ee07:

    player "Ah, bunların hepsi çok üzücü, Mirina."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:22
translate turkish D_mirina_time_together_5173ef43:

    mirina "Son zamanlarda bana kendimi canlı hissettiren tek kişi sensin."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:23
translate turkish D_mirina_time_together_42cd2759:

    player "Övünmem kederini artırdıysa üzgünüm..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:24
translate turkish D_mirina_time_together_66ca9283:

    mirina "Ah, hiç de değil! Senin suçun değil, Austie."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:25
translate turkish D_mirina_time_together_f6aa0fd2:

    mirina "Şu an burada benimle olmana gerçekten çok sevindim."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:26
translate turkish D_mirina_time_together_4d9be364:

    mirina "Bu gece beni yalnız bırakmayacaksın, değil mi?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:27
translate turkish D_mirina_time_together_30317ae9:

    player "Ah, bu benim için fazla acımasızca olurdu."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:28
translate turkish D_mirina_time_together_7270f524:

    mirina "Seni burada rehin tutuyormuşum gibi hissetmeni istemem, Austyn..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:29
translate turkish D_mirina_time_together_1656ef1b:

    player "Kesinlikle hayır! Bu akşamı seninle geçirmeyi gerçekten dört gözle bekliyorum, Mirina."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:30
translate turkish D_mirina_time_together_c3fef7e5:

    "Mirina'nın yüzü bir gülümsemeyle aydınlanıyor, gözleri minnetle doluyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:31
translate turkish D_mirina_time_together_7c63ee02:

    "Bir garson çağırıp biraz da beklenen bir sipariş veriyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:32
translate turkish D_mirina_time_together_317f321a:

    mirina "Bize biraz daha sert bir şey getirir misiniz lütfen?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:45
translate turkish D_mirina_time_together_ec103050:

    mirina "Ah, Austie... keşke sadece kendime ait bir femboy'u ne kadar çok istediğimi bilseydin..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:46
translate turkish D_mirina_time_together_f3daea54:

    mirina "Ama benim gibi biri sürekli bir partnere sahip olabilir mi?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:47
translate turkish D_mirina_time_together_d8364328:

    mirina "İşim yüzünden sürekli kıskançlık yapardı."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:48
translate turkish D_mirina_time_together_c12e94e9:

    mirina "Sözde kariyerim hayatımı mahvedip duruyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:49
translate turkish D_mirina_time_together_8da9f095:

    mirina "Ah, doğru! Geçen gün tam bir kabustu."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:50
translate turkish D_mirina_time_together_2ab26547:

    mirina "Sıradan bir iş gününün ardından eve geldim, ne gördüm dersin?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:51
translate turkish D_mirina_time_together_fc6b95e8:

    mirina "Yakında eski olacak sevgilim sadece telefonunu açmadım diye evdeki bütün tabakları kırmış!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:52
translate turkish D_mirina_time_together_aa9e6dd9:

    mirina "O femboy öyle bir hırçınlık yaptı ki... Görmeliydin."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:53
translate turkish D_mirina_time_together_6e15d0b2:

    mirina "Ama çok seksiydi... ah."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:56
translate turkish D_mirina_time_together_c42b53f5:

    player "Ah, e-evet... Z-zor zamanlar geçiriyor gibisin."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:59
translate turkish D_mirina_time_together_630bd0b8:

    mirina "Son birkaç yıldır tek yaptığım müşterilerimle seks yapma arzumu bastırmak oldu..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:60
translate turkish D_mirina_time_together_f29c5828:

    mirina "Ve geçenlerde neredeyse kavgaya tutuşacaktım."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:61
translate turkish D_mirina_time_together_36054afd:

    mirina "Şu pembe saçlı olan, femboy'u özel seanslar için bana geliyor diye yüzümü dağıtmaya hazırdı..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:64
translate turkish D_mirina_time_together_43e14cd1:

    player "Y-yani Anna ve Tiffany'yi mi kastediyorsun?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:67
translate turkish D_mirina_time_together_13fb3eb4:

    mirina "Evet, onlar! Lanet olası deliler. İkisinin de bir sürü vidası gevşek!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:68
translate turkish D_mirina_time_together_3e1442d2:

    mirina "Ugh, cehenneme kadar yolu var. Bütün bu... çiftler çok baş belası."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:71
translate turkish D_mirina_time_together_d6159f2e:

    player "Ah, belki aralarındaki işler düşündüğümden bile kötüdür."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:72
translate turkish D_mirina_time_together_0254f384:

    mirina "Biliyor musun... Ben sadece yan yana uyanmak gibi basit insani bir şey istiyorum..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:73
translate turkish D_mirina_time_together_96442631:

    mirina "Birlikte kahvaltı edip işlerimizin peşinden gitmek..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:74
translate turkish D_mirina_time_together_f069dfdd:

    mirina "Ve akşam yine birlikte yatmak. Ah, keşke öyle bir döngüde olsaydım."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:77
translate turkish D_mirina_time_together_3cb76c11:

    player "Sanırım bunların hepsi senin için gerçekten önemli..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:80
translate turkish D_mirina_time_together_106eeba1:

    mirina "Önemli. Ama diğer yandan, içinde kaybolmak da istemiyorum."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:81
translate turkish D_mirina_time_together_9a792e95:

    mirina "Yanlış anlama, aşk güzel bir şey."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:82
translate turkish D_mirina_time_together_babfc9a5:

    mirina "Ancak kendini gerçekleştirmek de en az o kadar önemli!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:83
translate turkish D_mirina_time_together_deedbf86:

    mirina "Biliyor musun... mesela şu iğrenç klinikte takılıp kalmak yerine kendi işimi kurmak?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:84
translate turkish D_mirina_time_together_555c2178:

    mirina "Kişisel antrenör olabilirim! Sonuçta harika bir yeteneğim var."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:85
translate turkish D_mirina_time_together_e857b0ba:

    player "Ah... E-evet... yeteneğin eşsiz!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:86
translate turkish D_mirina_time_together_d97dc56d:

    mirina "Teşekkürler, Austie."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:87
translate turkish D_mirina_time_together_cca62ebf:

    mirina "Ne kadar para kazanacağımı bir düşün!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:88
translate turkish D_mirina_time_together_637612e4:

    mirina "Ah, Tanrım... Ama para aşkı satın alamaz."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:89
translate turkish D_mirina_time_together_0b9522bd:

    mirina "Sen hiç bunu düşünmedin mi, Austie?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:90
translate turkish D_mirina_time_together_b263dd68:

    player "Ah, bilmiyorum bile... Bazı günler hayatımın en iyi dönemini yaşıyormuşum gibi hissediyorum..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:91
translate turkish D_mirina_time_together_2fa6bd4d:

    player "Yine de beni kesinlikle daha ciddi şeyler düşünmeye sevk ediyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:92
translate turkish D_mirina_time_together_7b0846f4:

    mirina "Sen... Sen çok iyi bir dinleyicisin, Austie..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:93
translate turkish D_mirina_time_together_652723d0:

    mirina "Mmm..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:94
translate turkish D_mirina_time_together_7f897c5a:

    mirina "Sana ne kadar harika olduğunu hiç söyledim mi, Austie? *Hık*"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:95
translate turkish D_mirina_time_together_a8d95465:

    "Mirina sohbeti sürdürmek için tamamen formsuz görünüyor, bu yüzden hesabı istiyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:96
translate turkish D_mirina_time_together_f83a1035:

    player "Şey, Mirina... seni eve bıraksam nasıl olur?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:97
translate turkish D_mirina_time_together_1717756c:

    mirina "Çok nazik olurdu... *Hık*."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:108
translate turkish D_mirina_time_together_D_mirina_time_together_sex_c2573c58:

    mirina "Ah, Austie... sen en iyisisin... *Hık*"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:109
translate turkish D_mirina_time_together_D_mirina_time_together_sex_645e3acb:

    mirina "Ne tatlısın..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:110
translate turkish D_mirina_time_together_D_mirina_time_together_sex_7b8f0d68:

    player "{i}Bu gece iyice kafayı bulmuş.{/i}"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:111
translate turkish D_mirina_time_together_D_mirina_time_together_sex_c33532a4:

    player "{i}Gerçi ben de birkaç kadeh içtim...{/i}"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:112
translate turkish D_mirina_time_together_D_mirina_time_together_sex_20092693:

    player "{i}Ah, ben neye dönüşüyorum?{/i}"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:113
translate turkish D_mirina_time_together_D_mirina_time_together_sex_e15677c2:

    player "Buraya gelmeden önce bir yudum bile alkol içmemiştim..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:116
translate turkish D_mirina_time_together_D_mirina_time_together_sex_38120288:

    mirina "Ne saçmalıyorsun, tatlım?"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:121
translate turkish D_mirina_time_together_D_mirina_time_together_sex_50b08818:

    "Düşüncelere dalmışken Mirina'nın kıyafetlerinin ortadan kaybolduğunu fark etmiyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:122
translate turkish D_mirina_time_together_D_mirina_time_together_sex_cf6966e0:

    "Çıplak ve sana hazır halde uzanıyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:125
translate turkish D_mirina_time_together_D_mirina_time_together_sex_8413b81f:

    mirina "Bugünlük konuşma yeter, tatlım..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:126
translate turkish D_mirina_time_together_D_mirina_time_together_sex_19271e5b:

    mirina "Gel bana."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:127
translate turkish D_mirina_time_together_D_mirina_time_together_sex_29aaf96a:

    "Taş gibi sert sikli, kendi çekim gücü olan kocaman bir gök cismi gibi inanılmaz bir güçle seni kendine çekiyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:130
translate turkish D_mirina_time_together_D_mirina_time_together_sex_d82e65b0:

    "Mirina'yı bekletmek istemeden, bir anda sen de çıplak kalıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:131
translate turkish D_mirina_time_together_D_mirina_time_together_sex_41a0475b:

    "Zarifçe üstüne atlayıp siklerini birbirine sürterek ısıyı yükseltmeye başlıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:132
translate turkish D_mirina_time_together_D_mirina_time_together_sex_afaee42d:

    "Islanmış ucu karnına sürtünürken ikiniz de o sikin içine ne kadar derin girebileceğini düşünmekten zevk alıyorsunuz."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:133
translate turkish D_mirina_time_together_D_mirina_time_together_sex_ab6d4283:

    mirina "Mmm... Artık dayanamıyorum, Austie..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:134
translate turkish D_mirina_time_together_D_mirina_time_together_sex_d0641044:

    mirina "Bu siki götüne sok. Bana ne kadar iyi olduğunu göster."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:137
translate turkish D_mirina_time_together_D_mirina_time_together_sex_6a62e236:

    "Daha fazla gecikmeden itaatkâr bir şekilde söyleneni yapıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:138
translate turkish D_mirina_time_together_D_mirina_time_together_sex_2dc482c7:

    "Kendini kaldırıp deliğini onun ucuyla hizalamaya başlıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:139
translate turkish D_mirina_time_together_D_mirina_time_together_sex_4263e68b:

    "Ellerini bacaklarına yaslıyor, sikini bulup vücudunun ağırlığının sana yardım etmesine izin veriyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:142
translate turkish D_mirina_time_together_D_mirina_time_together_sex_60a4165a:

    "İçeri girmesi aklını anında uçuruyor ve yüksek sesle inliyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:143
translate turkish D_mirina_time_together_D_mirina_time_together_sex_3696a07c:

    player "Ah evet... Çok kalın... Mmm..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:144
translate turkish D_mirina_time_together_D_mirina_time_together_sex_291ee45e:

    "Bunu hiç utanmadan yüksek sesle söylüyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:145
translate turkish D_mirina_time_together_D_mirina_time_together_sex_ca5aed61:

    mirina "İşte bu... kendini tutma..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:146
translate turkish D_mirina_time_together_D_mirina_time_together_sex_5b40cd1d:

    "Kendini kaptırıp sınırlarını denemek için kalın sikinin üstüne daha da derine gömülüyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:147
translate turkish D_mirina_time_together_D_mirina_time_together_sex_48e4128f:

    mirina "Mmm... Tanrım!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:148
translate turkish D_mirina_time_together_D_mirina_time_together_sex_117592bf:

    "Daha derine girdikçe, inlemelerin gitgide yükseliyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:149
translate turkish D_mirina_time_together_D_mirina_time_together_sex_4b692776:

    "Sonunda doğru pozisyonu buluyor ve kendinden emin bir şekilde onu götünle sikmeye başlıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:150
translate turkish D_mirina_time_together_D_mirina_time_together_sex_a61e9cd5:

    "Bir kez daha, sikine dokunmadan boşalmaya hazırmışsın gibi hissediyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:151
translate turkish D_mirina_time_together_D_mirina_time_together_sex_6d7df32c:

    mirina "Ah... Austie..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:152
translate turkish D_mirina_time_together_D_mirina_time_together_sex_290f6d1b:

    "Bu gizemi çözmeye yaklaşıyorsun. Görünüşe göre uç götünün derinlerindeki belli bir noktaya sürtündüğünde tam o uyarımı hissediyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:153
translate turkish D_mirina_time_together_D_mirina_time_together_sex_58050d83:

    "Ama fazla sarhoş ve dağınık olduğun için tam olarak nerede olduğunu çıkaramıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:154
translate turkish D_mirina_time_together_D_mirina_time_together_sex_ae878ebd:

    "Sadece düşünmeden kalçanı oynatıp içindeki o noktayı yoklamaya devam ediyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:155
translate turkish D_mirina_time_together_D_mirina_time_together_sex_e39398c9:

    mirina "Evet, sakın durma... Evet..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:156
translate turkish D_mirina_time_together_D_mirina_time_together_sex_0509c9ae:

    "Görünüşe göre an geldi. Mirina'nın siki şiddetle zonklamaya başlıyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:157
translate turkish D_mirina_time_together_D_mirina_time_together_sex_b7016a94:

    "Mirina'nın cesaretlendirici iniltileri eşliğinde son bir çaba için gücünü topluyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:162
translate turkish D_mirina_time_together_D_mirina_time_together_sex_0b1d8ba1:

    "Bütün ağırlığınla sikinin üstüne çöküp tamamen içine alıyor ve sevmeye başladığın o sıcak hissin tadını çıkarıyorsun..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:163
translate turkish D_mirina_time_together_D_mirina_time_together_sex_ee8f3fa5:

    "...futa spermi sıcaklığının."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:164
translate turkish D_mirina_time_together_D_mirina_time_together_sex_0e9af50d:

    mirina "Mmm... Evet!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:165
translate turkish D_mirina_time_together_D_mirina_time_together_sex_64d59350:

    "Spermini içine fışkırtışını, her fışkırtıştan zevk alarak hissediyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:166
translate turkish D_mirina_time_together_D_mirina_time_together_sex_7ad73410:

    mirina "Sen gerçekten başka birisin, Austie..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:169
translate turkish D_mirina_time_together_D_mirina_time_together_sex_e418f68a:

    "Bitkin halde Mirina'nın üstüne yığılıyorsun, siki kendine has bir sesle seni terk ediyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:170
translate turkish D_mirina_time_together_D_mirina_time_together_sex_e51d14d3:

    "Spermin bir kısmının açık kalmış deliğinden kontrolsüzce sızdığını hissedebiliyorsun ama bunu dert edemeyecek kadar sarhoşsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:171
translate turkish D_mirina_time_together_D_mirina_time_together_sex_13584abf:

    "Mirina'nın yumuşak göğsünde uykuya dalıyorsun. Onunla birlikte."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:178
translate turkish D_mirina_time_together_D_mirina_time_together_sex_c134c01e:

    "Vücudun onunkiyle sıcacık iç içe geçmiş. Huzurlu ve sakin hissediyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:179
translate turkish D_mirina_time_together_D_mirina_time_together_sex_dcd5deb0:

    "Ta ki..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:180
translate turkish D_mirina_time_together_D_mirina_time_together_sex_8f1034e5:

    "Mirina birden fırlayıp panikle bağırıyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:183
translate turkish D_mirina_time_together_D_mirina_time_together_sex_8ade1286:

    mirina "Aman Tanrım, galiba uyuyakalmışım!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:184
translate turkish D_mirina_time_together_D_mirina_time_together_sex_ceecd7b1:

    mirina "Hemen hazırlanmam lazım..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:185
translate turkish D_mirina_time_together_D_mirina_time_together_sex_851da793:

    "Çırılçıplak koşarak uzaklaşıyor."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:186
translate turkish D_mirina_time_together_D_mirina_time_together_sex_8c4acb70:

    mirina "Ah, üzgünüm, Austie."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:187
translate turkish D_mirina_time_together_D_mirina_time_together_sex_76bc662f:

    mirina "Dün gece harikaydı... ama gerçekten gitmem lazım."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:190
translate turkish D_mirina_time_together_D_mirina_time_together_sex_73e81d76:

    mirina "Anahtarları sana bırakıyorum! İstediğin zaman çıkabilirsin."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:191
translate turkish D_mirina_time_together_D_mirina_time_together_sex_3784f3ee:

    mirina "Ve ortalığın dağınıklığını dert etme!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:192
translate turkish D_mirina_time_together_D_mirina_time_together_sex_a461cecb:

    mirina "Ugh, gitmem lazım. Hoşça kal!"

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:195
translate turkish D_mirina_time_together_D_mirina_time_together_sex_2ebc6618:

    "Kapı çarparak kapanıyor ve sen uykunun kalıntılarını üzerinden atarak onun evinde yalnız kalıyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:196
translate turkish D_mirina_time_together_D_mirina_time_together_sex_f4d5e545:

    "Tamamen uyandıktan sonra toparlanıp işlerinin peşine düşüyorsun."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:197
translate turkish D_mirina_time_together_D_mirina_time_together_sex_3a63b7b6:

    player "Ah, artık Mirina'nın dairesinin anahtarı bende."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:198
translate turkish D_mirina_time_together_D_mirina_time_together_sex_c05934ad:

    player "Bana böyle bir şey emanet etmesi çok hoş..."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:199
translate turkish D_mirina_time_together_D_mirina_time_together_sex_ae89c537:

    player "Yine de birinin evinde duş almak için yeterince rahat hissetmiyorum."

# game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:200
translate turkish D_mirina_time_together_D_mirina_time_together_sex_1a71bb8d:

    player "Sanırım eve gideceğim."

translate turkish strings:

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:3
    old "You talk about Astra's research and share the details of your and Jessica's deal."
    new "Astra'nın araştırmasından ve senin ile Jessica'nın anlaşmasının ayrıntılarından bahsediyorsun."

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:35
    old "Once you've had your \"something stronger\", the conversation takes a completely different turn."
    new "\"Daha sert bir şeyini\" içtikten sonra sohbet tamamen farklı bir yöne kayıyor."

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:38
    old "The two of you drift toward more personal topics, not hesitating to share each other's plans and dreams."
    new "İkiniz de daha kişisel konulara yöneliyor, birbirinize planlarınızı ve hayallerinizi paylaşmaktan çekinmiyorsunuz."

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:41
    old "Well, at least Mirina does."
    new "Şey, en azından Mirina öyle yapıyor."

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:100
    old "You escort Mirina out of the restaurant arm in arm as you head for her apartment together."
    new "Mirina'yı kol kola restorandan çıkarıp birlikte dairesine doğru yürüyorsunuz."

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:103
    old "Barging into her apartment, Mirina makes herself comfortable on the couch."
    new "Dairesine dalan Mirina kanepeye rahatça yerleşiyor."

    # game/scripts/sequences/0160/mirina_time_together/dialogues.rpy:174
    old "In the morning, you wake up next to Mirina."
    new "Sabah, Mirina'nın yanında uyanıyorsun."

