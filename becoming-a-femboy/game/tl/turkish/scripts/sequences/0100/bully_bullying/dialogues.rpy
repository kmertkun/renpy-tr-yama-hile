# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:2
translate turkish D_billy_bully_bullying_meet_9118710d:

    "Jannet'le kısa bir selamlaşmanın ardından, başına böyle bir şey geleceğini hiç tahmin etmemiştin."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:3
translate turkish D_billy_bully_bullying_meet_d05fec62:

    "Tanımadığın atletik yapılı bir adam sana yaklaşıp tehditkâr bir şekilde bakıyor."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:6
translate turkish D_billy_bully_bullying_meet_4137093c:

    billy "Onunla ne konuşuyordun, pislik?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:7
translate turkish D_billy_bully_bullying_meet_9c09fcfe:

    player "B-biz sadece... Şey... Jannet'le ben..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:8
translate turkish D_billy_bully_bullying_meet_089415c7:

    billy "Ondan ne istiyorsun?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:9
translate turkish D_billy_bully_bullying_meet_3205b42c:

    player "S-sadece bir tür çiftiz falan..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:10
translate turkish D_billy_bully_bullying_meet_22770514:

    billy "Bir tür çift mi? Bu ne demek?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:11
translate turkish D_billy_bully_bullying_meet_98138606:

    player "Şey, çıkıyoruz ve..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:12
translate turkish D_billy_bully_bullying_meet_3f7b8bbf:

    billy "Oh, sen şu Austie'sin, ha? Evet, Jannet senden bahsetmişti."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:13
translate turkish D_billy_bully_bullying_meet_13a92971:

    player "E-evet, ben Austin."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:14
translate turkish D_billy_bully_bullying_meet_6d7ad335:

    billy "Yuvarlak kıçlı şirin bir femboy..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:15
translate turkish D_billy_bully_bullying_meet_d2c3a33a:

    player "Bunu mu dedi?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:16
translate turkish D_billy_bully_bullying_meet_aa727fa9:

    billy "Dikkatle dinle, iki kez açıklamayacağım."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:17
translate turkish D_billy_bully_bullying_meet_af2d2c71:

    billy "Jannet'le flört etmeye devam edersen, o koca ağzına daha iyi bir kullanım bulurum."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:18
translate turkish D_billy_bully_bullying_meet_d225443e:

    player "N-ne yaptım ki?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:19
translate turkish D_billy_bully_bullying_meet_1fb5f6f6:

    billy "Sen mi? Bir şey mi yapacaksın? Bana ne yapabilirsin ki?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:20
translate turkish D_billy_bully_bullying_meet_de631710:

    billy "Beni tehdit mi ediyorsun?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:21
translate turkish D_billy_bully_bullying_meet_a46e68d0:

    player "Kesinlikle hayır! Ben sadece anlamaya çalışıyorum..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:22
translate turkish D_billy_bully_bullying_meet_b9ce1a84:

    billy "Bilmen gereken her şeyi zaten açıkladım."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:23
translate turkish D_billy_bully_bullying_meet_54f1e269:

    billy "Bir dahaki sefere sana nazik olmayacağım."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:26
translate turkish D_billy_bully_bullying_meet_65b13659:

    "Billy işine bakmaya gidiyor, seni şaşkın bırakarak."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:29
translate turkish D_billy_bully_bullying_meet_b1e1c091:

    player "Az önce bana sataştı mı?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:36
translate turkish D_billy_bully_bullying_peek_b75804dd:

    "Görünüşe göre Jannet ve Billy konuşuyor..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:37
translate turkish D_billy_bully_bullying_peek_638773e6:

    "Gizlice izlemek için tribünün altına saklanmalısın..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:43
translate turkish D_billy_bully_bullying_talk_with_jannet_2f79742e:

    player "Seninle o zaman konuştuktan sonra, biri bana yaklaştı..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:45
translate turkish D_billy_bully_bullying_talk_with_jannet_d67bd8c4:

    jannet "Ah, yine mi başlamış."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:46
translate turkish D_billy_bully_bullying_talk_with_jannet_ed040784:

    jannet "Ona senden bahsettiğimden beri Billy huzursuz."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:47
translate turkish D_billy_bully_bullying_talk_with_jannet_65975c60:

    player "O kim? Ve beni neden tehdit etti?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:49
translate turkish D_billy_bully_bullying_talk_with_jannet_f686a362:

    jannet "Tehdit mi? Seni mi?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:50
translate turkish D_billy_bully_bullying_talk_with_jannet_011952b6:

    jannet "Onunla kesinlikle konuşacağım."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:51
translate turkish D_billy_bully_bullying_talk_with_jannet_7a97f9b6:

    jannet "Sadece üstüne alınma."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:52
translate turkish D_billy_bully_bullying_talk_with_jannet_853ba6be:

    jannet "Maalesef belagat onun güçlü yanı değil."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:53
translate turkish D_billy_bully_bullying_talk_with_jannet_bb7bc77c:

    player "Ah, e-eğer ona anlatmanın bir yolunu biliyorsan..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:54
translate turkish D_billy_bully_bullying_talk_with_jannet_e66af3a2:

    player "Onunla konuşurken tek kelime edemedim."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:56
translate turkish D_billy_bully_bullying_talk_with_jannet_14c1bd37:

    jannet "Evet, oldukça ısrarcı. Onunla baş etmek zor olabiliyor."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:58
translate turkish D_billy_bully_bullying_talk_with_jannet_9d995d7a:

    player "E-evet, öyle görünüyor..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:59
translate turkish D_billy_bully_bullying_talk_with_jannet_584ea3f2:

    jannet "Neyse, onu dert etme, her şey yoluna girecek."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:60
translate turkish D_billy_bully_bullying_talk_with_jannet_412170f8:

    jannet "Kesinlikle işleri çözmeye çalışacağım."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:63
translate turkish D_billy_bully_bullying_talk_with_jannet_b77ca9b2:

    player "{i}Ah, her şeyin yolunda gittiğinden emin olmalıyım...{/i}"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:64
translate turkish D_billy_bully_bullying_talk_with_jannet_02372403:

    player "{i}O Billy oldukça tehlikeli görünüyor.{/i}"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:74
translate turkish D_billy_bully_bullying_peeking_at_backyard_75e3fb00:

    "Jannet'in Billy'yle konuşma şeklini fark etmeden duramıyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:75
translate turkish D_billy_bully_bullying_peeking_at_backyard_00d6dd96:

    "Yakında saklanıp kulak misafiri olmaya karar veriyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:78
translate turkish D_billy_bully_bullying_peeking_at_backyard_3091a373:

    jannet "Bak, sana zaten açıkladım. Austin benim femboy-sevgilim..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:79
translate turkish D_billy_bully_bullying_peeking_at_backyard_9b219d68:

    billy "Femboy-sevgili... Ne karmaşık."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:80
translate turkish D_billy_bully_bullying_peeking_at_backyard_5b4431f3:

    jannet "Hiç de karmaşık değil. Sadece alışman gerek."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:81
translate turkish D_billy_bully_bullying_peeking_at_backyard_2541bbaa:

    billy "Oh, biliyorsun ki bunların hiçbirini anlamıyorum."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:82
translate turkish D_billy_bully_bullying_peeking_at_backyard_b411eb60:

    jannet "Oh, inan bana, bayılacaksın."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:83
translate turkish D_billy_bully_bullying_peeking_at_backyard_769dc46c:

    jannet "Ondan ne istediğini ona söylemelisin."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:84
translate turkish D_billy_bully_bullying_peeking_at_backyard_75d18158:

    jannet "Alışık olduğun gibi tehditlerle değil, düzgünce açıkla..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:85
translate turkish D_billy_bully_bullying_peeking_at_backyard_ea3210ae:

    billy "Şey, o bir erkek. Erkeklere başka nasıl davranabilirim ki?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:86
translate turkish D_billy_bully_bullying_peeking_at_backyard_73a02d14:

    jannet "Şşş! O bir femboy. Bu farklı."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:87
translate turkish D_billy_bully_bullying_peeking_at_backyard_43c6960b:

    billy "Oh, yine başladın..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:90
translate turkish D_billy_bully_bullying_peeking_at_backyard_a34fed27:

    jannet "İşte böyle... Sadece rahatlaman gerek..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:91
translate turkish D_billy_bully_bullying_peeking_at_backyard_406b31ed:

    "İşler garip bir hal almaya başlıyor gibi."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:92
translate turkish D_billy_bully_bullying_peeking_at_backyard_b65273d4:

    "Billy'nin fermuarının açıldığını ve rahatlamış iç çekişini duyuyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:95
translate turkish D_billy_bully_bullying_peeking_at_backyard_c65fe789:

    jannet "Ah, işte böyle. Koca adamın biraz hava alması lazım, hi-hi."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:98
translate turkish D_billy_bully_bullying_peeking_at_backyard_3fa2ed93:

    jannet "Mmm..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:101
translate turkish D_billy_bully_bullying_peeking_at_backyard_f3ca6932:

    "Inlemelerine eşlik eden emme sesleri başlıyor ve olanlar konusunda hiçbir belirsizlik bırakmıyor."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:104
translate turkish D_billy_bully_bullying_peeking_at_backyard_03be45b8:

    player "{i}Aman tanrım, burada mı? Okul bahçesinde mi?{/i}"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:105
translate turkish D_billy_bully_bullying_peeking_at_backyard_815e502c:

    player "{i}İşleri hep böyle mi çözüyormuş?{/i}"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:106
translate turkish D_billy_bully_bullying_peeking_at_backyard_f0949e81:

    player "{i}Ah, bunu bilmem gerekirdi...{/i}"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:107
translate turkish D_billy_bully_bullying_peeking_at_backyard_28e2a17e:

    "Olanlardan rahatsız olduğun belli olsa da..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:108
translate turkish D_billy_bully_bullying_peeking_at_backyard_78de5144:

    extend " Merakın seni içten içe yiyip bitiriyor ve gitmene izin vermiyor."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:109
translate turkish D_billy_bully_bullying_peeking_at_backyard_db8071af:

    "Neler olduğunu tam olarak bilerek sesleri dinlemeye devam ediyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:110
translate turkish D_billy_bully_bullying_peeking_at_backyard_d1638e42:

    player "Aman tanrım, ne zaman bitirecek?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:111
translate turkish D_billy_bully_bullying_peeking_at_backyard_6ec4756c:

    "Olanların görüntüsü kendiliğinden zihninde beliriyor."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:112
translate turkish D_billy_bully_bullying_peeking_at_backyard_6b87c527:

    "Emme seslerinden ve alçak, zor duyulan inlemelerden, Jannet'in orada zorlandığını hayal ediyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:113
translate turkish D_billy_bully_bullying_peeking_at_backyard_c74dfba8:

    "Billy'nin oldukça büyük bir yarağı var gibi duyuluyor ve bunu düşünmeden edemiyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:114
translate turkish D_billy_bully_bullying_peeking_at_backyard_80369ab7:

    player "Peki bunu teneffüslerde ne sıklıkla yapıyorlar?"

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:115
translate turkish D_billy_bully_bullying_peeking_at_backyard_4bfc7c4f:

    "Sanki o anda biri seni yargılıyormuş gibi hâlâ öfkeli numarası yaparak düşünmeye devam ediyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:116
translate turkish D_billy_bully_bullying_peeking_at_backyard_70cba1fb:

    "Billy'nin inlemeleri düşünce akışını kaybettirene kadar."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:119
translate turkish D_billy_bully_bullying_peeking_at_backyard_bdbdec67:

    billy "Evet... Mm..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:120
translate turkish D_billy_bully_bullying_peeking_at_backyard_916b1b2b:

    billy "Hepsini yut..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:121
translate turkish D_billy_bully_bullying_peeking_at_backyard_1e364836:

    billy "Sınırımdayım, ah..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:128
translate turkish D_billy_bully_bullying_peeking_at_backyard_ab832ce4:

    "Hemen ardından Jannet'in boğulma seslerini duyuyorsun."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:137
translate turkish D_billy_bully_bullying_peeking_at_backyard_d8bad655:

    "Ve bir an sonra, tam bir rahatlamanın iç çekişleri."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:138
translate turkish D_billy_bully_bullying_peeking_at_backyard_1d0b5105:

    billy "Mm... Sen en iyisisin..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:139
translate turkish D_billy_bully_bullying_peeking_at_backyard_7e060016:

    jannet "Konuştuklarımızı unutma Billy..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:140
translate turkish D_billy_bully_bullying_peeking_at_backyard_2817300a:

    billy "Ah, eğer o senin yarının kadar iyiyse..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:141
translate turkish D_billy_bully_bullying_peeking_at_backyard_f75587e0:

    jannet "Fazla umutlanma. Yarın, aynı yer..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:142
translate turkish D_billy_bully_bullying_peeking_at_backyard_e2172e62:

    billy "E-evet, tabii ki..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:143
translate turkish D_billy_bully_bullying_peeking_at_backyard_7d424344:

    player "Bu ne demek? Jannet onun..."

# game/scripts/sequences/0100/bully_bullying/dialogues.rpy:144
translate turkish D_billy_bully_bullying_peeking_at_backyard_b1d7fa7b:

    player "Bana da aynısını yapmasını mı istiyor?"

