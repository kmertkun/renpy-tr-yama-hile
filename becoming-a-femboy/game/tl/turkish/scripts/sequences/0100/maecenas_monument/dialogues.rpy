# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:2
translate turkish D_jannet_maecenas_monument_invite_2934db87:

    player "Hey, dinle... O-okuldan sonra bir ara yürüyüşe çıkmak ister misin?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:3
translate turkish D_jannet_maecenas_monument_invite_029b9f67:

    player "Genelde çok meşgul olduğunu falan biliyorum ama..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:4
translate turkish D_jannet_maecenas_monument_invite_127114e1:

    jannet "Oh, tabii. Neden olmasın."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:5
translate turkish D_jannet_maecenas_monument_invite_4b5b86b2:

    jannet "Geçenlerde parkımıza yeni bir anıt dikildi."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:6
translate turkish D_jannet_maecenas_monument_invite_a657c62c:

    jannet "Bir göz atabiliriz..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:7
translate turkish D_jannet_maecenas_monument_invite_2640ff69:

    jannet "Ve belki... Sonrasında parkta başka bir yere yürürüz, hi-hi."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:8
translate turkish D_jannet_maecenas_monument_invite_b209fbda:

    player "{i}Başka bir yere mi?{/i}"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:9
translate turkish D_jannet_maecenas_monument_invite_220fcb42:

    player "Oh, evet... Harika bir fikir."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:10
translate turkish D_jannet_maecenas_monument_invite_076d6004:

    jannet "O zaman görüşürüz!"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:33
translate turkish D_jannet_maecenas_monument_park_80049a12:

    player "Vay, ne çok isim."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:34
translate turkish D_jannet_maecenas_monument_park_443bd6d7:

    jannet "Evet, küçük kasabamızın bu kadar çok iyi insanı çekebileceğini kim tahmin ederdi?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:35
translate turkish D_jannet_maecenas_monument_park_aac3f1c8:

    worker "Evet, isimlerini buraya kazımaktan yoruldum... Püf..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:36
translate turkish D_jannet_maecenas_monument_park_70b4c644:

    "Ter içindeki bir futanari işçi sözünü kesti."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:37
translate turkish D_jannet_maecenas_monument_park_478ccf62:

    "Anıta hayırseverlerin isimlerini kazıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:38
translate turkish D_jannet_maecenas_monument_park_ec3310bf:

    jannet "Ah, bahse girerim sen de sadece onların sayesinde varsın."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:43
translate turkish D_jannet_maecenas_monument_park_15a4908b:

    worker "Aslında bu kasaba yüzlerce iyi insan sayesinde var."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:44
translate turkish D_jannet_maecenas_monument_park_f2ba6af3:

    worker "Belki büyüyünce sizler de onlar kadar iyi insanlar olursunuz."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:45
translate turkish D_jannet_maecenas_monument_park_2def49dd:

    jannet "Biz mi? Hah!"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:46
translate turkish D_jannet_maecenas_monument_park_63d07fe1:

    player "Evet, bunu düşünmek için çok erken. Önce okulu bitirmem lazım."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:47
translate turkish D_jannet_maecenas_monument_park_37ad17e8:

    worker "Oh... Bugünün gençleri. Gelecekten hiç umutları yok."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:48
translate turkish D_jannet_maecenas_monument_park_5c062935:

    "İşçi işini bitirip eşyalarını toplayarak parktan ayrılıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:49
translate turkish D_jannet_maecenas_monument_park_a3339ab5:

    worker "Dikkat edin, ikiniz. Burada kimse yaramazlık yapmasın!"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:50
translate turkish D_jannet_maecenas_monument_park_82e08008:

    player "Evet efendim!"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:51
translate turkish D_jannet_maecenas_monument_park_f1c17f48:

    jannet "Evet efendim!"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:55
translate turkish D_jannet_maecenas_monument_park_41b6b7e8:

    "Anıtın önünde yalnızsın, hâlâ ona bakıyorsun."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:56
translate turkish D_jannet_maecenas_monument_park_ebd285bc:

    "Daha yakından bakmak için Jannet eğiliyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:57
translate turkish D_jannet_maecenas_monument_park_c1c86a4c:

    "Kısa eteğinin altından külotu görünüyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:60
translate turkish D_jannet_maecenas_monument_park_fb5b3554:

    jannet "Mhm... Bütün bu paranın yerel gençleri baştan çıkarmaya harcandığını duydum..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:61
translate turkish D_jannet_maecenas_monument_park_e5f6d193:

    player "Ah... Yine bir komplo teorisi gibi geliyor..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:62
translate turkish D_jannet_maecenas_monument_park_a75407f5:

    jannet "Gerçekten mi? Saçma bir fikir olduğunu mu düşünüyorsun?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:63
translate turkish D_jannet_maecenas_monument_park_269fa7b8:

    "Gözlerini kıçından alamıyorsun."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:64
translate turkish D_jannet_maecenas_monument_park_aa019924:

    "Devasa kıçını görünce tahrik duygusu içini kaplıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:65
translate turkish D_jannet_maecenas_monument_park_b5b7511f:

    "İstese o kalçalarla seni kolayca boğabilirmiş gibi görünüyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:66
translate turkish D_jannet_maecenas_monument_park_2d0c6549:

    "Sen de buna karşı koymayı aklından bile geçirmezdin."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:69
translate turkish D_jannet_maecenas_monument_park_e4edd045:

    jannet "Bu durumda, şu an yaptığın şey ne?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:70
translate turkish D_jannet_maecenas_monument_park_8d7325c3:

    player "Ben..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:71
translate turkish D_jannet_maecenas_monument_park_4599315c:

    player "Oh, bu kadar sinirlenme. Sadece şaka yapıyorum."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:72
translate turkish D_jannet_maecenas_monument_park_f1a7e0c4:

    jannet "Biliyorum, kıçım sana düşünecek pek yer bırakmıyor..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:73
translate turkish D_jannet_maecenas_monument_park_0b8713a7:

    player "E-evet, bir bakıma bırakmıyor..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:74
translate turkish D_jannet_maecenas_monument_park_a3961ad3:

    jannet "Ne dersin, biz..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:75
translate turkish D_jannet_maecenas_monument_park_3a30bf76:

    extend "başka bir yere gitsek?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:76
translate turkish D_jannet_maecenas_monument_park_df9ff013:

    player "Nasıl bir yere?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:77
translate turkish D_jannet_maecenas_monument_park_d6c50511:

    jannet "Beni takip et!"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:80
translate turkish D_jannet_maecenas_monument_park_9ad9a149:

    "Jannet seni elinden tutup biraz ileri sürüklüyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:81
translate turkish D_jannet_maecenas_monument_park_c76836b4:

    "Seni tam bu anıtın arkasına götürüp duvara bastırıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:82
translate turkish D_jannet_maecenas_monument_park_23948bbf:

    jannet "Gözlerini üstümde hissedebiliyorum, Austie..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:83
translate turkish D_jannet_maecenas_monument_park_7e139eda:

    jannet "Muhtemelen bu orospuyu sürekli yarağında tutmanın ne kadar havalı olacağını düşünüyorsun..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:84
translate turkish D_jannet_maecenas_monument_park_31753d23:

    player "N-ne yapıyorsun... Ben..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:85
translate turkish D_jannet_maecenas_monument_park_2c293a2a:

    player "Ben öyle biri değilim..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:86
translate turkish D_jannet_maecenas_monument_park_e8f0d626:

    jannet "Oh, her şeyi çok iyi biliyorum, hi-hi."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:89
translate turkish D_jannet_maecenas_monument_park_0daf33f2:

    "Jannet önüne çöküp şortunu hızla indiriyor ve çoktan taş gibi olmuş yarağını yalamaya başlıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:90
translate turkish D_jannet_maecenas_monument_park_e09bd64a:

    jannet "Mhm.... Bu çok tatlı..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:91
translate turkish D_jannet_maecenas_monument_park_599946ce:

    jannet "Öyle değil mi diyorsun?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:92
translate turkish D_jannet_maecenas_monument_park_ead319f3:

    jannet "Mmmwah..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:95
translate turkish D_jannet_maecenas_monument_park_6e44b798:

    "Jannet yarağını emiyor, hepsini rahatça ağzına sığdırıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:96
translate turkish D_jannet_maecenas_monument_park_73a2dc2a:

    "Alttaki o olsa da, avının üstüne çullanmış bir avcıya benziyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:97
translate turkish D_jannet_maecenas_monument_park_8db5c65e:

    "Ona yukarıdan, baskın bir konumdan baksan da kıpırdayamıyorsun bile."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:98
translate turkish D_jannet_maecenas_monument_park_2e8b8b8e:

    "Jannet'in sana yaptıklarını seviyorsun ama durumun üzerinde hiçbir kontrolün yok."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:99
translate turkish D_jannet_maecenas_monument_park_49278eb2:

    "Jannet'in ustalıklı tekniğini yaşarken titremeden edemiyorsun."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:102
translate turkish D_jannet_maecenas_monument_park_0c2bc816:

    "Zevk almaya başladığın anda, Jannet'in iki parmağının anüsüne girdiğini hissediyorsun."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:103
translate turkish D_jannet_maecenas_monument_park_0d4ba0ec:

    jannet "Böyle... Değil mi?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:104
translate turkish D_jannet_maecenas_monument_park_6f59a814:

    jannet "Hoşuna gidiyor mu? Femboy..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:105
translate turkish D_jannet_maecenas_monument_park_dbe790c1:

    "Jannet eliyle kıçında çok hızlı hareketler yapmaya başlıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:108
translate turkish D_jannet_maecenas_monument_park_0f42ca89:

    "Diğer eliyle Jannet yarağını dipten sıkıca kavrıyor, taşaklarını sıkıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:109
translate turkish D_jannet_maecenas_monument_park_63656354:

    jannet "Evet... Mm..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:110
translate turkish D_jannet_maecenas_monument_park_e44dac8f:

    jannet "Tabii ki hoşuna gidiyor..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:111
translate turkish D_jannet_maecenas_monument_park_e09463d0:

    "Yarağın hiç olmadığı kadar sert gibi."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:112
translate turkish D_jannet_maecenas_monument_park_b0ec83ed:

    jannet "Görünüşe göre her an boşalmaya hazırsın..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:113
translate turkish D_jannet_maecenas_monument_park_eaa0b2a0:

    jannet "Sadece kıçını parmaklamamdan..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:114
translate turkish D_jannet_maecenas_monument_park_e2fb5954:

    "Durmaksızın seni delmeye devam ederken, Jannet seni boşaltmakta hiç zorlanmıyor."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:119
translate turkish D_jannet_maecenas_monument_park_c3ee0977:

    "Şu an yarağına dokunmuyor bile olsa, Jannet'in yüzüne çok şiddetli boşalıyorsun."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:120
translate turkish D_jannet_maecenas_monument_park_9eef2a5a:

    "Jannet'in yüzünde bir gülümseme beliriyor. Kendinden çok memnun görünüyor..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:121
translate turkish D_jannet_maecenas_monument_park_90110321:

    jannet "Mm... Austie..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:122
translate turkish D_jannet_maecenas_monument_park_2206c6b5:

    jannet "Sen gerçekten bir şeysin, hi-hi..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:123
translate turkish D_jannet_maecenas_monument_park_3eacc38c:

    "Jannet'in yoğun tavrı bir anda kayboluyor, sanki az önce önünde bir rol yapıyormuş gibi."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:124
translate turkish D_jannet_maecenas_monument_park_35a2b013:

    "Görünüşe göre her şeyin nasıl biteceğini tam olarak biliyormuş."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:125
translate turkish D_jannet_maecenas_monument_park_5c6dcfea:

    jannet "Çok mutluyum... Ah..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:126
translate turkish D_jannet_maecenas_monument_park_63a37a20:

    "Diyor Jannet, tamamen spermine bulanmış halde."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:127
translate turkish D_jannet_maecenas_monument_park_9d135ddc:

    jannet "Çok şükür mendil taşıyorum."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:128
translate turkish D_jannet_maecenas_monument_park_23606add:

    jannet "Yoksa hepsini üzerimden yalatırdım..."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:129
translate turkish D_jannet_maecenas_monument_park_8e13d6fd:

    player "N-ne?"

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:130
translate turkish D_jannet_maecenas_monument_park_4cdbaa49:

    jannet "Ha-ha. Rahat ol."

# game/scripts/sequences/0100/maecenas_monument/dialogues.rpy:131
translate turkish D_jannet_maecenas_monument_park_1deb3143:

    jannet "Sadece şaka yapıyorum."

