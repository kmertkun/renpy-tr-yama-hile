# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:22
translate turkish D_kim_cs_lesson_01_2d1fe84c:

    "Sınıfa girdiğinde her şey yerine oturuyor."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:23
translate turkish D_kim_cs_lesson_01_f58f64c5:

    "Okulunuzun bilgisayar öğretmeni bir femboy!"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:24
translate turkish D_kim_cs_lesson_01_18ceb772:

    "Şirin ve çok seksi görünen bir uzman."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:25
translate turkish D_kim_cs_lesson_01_e77ec1c1:

    player "{i}Programcı çorapları bile giymiş!{/i}"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:26
translate turkish D_kim_cs_lesson_01_678a1ef6:

    "Diye düşündün şaşkınlıkla."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:27
translate turkish D_kim_cs_lesson_01_91685f3f:

    player "{i}Gerçekten işe yarıyorlar mı?{/i}"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:28
translate turkish D_kim_cs_lesson_01_243f21eb:

    "Yaklaşıyorsun ve Kim hemen dikkatini sana veriyor."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:32
translate turkish D_kim_cs_lesson_01_a41521a5:

    kim "Oh, Austyn. Kimlik tanımlaman için tebrikler."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:33
translate turkish D_kim_cs_lesson_01_94b676fe:

    kim "Bu senin için birçok soruyu aydınlatmış olmalı?"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:34
translate turkish D_kim_cs_lesson_01_8c03ee1b:

    player "T-teşekkürler, evet... Artık düşünecek biraz daha az şey var..."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:35
translate turkish D_kim_cs_lesson_01_244deb95:

    kim "Bunu duymak güzel. Bu, sonunda aklını başına alacağın anlamına mı geliyor?"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:36
translate turkish D_kim_cs_lesson_01_b17ad927:

    player "{i}Hâlâ nasıl okuldan atılmadığım hakkında hiçbir fikrim yok.{/i}"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:37
translate turkish D_kim_cs_lesson_01_92b9602c:

    kim "Artık sana eskisi gibi göz yummayacağım."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:38
translate turkish D_kim_cs_lesson_01_0b6d39fd:

    kim "Senin için hiç sorun olmadığının gayet farkındayım. Ama herkes beni vazgeçirip durdu..."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:39
translate turkish D_kim_cs_lesson_01_470740ed:

    extend "Ciddi eğitim önlemleri almaktan."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:40
translate turkish D_kim_cs_lesson_01_370c3c42:

    "Kim'in masum ve narin imajı gözünün önünde parçalanıyor ve sırtında soğuk terden başka bir şey bırakmıyor."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:41
translate turkish D_kim_cs_lesson_01_5330c28e:

    kim "Bununla birlikte, lütfen öğren ve sana söylediğim her şeyi özümse."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:42
translate turkish D_kim_cs_lesson_01_8473f518:

    player "E-evet... Deneyeceğim."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:43
translate turkish D_kim_cs_lesson_01_4d8ed130:

    kim "Bu bir öneri değil, Ahududu. Bu bir emir."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:44
translate turkish D_kim_cs_lesson_01_380da7cd:

    kim "Çalışmak zorundasın."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:50
translate turkish D_kim_cs_lesson_01_22a4c18f:

    "Okulun kötü olmasının sadece Scarlett yüzünden olduğunu sanıyordun. Ama şimdi her sınıfta tehdit ediliyor gibisin."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:51
translate turkish D_kim_cs_lesson_01_2966ea6e:

    "Herkes seni şu ya da bu şekilde tehdit ediyor ama kimse belirli bir şeyden bahsetmiyor."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:52
translate turkish D_kim_cs_lesson_01_2df698af:

    "Yerine oturuyor ve ders çalışmaya başlamak için kendini topluyorsun."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:53
translate turkish D_kim_cs_lesson_01_8950d26a:

    "Uzaktan bakınca Kim'in imajı gözünde biraz silikleşmeye başladı."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:54
translate turkish D_kim_cs_lesson_01_cbce651b:

    "Çoraplar gözboyamadan başka bir şey değil. Bütün resmi gördüğünde, kandırılmana izin vermezsin."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:55
translate turkish D_kim_cs_lesson_01_b5aa0f4e:

    "Aslında Kim oldukça sönük görünüyor. Sade hırka, inek gözlük."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:56
translate turkish D_kim_cs_lesson_01_b248ddc6:

    "Kendi evrenine benzeterek bakınca, aslında aynı gülünç kombinasyonu görüyorsun."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:57
translate turkish D_kim_cs_lesson_01_22d251f5:

    "Aslında çorap olmasına rağmen ayaklarında sandaletle giydiği aynı çoraplar."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:58
translate turkish D_kim_cs_lesson_01_372e8101:

    player "{i}Neden herkes onu bu kadar seviyor ki?{/i}"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:59
translate turkish D_kim_cs_lesson_01_8cb776ea:

    "Merak etmeden duramıyorsun."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:60
translate turkish D_kim_cs_lesson_01_f021172d:

    "Ama Kim gözlüğünü takıp dersi başlattığı anda, her şey sana açıklığa kavuştu."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:63
translate turkish D_kim_cs_lesson_01_e9a7ff77:

    "Hızla masaya çıktı ve düzgün küçük bacakları sana başarısının sırrını verdi."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:64
translate turkish D_kim_cs_lesson_01_42fb8131:

    kim "Evet kediciklerim, bugün python veri tiplerini öğreneceğiz."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:65
translate turkish D_kim_cs_lesson_01_c13ff428:

    kim "Kaç tane olduklarını kim söyleyebilir?"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:66
translate turkish D_kim_cs_lesson_01_4da3f4b8:

    player "Aman tanrım, bu bir ders değil. Bu tam bir fanservice içeriği!"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:69
translate turkish D_kim_cs_lesson_01_9d622fa9:

    kim "Hadi ama, kimse yok mu?"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:70
translate turkish D_kim_cs_lesson_01_18a1029c:

    kim "Biraz yardımcı olayım. Elimizde... Satırlar var..."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:71
translate turkish D_kim_cs_lesson_01_4bae5879:

    kim "Stringlere benzeyen başka ne var?"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:72
translate turkish D_kim_cs_lesson_01_c99c8b4d:

    "Şirinlikle parmaklarıyla saymaya başlıyor."

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:73
translate turkish D_kim_cs_lesson_01_b5c54124:

    kim "Evet! Doğru, aferin sana! Tabii ki sayılar. Başka var mı?"

# game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:76
translate turkish D_kim_cs_lesson_01_b6fdcaa5:

    player "{i}Bu derslerden nasıl kaçırdım?!{/i}"

translate turkish strings:

    # game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:6
    old "You decide to go to your computer science class."
    new "Bilgisayar bilimi dersine gitmeye karar veriyorsun."

    # game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:9
    old "You’ve never felt any particular love towards computers. But you’ve heard that this teacher’s classes are the most attended."
    new "Bilgisayarlara hiç özel bir sevgi duymadın. Ama bu öğretmenin derslerinin en çok katılımlı olduğunu duydun."

    # game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:12
    old "Being overwhelmed with curiosity, you can’t help but try to attend a lesson."
    new "Merakla dolup taşarak bir derse katılmayı denemeden duramıyorsun."

    # game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:15
    old "At least once."
    new "En azından bir kez."

    # game/scripts/sequences/0100/cs_lesson_1/dialogues.rpy:79
    old "You sat there soaking up all the knowledge leaving nothing left."
    new "Oraya oturup tüm bilgiyi hiçbir şey bırakmayacak şekilde özümsedin."

