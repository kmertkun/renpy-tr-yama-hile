# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:10
translate turkish D_scarlett_getting_close_to_scarlett_9e583bb0:

    player "Yaklaşık öyle. Ama göründüğü kadar korkutucu değil..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:11
translate turkish D_scarlett_getting_close_to_scarlett_89d6538b:

    trish "Ben sınava internetteki materyalleri kullanarak kendi kendime hazırlanmaya karar verdim."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:12
translate turkish D_scarlett_getting_close_to_scarlett_7bda1494:

    player "Kötü bir fikir olduğunu duydum..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:13
translate turkish D_scarlett_getting_close_to_scarlett_ac4f8b1c:

    trish "Haha, bakalım... İyi not beklemiyorum, sadece geçmek istiyorum."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:14
translate turkish D_scarlett_getting_close_to_scarlett_b003ecf7:

    player "Sen bilirsin Trish, yeter ki bir şekilde geç."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:15
translate turkish D_scarlett_getting_close_to_scarlett_1b6920e9:

    trish "Bu arada, Scarlett'la olan ilişkin hakkında."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:16
translate turkish D_scarlett_getting_close_to_scarlett_0315673d:

    trish "Onun hakkında bir şeyler öğrenmeyi başardım... ama ne kadar doğru bilmiyorum."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:17
translate turkish D_scarlett_getting_close_to_scarlett_19331fa8:

    trish "Scarlett senin hakkında çok aktif şekilde bilgi topluyor."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:18
translate turkish D_scarlett_getting_close_to_scarlett_f92bf7f7:

    player "K-kim söyledi sana bunu?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:19
translate turkish D_scarlett_getting_close_to_scarlett_797da454:

    trish "Ö-önemli değil... Sadece bana güven. Boşuna değil."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:20
translate turkish D_scarlett_getting_close_to_scarlett_174aef5c:

    trish "Başka hiç kimseye sana davrandığı gibi davranmıyor."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:21
translate turkish D_scarlett_getting_close_to_scarlett_04e9eda1:

    trish "Onları soydurmuyor, aşağılamıyor... öyle bir şey yok."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:22
translate turkish D_scarlett_getting_close_to_scarlett_f750b280:

    player "Trish, söyle bana, bunu nereden biliyorsun?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:23
translate turkish D_scarlett_getting_close_to_scarlett_9ca198a8:

    trish "Ben... Söylemek isterdim ama ben de bilmiyorum."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:24
translate turkish D_scarlett_getting_close_to_scarlett_c2d74f20:

    player "Ne demek istiyorsun?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:25
translate turkish D_scarlett_getting_close_to_scarlett_59cf5d09:

    trish "Mesele şu ki, anonim bir e-postaydı."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:26
translate turkish D_scarlett_getting_close_to_scarlett_84a81901:

    trish "Ama çok spesifik, o yüzden görmezden gelemiyorum."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:27
translate turkish D_scarlett_getting_close_to_scarlett_43546f66:

    trish "Kim bana böyle kişisel şeyler yazmayı düşünür ki.."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:28
translate turkish D_scarlett_getting_close_to_scarlett_c876a09f:

    player "Ayrıca özellikle sana yazmaları çok garip."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:29
translate turkish D_scarlett_getting_close_to_scarlett_bab9e67c:

    trish "E-evet... bu da garip."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:30
translate turkish D_scarlett_getting_close_to_scarlett_959261c7:

    trish "Ah, bütün bunlar beni gerçekten korkutuyor... hadi derse gidelim Austyn."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:37
translate turkish D_scarlett_getting_close_to_scarlett_0b2e5bc8:

    trish "Kendine dikkat et Austyn."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:40
translate turkish D_scarlett_getting_close_to_scarlett_705708e1:

    trish "Neler olduğunu bilmiyorum ama umarım korkacak bir şeyin yoktur."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:49
translate turkish D_scarlett_getting_close_to_scarlett_f5043d45:

    player "Merhaba, Mistress Scarlett."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:50
translate turkish D_scarlett_getting_close_to_scarlett_8f9b0ef6:

    player "{i}Hemen önünde soyunmalıyım... etki bırakmak için.{/i}"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:54
translate turkish D_scarlett_getting_close_to_scarlett_cc02354a:

    "Hemen soyunmaya başlıyorsun."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:55
translate turkish D_scarlett_getting_close_to_scarlett_4e25493e:

    "Artık onun yanında utanmıyorsun ve bunalmış hissetmiyorsun."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:57
translate turkish D_scarlett_getting_close_to_scarlett_a43d85d2:

    scarlett "Ne takdire şayan. Bunu benim talimatım olmadan yapmayı öğrenmişsin."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:58
translate turkish D_scarlett_getting_close_to_scarlett_ddd48153:

    player "Hepsi çok iyi bir öğretmenim olduğu için, Mistress Scarlett."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:59
translate turkish D_scarlett_getting_close_to_scarlett_a08c6ea5:

    scarlett "Hm... Teşekkürler Austyn. Anlayışlı biriyle muhatap olmak çok hoş."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:60
translate turkish D_scarlett_getting_close_to_scarlett_e93d49ae:

    scarlett "James'le dersleriniz nasıl gidiyor?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:61
translate turkish D_scarlett_getting_close_to_scarlett_ed297b73:

    player "H-harika... James çok iyi bir öğretmen."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:62
translate turkish D_scarlett_getting_close_to_scarlett_01b4e0db:

    scarlett "Öyle mi? Bunu duymak ne güzel."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:63
translate turkish D_scarlett_getting_close_to_scarlett_a38ff865:

    scarlett "James de senden çok övgüyle bahsetti."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:64
translate turkish D_scarlett_getting_close_to_scarlett_9fdb87ae:

    scarlett "Konuyu çok iyi kavradığını söylüyor."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:65
translate turkish D_scarlett_getting_close_to_scarlett_03245789:

    player "Evet, doğru. Onun derslerine katılmaya devam edeceğim."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:66
translate turkish D_scarlett_getting_close_to_scarlett_9af7bba4:

    scarlett "Haklı olarak. Bu arada, son görüşmemiz hakkında..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:67
translate turkish D_scarlett_getting_close_to_scarlett_e258192d:

    scarlett "Seni ofisimi temizlemeye zorlamamalıydım."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:68
translate turkish D_scarlett_getting_close_to_scarlett_e30f1b94:

    scarlett "Biri fark etti ve beni uyardı."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:69
translate turkish D_scarlett_getting_close_to_scarlett_eb3129cd:

    scarlett "Öğrencilerin emeğini sömürmek kurallara uygun değil."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:70
translate turkish D_scarlett_getting_close_to_scarlett_7bb887d4:

    scarlett "Anlaşılan sana bunun karşılığını ödemem gerekiyor."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:71
translate turkish D_scarlett_getting_close_to_scarlett_07b13ed8:

    player "Lütfen..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:72
translate turkish D_scarlett_getting_close_to_scarlett_1eb0cbfb:

    scarlett "Özür dilemene gerek yok, Austyn."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:73
translate turkish D_scarlett_getting_close_to_scarlett_ddc0642f:

    scarlett "Genel olarak, bu bana sana yarı zamanlı bir iş teklif etme fikrini verdi."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:74
translate turkish D_scarlett_getting_close_to_scarlett_772af3bf:

    scarlett "Öğretmen asistanı olmaya ne dersin?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:75
translate turkish D_scarlett_getting_close_to_scarlett_8d2acd68:

    player "Asistan mı? Lütfen açıklayın."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:76
translate turkish D_scarlett_getting_close_to_scarlett_d4bd8d7d:

    scarlett "Genel olarak işin, işim dışında hiçbir şey için endişelenmememi sağlamak."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:77
translate turkish D_scarlett_getting_close_to_scarlett_ef475577:

    scarlett "Faaliyetlerim okuldaki basit öğretmenliğin çok ötesine geçtiği için, ilgilenen insanlarla konuşmak, makalelerim üzerinde çalışmak gibi birçok başka sorumluluğum var."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:78
translate turkish D_scarlett_getting_close_to_scarlett_d9750fdf:

    player "Yani... ben sizin hizmetkârınız mı olacağım?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:79
translate turkish D_scarlett_getting_close_to_scarlett_80bbf4d9:

    scarlett "Hayır, burada o terimi kullanmıyoruz. Buna asistan denir."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:80
translate turkish D_scarlett_getting_close_to_scarlett_29518dc5:

    scarlett "Ofiste düzeni sağlamaktan, telefonlara bakmaktan, kâğıtlarımı dijitalleştirmekten sorumlu olacaksın..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:81
translate turkish D_scarlett_getting_close_to_scarlett_831d0b0a:

    scarlett "Yeteneklerin genel olarak işe yarayabilir."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:82
translate turkish D_scarlett_getting_close_to_scarlett_9413c6f0:

    player "Ama... ben pek özel bir şey yapmayı bilmiyorum..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:83
translate turkish D_scarlett_getting_close_to_scarlett_fbe3e4a4:

    scarlett "Alçakgönüllülük yapma Austyn. Sende istisnai bir şey var."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:84
translate turkish D_scarlett_getting_close_to_scarlett_44406478:

    scarlett "Sen, herkesten daha çok, yeni ve alışılmadık her şeye açıksın."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:92
translate turkish D_scarlett_getting_close_to_scarlett_8ccdfee4:

    scarlett "Açık konuşacağım. Beni sana çok çekiyor, Austyn."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:93
translate turkish D_scarlett_getting_close_to_scarlett_2d16bbea:

    scarlett "Sende... diğer öğrencilerde görmediğim bir şey var."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:94
translate turkish D_scarlett_getting_close_to_scarlett_9c76b888:

    player "{i}Ondan böyle hoş şeyler duyabileceğimi hiç düşünmemiştim.{/i}"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:95
translate turkish D_scarlett_getting_close_to_scarlett_dc38759f:

    player "Oh... Ben... Asistanınız olmaktan onur duyarım, Mistress Scarlett."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:96
translate turkish D_scarlett_getting_close_to_scarlett_59def97d:

    scarlett "Bunu duyduğuma sevindim. Parasının yanı sıra asistan olarak paha biçilmez bir deneyim de kazanacağını belirtmek isterim. Bir anlamda çok şanslısın."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:97
translate turkish D_scarlett_getting_close_to_scarlett_bf8d59f7:

    scarlett "Hafta içi dersten sonra seni görmeyi dört gözle bekliyor olacağım."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:108
translate turkish D_scarlett_getting_close_to_scarlett_6dbe4d5c:

    player "Trish? Sen... Beni mi bekliyordun?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:109
translate turkish D_scarlett_getting_close_to_scarlett_051fe483:

    trish "Tabii ki! Senin için gerçekten endişelendim! Nasıl geçti?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:110
translate turkish D_scarlett_getting_close_to_scarlett_2b366bbb:

    player "İyi geçmiş gibi... Endişelenmeye değecek bir şey olduğunu sanmıyorum."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:111
translate turkish D_scarlett_getting_close_to_scarlett_c897db56:

    trish "Ah, çok sevindim. Bu sefer ne konuştunuz?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:112
translate turkish D_scarlett_getting_close_to_scarlett_8cd70119:

    player "Ah, Mistress Scarlett akademik başarımı fark etti ve bana... asistanı olmayı teklif etti."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:113
translate turkish D_scarlett_getting_close_to_scarlett_800757b4:

    trish "Asistan mı? Vay, bu bir şey. Gerçekten şanslısın Austyn."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:114
translate turkish D_scarlett_getting_close_to_scarlett_43bd9fa6:

    trish "Bilimsel araştırmacıların asistanlarına gelecekte tanınan bir sürü ayrıcalık duydum!"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:115
translate turkish D_scarlett_getting_close_to_scarlett_b38b0b41:

    trish "Biraz kıskandım bile, gerçi ben o yola girmeyi planlamıyorum."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:116
translate turkish D_scarlett_getting_close_to_scarlett_023dd9bb:

    player "Ah, hadi ama, Mistress Scarlett'ın asistanı olmaktan hoşlanacağını sanmıyorum..."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:117
translate turkish D_scarlett_getting_close_to_scarlett_e626b137:

    trish "Evet, sen buna çok daha uygunsun. Onun adını Mistress olduğunu söylemeden bile anamıyorsun... Haha."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:118
translate turkish D_scarlett_getting_close_to_scarlett_7663728e:

    player "Ah... y-yani... alıştım, evet."

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:119
translate turkish D_scarlett_getting_close_to_scarlett_e94e356e:

    trish "Bu arada... seni şimdiden özledim. Bu gece bana gelir misin...?"

# game/scripts/sequences/scarlett_lessons/getting_close_to_scarlett.rpy:120
translate turkish D_scarlett_getting_close_to_scarlett_b08704b2:

    player "E-evet, tabii Trish..."

