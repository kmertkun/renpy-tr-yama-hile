# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:3
translate turkish D_library_investigation_04_ac363a48:

    "Kütüphaneye geldin ve şaşırtıcı bir şeyle karşılaştın."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:4
translate turkish D_library_investigation_04_5e77edf9:

    "Patricia bir kereliğine yerindeydi. Sanki bunca zaman sessizce oturup seni bekliyormuş gibi."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:5
translate turkish D_library_investigation_04_b82de340:

    patricia "Selam, Austin. Hazır mısın, başka bir kitap alalım mı?"

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:6
translate turkish D_library_investigation_04_9be86d9d:

    player "E-evet, gidelim..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:17
translate turkish D_library_investigation_04_b483e7d6:

    "Patricia başka bir kitabı senin adına kaydediyor."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:18
translate turkish D_library_investigation_04_46f13a58:

    patricia "Peki, hazır mısın? Ah, heyecandan kendimi alamıyorum bile..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:19
translate turkish D_library_investigation_04_f5ee67ab:

    player "Evet, tabii ki... Hatırladığım kadarıyla bu sefer özel bir şey vaat etmiştin."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:20
translate turkish D_library_investigation_04_ac6fd886:

    patricia "Ah evet! Ama bu sefer burada, kütüphane salonunda yapamayız."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:21
translate turkish D_library_investigation_04_a1e75529:

    patricia "Benimle küçük depoma gel!"

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:28
translate turkish D_library_investigation_04_33636593:

    "Bir tür dinlenme odasına benziyor. Oldukça rahat döşenmiş."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:29
translate turkish D_library_investigation_04_4216a0a1:

    "Patricia bu odayı kendi odası yapmak için uzun zaman harcamış gibi görünüyor, sanki burada yaşıyor."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:31
translate turkish D_library_investigation_04_930fce10:

    patricia "Rahatına bak, birazdan başlıyoruz."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:33
translate turkish D_library_investigation_04_48d376ad:

    "Ortam çok davetkârdı."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:34
translate turkish D_library_investigation_04_175e0f23:

    "Oda hoş bir tütsü kokuyordu, güneş ışığı yastıklardaki işlemeli desenlere yumuşakça düşüyordu."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:35
translate turkish D_library_investigation_04_4b5cb781:

    "Sonuç olarak, Patricia için poz vermenin de aynı derecede keyifli olacağı izlenimine kapılıyorsun."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:36
translate turkish D_library_investigation_04_ea17c55d:

    "Huzur ve sükûneti, Patricia'nın harika fikriyle geri dönmesi bozdu."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:39
translate turkish D_library_investigation_04_f7c1ab89:

    "Elinde büyük bir lastik dildoyla odaya girdi."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:40
translate turkish D_library_investigation_04_5eeef72f:

    patricia "Gördüğün eskizi yeniden yaratmak istedim ama daha canlı bir şekilde..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:41
translate turkish D_library_investigation_04_0493bf86:

    player "Öyle mi?"

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:42
translate turkish D_library_investigation_04_6aedec83:

    patricia "Fantezilerimin canlandığını görmek istiyorum, Austin."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:43
translate turkish D_library_investigation_04_652a7222:

    player "Peki... Madem kabul ettim..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:44
translate turkish D_library_investigation_04_054a4c2c:

    patricia "Teşekkürler! Şimdi..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:45
translate turkish D_library_investigation_04_244bd98b:

    patricia "Bu dildoyu duvara sabitleyeceğim ve..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:46
translate turkish D_library_investigation_04_e9b79e00:

    patricia "Senden oturup burnunu başına bastırmanı isteyeceğim... Olur mu?"

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:47
translate turkish D_library_investigation_04_1de949a5:

    player "E-evet, sen nasıl dersen..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:50
translate turkish D_library_investigation_04_9af36ec3:

    "Patricia'nın dediğini yapıyorsun."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:51
translate turkish D_library_investigation_04_4e1c39ef:

    "Lastik dildonun görüntüsü seni hiç korkutmuyor, ne kadar büyük olursa olsun."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:52
translate turkish D_library_investigation_04_50258e35:

    "Yine de tanımadığın koşullardasın."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:53
translate turkish D_library_investigation_04_b4072499:

    "Ne de olsa buraya Mirina'yla yaptığın gibi ağzını eğitmeye gelmedin."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:54
translate turkish D_library_investigation_04_85c70eff:

    "Tek izleyicine yan gözle bakmaya çalıştıkça Patricia seni düzeltiyor."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:55
translate turkish D_library_investigation_04_56fd9347:

    "Senden sadece yukarı bakmanı istiyor. Sanki bu dildonun bir sahibi varmış gibi."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:56
translate turkish D_library_investigation_04_a886c375:

    "Yaklaşık on dakika hareketsiz kaldıktan sonra Patricia duruyor ve yardımın için teşekkür ediyor."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:61
translate turkish D_library_investigation_04_917e7253:

    patricia "Ah, sabrın için çok teşekkürler..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:62
translate turkish D_library_investigation_04_b95c97d5:

    "Patricia'nın sesinde hafif bir hoşnutsuzluk hissediyorsun."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:64
translate turkish D_library_investigation_04_6a9ce9e5:

    player "Bir sorun mu var?"

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:66
translate turkish D_library_investigation_04_55acc10e:

    patricia "Sorun yok, Austin... Sadece... Tamamen tatmin olmam için hâlâ bir şeyin eksik olduğunu hissediyorum..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:68
translate turkish D_library_investigation_04_599b4fb7:

    "Patricia'ya yardım edebileceğini hissediyorsun, bu yüzden bazı kolay tavizler veriyorsun."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:70
translate turkish D_library_investigation_04_8327505e:

    player "İstersen bir dahaki sefere yine yardım edebilirim..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:72
translate turkish D_library_investigation_04_d08a3589:

    patricia "Gerçekten mi? Ah, bu benim için çok şey ifade ediyor, Austin!"

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:73
translate turkish D_library_investigation_04_15a6baa2:

    patricia "Eksikleri düzeltmek için bir dahaki sefere bir şeyler bulmaya çalışacağım..."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:74
translate turkish D_library_investigation_04_5833ab86:

    "Patricia'yı kitabınla bir kez daha bırakıyorsun."

# game/scripts/sequences/370/library_investigation_04/dialogues.rpy:75
translate turkish D_library_investigation_04_3a168174:

    "Umarım ihtiyacın olan kitaptır."

translate turkish strings:

    # game/scripts/sequences/370/library_investigation_04/dialogues.rpy:24
    old "You step over the threshold into the staff room."
    new "Personel odasının eşiğinden geçiyorsun."

