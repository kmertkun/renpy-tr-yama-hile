# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:3
translate turkish D_library_investigation_02_27aaf5a9:

    "Bilgi arayışında şansını denemek için kütüphaneyi bir kez daha ziyaret ediyorsun."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:6
translate turkish D_library_investigation_02_dcf7b12b:

    "Danışma masasına yaklaştığında Patricia'yı yerinde bulamıyorsun."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:9
translate turkish D_library_investigation_02_a7feab02:

    "Seslenmeden önce biraz beklemeye ve masasının çevresine bakmaya karar veriyorsun."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:10
translate turkish D_library_investigation_02_3a72fe1b:

    "Açık bir kitabın içine sıkıştırılmış, ilginç çizimler olan bir kağıt parçası buluyorsun kolayca."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:13
translate turkish D_library_investigation_02_a55193da:

    "Çoğu farklı kıçların eskizleri."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:14
translate turkish D_library_investigation_02_0497272d:

    "Büyük, sulu femboy kıçları. Hepsinin üzerindeki küçük penislerden anlaşılıyor."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:15
translate turkish D_library_investigation_02_790bf958:

    "Sayfalardan birinde acı verici derecede tanıdık bir sahne görüyorsun. Küçük bir çizgi roman."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:16
translate turkish D_library_investigation_02_92568dab:

    "Bir femboy kütüphanede kitap arıyor. Ve çizimdeki sevimli bir kızın tavsiyesinden sonra, onun önünde kışkırtıcı bir şekilde eğiliyor."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:17
translate turkish D_library_investigation_02_1fc9ea96:

    player "Beni mi çizmiş?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:18
translate turkish D_library_investigation_02_76f56c02:

    "Yaklaşan ayak sesleri duyuyorsun ve her şeyi hızla eski haline koyuyorsun."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:19
translate turkish D_library_investigation_02_da1d1d3c:

    "Patricia bu. Sonunda yerine dönmeye karar vermiş gibi."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:24
translate turkish D_library_investigation_02_761765aa:

    patricia "Aa, Austin. Seni görmek güzel..."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:25
translate turkish D_library_investigation_02_25e49b50:

    player "Selam..."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:26
translate turkish D_library_investigation_02_1553998f:

    patricia "Yine kitap için mi geldin?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:27
translate turkish D_library_investigation_02_72057461:

    player "Evet, yine tarih için..."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:28
translate turkish D_library_investigation_02_2437e607:

    patricia "Evet, hatırlıyorum, Bayan Scarlett'la sınavın var. Hadi, seni rafa götüreyim."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:31
translate turkish D_library_investigation_02_e9c3d252:

    "Tek başına da halledebilirdin ama Patricia bilerek seninle daha fazla vakit geçirmek istiyor."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:40
translate turkish D_library_investigation_02_d039e1bd:

    "Patricia seni, kitabı senin adına kaydetmek için yeniden danışma masasına götürüyor."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:41
translate turkish D_library_investigation_02_0a7cdd9d:

    patricia "Austin... Senden bir iyilik istesem kaba olur mu?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:42
translate turkish D_library_investigation_02_2178a63c:

    player "Evet?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:43
translate turkish D_library_investigation_02_e843cdfd:

    patricia "Senden... burada, kütüphanede okumanı isteyebilir miyim?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:48
translate turkish D_library_investigation_02_e909c1bb:

    player "Ama bu kurallara aykırı. Bunu kendin söyledin."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:49
translate turkish D_library_investigation_02_06b3c31c:

    patricia "Evet, biliyorum, ama mesele sadece senin burada okuman değil."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:50
translate turkish D_library_investigation_02_ee368e54:

    patricia "Seni... çizmek istiyorum."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:52
translate turkish D_library_investigation_02_ea86223b:

    player "Ah, çok tatlısın, Patricia, a-ama..."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:54
translate turkish D_library_investigation_02_9962bf40:

    patricia "Lütfen, benim için çok önemli."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:56
translate turkish D_library_investigation_02_4c31a8da:

    player "Belki sadece fotoğrafını çekebilirsin?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:57
translate turkish D_library_investigation_02_c71d5e69:

    patricia "Hayır, hiç aynısı değil. Canlı modelden çizmek çok önemli, Austin."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:59
translate turkish D_library_investigation_02_cbba7fc8:

    patricia "Fotoğrafla hacmi ve ışığı yakalayamazsın, anlıyor musun?"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:61
translate turkish D_library_investigation_02_48684320:

    player "{i}Hafızası kıçımı çizmesine engel olmamış, ne komik...{/i}"

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:62
translate turkish D_library_investigation_02_579ee447:

    player "Tamam, peki..."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:65
translate turkish D_library_investigation_02_24f9d03d:

    "Senden pencerenin yanındaki masada hareketsiz oturmanı istedi."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:66
translate turkish D_library_investigation_02_c97bb16c:

    "Okumaya hiç odaklanamadın, çünkü dudaklarının hareketi bile dikkatini dağıtıyordu."

# game/scripts/sequences/370/library_investigation_02/dialogues.rpy:67
translate turkish D_library_investigation_02_a8b8470d:

    "Günün bir kısmını kütüphanede sessizce geçirdin, sonra hiçbir şey olmamış gibi ayrıldınız."

