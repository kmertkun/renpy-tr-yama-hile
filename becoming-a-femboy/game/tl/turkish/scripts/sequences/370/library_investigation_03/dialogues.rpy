# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:3
translate turkish D_library_investigation_03_f804a7cf:

    "Kütüphaneye varıyorsun ve yine alışılmış manzarayla karşılaşıyorsun."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:6
translate turkish D_library_investigation_03_c56686d1:

    "Her zamanki gibi yerinde değil."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:7
translate turkish D_library_investigation_03_aec9f559:

    player "{i}Ah, hep mi yok burada?{/i}"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:10
translate turkish D_library_investigation_03_d10728b3:

    "İzinsiz masasını karıştırdığın için artık suçluluk bile hissetmiyorsun."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:11
translate turkish D_library_investigation_03_c2ce78ca:

    "Onu beklerken bu sefer ne çizdiğine bir kez daha göz atmaya karar veriyorsun."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:14
translate turkish D_library_investigation_03_99586caa:

    "Bir çizgi roman daha. Ama bu sefer daha \"etkileyici\"."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:15
translate turkish D_library_investigation_03_7cde08de:

    "Kendinin geçen seferki açıdan eskizlerini görüyorsun, ama küçük bir değişiklikle."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:16
translate turkish D_library_investigation_03_86bd8162:

    "Gerçi dikkatli bakarsan, değişiklik oldukça büyük."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:17
translate turkish D_library_investigation_03_de65bb83:

    "Önünde, yüzünün kocaman bir yarak tarafından doldurulduğu bir sürü varyasyon var."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:18
translate turkish D_library_investigation_03_4b4bb134:

    "Gördüğün şey seni kızartıyor. Burada fazla ayrıntılı çizilmiş."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:19
translate turkish D_library_investigation_03_49376404:

    "O kocaman yarağı ağzına ne kadar derin aldığının birçok varyasyonunu çizmeye zahmet etmiş."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:22
translate turkish D_library_investigation_03_99a62704:

    "O kadar uzun baktın ki Patricia seni hazırlıksız yakalamayı başardı."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:23
translate turkish D_library_investigation_03_91ad0940:

    patricia "Vay vay vay... Göz mü atıyorsun?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:24
translate turkish D_library_investigation_03_7c0a080e:

    player "B-bunda anlaşmamıştık..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:25
translate turkish D_library_investigation_03_d3447e33:

    patricia "Ne demek istiyorsun? Bir sorun mu var?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:26
translate turkish D_library_investigation_03_59e3a472:

    player "Ben... Böyle çizilmem için izin vermedim..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:27
translate turkish D_library_investigation_03_30926ae8:

    patricia "Ve bunun sen olduğunu nasıl kanıtlayacaksın?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:32
translate turkish D_library_investigation_03_b55c1a8c:

    player "Ciddi misin? Belli ki... Geçen sefer sana kelimenin tam anlamıyla poz verdim, şimdi ne görüyorum?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:33
translate turkish D_library_investigation_03_3bc4e84e:

    player "Daha önce eğilirken çizmiştin beni..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:35
translate turkish D_library_investigation_03_7f3aea11:

    patricia "Ah, yani geçen sefer de göz atmıştın demek?!"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:36
translate turkish D_library_investigation_03_68430455:

    player "Eşyalarını başıboş bırakmasan iyi olur! Üstelik her seferinde senin gelmeni burada beklemekten hoşlanmıyorum..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:38
translate turkish D_library_investigation_03_905e1d3a:

    patricia "Öyle mi..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:39
translate turkish D_library_investigation_03_88675fad:

    "Patricia aniden çöktü, başını eğdi."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:40
translate turkish D_library_investigation_03_16c646f8:

    patricia "H-hadi başka bir kitap alalım, Austin..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:53
translate turkish D_library_investigation_03_9932eab7:

    "Danışma masasına dönünce Patricia toparlandı ve şunu söyleyecek gücü buldu."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:54
translate turkish D_library_investigation_03_4cb319ed:

    patricia "S-sana önce sormalıydım... Özür dilerim..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:55
translate turkish D_library_investigation_03_50c799cf:

    player "Evet! Sormalıydın... Ah..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:56
translate turkish D_library_investigation_03_2e3f7bdb:

    patricia "Sadece çok tatlısın, çok yakışıklısın, ben... Kendimi alamadım..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:58
translate turkish D_library_investigation_03_191a2a85:

    player "N-ne?!"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:59
translate turkish D_library_investigation_03_869bdc82:

    patricia "Bu fantezileri kafamdan atamıyorum ve sadece... Kendimi tutamıyorum..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:61
translate turkish D_library_investigation_03_4aa2d63a:

    patricia "E-eğer böyle bir şey için doğrudan poz vermeni isteseydim, k-kabul eder miydin?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:62
translate turkish D_library_investigation_03_2a22afb1:

    player "Ah, buna neden ihtiyacın var? Gerçekten bu kadar önemli mi?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:63
translate turkish D_library_investigation_03_691ab402:

    patricia "Sadece biraz rahatlamaya çalışıyorum, tamam mı?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:65
translate turkish D_library_investigation_03_652e645f:

    patricia "Sıradan bir kütüphaneci olarak aklını korumanın ne kadar zor olduğunu bilirsin..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:67
translate turkish D_library_investigation_03_8f16f590:

    player "B-bu çizimleri satıyor musun?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:69
translate turkish D_library_investigation_03_9738b301:

    patricia "Evet... Çizgi roman çiziyorum, sipariş alıyorum... Ve anlaşılan... femboy çizmek bir altın madeni gibi..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:70
translate turkish D_library_investigation_03_e18078c3:

    player "Peki kaç tane böyle çizdin?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:71
translate turkish D_library_investigation_03_1026c2d5:

    patricia "Genelde referansları internetten alırdım, ama bu bir şekilde artık ilham vermiyordu..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:72
translate turkish D_library_investigation_03_4e6401ae:

    patricia "Şimdi sadece yoldan geçenleri çiziyorum... Ya da kütüphaneye gelen diğer ziyaretçileri."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:73
translate turkish D_library_investigation_03_3b67f3e1:

    patricia "Bozuk kafama gelen saçma plotları uyduruyorum sadece..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:74
translate turkish D_library_investigation_03_4b2a12d3:

    player "Mesela koca yarakları yutmak gibi mi?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:76
translate turkish D_library_investigation_03_c5c5e994:

    patricia "Evet! Harika değil mi? Evde dijitale çeviriyorum ve parlatıyorum!"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:78
translate turkish D_library_investigation_03_9a098f6c:

    player "Dur! Hayır, yapamazsın..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:80
translate turkish D_library_investigation_03_5de1a35c:

    patricia "Neden olmasın?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:82
translate turkish D_library_investigation_03_34ff3e17:

    player "Ah, burada beni tanımak çok kolay! Tanrım, Patricia. Yüzümün böyle ortalıkta dolaşmasını istemiyorum."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:83
translate turkish D_library_investigation_03_5a96342e:

    patricia "T-tamam... Tamam. Sana tanınmayacak bir görünüm bulalım..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:85
translate turkish D_library_investigation_03_ebccff0e:

    player "Saç. Kesinlikle rengini değiştirmelisin."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:87
translate turkish D_library_investigation_03_101eae45:

    patricia "Pembe nasıl olur?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:89
translate turkish D_library_investigation_03_62d06836:

    player "Evet, kulağa hoş geliyor... Bir de uzat..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:90
translate turkish D_library_investigation_03_5b2acb8a:

    patricia "Tamam, tamam... Çok uzun saç..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:91
translate turkish D_library_investigation_03_4a7163b1:

    player "Ve başka küçük bir detay konusunda da ısrarcı olurum..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:92
translate turkish D_library_investigation_03_091a032c:

    patricia "Ah, bir fikrim var..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:111
translate turkish D_library_investigation_03_b4648f13:

    "Çizimdeki bu femboy sana korkunç derecede birini hatırlatıyor."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:112
translate turkish D_library_investigation_03_6c371b08:

    "Hatta ana evrenine dair sıcak anıları bile canlandırıyor."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:113
translate turkish D_library_investigation_03_9334a558:

    "Ya da belki eve gerçekten özlem duyuyorsun."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:114
translate turkish D_library_investigation_03_459f24bc:

    patricia "Poz verme teklifim hâlâ geçerli mi?"

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:115
translate turkish D_library_investigation_03_f7035c04:

    player "Ah, neden olmasın..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:118
translate turkish D_library_investigation_03_855d9c00:

    "Patricia seni göğsüne bastırdı, sevgisiyle seni boğmak gibi samimi bir niyetle."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:119
translate turkish D_library_investigation_03_1f7a717b:

    patricia "Yaşasın! Teşekkürler, teşekkürler. Sen bir harikasın..."

# game/scripts/sequences/370/library_investigation_03/dialogues.rpy:120
translate turkish D_library_investigation_03_baf2dfc3:

    patricia "Sonraki seferler çok daha ilginç olacak, hehe."

translate turkish strings:

    # game/scripts/sequences/370/library_investigation_03/dialogues.rpy:95
    old "Patricia draws something very carefully, covering the final result from you with her hand."
    new "Patricia çok dikkatli bir şekilde bir şeyler çiziyor, son sonucu eliyle senden gizleyerek."

    # game/scripts/sequences/370/library_investigation_03/dialogues.rpy:99
    old "Seems another wave of inspiration hit her."
    new "Görünüşe göre ona bir ilham dalgası daha geldi."

    # game/scripts/sequences/370/library_investigation_03/dialogues.rpy:103
    old "Finishing erasing the pencil dust, she offered you to admire the final result."
    new "Kurşun kalem tozunu temizledikten sonra sana son sonucu hayranlıkla izlemeyi teklif etti."

    # game/scripts/sequences/370/library_investigation_03/dialogues.rpy:107
    old "You didn’t even expect to like it this much."
    new "Bu kadar beğeneceğini hiç beklemiyordun."

