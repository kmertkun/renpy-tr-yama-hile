# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:2
translate turkish D_library_investigation_01_trish_smalltalk_00ec65e4:

    "Trish'in sınava hazırlıkta nasıl gittiğini öğrenmeye karar veriyorsun."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:3
translate turkish D_library_investigation_01_trish_smalltalk_04daca97:

    player "Çalışmalar nasıl gidiyor?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:4
translate turkish D_library_investigation_01_trish_smalltalk_5bccd92b:

    trish "Aslında oldukça kötü. Ne yapacağımı bile bilmiyorum."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:5
translate turkish D_library_investigation_01_trish_smalltalk_4363e13a:

    trish "Sadece internetten bazı dersleri izliyorum ama hiçbir şey anlamıyorum."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:6
translate turkish D_library_investigation_01_trish_smalltalk_5a7241d9:

    trish "Hiçbir şeyi kafama sokmak gerçekten çok zor."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:7
translate turkish D_library_investigation_01_trish_smalltalk_9eabe4c2:

    player "Kütüphanede kitaplar nasıl, baktın mı hiç?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:8
translate turkish D_library_investigation_01_trish_smalltalk_d16f58b1:

    trish "Orada tam bir kaos var."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:9
translate turkish D_library_investigation_01_trish_smalltalk_1030e734:

    trish "Kütüphaneci sadece şaka yapıp duruyor. Hiç yardımı yok."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:10
translate turkish D_library_investigation_01_trish_smalltalk_7c46e2ce:

    trish "Ama tabii kendin de deneyebilirsin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:11
translate turkish D_library_investigation_01_trish_smalltalk_48e1785e:

    trish "Belki sana karşı o kadar sinir bozucu olmaz, hehe."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:12
translate turkish D_library_investigation_01_trish_smalltalk_bdd2e56c:

    player "Neyi ima ediyorsun?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:13
translate turkish D_library_investigation_01_trish_smalltalk_b76caa31:

    trish "Bilmem, o inekler femboylara karşı hep bir zaafı varmış gibi görünüyor..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:14
translate turkish D_library_investigation_01_trish_smalltalk_87e8131c:

    player "Ay, hadi ama, hehe."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:15
translate turkish D_library_investigation_01_trish_smalltalk_8230f13b:

    player "Tamam, bir deneyeyim."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:22
translate turkish D_library_investigation_01_meet_patricia_ea8f519e:

    "Kütüphaneye girdiğinde neredeyse boş bir salon gördün."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:23
translate turkish D_library_investigation_01_meet_patricia_45bdee61:

    player "{i}Kütüphane gerçekten bu kadar berbat mı...{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:24
translate turkish D_library_investigation_01_meet_patricia_e4660e6b:

    player "{i}Yoksa artık kimsenin kütüphaneye ihtiyacı mı kalmadı?{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:27
translate turkish D_library_investigation_01_meet_patricia_a35b082b:

    "Dalgın dalgın düşündün. Gerçi kesin bir yargıya varacak kadar sık gelmiyorsun buraya."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:30
translate turkish D_library_investigation_01_meet_patricia_b1e88400:

    "Burayı keşfetmeye başlamanın en iyi yolunun buradaki sorumlu birini bulmak olduğuna karar verdin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:31
translate turkish D_library_investigation_01_meet_patricia_b86ccd2e:

    player "{i}Burası o kadar kötü olamaz, değil mi? Bir kütüphaneci falan olmalı?{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:34
translate turkish D_library_investigation_01_meet_patricia_00549b11:

    "Umutsuzluk hissi içine sızarken kendi kendine düşündün."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:35
translate turkish D_library_investigation_01_meet_patricia_44df37f3:

    patricia "Kayboldun mu? Sana yardımcı olabilir miyim?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:38
translate turkish D_library_investigation_01_meet_patricia_04cfbb05:

    "Birinin arkanda bir anda belirdiğini hissettin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:39
translate turkish D_library_investigation_01_meet_patricia_5d06b929:

    "Bu figürün ani, neredeyse görünmez belirişini başka türlü açıklayamıyorsun."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:40
translate turkish D_library_investigation_01_meet_patricia_73b4285c:

    "Şaşkınlıkla hızla arkanı döndün ve biraz geri çekildin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:41
translate turkish D_library_investigation_01_meet_patricia_dd84e2ef:

    patricia "Ben Patricia, burada kütüphaneci olarak çalışıyorum."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:42
translate turkish D_library_investigation_01_meet_patricia_81f92b81:

    patricia "Belirli bir şey mi arıyorsun?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:43
translate turkish D_library_investigation_01_meet_patricia_c2650cfc:

    "Kendine gelip cevap verecek gücü buluyorsun."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:48
translate turkish D_library_investigation_01_meet_patricia_b879857f:

    player "Tanıştığımıza memnun oldum, Patricia."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:49
translate turkish D_library_investigation_01_meet_patricia_7e7067b3:

    player "Evet, tarih sınavına hazırlanmak için buradayım..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:50
translate turkish D_library_investigation_01_meet_patricia_1c6cfb1c:

    patricia "Ah, anlıyorum. Scarlett'ın öğrencisisin yani?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:51
translate turkish D_library_investigation_01_meet_patricia_93f26c70:

    player "Evet, şu an herkes herhalde hazırlanmanın yollarını arıyordur..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:52
translate turkish D_library_investigation_01_meet_patricia_67c136d9:

    patricia "Ah evet, her yıl aynı zamanda."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:53
translate turkish D_library_investigation_01_meet_patricia_7585b77c:

    "Patricia bir an sustu ve seni baştan aşağı süzdü."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:54
translate turkish D_library_investigation_01_meet_patricia_6a9ce9e5:

    player "Bir sorun mu var?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:56
translate turkish D_library_investigation_01_meet_patricia_fb93749a:

    patricia "Mmm... Nasıl desem, dostum..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:57
translate turkish D_library_investigation_01_meet_patricia_f671f9b9:

    patricia "Şansının pek de yüksek olmadığının farkındasın, değil mi?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:59
translate turkish D_library_investigation_01_meet_patricia_99a49fa7:

    player "Ne demek istiyorsun? Hangi şanstan bahsediyorsun?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:60
translate turkish D_library_investigation_01_meet_patricia_9c4713ca:

    patricia "Senin gibi femboylar hep yıpranmış yan yolu izler..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:62
translate turkish D_library_investigation_01_meet_patricia_f6a2fde8:

    player "Fazla bilmece gibi konuşuyorsun."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:63
translate turkish D_library_investigation_01_meet_patricia_27b44810:

    patricia "Ah, biliyor musun? Hayatta kalmak istiyorsan, hırsını kullanmayı öğren."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:64
translate turkish D_library_investigation_01_meet_patricia_6592ddca:

    patricia "Kimse sana bilgiyi gümüş tepside sunmayacak."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:65
translate turkish D_library_investigation_01_meet_patricia_46977296:

    player "{i}Ne kadar da kaba...{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:66
translate turkish D_library_investigation_01_meet_patricia_c8d6a443:

    player "Tarih kitapları bölümünün nerede olduğunu söyleyebilir misin?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:67
translate turkish D_library_investigation_01_meet_patricia_26917624:

    patricia "4. sıra, sol raf."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:68
translate turkish D_library_investigation_01_meet_patricia_48e1f44b:

    patricia "Bol şans."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:69
translate turkish D_library_investigation_01_meet_patricia_6c2338ff:

    player "{i}Ah, şansa ne gerek var. Gidip ihtiyacım olanı bulurum...{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:74
translate turkish D_library_investigation_01_meet_patricia_9b34f9b7:

    "Aradığın rafı pek zorlanmadan buluyorsun, seni bekleyen sorunlardan habersiz."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:75
translate turkish D_library_investigation_01_meet_patricia_950c21f2:

    "Kitap dolu o değerli raflara göz gezdirirken ilk zorluklarla hemen karşılaştın."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:76
translate turkish D_library_investigation_01_meet_patricia_29f37c29:

    player "Hiçbirinin üzerinde etiket bile yok! Bu ne saçmalık?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:77
translate turkish D_library_investigation_01_meet_patricia_136b11de:

    patricia "Mesele de bu, saf dostum."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:78
translate turkish D_library_investigation_01_meet_patricia_67af244a:

    "Patricia seni hazırlıksız yakaladı, sanki en başından beri seni izliyormuş gibi."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:79
translate turkish D_library_investigation_01_meet_patricia_28015567:

    patricia "Masal diyarında olduğunu mu sandın? Buraya girmenin yeterli olacağını, sorunların kendiliğinden çözüleceğini mi düşündün?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:80
translate turkish D_library_investigation_01_meet_patricia_bb70eb38:

    player "Doğrusu, evet, öyle düşünmüştüm..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:81
translate turkish D_library_investigation_01_meet_patricia_012d5b01:

    patricia "Haha, tabii, yüzünden okunuyor."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:82
translate turkish D_library_investigation_01_meet_patricia_437e9660:

    player "Peki ne yapmalıyım?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:83
translate turkish D_library_investigation_01_meet_patricia_15d7f85d:

    patricia "Kendine nasıl yardım edebileceğini ben de bilmiyorum."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:84
translate turkish D_library_investigation_01_meet_patricia_a10d0337:

    patricia "Ama birkaç kuralı hemen koyayım."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:85
translate turkish D_library_investigation_01_meet_patricia_4e4d2193:

    patricia "Salonda okumak yasak."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:86
translate turkish D_library_investigation_01_meet_patricia_bd66dc2b:

    player "N-ne biçim saçmalık bu?!"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:87
translate turkish D_library_investigation_01_meet_patricia_2d52cdac:

    patricia "Ah, siz aptal öğrenciler kütüphaneyi çok sık yanlış sebeplerle kullanıyorsunuz."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:88
translate turkish D_library_investigation_01_meet_patricia_5aa3310f:

    patricia "Ayrıca bu boktan okulun düzeni sağlayacak parası bile yok."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:89
translate turkish D_library_investigation_01_meet_patricia_21a3f8af:

    player "Yani... bu bir tür rulet mi?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:90
translate turkish D_library_investigation_01_meet_patricia_ae09e343:

    patricia "Belki rulettir. Belki değildir..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:91
translate turkish D_library_investigation_01_meet_patricia_4d09d449:

    player "Bana yardım etsen daha iyi olur..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:93
translate turkish D_library_investigation_01_meet_patricia_b7b2796c:

    patricia "Tamam, tamam. Sırf çok tatlı bir yüzün olduğu için."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:94
translate turkish D_library_investigation_01_meet_patricia_72251cc2:

    player "Çok teşekkür ederim... Gerçekten minnettarım..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:95
translate turkish D_library_investigation_01_meet_patricia_9fb11632:

    patricia "Bence ilk sıradaki, en alttaki sol köşede duran kitapla başlamalısın..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:96
translate turkish D_library_investigation_01_meet_patricia_d9b72f13:

    "Rahat bir nefes alarak o değerli kitaba uzanmaya başladın."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:98
translate turkish D_library_investigation_01_meet_patricia_7d057ab1:

    "Dizlerini bükerek çömelmeye karar verdin ve kitap sırtlarını incelemeye başladın."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:99
translate turkish D_library_investigation_01_meet_patricia_601b59fa:

    "Doğru kitabı fark edince Patricia'ya mantıklı bir soru sordun."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:100
translate turkish D_library_investigation_01_meet_patricia_25fa5a0c:

    player "Bu kırmızı kapaklı kitap mı?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:101
translate turkish D_library_investigation_01_meet_patricia_adb5a9e3:

    patricia "Hayır, hayır. Pardon, ilk sıradaki ikinci kitabı kastetmiş olmalıyım..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:113
translate turkish D_library_investigation_01_chose_book_3b3faf7c:

    "Dizlerin biraz yoruldu ve ağır kitabı iki elinle alabilmek için sadece dizlerinin üstüne çökmeye karar verdin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:114
translate turkish D_library_investigation_01_chose_book_61bf7819:

    player "{i}Ah, umarım bu kitaba değer...{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:117
translate turkish D_library_investigation_01_chose_book_9815c525:

    "Sevinçle kitabı çekip çıkardın ve nefes verdin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:118
translate turkish D_library_investigation_01_chose_book_132b3f8d:

    player "Ah... Teşekkürler, Patricia. Bana ödünç verir misin?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:119
translate turkish D_library_investigation_01_chose_book_0db00b9b:

    "Ayağa kalkıp kitabı karşındaki kızarmış kıza uzatıyorsun."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:120
translate turkish D_library_investigation_01_chose_book_53d28204:

    patricia "E-evet, tabii ki..."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:121
translate turkish D_library_investigation_01_chose_book_45db4dab:

    player "Bir şey mi oldu?"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:122
translate turkish D_library_investigation_01_chose_book_190dc324:

    patricia "Hayır, hayır, sorun yok... Masama gidelim, birkaç kayıt gireyim, sonra gidebilirsin."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:125
translate turkish D_library_investigation_01_chose_book_3cf3a44a:

    "Resmi bürokrasiyi tamamladıktan sonra Patricia sana sabır ve bol şans diliyor, gidişini izliyor."

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:126
translate turkish D_library_investigation_01_chose_book_4bf8ca56:

    player "{i}Patricia garip biri...{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:127
translate turkish D_library_investigation_01_chose_book_ae4b24fa:

    player "{i}Benimle mi flört ediyordu? Yoksa benden mi hoşlanıyor?{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:128
translate turkish D_library_investigation_01_chose_book_b0df7a20:

    player "{i}Ah, bu kızın dikkatini çekmek için ne yapmış olabilirim ki.{/i}"

# game/scripts/sequences/370/library_investigation_01/dialogues.rpy:140
translate turkish D_school_library_first_time_wrong_book_1d423887:

    patricia "Sana söylemiştim! İlk sıradaki ikinci kitap..."

