# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:3
translate turkish D_library_investigation_05_93108cd7:

    "Patricia seni şaşırtmaktan asla vazgeçmiyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:4
translate turkish D_library_investigation_05_04e21dc7:

    "Yine yerinde."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:5
translate turkish D_library_investigation_05_33518b1a:

    patricia "Selam! Umarım bugüne hazırsındır?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:6
translate turkish D_library_investigation_05_3fbff706:

    player "Hazır mıyım? Benim için bir şey hazırlaması gereken kişinin sen olduğunu sanıyordum?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:7
translate turkish D_library_investigation_05_9c4a7bc0:

    patricia "Ah, doğru! Hehe. Sana henüz hiçbir şey söylemedim!"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:8
translate turkish D_library_investigation_05_4e303d20:

    player "Neyi söylemedin?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:9
translate turkish D_library_investigation_05_d3421a4f:

    patricia "Önemli değil! Yakında her şeyi göreceksin! Hadi gidip kitabı alalım."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:26
translate turkish D_library_investigation_05_ad93cd9b:

    "Yine seni sevimli küçük odasına götürüyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:27
translate turkish D_library_investigation_05_275b9d5b:

    "Oraya varınca o mekânda olmanın verdiği rahatlığı ve huzuru bir kez daha hissediyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:30
translate turkish D_library_investigation_05_c1ca0248:

    "Ama uzun sürmedi. Patricia'nın kapının hemen dışında biriyle konuştuğunu duyuyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:31
translate turkish D_library_investigation_05_4ad5ebbc:

    "Misafir mi bekliyorsun? Yoksa bu da planının bir parçası mı? Patricia sık sık bazı şeyleri söylemeden bıraktığını zaten belli etti."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:32
translate turkish D_library_investigation_05_2b751921:

    "Patricia arkadaşıyla odaya giriyor ve onu sana tanıştırıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:37
translate turkish D_library_investigation_05_2ecfbfd0:

    patricia "Austin, bu Amy. Amy, işte bu o Austin!"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:39
translate turkish D_library_investigation_05_78e196c8:

    amy "Aman tanrım, gerçekten de çok tatlı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:41
translate turkish D_library_investigation_05_ed4ab3ee:

    patricia "Sana söylemiştim. Ben bu konuda hiç yanılmam!"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:42
translate turkish D_library_investigation_05_4226f814:

    "Patricia ve Amy'nin coşkulu çığlıkları seni kızartıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:43
translate turkish D_library_investigation_05_0e817566:

    "Ama yine de neler olup bittiğini ya da Amy'nin neden burada olduğunu hiç bilmiyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:45
translate turkish D_library_investigation_05_eb65555d:

    patricia "Ah, doğru... Muhtemelen sorularının vardır, Austin..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:46
translate turkish D_library_investigation_05_45f668d6:

    player "Evet, ne yapacağız?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:47
translate turkish D_library_investigation_05_6846a2bb:

    patricia "Anlaştığımız şeyi. Eskizlerim için poz vereceksin."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:48
translate turkish D_library_investigation_05_3d4bd5ee:

    patricia "Amy kompozisyonu daha canlı göstermek için burada."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:49
translate turkish D_library_investigation_05_ee4783f3:

    patricia "Bunu ancak karedeki başka bir canlı insan yapabilir!"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:50
translate turkish D_library_investigation_05_7456d48c:

    patricia "Kapaklar için birkaç eskiz yapmak istiyorum."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:51
translate turkish D_library_investigation_05_fe7b69c1:

    patricia "Başlayalım mı?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:53
translate turkish D_library_investigation_05_14239630:

    amy "Tabii ki!"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:54
translate turkish D_library_investigation_05_f6b63af2:

    patricia "Harika."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:55
translate turkish D_library_investigation_05_c162caca:

    patricia "Austin, dizlerinin üstüne otur..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:58
translate turkish D_library_investigation_05_0a971674:

    player "Böyle mi?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:59
translate turkish D_library_investigation_05_9e8f08f3:

    patricia "Evet, mükemmel... Bacaklarını açmaktan çekinme."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:60
translate turkish D_library_investigation_05_89ebf35f:

    patricia "Amy... Yarağını çıkar."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:61
translate turkish D_library_investigation_05_8694550d:

    player "Yarak mı?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:62
translate turkish D_library_investigation_05_0657470c:

    patricia "Tabii ki yarak. Yetişkin çizgi romanları çiziyorum. Kendin de gördün..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:64
translate turkish D_library_investigation_05_45f27594:

    "Amy şortunu indirip kendini önünde ortaya seriyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:65
translate turkish D_library_investigation_05_a42eb355:

    "Başını arkasından sıkıca kavrıyor, saçlarını zar zor tutarak."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:66
translate turkish D_library_investigation_05_9cbd5b97:

    "Yukarı baktığında sadece Amy'den onaylayan bir göz kırpma görüyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:67
translate turkish D_library_investigation_05_75f9fe05:

    "Muhtemelen işlerin ne kadar hızlı ilerlediğini göz önünde bulundurarak ortamı yumuşatmaya çalışıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:68
translate turkish D_library_investigation_05_6558ef99:

    "İsimleri bile zor değiş tokuş etmişken kendini onun mahrem yerinin hemen yanında oturur halde buldun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:69
translate turkish D_library_investigation_05_20d5ee79:

    amy "Ah, Patricia, biraz yardıma ihtiyacım var, ne demek istediğimi anlıyorsan..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:76
translate turkish D_library_investigation_05_92761d7c:

    patricia "Hehe. Tabii ki..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:77
translate turkish D_library_investigation_05_ccdd89b2:

    "Patricia, Amy'nin kanı doğru yere aksın diye balıkçı yakalı kazağını çıkarıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:78
translate turkish D_library_investigation_05_7c2cfc8f:

    "O kadar şaşkınsın ki tek kelime etmeden gözlerini Patricia'nın koca memelerinden ayıramıyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:80
translate turkish D_library_investigation_05_b5691aa0:

    "Ancak kısa bir süre sonra manzaranı Amy'nin kalın sopası kapatıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:81
translate turkish D_library_investigation_05_3959828f:

    patricia "Mmm... Böyle, güzel... Mükemmel kompozisyon."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:82
translate turkish D_library_investigation_05_21a3fecb:

    "O pozisyonda delice garip hissettin, sanki gözlerin bağlıymış gibi."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:83
translate turkish D_library_investigation_05_89c1ad55:

    "Sonraki 5 dakika boyunca Patricia, sonradan bitirmek üzere ana noktaları vurgulamaya çalışarak aceleyle eskizler yaptı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:84
translate turkish D_library_investigation_05_c326f76a:

    "Sadece onun tüm kokularını içine çekiyordun ve bundan inanılmaz derecede azıyordun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:85
translate turkish D_library_investigation_05_4dfc0198:

    player "{i}Ah... Bu daha ne kadar sürecek?{/i}"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:86
translate turkish D_library_investigation_05_72bfac4d:

    "Tam Patricia'ya yeni bir fikir gelirken böyle düşündün."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:87
translate turkish D_library_investigation_05_1a510764:

    patricia "Amy, iyi misin?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:88
translate turkish D_library_investigation_05_ca11aeea:

    "Devam etmeden önce emin olmak için kontrol etmeye karar verdi."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:89
translate turkish D_library_investigation_05_8e0e0297:

    amy "Ah, bunun ne kadar zor olduğunu biliyorsun, bebeğim..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:90
translate turkish D_library_investigation_05_5887ca0a:

    patricia "Sorun değil. Bunu kesinlikle telafi edeceğim."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:91
translate turkish D_library_investigation_05_6187e80b:

    patricia "Ya sen, Austin? Devam etmeye hazır mısın?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:92
translate turkish D_library_investigation_05_4c62daff:

    player "Ben... Bunun bu kadar zor olacağını düşünmemiştim..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:93
translate turkish D_library_investigation_05_f27bcdfd:

    amy "Zor mu? Ne oldu, Austin?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:94
translate turkish D_library_investigation_05_9e1be00a:

    patricia "Evet, sorun ne? Amy'den hoşlanmadın mı?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:95
translate turkish D_library_investigation_05_bb5379ec:

    player "Yok, yok, ne diyorsun... Amy kesinlikle muhteşem görünüyor, ah..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:96
translate turkish D_library_investigation_05_6fc751f8:

    patricia "Muhteşem mi dedin? Sanırım neler olduğunu anlıyorum..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:98
translate turkish D_library_investigation_05_35dc6027:

    "Patricia sana ve Amy'ye yaklaşmaya karar verip tam onun yarağının önüne, yüzünün karşısına oturuyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:99
translate turkish D_library_investigation_05_d158d982:

    "Hiçbir sınır tanımadan yarağına dokunuyor ve usulca mırıldanıyor..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:100
translate turkish D_library_investigation_05_ae5f3f29:

    patricia "Femboyların en sevdiğim yanı bu..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:101
translate turkish D_library_investigation_05_cb41bc68:

    patricia "Önünde böyle sulu bir yarak varken kıpırdamadan oturmak çok zor, değil mi?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:102
translate turkish D_library_investigation_05_a445318d:

    "Çok azmış yarağını okşamaya başlıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:103
translate turkish D_library_investigation_05_1925f9bc:

    "Böyle devam ederse biraz daha fazlasında külotuna boşalacakmışsın gibi hissediyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:104
translate turkish D_library_investigation_05_0c48750c:

    patricia "Hazzı faydayla birleştirelim..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:105
translate turkish D_library_investigation_05_c832ec6c:

    amy "Ha! Düşünme tarzını seviyorum, Patricia..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:107
translate turkish D_library_investigation_05_c56d5388:

    "Patricia, Amy'nin yarağını kavrayıp yalamaya başlıyor, ağır, baştan çıkarıcı yorumlarla aralarını doldurarak."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:109
translate turkish D_library_investigation_05_80e3a255:

    patricia "Hadi, Austin... Utanma..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:110
translate turkish D_library_investigation_05_fc46a0a5:

    patricia "Sen de benim kadar çok istiyorsun bunu..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:112
translate turkish D_library_investigation_05_7111ef5d:

    "Direnemeyip sen de dilini Amy'nin kalın yarağına uzatıyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:113
translate turkish D_library_investigation_05_fa75f4ac:

    amy "Ah, harika... Mmm..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:114
translate turkish D_library_investigation_05_68f81ed7:

    amy "Dünyanın en iyi işi..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:115
translate turkish D_library_investigation_05_fd2ec445:

    patricia "Amy bütün yüzünü sıcak spermiyle dolduracak..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:116
translate turkish D_library_investigation_05_e369e17f:

    patricia "Ben de onu boyayacağım... Ah..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:117
translate turkish D_library_investigation_05_80f691c8:

    amy "En iyi fikirler azgınken gelir, değil mi?"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:119
translate turkish D_library_investigation_05_e064c174:

    "Tereddüt etmeden Patricia, Amy'nin yarağını ağzına alıp yutmaya başlıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:121
translate turkish D_library_investigation_05_751ddd9a:

    "Ustaca büyük kısmını içine alıyor, hırsla tükürüğüyle kaplıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:123
translate turkish D_library_investigation_05_bfd34c63:

    "Bu arada sen sadece kıskançlıkla izliyorsun ve daha da çok azıyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:124
translate turkish D_library_investigation_05_52254f42:

    "Amy'nin Patricia'yı bu konuda gerçekten iyi eğittiği belli."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:125
translate turkish D_library_investigation_05_41290e50:

    "Yarağı, Patricia'nın boğazından defalarca kolayca kayıyor, sanki orada dipsiz bir kuyu varmış gibi."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:126
translate turkish D_library_investigation_05_0323f95d:

    "Amy'nin yarağı sistematik biçimde boğazını gererken Patricia'nın boynundaki gerdanlığın nasıl attığını görüp büyüleniyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:127
translate turkish D_library_investigation_05_24b36083:

    "Şu an onun yerinde olmayı ne kadar çok isteyeceğini düşünürken yakalıyorsun kendini."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:128
translate turkish D_library_investigation_05_97ad413d:

    "Aynı derecede usta ve sarsılmaz olmayı. Ne de olsa Patricia'nın yüzünde bundan dolayı ne acıma ne de acı var."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:129
translate turkish D_library_investigation_05_b3d49734:

    "Seni hatırlayan Patricia, Amy'nin yarağını ağzından çıkarıp doğrudan ağzına uzatıyor."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:130
translate turkish D_library_investigation_05_737a00a8:

    "Refleks olarak dudaklarını aralıyor ve kalanını o okşarken başını emmeye başlıyorsun."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:131
translate turkish D_library_investigation_05_2499a458:

    "Böyle bir yarağı bu kadar ustaca idare edemiyorsun, bu yüzden Patricia sadece sonuca odaklandı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:134
translate turkish D_library_investigation_05_8fc3ff78:

    "Sana yaklaşıp kulağına yumuşakça fısıldıyor..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:135
translate turkish D_library_investigation_05_8313ab86:

    patricia "Hadi... Biraz daha..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:136
translate turkish D_library_investigation_05_6ab3a7f0:

    patricia "Bu yarağı yüzüne boşalt..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:137
translate turkish D_library_investigation_05_f7d63710:

    patricia "Dene... Benim için..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:138
translate turkish D_library_investigation_05_cd85c21c:

    patricia "Amy için..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:142
translate turkish D_library_investigation_05_65fe6945:

    "Sen kendin farkında olmadan sınırındaydın ve tadı alır almaz Patricia yarağı keskin bir hareketle ağzından çıkardı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:143
translate turkish D_library_investigation_05_4bc1a4c9:

    "Amy'nin de sınırda olduğunu çabucak sezdi ve yarağı yüzüne doğrultmaya, o toptan püskürtmeye başladı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:144
translate turkish D_library_investigation_05_4e8e6ab3:

    "Atış üstüne atış yüzünü Amy'nin kalın, sıcak spermiyle kapladı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:145
translate turkish D_library_investigation_05_bb2efb0d:

    "Göz kapaklarında ve dudaklarında uzun sperm iplikleri bıraktı, istediği resmi yarattı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:147
translate turkish D_library_investigation_05_87c4dd80:

    patricia "Ah... Kıpırdama..."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:148
translate turkish D_library_investigation_05_7f36057d:

    "Patricia sert bir şekilde, sana emir vererek söyledi."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:149
translate turkish D_library_investigation_05_d6605c50:

    "Sonuçtan memnun olan sen, resmi bozmamak için derin nefes almaktan bile korktun ve hiçbir şey damlamasın diye başını hafifçe geriye yatırdın."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:150
translate turkish D_library_investigation_05_8507090c:

    "Patricia çılgın bir hızla çizmeye başladı. Kaleminden eskiz üstüne eskiz çıktı."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:151
translate turkish D_library_investigation_05_4c22a31a:

    "Durumdan maksimum verimi çıkarmaya çalıştı. Belli olmasa da yüzü o anda tam bir tatmin gösteriyordu."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:153
translate turkish D_library_investigation_05_a1853ea7:

    "Son eskiz için sadece ağzını iyice açıp dilini çıkarmanı ve gözlerini devirmeni istedi."

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:154
translate turkish D_library_investigation_05_a022f33b:

    "Okurların şimdiye kadar heyecanlandığı şeyin bu olduğundan emindi!"

# game/scripts/sequences/370/library_investigation_05/dialogues.rpy:158
translate turkish D_library_investigation_05_65ee0098:

    patricia "Teşekkürler, Austin... Harika bir deneyimdi..."

translate turkish strings:

    # game/scripts/sequences/370/library_investigation_05/dialogues.rpy:20
    old "Patricia checks out another book to your name."
    new "Patricia başka bir kitabı senin adına kaydediyor."

    # game/scripts/sequences/370/library_investigation_05/dialogues.rpy:156
    old "Having captured images of you, she let you wipe yourself."
    new "Seni görüntüledikten sonra kendini silmene izin verdi."

    # game/scripts/sequences/370/library_investigation_05/dialogues.rpy:159
    old "She said touchingly at the end, letting you go about your business."
    new "Sonunda dokunaklı bir şekilde bir şey söyleyip işine gitmene izin verdi."

