# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:13
translate turkish D_astra_new_plan_e540b21f:

    real_mom "Süre 8 saat, 36 dakika, 54 saniye. Rapor veriyorum."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:14
translate turkish D_astra_new_plan_33f00ce1:

    "Holly verileri kontrol edip durumu analiz ediyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:15
translate turkish D_astra_new_plan_2eaf8a48:

    "Her şeyin yolunda olduğundan emin olduktan sonra senkronizasyonun son ayrıntılarını netleştiriyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:16
translate turkish D_astra_new_plan_585a4e31:

    "Temas için ayarlamayı yapıp cihazı kapatıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:19
translate turkish D_astra_new_plan_376bad06:

    real_mom "{i}Ah, Austyn... Umarım iyisindir...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:20
translate turkish D_astra_new_plan_2896f637:

    "Holly'nin seninle yapacağı temas için gerçekten çok gergin olduğu belli."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:21
translate turkish D_astra_new_plan_40c1d75d:

    "Austyn'in onu gerçek haliyle görünce çok mutlu olacağını umuyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:22
translate turkish D_astra_new_plan_4bd78de0:

    "Yine de düşünceleri, Austyn'in koca bir sikli anneye çoktan alışmış olması fikriyle sürekli bölünüyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:23
translate turkish D_astra_new_plan_e65052ed:

    real_mom "{i}Ah, ne düşünüyorum ben, ben onun annesiyim. Sevgilisi değil! Bacaklarımın arasında ne olduğunun kimin umurunda!{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:26
translate turkish D_astra_new_plan_a849d167:

    "Sonunda! Uyandığın anı yakaladı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:27
translate turkish D_astra_new_plan_fa19c695:

    real_mom "{i}Ah, tatlım. Erkek olsan bile, yine de...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:28
translate turkish D_astra_new_plan_0d9e3dea:

    real_mom "{i}Ama itiraf etmeliyim... Bu gecelik sana çok yakışıyor.{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:29
translate turkish D_astra_new_plan_365cf29e:

    "Holly'nin kalbi heyecanla sıkışıyor. Şu an kendi oğluna karşı çok çelişkili duygular besliyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:30
translate turkish D_astra_new_plan_10310737:

    "Belki bir senaryo bile hayal edebiliyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:31
translate turkish D_astra_new_plan_17d0d005:

    "Bu evrenin annesi olarak onun böyle bir şey yapabileceği..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:32
translate turkish D_astra_new_plan_22427f79:

    "Ama bunların hepsi delice!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:33
translate turkish D_astra_new_plan_6ee995b4:

    real_mom "{i}Ah, lanet olsun. Holly, kendine gel!{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:34
translate turkish D_astra_new_plan_abf17da9:

    real_mom "Austyn uyandı. Geri sayımdan sonra harekete geçiliyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:35
translate turkish D_astra_new_plan_f833156f:

    "3..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:36
translate turkish D_astra_new_plan_0ff2fb2c:

    "2..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:40
translate turkish D_astra_new_plan_7a3900fd:

    real_mom "Dur! Odaya biri girdi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:41
translate turkish D_astra_new_plan_5cb2b4bb:

    mom "Ah, uyanmışsın zaten tatlım."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:42
translate turkish D_astra_new_plan_5dc2fbde:

    real_mom "Ah, bu... Bu benim..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:43
translate turkish D_astra_new_plan_784d17f1:

    player "Evet, daha yeni kalktım."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:44
translate turkish D_astra_new_plan_1708618b:

    real_mom "Demek öbür ben. Umarım uzun sürmez..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:47
translate turkish D_astra_new_plan_7a0c572d:

    "Holly'nin bakışı kendi kıçı tarafından kapatıldı!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:48
translate turkish D_astra_new_plan_fefb3c21:

    mom "Ben de seni şaşırtmak istemiştim..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:49
translate turkish D_astra_new_plan_81cb2459:

    mom "Hafta sonları annenin keyfini çok sık yerine getiriyorsun."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:50
translate turkish D_astra_new_plan_10a08ce7:

    real_mom "Tamam... Dur, b-bir şey ters."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:51
translate turkish D_astra_new_plan_0fac4d81:

    player "Mmm... Anne, buna gerek yok, zaten bedavaya yapıyorum."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:52
translate turkish D_astra_new_plan_90666058:

    real_mom "Neyi yapıyor? Ne oluyor?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:53
translate turkish D_astra_new_plan_840a2cbe:

    operator "Neler oluyor? Neden hâlâ harekete geçmiyorsun?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:54
translate turkish D_astra_new_plan_c309cd5f:

    real_mom "Mücbir sebep. Üçüncü kişi müdahalesi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:55
translate turkish D_astra_new_plan_72a5825f:

    real_mom "İlerleyemiyorum."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:56
translate turkish D_astra_new_plan_bc2a0a4a:

    operator "O zaman geri çekiliyoruz!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:57
translate turkish D_astra_new_plan_5c6d117e:

    real_mom "Hayır, dur, belki yine de işe yarar. Bekleyelim..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:60
translate turkish D_astra_new_plan_2bbc074d:

    mom "Ah, Austy... Yatakta kahvaltıya ne dersin?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:61
translate turkish D_astra_new_plan_2aeca57a:

    real_mom "Dur, ah... Bu da ne..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:62
translate turkish D_astra_new_plan_37063436:

    real_mom "Tanrım, o... o..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:63
translate turkish D_astra_new_plan_a0ecd1ef:

    operator "O... O ne yapıyor?!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:64
translate turkish D_astra_new_plan_b98c642b:

    real_mom "Kocaman sikini çıkardı..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:65
translate turkish D_astra_new_plan_4dba1b9e:

    player "Resmen aklımı okudun, hi hi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:66
translate turkish D_astra_new_plan_b3013a46:

    real_mom "{i}Ah, bu olmasın...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:67
translate turkish D_astra_new_plan_11adb5d2:

    real_mom "{i}Sakın söyleme, yapacaksın...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:71
translate turkish D_astra_new_plan_ceb4db10:

    mom "Evet... Böyle..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:72
translate turkish D_astra_new_plan_00f4e034:

    "Gördükleri karşısında Holly'nin minik kalbi sıkıştı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:73
translate turkish D_astra_new_plan_70a5a69d:

    "Austyn'in o koca sike hevesle girişmesini duyunca dikkatle aldığı nefes anında bozuldu."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:74
translate turkish D_astra_new_plan_af66f034:

    real_mom "{i}Daha yeni gözlerini açtın... Ve çoktan...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:75
translate turkish D_astra_new_plan_1ccfe4e0:

    mom "Mmm... Ağzın çok sıcak, Tanrım..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:76
translate turkish D_astra_new_plan_81ff4f9b:

    "Annen ne hissettiğine karar veremiyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:77
translate turkish D_astra_new_plan_b52f6f8b:

    "Bu azgınlık mı... Yoksa kıskançlık mı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:78
translate turkish D_astra_new_plan_7f355ca0:

    "Ya da sadece o sike duyulan bir imrenme."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:79
translate turkish D_astra_new_plan_b4b779b4:

    operator "Beni duyuyor musun? Tamam."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:80
translate turkish D_astra_new_plan_d6fedbae:

    operator "Şimdi harekete geçeceksen—yoksa sonra tekrar etmemiz gerekecek!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:83
translate turkish D_astra_new_plan_b49da3e9:

    real_mom "Ben... Ben buna bakamıyorum..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:84
translate turkish D_astra_new_plan_ffdda9cf:

    real_mom "Çok az zamanımız var... Biraz sonra tekrar deneyelim. Tamam."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:86
translate turkish D_astra_new_plan_a42ec98d:

    "Anlaşıldı. Geçiş yapılıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:87
translate turkish D_astra_new_plan_481067b2:

    "Duygulara boğulan annen biraz üzüldü ve gitme vaktinin geldiğine karar verdi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:88
translate turkish D_astra_new_plan_13b1b1d1:

    "Bir hologram gibi buharlaşıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:105
translate turkish D_astra_new_plan_ec9defb9:

    real_trish "Süre 2 saat, 34 dakika, 13 saniye. Rapor veriyorum."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:106
translate turkish D_astra_new_plan_e88a1666:

    "Trish kendi evinin koridorunda konumlandı!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:107
translate turkish D_astra_new_plan_bda14f03:

    "Ekiple birlikte, Austyn'in günün bu saatinde arkadaşını ziyaret etmeyi sevdiğini tespit ettiler."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:108
translate turkish D_astra_new_plan_36396f79:

    "Odasının kapısına dikkatle yaklaşan Trish, Austyn'le temas kurmaya çalışıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:111
translate turkish D_astra_new_plan_3a054217:

    "Göğüslerini usulca kapıya bastırarak Trish içeri bakmaya çalışıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:112
translate turkish D_astra_new_plan_7528e29a:

    real_trish "Austyn yatakta oturuyor sadece."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:113
translate turkish D_astra_new_plan_09fe0346:

    real_trish "Görünüşe göre yalnız."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:114
translate turkish D_astra_new_plan_5be54a1d:

    operator "Bir saniye bile kaybetme!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:115
translate turkish D_astra_new_plan_94af26be:

    real_trish "{i}Tanrım, Austyn... Bu evren sana ne yapmış...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:116
translate turkish D_astra_new_plan_2dad37b7:

    real_trish "{i}Şu kıyafetin...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:117
translate turkish D_astra_new_plan_1d882ea9:

    real_trish "{i}Ben... Bu hale geldiğine çok sevindim...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:118
translate turkish D_astra_new_plan_383552b9:

    "Trish'in hayalleri, öbür Trish'in cüretkâr haykırışıyla aniden kesildi!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:119
translate turkish D_astra_new_plan_4e5f20b4:

    trish "Ah, şu kıç..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:120
translate turkish D_astra_new_plan_b7c591bb:

    real_trish "Siktir."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:121
translate turkish D_astra_new_plan_cf131599:

    operator "Orada neler oluyor?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:122
translate turkish D_astra_new_plan_6e1699d6:

    trish "Antrenman sana yaramış, yaramaz..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:123
translate turkish D_astra_new_plan_24c44d73:

    real_trish "Austyn... O... Ah..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:126
translate turkish D_astra_new_plan_43b93a8d:

    player "Daha yeni başlıyorum... Ah..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:127
translate turkish D_astra_new_plan_9f112458:

    "Trish senin baskından fazlasıyla azıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:128
translate turkish D_astra_new_plan_49f4497f:

    "Utangaç Austyn'inin bunu yapabilmesi ona kültür şoku yaşatmış gibi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:129
translate turkish D_astra_new_plan_b027c20e:

    real_trish "Onlar Trish'le birlikte. Ve o..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:130
translate turkish D_astra_new_plan_e2459e00:

    operator "Ve o ne?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:131
translate turkish D_astra_new_plan_c232dd86:

    operator "Rapor ver."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:132
translate turkish D_astra_new_plan_2aa03941:

    "Trish nasıl anlatacağını bilemiyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:133
translate turkish D_astra_new_plan_5d49e5c2:

    "Sevgili arkadaşını kirli küçük kelimelerle lekelemek istemiyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:134
translate turkish D_astra_new_plan_b51530c8:

    real_trish "Austyn... Çok meşgul..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:135
translate turkish D_astra_new_plan_686b099d:

    trish "Sikim o kıçta eriyip gidiyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:136
translate turkish D_astra_new_plan_91d9675a:

    real_trish "{i}Vay, bu sadece...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:137
translate turkish D_astra_new_plan_0ff79a0b:

    real_trish "{i}İnanılmaz...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:138
translate turkish D_astra_new_plan_538155d0:

    real_trish "{i}Kıçın bunu nasıl kaldırıyor... Austyn...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:139
translate turkish D_astra_new_plan_c22ebb3c:

    player "Sen boşalana kadar durmayacağım."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:140
translate turkish D_astra_new_plan_a47ba9f6:

    "Trish, buradaki Trish'in o an ne hissettiğini tam olarak hissediyor gibi..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:141
translate turkish D_astra_new_plan_1b916487:

    "O etli kıç o sikin üstüne oturduğunda."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:144
translate turkish D_astra_new_plan_bf55860c:

    real_trish "{i}Şu Trish... Çok mutlu...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:145
translate turkish D_astra_new_plan_6363091d:

    real_trish "{i}Hayatının keyfini çıkarıyor...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:146
translate turkish D_astra_new_plan_9830056d:

    operator "Bir şeyin ilerlemediğini görüyorum, beni duyuyor musun? Tamam."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:150
translate turkish D_astra_new_plan_da09ee8a:

    operator "Geçiş yapılıyor!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:151
translate turkish D_astra_new_plan_1512d092:

    real_trish "H-hayır, dur..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:161
translate turkish D_astra_new_plan_5cb79cdc:

    real_jannet "Süre 8 saat, 48 dakika, 34 saniye. R-rapor veriyorum."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:162
translate turkish D_astra_new_plan_6e85e1c7:

    "Araştırma, akşamları seni bazen burada bulabileceğimizi gösterdi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:163
translate turkish D_astra_new_plan_d1043727:

    "Akşam, en hareketli olduğun zaman."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:164
translate turkish D_astra_new_plan_203a9daa:

    "Yani temelde tahmine dayanarak, seni burada aramaya karar verildi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:165
translate turkish D_astra_new_plan_a3921a9e:

    "Jannet olay yerine varınca yatak odası penceresinden bakmaya karar veriyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:168
translate turkish D_astra_new_plan_2c54ba3a:

    real_jannet "Aman Tanrım..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:169
translate turkish D_astra_new_plan_35f47e5a:

    operator "Bu sefer ne var?!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:170
translate turkish D_astra_new_plan_51884445:

    real_jannet "O... O..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:171
translate turkish D_astra_new_plan_559711b9:

    operator "Bu çok saçma..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:172
translate turkish D_astra_new_plan_e8db4459:

    operator "Tek başına geçirebileceğin bir izin günü bu kadar zor mu yani."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:173
translate turkish D_astra_new_plan_807c947e:

    real_jannet "B-bu ben miyim?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:174
translate turkish D_astra_new_plan_a2eb1fc9:

    real_jannet "Ve Austyn de bana..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:175
translate turkish D_astra_new_plan_f910e750:

    "Gördüğü şey Jannet'i anında kızarttı!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:176
translate turkish D_astra_new_plan_62043976:

    "Daha yakından bakma isteğine karşı koyamıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:177
translate turkish D_astra_new_plan_4ee39fde:

    "Odaklanıp manzaranın tadını çıkarıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:178
translate turkish D_astra_new_plan_1b067075:

    operator "Hm... Kesin bir adım atmamız lazım..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:179
translate turkish D_astra_new_plan_1d80f4fa:

    real_jannet "Yalıyor... Yalıyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:180
translate turkish D_astra_new_plan_d8421755:

    real_jannet "{i}Ah... Austyn'in dili...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:181
translate turkish D_astra_new_plan_0aaaa72f:

    "Jannet'in küçük kalbi çılgınca atmaya başlıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:182
translate turkish D_astra_new_plan_467c6b22:

    operator "Jannet? İyi misin?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:183
translate turkish D_astra_new_plan_4d46609e:

    real_jannet "{i}Tam bacaklarımın arasında...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:184
translate turkish D_astra_new_plan_1a79f27f:

    operator "Tehlikede misin? Nabzın çok yüksek!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:185
translate turkish D_astra_new_plan_daed9143:

    real_jannet "{i}Y-yani, onun bacaklarının arasında...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:186
translate turkish D_astra_new_plan_2c7c103c:

    operator "Durumu bildir!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:187
translate turkish D_astra_new_plan_f88e9cc8:

    real_jannet "{i}Tam orada...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:190
translate turkish D_astra_new_plan_cb742545:

    "Austyn kıçını kaldırıp yeni ayrıntıları gözler önüne seriyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:191
translate turkish D_astra_new_plan_00311470:

    real_jannet "Ve kıçında... Tanrım..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:192
translate turkish D_astra_new_plan_284f5e13:

    operator "Jannet!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:193
translate turkish D_astra_new_plan_e0497c80:

    real_jannet "O dildoyu çok kolay kaldırıyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:194
translate turkish D_astra_new_plan_d38558b5:

    real_jannet "Benim Austyn'im... Ah..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:195
translate turkish D_astra_new_plan_00e941a4:

    operator "Ah, ayrıntıları bana anlatma!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:196
translate turkish D_astra_new_plan_79ae7686:

    real_jannet "Bu... Bu inanılmaz..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:197
translate turkish D_astra_new_plan_96cde14f:

    real_jannet "Bu Austyn... Bambaşka biri..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:200
translate turkish D_astra_new_plan_b7078c7b:

    "Buradaki Jannet'in bir sonraki hamlesine bakılırsa, Jannet olan biten her şeyin doruk noktasını izliyor gibi!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:201
translate turkish D_astra_new_plan_18c1940c:

    real_jannet "{i}Ah, k-kendine ne yaptırıyor...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:202
translate turkish D_astra_new_plan_a2a3ebce:

    real_jannet "{i}Austyn'im bunların hepsinden bu kadar mı hoşlanıyor?{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:203
translate turkish D_astra_new_plan_e3eab84c:

    real_jannet "{i}Kıçında böyle bir şey olunca hoşuna gidiyor demek...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:204
translate turkish D_astra_new_plan_55aceee6:

    real_jannet "{i}Bu çocuğun gerçekten bu kadar sert bir kıza ihtiyacı var mı... Ah...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:205
translate turkish D_astra_new_plan_9a4e8f3b:

    operator "Seni fark edebilirler, Jannet!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:206
translate turkish D_astra_new_plan_46c46681:

    operator "Saklanmalı ve bakmayı bırakmalısın!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:209
translate turkish D_astra_new_plan_2500d9ab:

    real_jannet "Ama... Ama yapamıyorum..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:210
translate turkish D_astra_new_plan_c860d59d:

    operator "Ah, kahretsin. Pekâlâ, Jannet. Başka çaremiz yok."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:211
translate turkish D_astra_new_plan_da09ee8a_1:

    operator "Geçiş yapılıyor!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:212
translate turkish D_astra_new_plan_1e7d2e01:

    real_jannet "B-ben izlemek istiyorum..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:215
translate turkish D_astra_new_plan_658bdaab:

    operator "Buna vaktimiz yok, Jannet!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:228
translate turkish D_astra_new_plan_7fbad9d0:

    real_astra "Süre 2 saat, 10 dakika... Ah, boş ver."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:229
translate turkish D_astra_new_plan_bf3a2213:

    "Bazen Austyn evde uyumuyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:230
translate turkish D_astra_new_plan_bf095d12:

    "Austyn evde uyumuyorsa—büyük ihtimalle meşguldür..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:231
translate turkish D_astra_new_plan_2e36a82a:

    "Ancak bu sefer ekip senin evde olduğunu kesin olarak biliyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:232
translate turkish D_astra_new_plan_a6ce023b:

    "Ama bu, şu an senin de meşgul olmana engel olmadı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:233
translate turkish D_astra_new_plan_82093f90:

    real_astra "Austyn bir türlü sakinleşmiyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:234
translate turkish D_astra_new_plan_c20c4e60:

    operator "Bu saatte bile mi?!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:235
translate turkish D_astra_new_plan_9a62f479:

    real_astra "Hayır, o... Yalnız. Sadece..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:236
translate turkish D_astra_new_plan_314461aa:

    real_astra "Kendi kendine yapıyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:237
translate turkish D_astra_new_plan_da480d13:

    operator "Yalnız mı? O zaman harekete geçmeliyiz."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:238
translate turkish D_astra_new_plan_f69ae64c:

    real_astra "{i}Ugh... Ne utanç verici...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:239
translate turkish D_astra_new_plan_23875d6c:

    real_astra "{i}Normal bir erkek gibi mastürbasyon bile yapamıyorsun...{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:240
translate turkish D_astra_new_plan_d44b0920:

    real_astra "{i}Normal biri gibi.{/i}"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:241
translate turkish D_astra_new_plan_f7df5fcc:

    real_astra "Ah. Yeter. Giriyorum!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:244
translate turkish D_astra_new_plan_9b0f7650:

    real_astra "Austyn!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:245
translate turkish D_astra_new_plan_936d6f2d:

    real_astra "Kımılda, hemen!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:246
translate turkish D_astra_new_plan_4b62acfa:

    player "Ha? Astra?!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:247
translate turkish D_astra_new_plan_903e7f8a:

    "Gözünün önünde imkânsız bir şey görünce ödün patlıyor!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:250
translate turkish D_astra_new_plan_88cfd9b9:

    "Kendini başlığa yaslayıp titremeye başlıyorsun."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:251
translate turkish D_astra_new_plan_45cf4ff0:

    "Utanca ve kaçınılmaz bir şeyin seni beklediği hissine boğuluyorsun!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:252
translate turkish D_astra_new_plan_186c176c:

    player "S-sen... Nasıl..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:253
translate turkish D_astra_new_plan_c0937375:

    real_astra "Buna gerçekten vaktimiz yok!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:254
translate turkish D_astra_new_plan_e611432a:

    real_astra "Giyin ve beni takip et!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:255
translate turkish D_astra_new_plan_e5d2a4f8:

    player "N-nereye? N-neden?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:256
translate turkish D_astra_new_plan_d9ac4445:

    player "Dışarısı gece!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:257
translate turkish D_astra_new_plan_da4eb08c:

    real_astra "Tek kelime etme!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:258
translate turkish D_astra_new_plan_5b5ef2b2:

    mom "İyi misin orada, Austy?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:262
translate turkish D_astra_new_plan_70f73261:

    "Kapıya hafifçe vurulması üzerine yıldırım çarpmış gibi oldun!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:263
translate turkish D_astra_new_plan_24e6cfcf:

    "Her şeyin birdenbire olması seni en garip şekilde davranmaya itiyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:264
translate turkish D_astra_new_plan_6bfe4a80:

    mom "Tatlım?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:265
translate turkish D_astra_new_plan_bc4ec638:

    astra "Siktir. Şimdi! Pencereden çık!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:266
translate turkish D_astra_new_plan_b4f9bdfb:

    "Anneden habersiz odadan çıkmayı başarıyorsun..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:267
translate turkish D_astra_new_plan_127f0f1d:

    mom "Bir ses duydum ve..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:270
translate turkish D_astra_new_plan_4f319aab:

    "Gittiğini fark edince annen endişeleniyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:271
translate turkish D_astra_new_plan_fbd4f508:

    mom "Aman Tanrım! N-ne oldu?!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:272
translate turkish D_astra_new_plan_2a0c2414:

    mom "A-austyn? N-nerdesin?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:275
translate turkish D_astra_new_plan_3e37f92d:

    "Astra seni yerel parka, zaten bildiğin bir yere götürdü."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:276
translate turkish D_astra_new_plan_bbd0fd9f:

    "Bütün yol boyunca elini sıkıca tuttu ve seni zorla sürükledi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:277
translate turkish D_astra_new_plan_7a4fb1cd:

    "Bacaklarını zor oynatarak onun hızından dolayı tökezlememeye çalıştın."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:278
translate turkish D_astra_new_plan_fff3b81a:

    "Nefesin sürekli bozuluyordu."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:279
translate turkish D_astra_new_plan_951c13bf:

    "Varış noktasına yaklaştıkça kızgın bir tartışma duymaya başlamıştın."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:280
translate turkish D_astra_new_plan_c3e697c1:

    "Orada güvenli olmadığını düşündün ama Astra durmayı aklına bile getirmedi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:281
translate turkish D_astra_new_plan_cdc620b9:

    "Bir an sonra—Astra'nın özgüveninin sebebini anladın."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:282
translate turkish D_astra_new_plan_d7ad7baf:

    "Ailenin önünde mahkemeye çıkarılmış gibi sunuldun."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:283
translate turkish D_astra_new_plan_74ef66ed:

    "Sana söyleyecek söz bulamadıklarını görebiliyorsun."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:286
translate turkish D_astra_new_plan_57bc94d4:

    mom "Tanrım, Austyn... Ah..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:287
translate turkish D_astra_new_plan_a4d89887:

    jannet "Bu... Bu... B-buydu..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:288
translate turkish D_astra_new_plan_ed4aacdb:

    trish "Ah, sana hayranım Austyn!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:289
translate turkish D_astra_new_plan_3050373a:

    "Sadece Trish konuşmaktan çekinmiyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:290
translate turkish D_astra_new_plan_1a0f9698:

    mom "Nasıl yapabilirsin, Trish!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:291
translate turkish D_astra_new_plan_5db1126b:

    jannet "O... Ah... S-sen de kendi gözünle gördün!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:292
translate turkish D_astra_new_plan_46fd7c92:

    astra "Bizim... Bunun... İçin... Vaktimiz... Yok!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:293
translate turkish D_astra_new_plan_66c2f90a:

    "Astra sertçe çıkıştı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:294
translate turkish D_astra_new_plan_06d660ee:

    mom "Ehem-ehem... Burada fiziksel formumuzla olmamıza şaşırmış olmalısın."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:295
translate turkish D_astra_new_plan_b6cd37c5:

    jannet "V-ve belki tuhaf kostümlerimizi de fark etmişsindir."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:296
translate turkish D_astra_new_plan_c4afd794:

    trish "Ah hadi ama, Jannet! O \"tuhaf kostüm\" sana çok yakışıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:297
translate turkish D_astra_new_plan_cc590aca:

    trish "Gerçi buradaki ben muhtemelen böyle bir şeye sığamazdı..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:298
translate turkish D_astra_new_plan_07598eeb:

    trish "O kocaman..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:301
translate turkish D_astra_new_plan_813bdbef:

    astra "Evet, anladık Trish."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:302
translate turkish D_astra_new_plan_2846a125:

    astra "Anne, bu harika kıyafet sayesinde fiziksel olarak ışınlanmayı başardığımızı söylemek istedi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:303
translate turkish D_astra_new_plan_f32816d2:

    mom "Evet, ayrıntıya girmeyeceğiz ama gerçekten canlı bedenler olarak buradayız."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:304
translate turkish D_astra_new_plan_05721e41:

    mom "Yani, şu an bizim dünyamızda hiç yokuz."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:305
translate turkish D_astra_new_plan_ce996102:

    player "Ah, ne... Ne garip... Hiçbir şey anlamıyorum."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:306
translate turkish D_astra_new_plan_cb528f7c:

    player "İmkânsız olduğunu söylemiştiniz. Neden buradasınız?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:307
translate turkish D_astra_new_plan_e6ad8d1f:

    player "Beni geri götürmek mi istiyorsunuz?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:308
translate turkish D_astra_new_plan_44d4e144:

    jannet "Hâlâ imkânsız..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:309
translate turkish D_astra_new_plan_d3b5229b:

    trish "Bu konuda hiçbir şey yapamayız."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:310
translate turkish D_astra_new_plan_b54da684:

    mom "Belki böyle bir kıyafeti sana getirip seni buradan çıkaracağımızı sandın..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:311
translate turkish D_astra_new_plan_03cb3b55:

    mom "Ama kalibrasyonu bizim laboratuvarımızda canlı birinin üzerinde yapılmak zorunda."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:312
translate turkish D_astra_new_plan_c42202f1:

    astra "Ancak Scarlett'in seni yanında çalışmaya davet ettiğini duyduk!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:313
translate turkish D_astra_new_plan_dcb1846d:

    trish "Ve bu, geri dönmen için harika bir şans!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:314
translate turkish D_astra_new_plan_85e931a1:

    trish "Ama tabii göründüğü kadar basit değil..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:315
translate turkish D_astra_new_plan_beccfc45:

    player "B-bana hiçbir zaman basit görünmedi zaten."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:316
translate turkish D_astra_new_plan_3745572f:

    player "S-sen bilirsin... O daveti almak için neler yaptığımı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:317
translate turkish D_astra_new_plan_96935b07:

    player "Ve ondan önce beni nelerin beklediğini hayal bile edemezsin."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:318
translate turkish D_astra_new_plan_034ba18c:

    astra "Tek kelime daha etme. Sana yardım etmek için öğrenebildiğimiz her şeyi inceledik."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:319
translate turkish D_astra_new_plan_3711a614:

    mom "Görgü kuralları ve diğer ayrıntılarla ilgili tüm incelikleri biliyoruz."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:322
translate turkish D_astra_new_plan_d530a31d:

    jannet "B-buyur... Bu senin için."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:323
translate turkish D_astra_new_plan_70324d0a:

    "Şu devasa anal tıkaca şaşkınlıkla bakıyorsun."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:324
translate turkish D_astra_new_plan_6846dbdc:

    astra "\"Gizli oda\"ya girmen için sana bir geçiş getirmenin yolunu uzun süre bulamadık."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:325
translate turkish D_astra_new_plan_5060b494:

    trish "Biz de Jannet'in \"gizli odası\"nı kullandık!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:326
translate turkish D_astra_new_plan_865de4af:

    mom "Kes şunu, Trish! Jannet'in gizli yeteneklerine minnettar olmalıyız!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:327
translate turkish D_astra_new_plan_35bf9d1c:

    astra "Ve inanılmaz hızlı düşünmesine."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:328
translate turkish D_astra_new_plan_277ac7c0:

    trish "Pardon, Jannet. Seni kırmak istemedim..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:329
translate turkish D_astra_new_plan_6d002927:

    trish "Gerçekten becerikli kıçına minnettar olmalıyız."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:332
translate turkish D_astra_new_plan_76378cae:

    "Jannet'in her yeni cümlede utançtan biraz daha büzüldüğünü izliyorsun."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:333
translate turkish D_astra_new_plan_29c6c49c:

    player "T-teşekkürler, Jannet..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:334
translate turkish D_astra_new_plan_28033dea:

    player "Bu... Bu çok etkileyici."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:335
translate turkish D_astra_new_plan_ed24c17e:

    player "İyi anlamda."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:338
translate turkish D_astra_new_plan_95b67e78:

    astra "Nesne teslim edildi, beni duyuyor musunuz?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:339
translate turkish D_astra_new_plan_f6bcf4a8:

    astra "Evet mi?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:340
translate turkish D_astra_new_plan_cfc992ec:

    astra "Pekâlâ kızlar, zamanımız daralıyor."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:341
translate turkish D_astra_new_plan_6ab1b3bd:

    mom "Seninle tekrar iletişime geçeceğiz, tatlım."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:342
translate turkish D_astra_new_plan_7785cc5d:

    mom "Geçiş yapın!"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:346
translate turkish D_astra_new_plan_cdfdc1c2:

    "Bir anda dört kızın hepsi gözlerinin önünde hologramlar gibi buharlaştı."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:367
translate turkish D_astra_new_plan_c29750fa:

    mom "Ah, Tanrım... Neredeyse çıldırıyordum, Tanrım."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:368
translate turkish D_astra_new_plan_0bba543f:

    mom "Nereye gittin?! B-burada ne yapıyorsun?"

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:369
translate turkish D_astra_new_plan_0f9f66db:

    player "P-pardon, kimseyi uyandırmak istemedim."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:370
translate turkish D_astra_new_plan_7d7e2599:

    player "Sadece burada biriyle buluşmaya söz vermiştim ve..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:371
translate turkish D_astra_new_plan_24522da8:

    mom "Elindeki ne öyle? Çok büyük..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:372
translate turkish D_astra_new_plan_6b428e01:

    player "Ah, bu... Evet, buraya o yüzden geldim."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:373
translate turkish D_astra_new_plan_b47e4220:

    player "Satıcıyla burada buluşmak üzere anlaşmıştım ve..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:374
translate turkish D_astra_new_plan_89cfd7d7:

    mom "Hm... Şu şeye dikkat et tatlım..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:375
translate turkish D_astra_new_plan_86d1dfd8:

    mom "Elde ettiklerinle yetinmemene sevindim ama bu..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:376
translate turkish D_astra_new_plan_43ab2742:

    mom "Aşırı görünüyor..."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:378
translate turkish D_astra_new_plan_d59e4a3d:

    mom "İtiraf etmeliyim, hatta biraz da azdırıcı, hi hi."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:380
translate turkish D_astra_new_plan_672ff62a:

    player "Eve gidelim, Anne."

# game/scripts/sequences/3100/astra_new_plan/dialogues.rpy:381
translate turkish D_astra_new_plan_67bbcbca:

    mom "Evet, haklısın."

