    "Kıçını onun kasığına yaslayınca Trish'in harekete hazır olduğunu şimdiden hissedebiliyordun."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:8
translate turkish D_trish_repeatable_anal_02_9baa3b4c:

    trish "Ah... Austyn...."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:9
translate turkish D_trish_repeatable_anal_02_2aeb744a:

    player "Hoşuna gidiyor mu?"

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:12
translate turkish D_trish_repeatable_anal_02_fc5ee54f:

    "Bir anda şortunu ve külotunu sıyırıyorsun..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:17
translate turkish D_trish_repeatable_anal_02_4e5f20b4:

    trish "Ah, şu kıç..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:18
translate turkish D_trish_repeatable_anal_02_a76f2f19:

    trish "Antrenman sana yaramış, seni yaramaz..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:19
translate turkish D_trish_repeatable_anal_02_43b93a8d:

    player "Daha yeni başlıyorum... Ah..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:22
translate turkish D_trish_repeatable_anal_02_6640a2e3:

    "Kalın sikinin üstüne çökmeye başlıyorsun."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:27
translate turkish D_trish_repeatable_anal_02_77bd0b79:

    "Kendinden emin hamlelerle Trish'ten inlemeler koparıyorsun."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:28
translate turkish D_trish_repeatable_anal_02_742e5e7d:

    trish "Sikim o kıçın içinde eriyip gidiyor..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:29
translate turkish D_trish_repeatable_anal_02_2f6bb5fb:

    "Hızlanıp güçlü hareketlerle sallanmaya başlıyorsun."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:30
translate turkish D_trish_repeatable_anal_02_c22ebb3c:

    player "Sen boşalana kadar durmayacağım."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:31
translate turkish D_trish_repeatable_anal_02_496a0885:

    "Oda, kıçının sert şaplaklarıyla yankılanıyor."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:32
translate turkish D_trish_repeatable_anal_02_e36947d1:

    "Kıçınla Trish'i yumuşak yatağa gayretle çakıyorsun..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:33
translate turkish D_trish_repeatable_anal_02_2d8f0e53:

    "Sevgili arkadaşından tamamen doyamıyorsun."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:34
translate turkish D_trish_repeatable_anal_02_a514da80:

    trish "Ah... Austyn..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:38
translate turkish D_trish_repeatable_anal_02_9fafe498:

    trish "Evet..."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:39
translate turkish D_trish_repeatable_anal_02_1fde48cd:

    "Trish'i sınıra getirip kasığını tamamen sikinin üzerine bastırıyorsun."

# game/scripts/sequences/3100/trish_repeatable_anal_02/dialogues.rpy:40
translate turkish D_trish_repeatable_anal_02_b00bb13c:

    "İçinin sıcak sularla dolduğunu hissederken biraz daha tadını çıkarmaya karar veriyorsun."

