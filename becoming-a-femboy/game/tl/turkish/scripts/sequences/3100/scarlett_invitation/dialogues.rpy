# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:3
translate turkish D_scarlett_invitation_f80f33ee:

    "Daha yeni uyanıyorsun ve annen kapını çalıyor."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:6
translate turkish D_scarlett_invitation_ab436c90:

    mom "Tatlım, ziyaretçilerin var..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:7
translate turkish D_scarlett_invitation_c21f3f03:

    sally "Hey, günaydın!"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:8
translate turkish D_scarlett_invitation_38b0ca92:

    lilly "Bizi beklemiyordun, değil mi? Haha."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:15
translate turkish D_scarlett_invitation_89b7f633:

    player "N-neler oluyor burada?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:16
translate turkish D_scarlett_invitation_7a740e02:

    mom "Sizi yalnız bırakıyorum. Scarlett beni bekliyor."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:17
translate turkish D_scarlett_invitation_f3c5748a:

    player "Scarlett de mi burada?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:20
translate turkish D_scarlett_invitation_c9c228da:

    sally "Tabii ki Hanımefendimiz burada."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:22
translate turkish D_scarlett_invitation_5b0d6974:

    lilly "Onsuz biz ne yapardık ki!"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:23
translate turkish D_scarlett_invitation_62e10bcc:

    sally "Scarlett'in seni malikanesinde çalışmaya davet etmek istediğini biliyor musun?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:24
translate turkish D_scarlett_invitation_875b32a7:

    player "Çalışmak mı?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:25
translate turkish D_scarlett_invitation_77e1c150:

    sally "Evet! Eğlenceli olacak! Hizmette gerçekten fazladan sadık ellere ihtiyacımız var..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:26
translate turkish D_scarlett_invitation_09a08f17:

    player "Hizmette mi?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:27
translate turkish D_scarlett_invitation_b3671556:

    lilly "Hep son kelimeyi mi tekrarlayacaksın?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:28
translate turkish D_scarlett_invitation_09250533:

    lilly "Sağır olmadığını gayet iyi biliyoruz."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:29
translate turkish D_scarlett_invitation_16b45bef:

    lilly "Evet, bir iş. Evet, hizmet."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:30
translate turkish D_scarlett_invitation_78ea4ce2:

    player "Ne düşüneceğimi bile bilmiyorum... Ç-çok ani..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:31
translate turkish D_scarlett_invitation_05ad99e1:

    sally "Ah, \"tatlım\". Bak, durum şu."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:32
translate turkish D_scarlett_invitation_37b025bc:

    sally "Böyle teklifler asla beklenmez."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:33
translate turkish D_scarlett_invitation_2e939eea:

    sally "Hep böyle olur, sihir gibi, hi hi."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:34
translate turkish D_scarlett_invitation_53097d8b:

    lilly "Evet, ne yazık ki teklif sadece bir formalite."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:35
translate turkish D_scarlett_invitation_a6582d28:

    lilly "Aslında zaten içerdesin."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:36
translate turkish D_scarlett_invitation_f3eb0c5e:

    lilly "Biz sadece sana kuralları söylemeye geldik."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:37
translate turkish D_scarlett_invitation_f4ac493d:

    player "Ah... Hiçbir şey anlamıyorum..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:38
translate turkish D_scarlett_invitation_f1ba413a:

    sally "Çok basit! Bir şey anlamana gerek yok."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:39
translate turkish D_scarlett_invitation_84843755:

    sally "Sadece hizmet edeceksin ve sana söyleneni yapacaksın."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:40
translate turkish D_scarlett_invitation_4eb07c7b:

    lilly "Evet, sadece kuralları sana sıralamak istiyoruz..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:41
translate turkish D_scarlett_invitation_2bd0e455:

    lilly "Birincisi, Malikâne'ye hizmet bağını kabul ederek kafes takmak zorundasın."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:42
translate turkish D_scarlett_invitation_a533c9b4:

    sally "Her zaman. Bu, özgürlükten vazgeçmenin bir göstergesi."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:43
translate turkish D_scarlett_invitation_af929511:

    lilly "İkincisi, kıçın her zaman kapalı olmalı..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:44
translate turkish D_scarlett_invitation_8bbca957:

    sally "Ve sadece kıyafet yetmez..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:45
translate turkish D_scarlett_invitation_34b479bf:

    lilly "Sanırım Austy neden bahsettiğimizi anladı."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:46
translate turkish D_scarlett_invitation_8168354b:

    sally "Kıçında bir tıkaç olmalı! Her zaman!"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:47
translate turkish D_scarlett_invitation_086380df:

    lilly "Ah... Sally..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:48
translate turkish D_scarlett_invitation_81925a92:

    lilly "Eh, evet, kıçındaki tıkaçtan bahsediyoruz."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:49
translate turkish D_scarlett_invitation_2c484539:

    sally "Hanımefendin için her an yardıma hazır olduğunu simgeliyor."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:50
translate turkish D_scarlett_invitation_c5e45559:

    lilly "Ehem... Ya da onun dilediği herkes için."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:51
translate turkish D_scarlett_invitation_247df8cf:

    lilly "Malikâne'ye hizmet etmek Hanımefendi'den fazlası."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:52
translate turkish D_scarlett_invitation_bff4629a:

    lilly "Hanımefendi sadece bizim rehberimiz, anladın mı?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:53
translate turkish D_scarlett_invitation_a9c2b754:

    player "*kafası karışık başını sallıyor*"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:54
translate turkish D_scarlett_invitation_4437cf8f:

    sally "Ve en önemlisi... Hizmete hiçbir şeyle gelmiyorsun."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:55
translate turkish D_scarlett_invitation_d5a67b41:

    sally "Malikâne'de ihtiyacın olan her şey var."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:56
translate turkish D_scarlett_invitation_6c77e1df:

    lilly "Evet, eşiği geçtiğin an, çıplak geçmelisin."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:57
translate turkish D_scarlett_invitation_b0943623:

    sally "Evet, baş görevlimiz Barbara gelişinde her şeyle ilgilenecek."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:58
translate turkish D_scarlett_invitation_99f20b75:

    player "{i}Ah, Tanrım, ne kadar çok bilgi...{/i}"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:59
translate turkish D_scarlett_invitation_14b067e3:

    player "E-evet, hepsini anladım... Teşekkürler."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:60
translate turkish D_scarlett_invitation_eef4b36a:

    sally "Peki, Malikâne'nin şanı yüceyse."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:61
translate turkish D_scarlett_invitation_d9863e41:

    lilly "Açıklamayı unuttum. Küçük kafesi ve anal tıkacı da sana verecekler..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:62
translate turkish D_scarlett_invitation_a10c1cdd:

    scarlett "Gitme vaktimiz geldi."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:63
translate turkish D_scarlett_invitation_719e0685:

    sally "Görüşürüz!"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:64
translate turkish D_scarlett_invitation_29f0b1bc:

    player "N-neydi o? Scarlett'le ne konuşuyordunuz?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:65
translate turkish D_scarlett_invitation_597e736c:

    mom "Senin onların dini kampına gidişini ayarlıyorduk!"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:66
translate turkish D_scarlett_invitation_12c76441:

    mom "Ve bence senin için harika bir fırsat!"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:67
translate turkish D_scarlett_invitation_f975c055:

    player "B-bana fanatik gibi konuşuyorlarmış gibi geldi..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:68
translate turkish D_scarlett_invitation_ce831875:

    player "Gerçekten güvenli mi?"

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:69
translate turkish D_scarlett_invitation_21f6d6ba:

    mom "Rahat ol tatlım. Bunu geçici bir ek iş olarak düşün."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:70
translate turkish D_scarlett_invitation_cf2da2cf:

    mom "Scarlett sadece sana iyi geleceğine dair bana güvence verdi."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:71
translate turkish D_scarlett_invitation_03976d6a:

    player "Ah, evet, ona inanmamak için ne sebep var ki..."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:72
translate turkish D_scarlett_invitation_01e17ec8:

    mom "Evet, Scarlett saygın biri. Ve bunun bir şekilde dinle bağlantılı olması önemli değil."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:73
translate turkish D_scarlett_invitation_906d4e41:

    mom "Asıl mesele, düzgünce hazırlanmak."

# game/scripts/sequences/3100/scarlett_invitation/dialogues.rpy:74
translate turkish D_scarlett_invitation_7f997e28:

    player "Ah, işte o Malikâne... Hedefime yaklaşıyor gibiyim."

