# game/scripts/sequences/frankly_conversation/dialogues.rpy:5
translate turkish D_jannet_frankly_conversation_ddc30db0:

    player "M-merhaba Jannet."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:6
translate turkish D_jannet_frankly_conversation_ac917fc1:

    player "{i}Ah, gördüklerimden sonra gözlerinin içine bakmak zor.{/i}"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:7
translate turkish D_jannet_frankly_conversation_847e87b7:

    player "{i}Şimdi ağzındaki o sağlam sikten başka bir şey hayal edemiyorum.{/i}"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:8
translate turkish D_jannet_frankly_conversation_dce95069:

    jannet "Bir şey mi oldu? Endişeli görünüyorsun."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:9
translate turkish D_jannet_frankly_conversation_857f671f:

    player "Şey, nasıl söylesem.. evet, bir şey var."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:10
translate turkish D_jannet_frankly_conversation_bc05aca9:

    jannet "Ne oldu?"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:11
translate turkish D_jannet_frankly_conversation_c6854000:

    player "Ah, sence ne?"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:12
translate turkish D_jannet_frankly_conversation_7fdd63df:

    jannet "Hiçbir şey aklıma gelmiyor, bebeğim.."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:13
translate turkish D_jannet_frankly_conversation_7bc32882:

    jannet "Benimle daha açık konuşabilir misin? Janny'in için, hi hi."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:14
translate turkish D_jannet_frankly_conversation_34b05fc1:

    player "{i}Ne kadar neşeli..{/i}"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:15
translate turkish D_jannet_frankly_conversation_68de4955:

    player "Şey... Bana gönderdiğin o fotoğraf hakkında konuşmak istiyordum..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:16
translate turkish D_jannet_frankly_conversation_0981d5eb:

    jannet "Oh, sonunda, hi hi."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:17
translate turkish D_jannet_frankly_conversation_761cefd8:

    jannet "Yorum bile yapmadın."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:18
translate turkish D_jannet_frankly_conversation_71c6529e:

    player "Ş-şey... Bu konuda sana ne diyeceğimi bilmiyorum..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:19
translate turkish D_jannet_frankly_conversation_1e2d980d:

    player "Dürüst olmak gerekirse çok utanmış ve kafam karışık durumdayım."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:20
translate turkish D_jannet_frankly_conversation_e6f82d05:

    jannet "Kız arkadaşının senin gibi koca sikleri sevmesi seni rahatsız mı ediyor?"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:21
translate turkish D_jannet_frankly_conversation_40397efb:

    jannet "Zevklerimizin uyuşması çok güzel, ha-ha."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:22
translate turkish D_jannet_frankly_conversation_b7c84a39:

    player "S-sen gerçekten öyle mi düşünüyorsun?"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:23
translate turkish D_jannet_frankly_conversation_4da8a9c7:

    player "S-sen bana hiç söylemedin, sende ne var... Başka biri.."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:24
translate turkish D_jannet_frankly_conversation_0c3f63b8:

    player "Seninle benim çift olduğumuzu sanıyordum..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:25
translate turkish D_jannet_frankly_conversation_aca8b48c:

    jannet "Şey, bilirsin, yakın zamana kadar seninle cinsel olarak ilgilenebileceğimi düşünmüyordum."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:26
translate turkish D_jannet_frankly_conversation_887feb68:

    jannet "Benim gibi bir kızın bunca zaman kendini bir şeyle tatmin ettiğini tahmin etmeliydin... Bana çok açık görünüyordu."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:27
translate turkish D_jannet_frankly_conversation_a39c0535:

    player "A-ama... Bunun için bana sahip olduğunu sanıyordum ve..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:28
translate turkish D_jannet_frankly_conversation_b55afed9:

    player "Ve... biz sadece yavaş yavaş böyle bir şeye yaklaşıyoruz..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:29
translate turkish D_jannet_frankly_conversation_c03e6283:

    jannet "Hayır, buna yavaş yavaş ilerleyen sadece sensin. Ben bunu çok uzun zamandır yapıyorum."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:30
translate turkish D_jannet_frankly_conversation_dc965784:

    jannet "Anlıyorsun ya, olgunlaşmanı yıllardır bekliyorum. Artık neredeyse hazırsın."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:31
translate turkish D_jannet_frankly_conversation_492dec09:

    player "Neye hazır..?"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:32
translate turkish D_jannet_frankly_conversation_a84127cd:

    jannet "Seks için... benimle."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:33
translate turkish D_jannet_frankly_conversation_01305082:

    jannet "Sevdiğin biriyle bunu yapmanın ne kadar daha hoş olacağını anlıyorsun ya ..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:34
translate turkish D_jannet_frankly_conversation_e0c2f0c0:

    player "{i}Benimle seks yapmak mı istiyor?{/i}"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:35
translate turkish D_jannet_frankly_conversation_3da015d0:

    jannet "Kıçın büyük sert bir sikle becerilirken güvenebileceğin birini ne kadar özleyeceğini hayal bile edemezsin."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:36
translate turkish D_jannet_frankly_conversation_194421bd:

    player "?!"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:37
translate turkish D_jannet_frankly_conversation_7ad405be:

    jannet "Keşke o sırada güvenebileceğim biri olsaydı ... Çok yakın biri de darbeyi paylaşabilirdi."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:38
translate turkish D_jannet_frankly_conversation_2c03e6d4:

    player "Darbeyi mi paylaşmak? Oh..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:39
translate turkish D_jannet_frankly_conversation_ddc6fa01:

    jannet "Evet. Seninle benim birlikte ne kadar eğlenebileceğimizi bilemezsin.."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:40
translate turkish D_jannet_frankly_conversation_0ea4d89d:

    jannet "Birlikte kaç tane sağlam sikin keyfini çıkarabiliriz!"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:41
translate turkish D_jannet_frankly_conversation_b6365c16:

    jannet "Gözlerimin önünde masumiyetini kaybederken kıçının sikle dolduğunu görmeyi ne kadar çok isteyeceğimi tahmin bile edemezsin."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:42
translate turkish D_jannet_frankly_conversation_6bbca586:

    player "{i} Görünüşe göre Janny gerçekten çok azmış... {/i}"

# game/scripts/sequences/frankly_conversation/dialogues.rpy:43
translate turkish D_jannet_frankly_conversation_87c3d029:

    jannet "Ama sen kendini keşfetmekle vakit kaybedip kaçınılmazdan kaçarken - ben bunu tek başıma yaşamak zorunda kalıyorum... Üstelik bir de beni yanlış bir şey yapmakla suçluyorsun."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:44
translate turkish D_jannet_frankly_conversation_d9b1f5ed:

    jannet "Biliyor musun? Bence sahip olduğun şeyin kıymetini hiç bilmiyorsun."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:48
translate turkish D_jannet_frankly_conversation_0d75cae2:

    player "Ah... ne kadar... sert ruh hali değişimleri... ve..."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:49
translate turkish D_jannet_frankly_conversation_aa353005:

    player "Onu ne kadar endişelendirebileceğini düşünmemiştim bile."

# game/scripts/sequences/frankly_conversation/dialogues.rpy:50
translate turkish D_jannet_frankly_conversation_0fe77dd5:

    player "B-bütün bunları düşünmeliydim..."

