translate turkish D_meet_anna_59012467:

    player "Şey.. yani.. ne diyeceğimi bilemiyorum."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:35
translate turkish D_meet_anna_f2617140:

    anna "Utanma. Burada çok pahalı aletler var."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:36
translate turkish D_meet_anna_f33f0705:

    anna "Sana kendi aletlerini edinmeni tavsiye ederim... en azından başlangıç için birkaç basit tane."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:38
translate turkish D_meet_anna_03513bae:

    player "Kendi aletlerimi mi? Off, bunu ne düşüneceğimi bile bilmiyorum. Param yok."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:40
translate turkish D_meet_anna_a3b3c6fa:

    anna "Paran yok mu? Femboy'sun ve hâlâ işsizsin? Bu bir tür mucize olmalı!"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:42
translate turkish D_meet_anna_e5e027a9:

    anna "Bizim kafeye gel. Hastaneye uzak değil."

