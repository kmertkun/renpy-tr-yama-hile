    anna "Mirina yaptırıyor. Kötü davranışın cezası gibi bir şey."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:14
translate turkish D_meet_anna_f7740bd0:

    player "Ne yaptın?"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:16
translate turkish D_meet_anna_3406f0c0:

    anna "Ah.. ş-şey.. şu an o kadar önemli değil. Adın ne?"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:18
translate turkish D_meet_anna_c2f7f4b8:

    player "Ben Austyn.."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:19
translate turkish D_meet_anna_8b6334b0:

    anna "Ben de Anna. Tanıştığımıza çok memnun oldum, Austyn."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:22
translate turkish D_meet_anna_7835f9e0:

    anna "Çok ilginç bir saç rengin var. Çok sıra dışı görünüyor."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:23
translate turkish D_meet_anna_73734dd5:

    player "Ah, gerçekten mi?"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:24
translate turkish D_meet_anna_bce239c8:

    anna "Mavi saçlı sadece bir kişi daha görmüştüm."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:25
translate turkish D_meet_anna_976cfe04:

    player "Hah, bütün ailem böyle. Annem, kız kardeşim... herkesin saçı mavi!"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:26
translate turkish D_meet_anna_641806d0:

    anna "Vay, ne harika! Onları bir ara kesinlikle görmeliyim, hihi."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:27
translate turkish D_meet_anna_3b9fafee:

    anna "Buraya neden geldin? İlk seferin mi?"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:28
translate turkish D_meet_anna_59295442:

    player "Evet.. ne olacağını bile bilmiyorum."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:29
translate turkish D_meet_anna_a88d5c0f:

    anna "Ah, şey.. sana sadece şans dileyebilirim."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:30
translate turkish D_meet_anna_e27b7c43:

    player "Burada neler oluyor?"

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:31
translate turkish D_meet_anna_62bb13f0:

    anna "Cinsel nitelikte dersler var. Oral, anal ve daha fazlası."

# game/scripts/sequences/other/work_in_cafe/dialogues.rpy:32
translate turkish D_meet_anna_f92edaba:

    player "Oh... etraftaki bu şeyler bunun için demek."

