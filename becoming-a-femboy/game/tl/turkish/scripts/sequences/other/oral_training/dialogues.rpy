# game/scripts/sequences/other/oral_training/dialogues.rpy:54
translate turkish D_mirina_oral_lesson_00_ba88adcb:

    mirina "Sorun değil. Çözülemeyecek sorun yoktur, Austyn."

# game/scripts/sequences/other/oral_training/dialogues.rpy:55
translate turkish D_mirina_oral_lesson_00_da1ddb64:

    mirina "Ben söyleyene kadar ağzını açık tut ve kapatma. Anladın mı?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:56
translate turkish D_mirina_oral_lesson_00_0c081e71:

    player "Evet."

# game/scripts/sequences/other/oral_training/dialogues.rpy:57
translate turkish D_mirina_oral_lesson_00_d8323779:

    mirina "Güzel. Şimdi refleksini test edeceğim. Rahatla."

# game/scripts/sequences/other/oral_training/dialogues.rpy:89
translate turkish D_breathing_game_lose_b02d15a9:

    mirina "Aman tanrım.. çok erken pes ettin. Hadi tekrar. En az 5 saniye dayanmaya çalış."

# game/scripts/sequences/other/oral_training/dialogues.rpy:90
translate turkish D_breathing_game_lose_8d29669b:

    mirina "Mirina parmağını yine ağzına sokar."

# game/scripts/sequences/other/oral_training/dialogues.rpy:96
translate turkish D_breathing_game_lose_478f5ba0:

    mirina "Tekrar deneyecek misin?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:120
translate turkish D_mirina_oral_lesson_00_continue_75069c73:

    mirina "Şimdi basit bir egzersiz yapalım."

# game/scripts/sequences/other/oral_training/dialogues.rpy:121
translate turkish D_mirina_oral_lesson_00_continue_10fd83d7:

    mirina "Ağzını aç, ben de seni nazikçe dolduracağım."

# game/scripts/sequences/other/oral_training/dialogues.rpy:122
translate turkish D_mirina_oral_lesson_00_continue_a6cf355a:

    player "Burada, herkesin önünde mi?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:123
translate turkish D_mirina_oral_lesson_00_continue_774727c2:

    mirina "Rahat ol, sorun yok. Sorun yok."

# game/scripts/sequences/other/oral_training/dialogues.rpy:129
translate turkish D_mirina_oral_lesson_00_continue_eb68daf4:

    "Ağzını açıyorsun ve Mirina küçük bir dildoyu ağzına nazikçe yerleştiriyor."

# game/scripts/sequences/other/oral_training/dialogues.rpy:130
translate turkish D_mirina_oral_lesson_00_continue_5d3295eb:

    mirina "İşte böyle, aferin."

# game/scripts/sequences/other/oral_training/dialogues.rpy:136
translate turkish D_mirina_oral_lesson_00_continue_3f0c8929:

    mirina "Korkma, dikkatli yapacağım.."

# game/scripts/sequences/other/oral_training/dialogues.rpy:137
translate turkish D_mirina_oral_lesson_00_continue_bd32f5ec:

    player "Ah.. ne yapıyoruz biz? Bana emmeyi mi öğretiyor?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:138
translate turkish D_mirina_oral_lesson_00_continue_527c053d:

    mirina "Evet, doğru.. hisset.. dişlerinle dokunmamaya çalış."

# game/scripts/sequences/other/oral_training/dialogues.rpy:139
translate turkish D_mirina_oral_lesson_00_continue_f5c4130b:

    player "Çok.. çok zor.. Oysa sadece birkaç santim emiyorum."

# game/scripts/sequences/other/oral_training/dialogues.rpy:140
translate turkish D_mirina_oral_lesson_00_continue_0795b831:

    mirina "Tükürüğünü yut.. tükürme."

# game/scripts/sequences/other/oral_training/dialogues.rpy:158
translate turkish D_mirina_oral_lesson_00_continue_9f72788d:

    mirina "Evet, 5 dakika oldu. Süre doldu."

# game/scripts/sequences/other/oral_training/dialogues.rpy:170
translate turkish D_mirina_oral_lesson_00_continue_3adb7dff:

    player "Argh, bu da ne?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:171
translate turkish D_mirina_oral_lesson_00_continue_d8e28382:

    mirina "İşte böyle, aferin. Çok iyi. Hepsini yut."

# game/scripts/sequences/other/oral_training/dialogues.rpy:175
translate turkish D_mirina_oral_lesson_00_continue_a02e7643:

    mirina "Aferin oğluma."

# game/scripts/sequences/other/oral_training/dialogues.rpy:185
translate turkish D_mirina_oral_lesson_00_ending_845ec9ee:

    mirina "Harika iş. İlk antrenman için gayet iyiydin.."

# game/scripts/sequences/other/oral_training/dialogues.rpy:186
translate turkish D_mirina_oral_lesson_00_ending_71bd043c:

    player "N-Nesiydi o sonda?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:187
translate turkish D_mirina_oral_lesson_00_ending_ba83382c:

    mirina "O mu? Tohum tabii ki, şapşal."

# game/scripts/sequences/other/oral_training/dialogues.rpy:188
translate turkish D_mirina_oral_lesson_00_ending_64ea51cf:

    player "T-tohum mu? Gerçekten mi? Bir oyuncağın içinde mi?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:189
translate turkish D_mirina_oral_lesson_00_ending_c5393400:

    mirina "Evet, sentezlenmiş futanari tohumu. Tek kullanımlık bir oral eğitim dildosu bu."

# game/scripts/sequences/other/oral_training/dialogues.rpy:190
translate turkish D_mirina_oral_lesson_00_ending_7730414a:

    mirina "Ama bu bir eğitim modeli. Üzerinde bir düğme var, görüyor musun?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:191
translate turkish D_mirina_oral_lesson_00_ending_409f8109:

    mirina "Mağazalarda satılan normal olanlarda düğme yok. Onlarla tohum için epey uğraşman gerekiyor, hihi."

# game/scripts/sequences/other/oral_training/dialogues.rpy:192
translate turkish D_mirina_oral_lesson_00_ending_36389dbb:

    player "Zamanının geldiğini.. şey.. nereden anlıyor?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:193
translate turkish D_mirina_oral_lesson_00_ending_5d487aab:

    mirina "Aman, sorma bile. Ben doktorum, dahi bir mühendis değil."

# game/scripts/sequences/other/oral_training/dialogues.rpy:194
translate turkish D_mirina_oral_lesson_00_ending_8cfe2e99:

    mirina "Nasıl yaptıklarını bilmiyorum ama tıpkı normal bir erkeklik organı gibi çalışıyor."

# game/scripts/sequences/other/oral_training/dialogues.rpy:195
translate turkish D_mirina_oral_lesson_00_ending_2db171f9:

    mirina "Böyle bir sonuca nasıl ulaştıklarına dair hiçbir fikrim yok ama harika, değil mi?"

# game/scripts/sequences/other/oral_training/dialogues.rpy:196
translate turkish D_mirina_oral_lesson_00_ending_6f07ba7f:

    player "E-evet.. öyle.. doğru.."

# game/scripts/sequences/other/oral_training/dialogues.rpy:197
translate turkish D_mirina_oral_lesson_00_ending_512de05b:

    mirina "Özel sevgililer için içinde erkek tohumu olanları da var, hihi."

# game/scripts/sequences/other/oral_training/dialogues.rpy:198
translate turkish D_mirina_oral_lesson_00_ending_02b66767:

    mirina "Bir de farklı boyutları var. Boyut büyüdükçe içindeki tohum da artıyor."

# game/scripts/sequences/other/oral_training/dialogues.rpy:199
translate turkish D_mirina_oral_lesson_00_ending_8cb87738:

    mirina "Ama onlarla başa çıkmak çok daha zor, biliyorsun."

# game/scripts/sequences/other/oral_training/dialogues.rpy:200
translate turkish D_mirina_oral_lesson_00_ending_577ac671:

    mirina "Neyse, yine gel, daha gidecek çok yolun var."

