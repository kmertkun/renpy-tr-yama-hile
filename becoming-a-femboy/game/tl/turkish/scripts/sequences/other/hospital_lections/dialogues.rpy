# game/scripts/sequences/other/hospital_lections/dialogues.rpy:6
translate turkish D_hospital_lection_sequence_0_6535eaf3:

    mirina "Bugünkü derse hepinizin geldiğini görmekten çok memnunum."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:7
translate turkish D_hospital_lection_sequence_0_eda4dc3f:

    mirina "Toplumumuzda kendinizi bulma yolunda buraya gelerek doğru bir adım atıyorsunuz."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:8
translate turkish D_hospital_lection_sequence_0_2443c041:

    mirina "Adım Dr. Mirina. Sizin için bir giriş kursu vereceğim."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:9
translate turkish D_hospital_lection_sequence_0_955efab9:

    mirina "Bugünün konusu femboy türünün evrimi."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:10
translate turkish D_hospital_lection_sequence_0_f2a79e7f:

    player "{i}Etrafımdaki bu insanların hepsi de femboy mu?{/i}"

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:11
translate turkish D_hospital_lection_sequence_0_44b7117e:

    player "{i}Bazıları kızlardan hiç ayırt edilemiyor!{/i}"

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:14
translate turkish D_hospital_lection_sequence_0_f0f959b3:

    mirina "Şimdi. İstatistiklerle başlayalım."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:17
translate turkish D_hospital_lection_sequence_0_7f554104:

    mirina "Femboylar çoğunlukla erkeklerle kadınların değil, bir futa ile bir kadının birleşmesinin sonucu doğar."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:18
translate turkish D_hospital_lection_sequence_0_7d4092c7:

    mirina "Bunun nedeni, bir femboyun dolu dolu bir yaşam için çok daha fazla kadın hormonuna ihtiyaç duymasıdır."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:19
translate turkish D_hospital_lection_sequence_0_974edf41:

    mirina "Ve bu kadar saçma miktarda östrojeni sadece tam teşekküllü bir kadın ve futanari gibi bir süper kadın verebilir"

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:23
translate turkish D_hospital_lection_sequence_0_72013727:

    mirina "Ancak bir femboy, bir erkekle birleşmeden de doğabilir, ama sadece her iki bireyin de genetik yapısında futanari varsa."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:24
translate turkish D_hospital_lection_sequence_0_75e01d0a:

    mirina "Bu bilgiyi istediğiniz gibi değerlendirebilirsiniz, benim işim yalnızca elimizdeki istatistiklerden çıkan çıplak gerçekleri anlatmak."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:28
translate turkish D_hospital_lection_sequence_0_3709a765:

    mirina "Genel olarak, bu kadar çok östrojen yüzünden, bir femboyun penisi - bir organ olarak - sadece köreldiği söylenebilir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:29
translate turkish D_hospital_lection_sequence_0_00611f5c:

    mirina "Yani pratik bir kullanımı ve anlamı yok."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:30
translate turkish D_hospital_lection_sequence_0_c48eae8a:

    mirina "Bir femboyun penisi, klitoris ile erkek sikinin arasında bir şeydir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:31
translate turkish D_hospital_lection_sequence_0_5144016d:

    mirina "Uyarılması mümkündür ama boşalan sperm hiçbir bireyin döllenmesine yol açmaz."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:32
translate turkish D_hospital_lection_sequence_0_4b62956c:

    mirina "Bu artık doğrulanmış bir gerçek ve muhtemelen kimse buna itiraz etmeyecek."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:36
translate turkish D_hospital_lection_sequence_0_53a92c14:

    mirina "Bir femboyun vücudunda iyi, sağlıklı hormon seviyelerini korumak için iyi bir doz öz tüketilmelidir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:37
translate turkish D_hospital_lection_sequence_0_b58fa457:

    mirina "Sperm doğal kaynaktır."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:38
translate turkish D_hospital_lection_sequence_0_def090e9:

    mirina "Tohumun kalitesi, sahibinin testislerinin boyutuna bağlıdır."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:39
translate turkish D_hospital_lection_sequence_0_748df45c:

    mirina "Tabii ki bunun bir futanari tohumu olması tercih edilir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:40
translate turkish D_hospital_lection_sequence_0_45a9783c:

    mirina "Ayrıca tohum, bir kadının organlarından hatta bir erkeğin ya da kadının kolonundan gelen sularla karıştırılırsa daha büyük etki gösterir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:41
translate turkish D_hospital_lection_sequence_0_92bab379:

    mirina "Ama ikinci durumda her zaman hijyen kurallarına uymalısınız."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:42
translate turkish D_hospital_lection_sequence_0_9e04a566:

    mirina "Genel olarak tohum, doğrudan kullanılmasa bile olumlu bir etki yapar."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:43
translate turkish D_hospital_lection_sequence_0_c0749373:

    mirina "Diyelim ki cilt dokusuna sürerseniz - vücudun bazı bölgelerinin gençleşmesine yardımcı olabilir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:47
translate turkish D_hospital_lection_sequence_0_dc67ed9f:

    mirina "Femboy türünün evrimi sonucunda - partnerin tohum üretme yeteneğini artırmak için - tür bazı özel yetenekler kazandı."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:48
translate turkish D_hospital_lection_sequence_0_a9fa55f5:

    mirina "Örneğin. Femboyların çene bölgesinde çok gelişmiş bağlar ve oldukça esnek bir boğaz vardır."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:49
translate turkish D_hospital_lection_sequence_0_e8781977:

    mirina "Yani sağlığınıza zarar vermeyecek şekilde gelişebilirler."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:50
translate turkish D_hospital_lection_sequence_0_af0bf53b:

    mirina "Ama bunun için fallik organı taklit eden özel aletler üzerinde pratik yapmanız gerekir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:51
translate turkish D_hospital_lection_sequence_0_6e9c8c64:

    mirina "Doktor tavsiyesi, en az 15 cm uzunluktaki bir boyla başlamanızdır, çünkü bu bir futanari üreme organının asgari boyutu sayılır."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:52
translate turkish D_hospital_lection_sequence_0_c99de8ca:

    mirina "Hastanemizde egzersiz için özel bir oda var."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:53
translate turkish D_hospital_lection_sequence_0_352ef16d:

    mirina "Orada antrenmana başlamak için ihtiyacınız olan her şeyi bulacaksınız."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:57
translate turkish D_hospital_lection_sequence_0_84112aec:

    mirina "Anal ilişki açısından da durum benzer."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:58
translate turkish D_hospital_lection_sequence_0_bade3d89:

    mirina "Bir femboyun kalın bağırsağı da, tıpkı bir kadının vajinası gibi iyi bir esnekliğe sahiptir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:59
translate turkish D_hospital_lection_sequence_0_e4215245:

    mirina "Ancak antrenman ihmal edilmemeli, çünkü hem boğaz hem de bağırsaklar zarar görebilir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:63
translate turkish D_hospital_lection_sequence_0_a0c8edbf:

    mirina "Doktorlar, hoş olmayan durumlardan kaçınmak için anüsü esnetmeye yarayan aletlerin kullanılmasını şiddetle tavsiye eder."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:64
translate turkish D_hospital_lection_sequence_0_57a56dd5:

    mirina "Bunları neredeyse her yerden satın alabilirsiniz."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:65
translate turkish D_hospital_lection_sequence_0_7294d663:

    mirina "Femboylar kayganlaştırıcı ve hijyen konusunda da aynı derecede iyidir."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:66
translate turkish D_hospital_lection_sequence_0_04232443:

    mirina "Bu, düzenli olarak özel ürünler kullanmak zorunda olan kadınlar ve erkekler için büyük bir avantajdır."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:67
translate turkish D_hospital_lection_sequence_0_9a503658:

    mirina "Ama sizin durumunuzda da fazlalık olmazlar."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:68
translate turkish D_hospital_lection_sequence_0_eefe25af:

    mirina "Yani güvenli ilişki için en asgari hijyen kurallarına uymanız gerekir ve her şey yolunda olur."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:69
translate turkish D_hospital_lection_sequence_0_e1871ae6:

    mirina "Evrim sonucunda bu özellikler türünüzü korumak için ortaya çıktı."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:70
translate turkish D_hospital_lection_sequence_0_c17f8ac2:

    mirina "Eskiden femboylar yalnızca seks ihtiyaçlarını gidermeye hizmet ederdi."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:71
translate turkish D_hospital_lection_sequence_0_86d5289a:

    mirina "Yani atalarınızın güvende kalmak için ne kadar katlanmak zorunda kaldığını hayal edebilirsiniz, tee hee."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:75
translate turkish D_hospital_lection_sequence_0_bff97ddd:

    mirina "Geniş aile olgusunu duymuş olabilirsiniz. Yani hormona duyulan bu kadar güçlü ihtiyaç sonucunda ortaya çıktılar."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:76
translate turkish D_hospital_lection_sequence_0_28b13d74:

    mirina "Femboylar tarih boyunca, sağlıklı sperm tüketimi için tam zamanında normal çiftlere kolayca yerleşti."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:77
translate turkish D_hospital_lection_sequence_0_a28db174:

    mirina "Sizin için bu, cinsel ilişki açısından harika fırsatlar sunuyor, çünkü birleşen herhangi bir çiftle mutlu olabilirsiniz."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:78
translate turkish D_hospital_lection_sequence_0_cab2a2c1:

    mirina "Benden bu kadar. Gündüz ve akşam antrenman için hastaneyi özgürce ziyaret edebilirsiniz."

# game/scripts/sequences/other/hospital_lections/dialogues.rpy:79
translate turkish D_hospital_lection_sequence_0_6f9e0840:

    mirina "Sorularınız olursa bana başvurun. Ben her zaman ofisimde olacağım."

