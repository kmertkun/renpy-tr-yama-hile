# game/scripts/sequences/0170/night_snack/dialogues.rpy:15
translate turkish D_night_snack_0ece2bc7:

    "Odandan çıkınca mutfakta çoktan birinin olduğunu görüyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:16
translate turkish D_night_snack_a1932f0c:

    "Parmak uçlarında yaklaşırken hafifçe duyulan bir mırıldanma işitmeye başlıyorsun..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:17
translate turkish D_night_snack_3c3e8f72:

    mom "Ugh, Astra yine her şeyi tek başına yemiş. Anneciğini hiç düşünmüyor..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:18
translate turkish D_night_snack_d7bdc457:

    "Annenin söylenmesini kolayca tanıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:19
translate turkish D_night_snack_e0047fdc:

    "Aniden kendi evrenindeki gerçek kız kardeşinin de tatlıya düşkün olduğu aklına geliyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:20
translate turkish D_night_snack_2626fbf9:

    "Ama eski evinde böyle bir sahneye asla şahit olamazdın."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:21
translate turkish D_night_snack_9dcc152a:

    "Anneciğinin koca, çıplak götü bütün ihtişamıyla sergileniyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:22
translate turkish D_night_snack_0170ed91:

    "İç çamaşırsız uyumayı alışkanlık edindiği için odasından çıkarken tekrar giymekle uğraşmıyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:23
translate turkish D_night_snack_5dd20b63:

    "Evin gerçek reisi olarak bunda bir sakınca görmüyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:24
translate turkish D_night_snack_473ff62f:

    "Bu, içinde yeni, daha güçlü bir açlık uyandırıyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:25
translate turkish D_night_snack_e3f01fde:

    mom "Ah, Austyn. Sen misin?"

# game/scripts/sequences/0170/night_snack/dialogues.rpy:26
translate turkish D_night_snack_e9403be9:

    "Anne, gözlerini buzdolabının içinden ayırmadan sana sesleniyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:27
translate turkish D_night_snack_bf6343da:

    mom "Tatlı kız kardeşin tam böyle bir an için sakladığım bütün pudingi silip süpürmüş..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:28
translate turkish D_night_snack_5193162f:

    mom "Görünüşe göre bu gece ikimizin de tatlı şansı kalmadı."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:29
translate turkish D_night_snack_a2232f36:

    "Belki onun, ama senin değil. Bu gece açlığını gidermek için kendine hemen yeni bir tatlı bulmuşsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:32
translate turkish D_night_snack_1a4fbbd7:

    "Diz çöküp anüsünü yavaşça yalamaya başlıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:33
translate turkish D_night_snack_e01f23c4:

    mom "Ah... Austyn..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:34
translate turkish D_night_snack_8e683cf4:

    "Sikinin kökünü nazikçe kavrıyorsun, Anneciğin de yükselen tahrikten buzdolabının kapağını daha sıkı tutuyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:35
translate turkish D_night_snack_1366eafd:

    "Dilini sıkıca bastırarak hevesle içine kaydırmaya başlıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:36
translate turkish D_night_snack_9f43c72a:

    "Fazla kıvamda olduğun için bir an bile tereddüt etmeden onu çok iyice tadıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:37
translate turkish D_night_snack_136fbd16:

    "İşe kaptırıp bu arada onu da çekmeye başlıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:38
translate turkish D_night_snack_44d1c25e:

    mom "Tatlım, anneciğin bu gidişle uzun dayanamayacak..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:39
translate turkish D_night_snack_01ca0b93:

    "Ne kadar hoşuna gittiğini hissederek yüzünü kalçalarının arasına gömüp daha da derine dalıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:40
translate turkish D_night_snack_266ffe9b:

    "Çıldırtıcı miktarda salya akıtıyorsun, salyaların büyük taşaklarına ve çenenden aşağı damlıyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:41
translate turkish D_night_snack_204fb59f:

    mom "Ah... Evet..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:42
translate turkish D_night_snack_77f552c6:

    mom "Durma... Ah..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:43
translate turkish D_night_snack_2f47d9f0:

    "Anneciğin sikinin şişip şiddetle zonklamaya başladığını hissediyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:44
translate turkish D_night_snack_f9d377bc:

    "Görünüşe göre bitiş çizgisine şimdiden yaklaşıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:46
translate turkish D_night_snack_d09867e5:

    "Kolay ödülünü kaçırmak istemeyerek anneciğinin sikini ağzına alıp yeniden okşamaya devam ediyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:47
translate turkish D_night_snack_c0357c5c:

    "Anneciğinin bütün vücudu yutmaya hazırlanman gerektiğini haber veriyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:50
translate turkish D_night_snack_16784749:

    "Uzun bir inlemeyle ağzını spermiyle doldurmaya başlıyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:52
translate turkish D_night_snack_7d1aba1e:

    "Hepsini yudum yudum yutuyorsun, tek damlayı bile kaçırmıyorsun."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:54
translate turkish D_night_snack_582aa5eb:

    "Anneciğin toparlanmaya çalışırken sadece inliyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:56
translate turkish D_night_snack_0d60b9a4:

    "Aklı yerine gelince, istediğini buzdolabının en dibinden çıkarıp kapıyı kapatıyor ve önünde boy boy doğruluyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:57
translate turkish D_night_snack_0abdc234:

    "Elinde tam da aradığı puding kabı duruyor."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:58
translate turkish D_night_snack_02d819a3:

    mom "Ah... sensiz ne yapardım, Austyn..."

# game/scripts/sequences/0170/night_snack/dialogues.rpy:59
translate turkish D_night_snack_5982409b:

    "İkiniz de tatlınızı aldığınız için Anneciğin tamamen tatmin olmuş halde uzaklaşıyor."

