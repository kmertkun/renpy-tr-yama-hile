# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:3
translate turkish D_jessica_first_photoset_awakening_cc83d545:

    "Bir telefon bildirimi seni uyandırıyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:9
translate turkish D_jessica_first_photoset_awakening_end_b6b00b6f:

    player "Ah, harika... Jessica'nın benim için ne uydurmuş olabileceğini hayal bile edemiyorum!"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:10
translate turkish D_jessica_first_photoset_awakening_end_1f5593eb:

    player "Tarzını bildiğime göre kesinlikle çok açık saçık bir şey..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:11
translate turkish D_jessica_first_photoset_awakening_end_c4cf34e7:

    "Aynadaki yansımanı gördüğün anda gözlerin nihayet tam olarak açılıyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:12
translate turkish D_jessica_first_photoset_awakening_end_fccba275:

    "Saçının biraz uzadığını ve artık alıştığın şekilde durmadığını fark ediyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:13
translate turkish D_jessica_first_photoset_awakening_end_edb0d39d:

    player "Tabii ya, böyle bir şey tam da bu kadar önemli bir günde olacaktı!"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:22
translate turkish D_jessica_first_photoset_9c7ab25f:

    player "Ah, işler berbat! Üstelik konu bir fotoğraf çekimi..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:23
translate turkish D_jessica_first_photoset_664148c8:

    player "Tam da birinin beni çekici bulduğunu düşünmüşken..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:25
translate turkish D_jessica_first_photoset_403fd117:

    player "Jessica bu fotoğraflarla ne yapacak ki?"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:26
translate turkish D_jessica_first_photoset_e819f0b0:

    player "Umarım sadece gündelik, özel bir deneyim olur..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:27
translate turkish D_jessica_first_photoset_8d43209e:

    player "...ve ondan başka kimse görmez!"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:29
translate turkish D_jessica_first_photoset_9884f76d:

    player "Hm, girişi artık kimse korumuyor. Joseph burada yirmi dört saat çalışmıyor galiba."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:30
translate turkish D_jessica_first_photoset_8821373f:

    player "Bu nasıl bir tuhaf güvenlik? Ya buraya silahla gelseydim? Hehe."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:31
translate turkish D_jessica_first_photoset_82603f43:

    player "Neyse, benim için iyi. Endişelenecek bir şey eksildi."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:40
translate turkish D_jessica_first_photoset_8cc26b0e:

    jessica "Ah, geldin! Seni görmek güzel."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:41
translate turkish D_jessica_first_photoset_a3e4921f:

    jessica "İyi hissediyor musun?"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:42
translate turkish D_jessica_first_photoset_a6eefb6f:

    player "Şey, biraz gerginim..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:43
translate turkish D_jessica_first_photoset_1b82fd35:

    jessica "Herkes başta gergin olur, Austyn. Her şey yoluna girecek."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:44
translate turkish D_jessica_first_photoset_9a38e01c:

    jessica "Seninle olacağım, seni yalnız bırakmayacağım."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:46
translate turkish D_jessica_first_photoset_43ad8a4f:

    player "T-teşekkürler, Jessica."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:49
translate turkish D_jessica_first_photoset_fc361693:

    jessica "Hadi işe koyulalım."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:50
translate turkish D_jessica_first_photoset_dafa488e:

    jessica "Hata benim işim değil, bu yüzden bu kıyafet üstüne giydiğin anda mükemmel görünmeli. Eminim çok seveceksin."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:51
translate turkish D_jessica_first_photoset_22c4bfdc:

    jessica "Normalde kıyafetlerin oturduğundan emin olmadan çekime başlamayız."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:53
translate turkish D_jessica_first_photoset_40ee10ee:

    jessica "Ama vücudun o kadar iyi biçimlenmiş ki, her çalışma aşamasında onu mükemmel şekilde gözümde canlandırabildim."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:55
translate turkish D_jessica_first_photoset_36af2e94:

    player "Bunu duymak çok güzel... Teşekkür ederim."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:57
translate turkish D_jessica_first_photoset_c8232a91:

    jessica "Ah, umarım sonunda teşekkür eden ben olurum, Austyn."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:58
translate turkish D_jessica_first_photoset_4cbc5936:

    jessica "Ama yaratımı üstüne giymeden önce en taze halinde olmalısın."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:59
translate turkish D_jessica_first_photoset_12d8f66c:

    jessica "O yüzden acele et ve biz sana her şeyi hazırlarken bir duş al."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:61
translate turkish D_jessica_first_photoset_16072d6a:

    "Jessica seni en yakın banyoyu gösteriyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:62
translate turkish D_jessica_first_photoset_544cd4fa:

    jessica "Koridorun hemen sonunda. Misafir banyom orada."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:63
translate turkish D_jessica_first_photoset_89ac8c68:

    jessica "Umarım ihtiyacın olan her şeyi orada bulursun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:64
translate turkish D_jessica_first_photoset_30236160:

    player "Lütfen, o kadar seçici biri değilim. Ve teşekkürler."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:67
translate turkish D_jessica_first_photoset_eb73c615:

    "Jessica seni bırakıp gidiyor, sen de duş odasına doğru acele ediyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:68
translate turkish D_jessica_first_photoset_e155bb16:

    "Ama Jessica seni sakinleştirip doğru ruh haline sokar sokmaz kaygı yeniden seni vuruyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:70
translate turkish D_jessica_first_photoset_59cf1b88:

    "İçeride Riley ve Joseph'i yakalıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:72
translate turkish D_jessica_first_photoset_d1710112:

    "Riley, Joseph'in önünde diz çökmüş, sikini boğazına almaya çalışıyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:73
translate turkish D_jessica_first_photoset_4a88676c:

    "Bu dünyadaki erkeklerin bu kadar devasa sikleri olabileceğini hiç düşünmezdin."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:74
translate turkish D_jessica_first_photoset_e2097577:

    "Ortalama bir futanarinin sikiyle aynı boyutta, hatta belki daha büyük!"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:76
translate turkish D_jessica_first_photoset_4458ca32:

    "Bu arada Riley'nin yetenekleri sana kıskançlıktan başka bir şey hissettirmiyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:77
translate turkish D_jessica_first_photoset_c7494a1a:

    "Ustaca içine alıyor ve hiç geri durmuyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:78
translate turkish D_jessica_first_photoset_f07a5673:

    "Bütün yüzü akmış makyajla kaplı."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:80
translate turkish D_jessica_first_photoset_b22f96cb:

    "Sikinin üstünde küçük bir kafes olduğunu da fark ediyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:81
translate turkish D_jessica_first_photoset_3d1baa6d:

    "Joseph başını sıkıca kavrayıp temposunu belirliyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:83
translate turkish D_jessica_first_photoset_11866e11:

    "Bir kez daha Riley'yi kusursuz itaatkâr bir femboy olarak görüyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:84
translate turkish D_jessica_first_photoset_3899dec6:

    "Olup bitene öyle dalıyorsun ki ağzın açık halde sahneye bakakalıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:85
translate turkish D_jessica_first_photoset_86663c70:

    "Yakalandığının bile farkında değilsin."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:88
translate turkish D_jessica_first_photoset_26804bf2:

    joseph "Ne? Katılmak ister misin?"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:89
translate turkish D_jessica_first_photoset_4117c925:

    "Joseph umursamaz bir şekilde, Riley'nin içine girmeye devam ederek söylüyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:90
translate turkish D_jessica_first_photoset_f5c1f074:

    "Teklif seni çok öfkelendiriyor ve kapıyı çarpıp çıkıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:93
translate turkish D_jessica_first_photoset_b2dcdad8:

    player "{i}Ah, inanılmaz! Kendini ne sanıyor?!{/i}"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:94
translate turkish D_jessica_first_photoset_241a1655:

    player "{i}Bu bir ucuz porno senaryosu değil. Bu gerçek hayat!{/i}"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:95
translate turkish D_jessica_first_photoset_6ac43ce5:

    player "{i}Şuna bak! Koca adam hâlâ hayal dünyasında yaşıyor.{/i}"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:96
translate turkish D_jessica_first_photoset_06b1fd34:

    player "{i}Ve Riley... Sıradan bir model için biraz fazla yetenekli görünüyordu.{/i}"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:97
translate turkish D_jessica_first_photoset_279ba249:

    "Jessica'nın yanına dönerken kendi kendine düşünüyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:100
translate turkish D_jessica_first_photoset_c44dac52:

    jessica "Ah, bir sorun mu var? Neden hâlâ duşta değilsin?"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:101
translate turkish D_jessica_first_photoset_43ae02b6:

    player "Şey... Duş doluydu."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:102
translate turkish D_jessica_first_photoset_8c9afb0e:

    "Sinirini belli etmemeye çalışarak sessizce söylüyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:104
translate turkish D_jessica_first_photoset_4e9811b5:

    jessica "Doğru, ben de aptalım. Joseph ya da Riley'ye denk gelmiş olmalısın."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:106
translate turkish D_jessica_first_photoset_57c6688e:

    player "Evet, ikisine de. Aynı anda."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:108
translate turkish D_jessica_first_photoset_65b447af:

    jessica "Yahu, bu misafirler bazen tam domuz oluyor. Bu iş için duşu kullanmayın demiştim..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:109
translate turkish D_jessica_first_photoset_db570d7b:

    jessica "Neyse, ne yapabilirim? Benim banyomu kullanman gerekecek."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:115
translate turkish D_jessica_first_photoset_26bc4aaf:

    "Duş almaya başlarken kafana yerleşen görüntüden kurtulamıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:117
translate turkish D_jessica_first_photoset_6f97672e:

    "Bütün bu olay seni deli gibi kıvamına getirdi ve siki şu anda sana huzur vermiyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:118
translate turkish D_jessica_first_photoset_258fdea5:

    "Bir süre bu dürtüye elinden geldiğince direniyorsun ama sonunda başarısız oluyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:120
translate turkish D_jessica_first_photoset_75727f3a:

    "Kendine dokunmaya başlıyor, kendini Riley'nin yerinde hayal ediyorsun... ya da yanında..."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:122
translate turkish D_jessica_first_photoset_3644e7bf:

    "Akla gelebilecek her şekilde. Ancak artık eskisi kadar kolay boşalamadığını fark ediyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:123
translate turkish D_jessica_first_photoset_d34c97fc:

    "Boğazında ya da götünde bir şey olmadan aynı zevk dalgasını hissetmiyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:124
translate turkish D_jessica_first_photoset_6df5aede:

    "Dayanamayıp sikini çekmeye devam ederken götünü parmaklamaya başlıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:127
translate turkish D_jessica_first_photoset_505e2b62:

    "Bunun onun parmakları olabileceğini düşünmek seni anında boşaltıyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:128
translate turkish D_jessica_first_photoset_1db9e10a:

    player "{i}Ah... ne çabuk...{/i}"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:129
translate turkish D_jessica_first_photoset_47fdff12:

    player "{i}Gerçekten çok kıvamda olmalıyım...{/i}"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:131
translate turkish D_jessica_first_photoset_51dd5354:

    "Duşuna devam ediyorsun ve neredeyse bitirmişken Jessica odaya dalıyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:133
translate turkish D_jessica_first_photoset_fabee135:

    jessica "Ah, mükemmel. Tam zamanında geldim. Üstüne bir şey giymekle uğraşma."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:134
translate turkish D_jessica_first_photoset_7c0cf523:

    jessica "Seni yepyeni bir şeyler giydireceğiz."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:141
translate turkish D_jessica_first_photoset_4ce0f9c9:

    "Hatta ayrı bir soyunma odasına bile götürülüyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:142
translate turkish D_jessica_first_photoset_5b09cf96:

    "Soyunma odasından çıkınca doğrudan duvarları bembeyaz, bir sürü aydınlatma ekipmanı olan küçük bir odaya açılan bir çıkış var."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:145
translate turkish D_jessica_first_photoset_f62cfda7:

    "Seni fotoğraf çekimine hazırlamaya başlıyorlar."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:146
translate turkish D_jessica_first_photoset_0900cac5:

    "Jessica kıyafetinle her ayrıntıya kadar ilgilenmiş."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:147
translate turkish D_jessica_first_photoset_c25ed94c:

    "Eteğin rengiyle uyumlu dikişsiz bir tanga giyiyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:148
translate turkish D_jessica_first_photoset_73d57b5c:

    "Uzun kollu üst, nefes alan bir kumaştan yapılmış."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:150
translate turkish D_jessica_first_photoset_70fc2345:

    "Eteği giymek senin için gerçek bir sınav oluyor. Ama sonuç buna değiyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:151
translate turkish D_jessica_first_photoset_3094018b:

    "Götünün etrafında inanılmaz sıkı."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:152
translate turkish D_jessica_first_photoset_e592a360:

    "Ön kısım da hayal gücüne pek bir şey bırakmıyor. Küçük penisinin hatları net bir şekilde görünüyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:154
translate turkish D_jessica_first_photoset_1f0d43c5:

    "Ayrıca üstünün üzerine saçma derecede dar, kısa kollu bir ceket de giydiriyorlar."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:155
translate turkish D_jessica_first_photoset_96fd1762:

    jessica "Ne düşünüyorsun? Bence harika! Eminim götün şu an olduğu kadar iyi hiç görünmemiştir."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:156
translate turkish D_jessica_first_photoset_3ea65153:

    player "Şey, bunun halka açık yerlerde giyilebilecek bir şey olduğundan emin misin...?"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:157
translate turkish D_jessica_first_photoset_6e742711:

    jessica "Ah, elbette. İşte, okulda, önemli etkinliklerde. Her yerde."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:158
translate turkish D_jessica_first_photoset_82a0f2b3:

    jessica "Ve gittiğin her yerde kendini ana karakter gibi hissedeceksin. Ne demek istediğimi anlıyorsun, değil mi?"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:159
translate turkish D_jessica_first_photoset_b6535824:

    jessica "Tabii ki anlıyorsun! Haha."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:161
translate turkish D_jessica_first_photoset_d722d066:

    "Sırada yüzün var. Usta makyajı sürmeye başlıyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:162
translate turkish D_jessica_first_photoset_aeb8a351:

    "Cesur kırmızı bir ruj. Allık. Rimel."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:163
translate turkish D_jessica_first_photoset_803dd21b:

    "Ve daha etkileyici görünmen için takma küpeler."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:164
translate turkish D_jessica_first_photoset_e707ce7b:

    "Son dokunuş, poz vermen gereken yüksek topuklular."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:165
translate turkish D_jessica_first_photoset_0d55ff9f:

    jessica "Muhteşem! Kesinlikle çok güzel görünüyorsun!"

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:171
translate turkish D_jessica_first_photoset_f88159c1:

    "Jessica'nın ve fotoğrafçının basit komutlarını izleyerek doğru ruh haline girmeyi başarıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:174
translate turkish D_jessica_first_photoset_52fdd258:

    "Sen Jessica'nın pozunu taklit ederken sana sadece nereye bakacağını söyleyip duruyorlar."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:177
translate turkish D_jessica_first_photoset_f6870a14:

    "Fotoğraf çekiminin odağının sen değil, giydiğin kıyafet olduğunu fark edince kaygın tamamen gidiyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:178
translate turkish D_jessica_first_photoset_6d2f2ee0:

    "Büyük götün ilgi odağı oluyor. Ve çekiciliğinden şüphe yok."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:179
translate turkish D_jessica_first_photoset_4ab441a5:

    "Sonuç olarak biraz ekstra özgüven ve küçük bir ego tatmini kazanıyorsun. Hatta deneyime hoş bir deneyim olarak bakıyorsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:180
translate turkish D_jessica_first_photoset_a298ae31:

    "Sonuçtan yüzde yüz memnunsun."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:181
translate turkish D_jessica_first_photoset_b3ee319c:

    "Jessica, anlaştığınız gibi, kıyafeti, hatta ayakkabıları ve külotu bile kendine almana izin veriyor."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:182
translate turkish D_jessica_first_photoset_4d7e9abf:

    "Fotoğrafların akıbeti henüz belirlenmedi."

# game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:183
translate turkish D_jessica_first_photoset_91926137:

    "Yine de Jessica iletişimde kalmanızı ve bir gün birlikte eğlenmenizi ısrarla söylüyor."

translate turkish strings:

    # game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:33
    old "Without a second thought, you gently knock on the door."
    new "Hiç düşünmeden kapıya hafifçe vuruyorsun."

    # game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:35
    old "Jessica pops out immediately as if she was waiting for you at the doorstep."
    new "Jessica sanki kapı eşiğinde seni bekliyormuş gibi hemen beliriyor."

    # game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:111
    old "Jessica brings you in and leaves you to your own devices again."
    new "Jessica seni içeri alıyor ve yine kendi başına bırakıyor."

    # game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:137
    old "You had no idea there were so many rooms in Jessica's apartment."
    new "Jessica'nın dairesinde bu kadar çok oda olduğunu bilmiyordun."

    # game/scripts/sequences/0170/jessica_first_photoset/dialogues.rpy:167
    old "Jessica takes you through the very basics of posing for a photo."
    new "Jessica sana fotoğraf için poz vermenin en temel kurallarını anlatıyor."

