translate turkish D_meet_your_maker_c6172e2e:

    player "A-ama... nasıl? Buraya gelen ilk kişinin ben olduğumu söylemiştin!"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:93
translate turkish D_meet_your_maker_5466b4da:

    mom "Her şey çok karışık, tatlım... Senden daha fazla bilgiye ihtiyacım var."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:94
translate turkish D_meet_your_maker_e465ee54:

    mom "Ona yakınlaşmaya çalış... Onun hakkında daha çok şey öğren... Nerede yaşıyor, kimlerle iletişim kuruyor."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:95
translate turkish D_meet_your_maker_2c990b19:

    mom "Okul dışında ne yapıyor."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:96
