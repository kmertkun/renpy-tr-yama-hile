translate turkish D_meet_your_maker_3620a202:

    mom "Onun hakkında bildiğin her şeyi anlat bana."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:81
translate turkish D_meet_your_maker_df167c18:

    player "T-tabii... tamam.."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:82
translate turkish D_meet_your_maker_4885a9b0:

    player "O... okulda öğretmen olarak çalışıyor. Bize... antik tarih dersi veriyor."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:83
translate turkish D_meet_your_maker_7db48eba:

    mom "Onunla yüz yüze konuştun mu?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:84
translate turkish D_meet_your_maker_d06b901d:

    player "Ah, e-evet... birkaç kez oldu.."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:85
translate turkish D_meet_your_maker_c24c2ce7:

    mom "Onunla ne konuştun?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:86
translate turkish D_meet_your_maker_72f6b1c5:

    player "O... sadece beni inceliyor... bir femboy olarak gelişimimi izliyor.."

