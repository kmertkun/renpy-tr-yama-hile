    player "A-anne..?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:38
translate turkish D_meet_your_maker_fcd2dae6:

    mom "Evet, benim. Çok az vaktim var..."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:39
translate turkish D_meet_your_maker_4cce0631:

    player "Ama nasıl... sen... neden?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:40
translate turkish D_meet_your_maker_695161c9:

    mom "Ah, ben de senin gibi beden değiştirdim, sadece buradaki annenle."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:41
translate turkish D_meet_your_maker_260de096:

    mom "Ve o uyurken... Sanırım birkaç dakikada işimiz biter... ah..."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:42
translate turkish D_meet_your_maker_537eb554:

    mom "Austyn. N-neden böyle görünüyorsun? Tanrım..."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:47
translate turkish D_meet_your_maker_cf980ecc:

    player "Oh, bu... ş-şey... burada... benim gibi insanlar için... böyle... ve..."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:48
translate turkish D_meet_your_maker_1fb0ffff:

    mom "Ah, boş ver. Sana görevinin amacını anlatmıştım ama makine düşündüğümden daha hızlı çalıştı... Hiçbir şey anladığını düşünmemiştim... çünkü çok uzun zamandır hiç sinyal görmedim."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:49
translate turkish D_meet_your_maker_0c317187:

    player "Sinyal mi?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:50
translate turkish D_meet_your_maker_436a4824:

    mom "Evet, sinyal. Bu odadaki bilgisayarın sinyal verebilir. Bu boyuttan bize en azından biraz bilgi gönderebilmeni sağladık."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:51
translate turkish D_meet_your_maker_8a0d73d0:

    mom "Ve... ve... Ah.."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:52
translate turkish D_meet_your_maker_fffe6419:

    "Anneciğin sikti külotunun içinde gözle görülür şekilde sertleşiyor"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:58
translate turkish D_meet_your_maker_01f9db22:

    mom "Tanrım, bu şey... çok sert sürtünüyor... Ah..."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:59
translate turkish D_meet_your_maker_badd327e:

    "Anne rahat olması için külotunu çıkarıyor"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:64
translate turkish D_meet_your_maker_42fe65d3:

    mom "Ah, çok daha iyi."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:69
translate turkish D_meet_your_maker_a048c81b:

    mom "Oh, bu bir sik mi?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:70
translate turkish D_meet_your_maker_c63a4781:

