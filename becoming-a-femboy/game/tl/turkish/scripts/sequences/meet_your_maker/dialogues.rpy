translate turkish D_meet_your_maker_dee6c108:

    mom "Gerçekten büyük bir sikim var, haha."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:76
translate turkish D_meet_your_maker_005192ae:

    player "Ah evet... buradaki sıradan kızların çoğu futanari."

