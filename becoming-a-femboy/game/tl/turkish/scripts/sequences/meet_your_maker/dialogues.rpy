# game/scripts/sequences/meet_your_maker/dialogues.rpy:130
translate turkish D_meet_your_maker_5130a04d:

    astra "Rüyada yürümüşsün, o zaman rüyada külotunu da çıkarmışsındır herhalde."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:131
translate turkish D_meet_your_maker_80a13b65:

    astra "Yoksa burada başka bir şey mi dönüyor?"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:132
translate turkish D_meet_your_maker_8e3aa4e1:

    player "Düşündüğün gibi değil, Astra.."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:135
translate turkish D_meet_your_maker_715f1c7f:

    astra "Haha, neden utanıyorsun, Austyn."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:138
