    mom "Hepsi ortak iyilik için."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:97
translate turkish D_meet_your_maker_ad6153e0:

    player "Ah... Ben... Elimden geleni yapacağım."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:98
translate turkish D_meet_your_maker_13255162:

    mom "Çok şey sana bağlı, tatlım... Sana inanıyorum."

# game/scripts/sequences/meet_your_maker/dialogues.rpy:101
translate turkish D_meet_your_maker_41a58141:

    "Odanın kapısı çalınıyor"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:105
translate turkish D_meet_your_maker_580e3040:

    astra "Hey! Gecenin ortasında bu kadar uzun süre ne konuşuyorsunuz!"

# game/scripts/sequences/meet_your_maker/dialogues.rpy:119
translate turkish D_meet_your_maker_ede0de19:

    mom "Ah? Ne? Ne... neler oluyor?"

