# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:6
translate turkish D_astra_research_ending_ready_0ef972f6:

    "Astra'ya iyi haberle dönüyorsun. Sunuma hazırsın gibi görünüyor!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:7
translate turkish D_astra_research_ending_ready_0ba6e4a0:

    astra "Ah, harika haber. Üstelik tam zamanında!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:8
translate turkish D_astra_research_ending_ready_0a291cb5:

    astra "Yarın sabah seni komiteye tanıtmaya hazır olacağım!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:9
translate turkish D_astra_research_ending_ready_6e08262e:

    astra "Ah, bir de muhteşem görünmeyi unutma. Havanı göstermelisin. Çok önemli."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:10
translate turkish D_astra_research_ending_ready_72b2e947:

    player "Elimden geleni yapacağım, Astra."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:11
translate turkish D_astra_research_ending_ready_7c0ebf76:

    astra "Teşekkürler. Gerçekten benim için çok şey ifade ediyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:12
translate turkish D_astra_research_ending_ready_eb8caf07:

    "Astra'nın seninle bu kadar nazik konuştuğunu duymak sana tuhaf geliyor. Buradaki Astra da olsa, gerçek ablan da olsa."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:32
translate turkish D_astra_research_ending_273e6b28:

    "Kendini o kadar çok seviyorsun ki, aynada kendi fotoğrafını çekme fırsatını kaçıramıyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:33
translate turkish D_astra_research_ending_0f16d85e:

    player "{i}Ah, bunu paylaşacak bir sayfam olmaması ne yazık!{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:34
translate turkish D_astra_research_ending_8ecbae5e:

    player "{i}Keşke bu manzarayı herkesle paylaşabilsem.{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:35
translate turkish D_astra_research_ending_aa060c16:

    "Kendine o kadar güveniyorsun ki fotoğrafları tanıdığın herkese gönderdiğini, iltifatlara boğulacağından emin olduğunu bile hayal ediyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:36
translate turkish D_astra_research_ending_5d5e60b2:

    "Ancak bugünkü fırsat daha da iyi! Bir saatten kısa sürede koca bir kalabalığın önünde caka satacaksın."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:37
translate turkish D_astra_research_ending_e5754e5d:

    "Üniversite ortamında kıyafetinin uygunluğu hâlâ içini kemiriyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:48
translate turkish D_astra_research_ending_451cfe3f:

    "Annenle Astra'yı oturma odasında kızgın bir tartışma yaparken buluyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:49
translate turkish D_astra_research_ending_b6867214:

    "Annen de nedense şık giyinmiş."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:50
translate turkish D_astra_research_ending_bbe231a1:

    "Ve inanılmaz seksi görünüyor!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:51
translate turkish D_astra_research_ending_c9c61cf4:

    "Göğüsleri sanki o bluzdan taşmaya hazırmış gibi, yumuşak pembe meme uçları kumaşın arasından açıkça görünüyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:52
translate turkish D_astra_research_ending_eb8124f4:

    "Sikini sanki askılıymış gibi kalın ve ağır bir kabarıklık halinde toplanmış."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:53
translate turkish D_astra_research_ending_650353b7:

    mom "Ah, işte küçük ünlümüz geliyor! Harika görünüyorsun, Austie!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:55
translate turkish D_astra_research_ending_cc7eb9cc:

    player "E-evet, teşekkürler! S-sen de bir yere mi gidiyorsun?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:57
translate turkish D_astra_research_ending_3493769c:

    astra "Anne de komitenin bağımsız üyesi. Sonuçta mezun olduğu üniversite orası ve uzun zamandır orada araştırma yapıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:59
translate turkish D_astra_research_ending_e0d11d92:

    player "Ah, anladım... Ama gerçekten sorun olmaz mı? Yani öğrencinin annesi olman?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:61
translate turkish D_astra_research_ending_95c55773:

    mom "Taraflı olacağımı mı düşünüyorsun tatlım?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:63
translate turkish D_astra_research_ending_b2a8713a:

    astra "Anneden asla iyi bir söz duyamazsın, özellikle bilim söz konusuysa, Austyn. Annemiz hakkında kötü düşünme."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:64
translate turkish D_astra_research_ending_7a329fd5:

    astra "Araştırmada bana yardım etmeye bile zahmet etmedi!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:66
translate turkish D_astra_research_ending_04307790:

    mom "Ablanı dinle. Her zamanki gibi haklı!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:67
translate turkish D_astra_research_ending_9633d0cb:

    mom "Çoktan bir taksi çağırdım. Muhtemelen dışarı çıkma vaktimiz geldi."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:70
translate turkish D_astra_research_ending_e2c5eaa7:

    "Üniversiteye oldukça geniş, lüks bir arabayla gidiyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:71
translate turkish D_astra_research_ending_c45648ee:

    "Otuzlarındaki futanari şoför, senin ve Astra'nın görünüşü hakkında sürekli yorum yapıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:74
translate turkish D_astra_research_ending_6d608086:

    "Tatlı dilli biri olduğu için neredeyse daha yakın bir temasa dönüşecekti."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:75
translate turkish D_astra_research_ending_1c0413d2:

    "Ama ona numaranı bırakma fikri annen tarafından engelleniyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:78
translate turkish D_astra_research_ending_6167d907:

    "Yine de yolculuğun sonunda şoför gitmeden önce kartvizitini eline sıkıştırmayı başarıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:79
translate turkish D_astra_research_ending_83594a04:

    "Taksisinde hem para kazanılıp hem de iyi vakit geçirilebileceğini ima ediyor, ne demekse."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:86
translate turkish D_astra_research_ending_2e63720d:

    "Büyük ama rahat amfide, ön sıradaki uzun masada oturan üç komite üyesi seni karşılıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:89
translate turkish D_astra_research_ending_f93ccf99:

    "Annen hemen onlara katılıp dördüncü koltuğa oturuyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:90
translate turkish D_astra_research_ending_575b2e1d:

    "Ne Astra'ya ne de sana sandalye var. Astra konuşması için hazırlanarak kürsünün arkasına geçiyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:91
translate turkish D_astra_research_ending_f8575430:

    "Herkes seni tam boyunla görebilsin diye yanında durmanı söylüyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:92
translate turkish D_astra_research_ending_fc5e8646:

    "Bu kadar çok yabancının yanında kendini son derece rahatsız hissediyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:93
translate turkish D_astra_research_ending_5ebf3bde:

    "Dikkatini dağıtmak için etrafa bakmaya karar veriyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:94
translate turkish D_astra_research_ending_a094a83b:

    "Buradan salonu mükemmel görüyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:95
translate turkish D_astra_research_ending_e329fa20:

    "Komite dışında epey insan var."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:96
translate turkish D_astra_research_ending_4e0edd0c:

    "Hepsi sadece üniversite öğrencisi gibi görünüyor. Sonuçta sunumdan sonra soru sormalarına da izin var."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:97
translate turkish D_astra_research_ending_4d9f0315:

    "Birkaç yıl içinde onlar da aynı kaderi yaşayacak, bu yüzden büyüklerinden öğrenebildikleri her şeyi öğrenmeye çalışıyorlar."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:98
translate turkish D_astra_research_ending_a7661522:

    "Herkesin sana baktığını fark ediyorsun. Aklında ilgi odağı olmanın heyecanını çok farklı hayal etmiştin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:99
translate turkish D_astra_research_ending_a9870c60:

    "Orada bulunan insan sayısından kafan karmakarışık. Bazılarını sadece belli belirsiz tanıyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:102
translate turkish D_astra_research_ending_daaa137a:

    "Komite üyelerinin hepsi formda, güzel görünümlü milf'ler. Annenin nasıl biri olduğunu buradan anlayabiliyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:103
translate turkish D_astra_research_ending_b8fb7801:

    "Sanki hepsi aynı montaj hattından çıkmış gibiler. Üniversite üniformaları, manikürlü görünüm, dolgun göğüsler. Bir esmer, bir sarışın ve bir kızıl."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:104
translate turkish D_astra_research_ending_239dfb97:

    "Gözlerin biraz aşağı kayınca cinsiyetleriyle ilgili şüphelerin dağılıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:105
translate turkish D_astra_research_ending_4835dd13:

    "Üçünün de sulu görünümlü mahrem yerleri eteklerinin altından dışarı bakıyordu."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:106
translate turkish D_astra_research_ending_ea693ce6:

    "Bu manzara seni garip bir şekilde sakinleştiriyor, çünkü kıyafetin diğer herkese kıyasla o kadar kışkırtıcı görünmüyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:107
translate turkish D_astra_research_ending_92049cec:

    "Amfi, tam çiçek açmış genç öğrencilerle ağzına kadar dolu!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:110
translate turkish D_astra_research_ending_dd903ad4:

    player "{i}Astra burayı gerçekten çok seviyor olmalı!{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:111
translate turkish D_astra_research_ending_4837354e:

    "Ama bu fakülte kızlar arasında pek popüler görünmüyor. Kim bilir neden? Sana önemli bir şey gibi gelmiyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:112
translate turkish D_astra_research_ending_ef72c990:

    "Ancak dikkat çeken şey, femboyların ve futaların salonun karşıt taraflarında ayrı oturması."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:113
translate turkish D_astra_research_ending_721af055:

    "Gevşek kıyafet kuralı buradaki öğrenciler arasında fazla sapkınlığa yol açıyor olmalı, bu yüzden yan yana oturmalarına izin verilmiyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:116
translate turkish D_astra_research_ending_44f1d9d2:

    "Odada, bir adamla kızgın bir tartışmaya dalmış belli bir kişiyi fark etmeden duramıyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:117
translate turkish D_astra_research_ending_152d471b:

    player "{i}Jannet?!{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:118
translate turkish D_astra_research_ending_ac8979d7:

    "Geniş geniş sırıtıyor ve konuşurken parmağıyla sana işaret ediyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:119
translate turkish D_astra_research_ending_8255e209:

    player "{i}Yoksa ona benden mi bahsediyor?{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:120
translate turkish D_astra_research_ending_2b06ca1a:

    "Birdenbire kendini endişeli ve kıskanç hissediyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:124
translate turkish D_astra_research_ending_77169f6e:

    player "A-Astra... Jannet'in yanındaki o adam kim?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:125
translate turkish D_astra_research_ending_a3b5aad1:

    astra "Ha? Yanındaki mi, şey..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:126
translate turkish D_astra_research_ending_6418c475:

    astra "Ah, rahat olabilirsin. Endişelenecek bir şey yok, hehe."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:127
translate turkish D_astra_research_ending_6d8dc054:

    astra "Bu arada, başlamak üzereyiz."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:130
translate turkish D_astra_research_ending_ae8395a7:

    player "{i}Ah, evet... 'Endişelenme Dediği Adam.'{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:131
translate turkish D_astra_research_ending_0bb88510:

    player "{i}Bunu kesinlikle daha önce duymuştum.{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:134
translate turkish D_astra_research_ending_1e79f401:

    "Astra izleyicilere ve komiteye kendini tanıttıktan sonra seni tanıtıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:135
translate turkish D_astra_research_ending_30329789:

    "Sen de sadece beceriksizce elini sallıyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:136
translate turkish D_astra_research_ending_9c986ab8:

    "Gülümsemek ve en iyi halini sergilemek için elinden geleni yapıyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:137
translate turkish D_astra_research_ending_0d813ce8:

    "Astra herkese bir sürü bilimsel terim yağdırırken sen sadece anlamlı gelen birkaç şeyi yakalayabiliyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:138
translate turkish D_astra_research_ending_158fd94a:

    "Konuşma esas olarak bir femboy'un doğasına ne kadar direnirse dirensin fark etmediğini anlatıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:139
translate turkish D_astra_research_ending_28429b76:

    "Süreci başlatmak için gereken tek şey o küçük bir dürtme."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:140
translate turkish D_astra_research_ending_a6309d6a:

    "Örneğin sen, kavrama sadece resimler ve manga seviyesinde aşina olmana rağmen burada bu kadar kısa sürede uyum sağlamakta pek zorlanmadın."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:141
translate turkish D_astra_research_ending_debae90a:

    "Mirina'yla sadece bir seans ve bir çift Astra'nın külotu seni tamamen farklı biri yaptı."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:142
translate turkish D_astra_research_ending_88578af6:

    "Astra, sopa olmadan sadece havuçla inanılmaz sonuçlar elde edilebileceğinde ısrar ediyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:143
translate turkish D_astra_research_ending_36ff3341:

    "Araştırmanın temel amacını, toplumsal ihtiyaçların zaten ağır olan vergi yükünü azaltmanın bir yolu olarak anlatıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:144
translate turkish D_astra_research_ending_7d151285:

    "Bazı muğlak hipnoz seansları, özel ücretsiz oral ve anal seanslar..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:145
translate turkish D_astra_research_ending_bc3aad06:

    "Doğru yetiştirilme ve biraz yönlendirmenin insanı doğanın istediği kişi haline getirdiğinin mükemmel örneği oldun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:146
translate turkish D_astra_research_ending_6785349e:

    "Ve ardından birçok kişiyi düşündüren şok edici rakamlar geliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:147
translate turkish D_astra_research_ending_5b932598:

    astra "Külot giymeye başladıktan {color=#f00}XXX{/color} gün içinde Austyn ilk kez oral seks denedi."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:148
translate turkish D_astra_research_ending_ded9d8cf:

    astra "Külot giymeye başladıktan {color=#f00}YYY{/color} gün sonra Austyn ilk kez anal seks denedi."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:149
translate turkish D_astra_research_ending_c2f2d2ec:

    astra "Son kontrol itibarıyla seks partneri sayısı: {color=#f00}AAA{/color}."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:150
translate turkish D_astra_research_ending_981a28b5:

    astra "Austyn'in vücudunu kabullenmesi ve geleneksel erkeksi kıyafetler dışında bir şeyle toplum içinde rahat hissetmesi {color=#f00}BBB{/color} gün sürdü."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:151
translate turkish D_astra_research_ending_eb71043b:

    "Astra'nın her ifadesinden sonra nedenini anlamasan da giderek daha çok utanıyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:152
translate turkish D_astra_research_ending_75a76295:

    "İzleyiciler tarafından yargılandığını hissediyorsun. Ya da belki gerçekten şaşırmışlardır?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:153
translate turkish D_astra_research_ending_a7a8f68a:

    "Kendi kendine karar veremiyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:154
translate turkish D_astra_research_ending_73ddc923:

    "Astra, oldukça basit ve düşük maliyetli yöntemlerle sonuçlara ne kadar hızlı ulaştığın konusunda durmadan konuşuyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:155
translate turkish D_astra_research_ending_40f3c22c:

    "Bitirdiğinde komitenin soruları sırası geliyor, ardından izleyici soruları gelecek."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:156
translate turkish D_astra_research_ending_3930e538:

    "Ancak öğrencilerin soruları nota katkı sağlamıyor. Onlara sadece alandaki kendi araştırmaları için lazım."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:159
translate turkish D_astra_research_ending_b2614e7f:

    "İlk soru soran, komitedeki sarışın Lucie."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:162
translate turkish D_astra_research_ending_0b5179b9:

    lucie "Ah, Astra, nereden başlayacağımı bile bilmiyorum. Öncelikle rapor için teşekkürler."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:163
translate turkish D_astra_research_ending_ed3dcd18:

    lucie "Austyn, bugün çok çarpıcı görünüyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:164
translate turkish D_astra_research_ending_91b279a6:

    lucie "Ama itiraf etmeliyim ki ben ve meslektaşlarım teorine biraz şüpheyle yaklaşıyoruz."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:165
translate turkish D_astra_research_ending_af575ba0:

    lucie "Sonuçları nesnel biçimde değerlendirmek bizim için çok zor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:166
translate turkish D_astra_research_ending_79e98391:

    lucie "Basit bir nemfomani nöbeti ile karşı karşıya olamaz mıyız?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:169
translate turkish D_astra_research_ending_4c9ac832:

    "Esmer meslektaşı Elizabeth, kendi yorumuyla araya giriyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:170
translate turkish D_astra_research_ending_05c144ed:

    elizabeth "Evet, Austyn'in yolunu bulmasına sevindik ama bu yolun ne anlama geldiğini hepimiz çok iyi biliyoruz."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:173
translate turkish D_astra_research_ending_4a92c0d8:

    "Üçüncü komite üyesi de tartışmaya katılıyor, kızıl saçlı futanari Katherine."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:174
translate turkish D_astra_research_ending_eecf1b71:

    katherine "Ah evet, ayrıca fazla taraflı görünmek istemem ama Jessica Love'ın kıyafetlerini bile giyiyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:175
translate turkish D_astra_research_ending_7364741b:

    katherine "Pek cesaret verici bir örnek değil, farkındasın."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:178
translate turkish D_astra_research_ending_986c331a:

    mom "Ben aksi kanıdayım. Bence bunun önemi yok, Katherine."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:179
translate turkish D_astra_research_ending_fdd796aa:

    "Anne seni savunuyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:182
translate turkish D_astra_research_ending_d58f55c9:

    katherine "Kişisel bir şey değil, Holly. Duyduklarımız oğlunu takıntılı gibi gösteriyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:183
translate turkish D_astra_research_ending_1589dade:

    katherine "Sağlıklı gelişimin daha fazla zaman aldığını biliyorsun, değil mi?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:186
translate turkish D_astra_research_ending_2f7628a4:

    elizabeth "Gerçekten. Daha çok talimatlarla zorla besleme gibi geliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:187
translate turkish D_astra_research_ending_1a86c543:

    elizabeth "Astra, bu normal değil. Sanırım meslektaşlarım da benimle aynı fikirde olacak—"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:190
translate turkish D_astra_research_ending_8fb45b41:

    "Komite tamamen acımasız. Söyledikleri her kelime kalbine bıçak gibi saplanıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:191
translate turkish D_astra_research_ending_c46cb304:

    "Annen, Astra'yı savunmayacağına dair sözüne rağmen tamamen dağılmış görünüyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:192
translate turkish D_astra_research_ending_81b0d0da:

    "Astra öfkeden köpürüyor. Söz almak istiyor ama yumruklarını sıkarak nazikçe bekliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:195
translate turkish D_astra_research_ending_27234022:

    lucie "...Holly, küçük kızına femboyların cinsel gelişimi hakkında bilgi vermeliydin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:198
translate turkish D_astra_research_ending_f77f82a2:

    katherine "Evet, kesinlikle. Bunca zamandır, femboy'unun kafesinin anahtarını üzerinde bile görmüyorum."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:201
translate turkish D_astra_research_ending_139a27d6:

    astra "Kafes aslında bireyin sadakatini kontrol etmek için bir araçtır."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:202
translate turkish D_astra_research_ending_d1c648b9:

    astra "Bizim durumumuzda denek her şeye kendisi karar verebiliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:205
translate turkish D_astra_research_ending_64d5c50a:

    astra "Onu fetiş unsuru olarak ya da bir tür sembol olarak kullanmakta özgür. Ama pratik bir kullanımı yok."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:206
translate turkish D_astra_research_ending_9f96bee5:

    astra "Kafesler günümüzde sadece eski bir gelenek."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:207
translate turkish D_astra_research_ending_99c1ec55:

    astra "Bayan Holly, tarafsız bir uzman olarak Austyn'in her şeyi yavaş yavaş kendi başına çözdüğüne tanık oldu."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:210
translate turkish D_astra_research_ending_0f1c0fde:

    mom "Evet, Austyn istek gösterdi ve işlere kendi yaratıcılığıyla yaklaştı."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:211
translate turkish D_astra_research_ending_6704c732:

    "Anne bunu söyleyerek herkesin önünde seni çok utandırıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:214
translate turkish D_astra_research_ending_a6fe2a2e:

    elizabeth "Hâlâ onu eğitiyor musun?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:217
translate turkish D_astra_research_ending_1b2d2b1d:

    mom "Hayır, sadece yön verdim, gerisini o yaptı."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:220
translate turkish D_astra_research_ending_b134feac:

    astra "Rapora, Austyn'in yerel eğitim kliniğine yaptığı ziyaretlerin notları ekli."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:221
translate turkish D_astra_research_ending_0770fee7:

    player "{i}Ah, Mirina'yla bunu mu konuştu?!{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:222
translate turkish D_astra_research_ending_ea11dba0:

    astra "Para sorusunu tahmin ederek söyleyeyim, hayır, Austyn tüm parayı kendisi kazandı; bu da deneğin motivasyonuna ekstra puan katıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:223
translate turkish D_astra_research_ending_d7ef562d:

    astra "Ayrıca özel, yüksek vasıflı bir kişisel antrenörden alınan eğitimin raporu da var."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:226
translate turkish D_astra_research_ending_f21b5f68:

    katherine "Ah, Mirina. Evet, aslında onu tanıyorum. Demek hâlâ işte? Bu fiyatlarla ben de antrenör olmayı düşünebilirim, hehe."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:229
translate turkish D_astra_research_ending_d9fc0dcf:

    player "{i}Mirina bu tür şeyler için çek yazdı... ama bana bedavaydı.{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:230
translate turkish D_astra_research_ending_1504fd87:

    player "{i}Gerçekte ne kadara mal olduğunu hayal bile edemiyorum.{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:233
translate turkish D_astra_research_ending_d0cf0bfd:

    lucie "Hmm... Bu kadar harcadıktan sonra deneğin motivasyonu tartışılmaz sanırım."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:236
translate turkish D_astra_research_ending_9dd78d8a:

    elizabeth "Evet, senin yaşında tüm bunları karşılayabilmek oldukça takdire şayan."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:239
translate turkish D_astra_research_ending_be423a8e:

    "Komitenin hâlâ şüphelerinin olduğunu görebiliyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:240
translate turkish D_astra_research_ending_79227159:

    "Astra hayalet gibi solgun görünüyor, anne de hâlâ perişan."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:243
translate turkish D_astra_research_ending_0fcc7b45:

    "Hiçbiri komiteden böyle itirazlar beklemiyordu."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:244
translate turkish D_astra_research_ending_0979fdfd:

    "İşleri kendi ellerine alıp onları savunman gerektiğini düşünüyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:248
translate turkish D_astra_research_ending_74dcd391:

    player "Şey, s-sayın komite... İtiraf etmeliyim ki kendime nispeten yakın zamanda geldim ve bunca yıl kördüm."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:250
translate turkish D_astra_research_ending_9e93dff2:

    player "Astra'nın yöntemleri gerçekten işe yarıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:251
translate turkish D_astra_research_ending_3da9f496:

    player "Yeni bir benlik bulmanın ne kadar harika olacağını daha önce hiç düşünmemiştim."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:253
translate turkish D_astra_research_ending_91884baf:

    player "Şimdi her zamankinden daha iyi hissediyorum."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:254
translate turkish D_astra_research_ending_eaaba170:

    player "Kadın külotları, daha önce yanlışlıkla inandığım gibi hiçbir zaman erkek olmadığımı fark etmemi sağladı."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:256
translate turkish D_astra_research_ending_736f11cb:

    player "Annemin desteği sayesinde sikleri gerçekten sevdiğimi fark ettim."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:257
translate turkish D_astra_research_ending_04f328e9:

    "Biraz kendini kaptırıp neden bahsettiğinin farkında bile değilsin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:259
translate turkish D_astra_research_ending_72f60b7b:

    player "Ve biri ağzıma ya da kıçıma... ya da tüm suratıma boşaldığında hiç pişman olmadım!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:260
translate turkish D_astra_research_ending_c2d3284a:

    "Sessizlikle karşılaşınca ömrünün sonuna kadar dalga geçileceğini fark ediyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:261
translate turkish D_astra_research_ending_869994d1:

    "Ellerin titremeye başlıyor ve olduğun yerde donmuş hissediyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:262
translate turkish D_astra_research_ending_c5c4219a:

    "Annenin söylediklerine ne kadar utandığını görebiliyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:266
translate turkish D_astra_research_ending_524ddf1f:

    "Bu arada Astra, dolaylı utançtan dolayı avucunu yüzüne dayamış."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:267
translate turkish D_astra_research_ending_72e8b857:

    "Yine de sözlerin kalabalıktan destek görüyor. Kimse sana gülmeyi aklından bile geçirmiyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:268
translate turkish D_astra_research_ending_21b08c5f:

    "En çılgın şaşkınlığınla, bir alkış tufanı duyuyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:269
translate turkish D_astra_research_ending_6d06e7a1:

    "Sonunda gerginlik dindi ve beceriksizliğin zincirlerinden bir şekilde kurtulmayı başardın."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:271
translate turkish D_astra_research_ending_138dce3c:

    player "{i}Böyle bir şey ancak paralel bir evrende olabilirdi...{/i}"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:272
translate turkish D_astra_research_ending_28e8282f:

    "En utanç verici konuşmanı yaptıktan sonra, komiteden pek tepki almasa da kendinden memnunsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:273
translate turkish D_astra_research_ending_a7580fee:

    "Ama duyduklarından gerçekten keyif aldıkları belli."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:276
translate turkish D_astra_research_ending_5bbe9661:

    elizabeth "Hepiniz susun!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:277
translate turkish D_astra_research_ending_736b7f85:

    "Elizabeth odayı anında susturuyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:280
translate turkish D_astra_research_ending_237b69e0:

    elizabeth "Sanırım izleyicilerden soru alma vakti geldi."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:281
translate turkish D_astra_research_ending_ebc63edb:

    elizabeth "Sırayla mikrofona gelin ve sorun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:284
translate turkish D_astra_research_ending_62e0d8f6:

    student "Selam! Eminim beni hatırlamıyorsun ama kafede bana hizmet edenin sen olduğunu biliyorum!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:285
translate turkish D_astra_research_ending_b210a0dd:

    student "Bahşişin iyi bir amaca gitmesine sevindim!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:286
translate turkish D_astra_research_ending_73f0d3c6:

    student "Orada çalışmaya devam etmeyi düşünüyor musun?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:287
translate turkish D_astra_research_ending_880e591e:

    player "Ah, t-teşekkürler! Evet, hâlâ paraya ihtiyacım var, bu yüzden şimdilik hiçbir yere gitmiyorum, hehe."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:290
translate turkish D_astra_research_ending_8e461796:

    elizabeth "Lütfen böyle sorular sormayın. Sıradaki."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:293
translate turkish D_astra_research_ending_0ec9bf09:

    student "Merhaba! Seni plaj partilerinde bir sürü kez gördüm!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:294
translate turkish D_astra_research_ending_336dbd7f:

    student "Ve her seferinde farklı bir partnerle birlikteydin... Seninle de çıkma şansım var mı?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:295
translate turkish D_astra_research_ending_e9f4f2df:

    player "E-emin değilim... Birbirimizi tanımıyoruz bile—"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:296
translate turkish D_astra_research_ending_e1c49f50:

    lucie "Aman Tanrım, millet! Lütfen araştırmayla ilgili sorular sorun! Sıradaki."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:297
translate turkish D_astra_research_ending_0e77a51a:

    student "Numaranı alabilir miyim, tatlım?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:298
translate turkish D_astra_research_ending_7e6168b3:

    player "Şey..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:301
translate turkish D_astra_research_ending_ae3a7549:

    elizabeth "Onu mikrofondan uzaklaştırın. Lanet olsun..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:304
translate turkish D_astra_research_ending_b36bcd28:

    student "Üniversitemize başvuracak mısın?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:305
translate turkish D_astra_research_ending_ede7c2ee:

    player "Ben... Bunu henüz düşünmedim."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:308
translate turkish D_astra_research_ending_e8c998ed:

    katherine "Pekâlâ, toparlayalım... Tanrım, sanırım bu tür etkinliklere öğrenci getirmeyi bırakmalıyız."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:309
translate turkish D_astra_research_ending_f09aa6cd:

    katherine "Komite karar vermek üzere çekilecek. On dakika içinde döneceğiz."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:337
translate turkish D_astra_research_ending_ebf384e2:

    katherine "Austyn, buraya gelerek ortalığı sarstın."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:339
translate turkish D_astra_research_ending_409f55e1:

    lucie "Bilimsel toplantı bir hayran buluşmasına dönüştü."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:341
translate turkish D_astra_research_ending_2f782db5:

    elizabeth "Astra, rapor için teşekkürler. Olumlu bir not bekleyebilirsin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:352
translate turkish D_astra_research_ending_c546aa89:

    jannet "Tebrikler Astra!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:354
translate turkish D_astra_research_ending_4eac7542:

    mom "Harika idare ettin, Astra."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:356
translate turkish D_astra_research_ending_b241d6a2:

    astra "Ah, teşekkürler! Çok mutluyum. Vay canına..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:357
translate turkish D_astra_research_ending_bec2b7ef:

    astra "Bu gece burada kalacağım. Elimden geldiğince kutlamam lazım!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:359
translate turkish D_astra_research_ending_59fd5dbc:

    mom "Tamam, canım."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:360
translate turkish D_astra_research_ending_325b6a3b:

    "Toplantı bittikten sonra üç komite üyesi de sana yaklaşıyor. Annenden ve Jannet'ten seninle özel konuşmalarını istiyorlar."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:370
translate turkish D_astra_research_ending_f9527270:

    lucie "Sana söylemeliyim, gayet iyi dayandın."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:372
translate turkish D_astra_research_ending_8a08ae31:

    elizabeth "Evet, buradaki varlığın hepimize büyük keyif verdi."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:374
translate turkish D_astra_research_ending_f3e97dad:

    katherine "Uzun zamandır bu odada olan en güzel şey sen olmalısın!"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:375
translate turkish D_astra_research_ending_b7d4ed35:

    player "T-teşekkürler..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:376
translate turkish D_astra_research_ending_33f368bd:

    "Bu kadar seksi futanarilerden gelen iltifatlarla sersemliyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:378
translate turkish D_astra_research_ending_0c2ca7d3:

    elizabeth "Özellikle ilginç bir inceleme konusu gibisin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:379
translate turkish D_astra_research_ending_8bf22224:

    "Tonu sana şimdiden oldukça açık geliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:381
translate turkish D_astra_research_ending_d54dfd04:

    lucie "Seni yakından incelemekten mutluluk duyarız, tabiri caizse..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:382
translate turkish D_astra_research_ending_b72273c7:

    player "{i}Bu gerçekten oluyor mu...? Beni istiyorlar... üçü birden mi?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:384
translate turkish D_astra_research_ending_8a645597:

    katherine "Buyur. İstediğin zaman buraya gelebilirsin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:385
translate turkish D_astra_research_ending_27913302:

    "Katherine sana kampüs için bir misafir kartı uzatıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:387
translate turkish D_astra_research_ending_c9ff19a6:

    elizabeth "Biz hep buradayız..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:392
translate turkish D_astra_research_ending_2ede3459:

    "Üç komite üyesi de işlerinin başına dönüp seni yalnız bırakıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:393
translate turkish D_astra_research_ending_9b8f6c04:

    "Ortak bir bilinçleri varmış gibi bir izlenim ediniyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:394
translate turkish D_astra_research_ending_a7d0bc63:

    "Birbirlerinin düşüncelerini tamamlama tarzları tekinsiz vadi hissi veriyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:398
translate turkish D_astra_research_ending_78917fd3:

    "Jannet yine yanına geliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:399
translate turkish D_astra_research_ending_cf45cbec:

    jannet "Ooh, birinin başına güzel şeyler gelecek, ha?"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:400
translate turkish D_astra_research_ending_8ec10f2e:

    player "Hayır, n-ne diyorsun... Sadece ziyarete gelmeyi teklif ettiler."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:401
translate turkish D_astra_research_ending_3fbcf8e2:

    jannet "Ah, boş ver. Sana nasıl baktıklarını gördüm."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:404
translate turkish D_astra_research_ending_295dfb27:

    jannet "Bunu başka bir şeyle karıştırmak zor..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:408
translate turkish D_astra_research_ending_5be3236e:

    "Anne de sana katılıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:409
translate turkish D_astra_research_ending_069b257a:

    mom "Evet, Austie, Jannet haklı. Seni her yönden incelemek istiyorlar."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:410
translate turkish D_astra_research_ending_2aa7295c:

    mom "Onlara güveniyorum ama son söz tabii ki senin."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:412
translate turkish D_astra_research_ending_6836c58b:

    mom "Biraz tuhaf bir şeye dönüşebilir... ama zarar vermez, hehe."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:414
translate turkish D_astra_research_ending_eda70390:

    player "T-tamam... Aklımda tutarım."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:426
translate turkish D_astra_research_ending_8e597f8c:

    jannet "Bugün harikaydın, Austyn."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:427
translate turkish D_astra_research_ending_236c378c:

    jannet "O konuşman..."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:429
translate turkish D_astra_research_ending_8682e52d:

    player "Ah, onun için üzgünüm! Çok aptalcaydı—"

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:431
translate turkish D_astra_research_ending_9ff6c383:

    "Sözün yarıda bir öpücükle kesiliyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:432
translate turkish D_astra_research_ending_67000335:

    "Jannet niyeti tamamen saf bir şekilde dudaklarına şefkatle dokunuyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:433
translate turkish D_astra_research_ending_440f0da1:

    "Seninle gerçekten gurur duyuyor gibi."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:435
translate turkish D_astra_research_ending_551d08f3:

    jannet "Ah, Austyn... Senin adına çok mutluyum."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:436
translate turkish D_astra_research_ending_5a0b72f6:

    jannet "Ben... Ziyaretini gerçekten dört gözle bekliyorum."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:437
translate turkish D_astra_research_ending_e5a2cfbb:

    "Jannet'in söylediği şey yüzünden kızardığını bile görüyorsun."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:438
translate turkish D_astra_research_ending_a5ac110e:

    "Bu manzara içini ısıtıyor. Kendi evrenindeki Jannet'i fazlasıyla hatırlatıyor."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:439
translate turkish D_astra_research_ending_8920bd48:

    "Şu an buradaki haline pek benzemiyor bile."

# game/scripts/sequences/360/astra_research_ending/dialogues.rpy:440
translate turkish D_astra_research_ending_c1bd524f:

    player "Mutlaka gelirim..."

translate turkish strings:

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:1
    old "Student"
    new "Öğrenci"

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:19
    old "Grabbing your outrageous outfit, you begin getting dressed."
    new "Densiz kıyafetini alıp giyinmeye başlıyorsun."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:22
    old "You find yourself feeling insanely excited about wearing something like this."
    new "Böyle bir şey giyme fikri seni inanılmaz heyecanlandırıyor."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:25
    old "You've never touched these clothes since the photo shoot. Having put it on again, you feel like it looks even better on you today."
    new "Fotoğraf çekiminden beri bu kıyafetlere dokunmamıştın. Tekrar giyince bugün üzerinde daha da güzel durduğunu düşünüyorsun."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:40
    old "Yet your doubts vanish as soon as you leave the room."
    new "Ama odadan çıkar çıkmaz şüphelerin buharlaşıyor."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:82
    old "Finally, you step into the university building. With Astra and Mommy knowing the way perfectly well, you immediately reach your destination."
    new "Sonunda üniversite binasına adım atıyorsun. Astra ve anne yolu çok iyi bildiği için hemen varış noktasına ulaşıyorsun."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:312
    old "The next ten minutes stretch on nervously."
    new "Sonraki on dakika gergin geçiyor."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:315
    old "The whole lecture hall comes to life as soon as the committee leaves the room."
    new "Komite odadan çıkar çıkmaz bütün amfi canlanıyor."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:318
    old "Seems like Astra will be reminding you about your speech three times a day."
    new "Görünüşe göre Astra sana konuşmanı günde üç kez hatırlatacak."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:321
    old "And Mommy seems to think you've taken it too far."
    new "Anne de fazla ileri gittiğini düşünüyor gibi."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:324
    old "Perhaps you really should have chosen your words better."
    new "Belki de sözlerini gerçekten daha iyi seçmeliydin."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:327
    old "Yet you catch yourself thinking only about the fact that you'd never dare to do such a thing in your own universe."
    new "Yine de kendi evreninde asla böyle bir şeye cesaret edemeyeceğini düşünürken yakalıyorsun kendini."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:330
    old "You probably wouldn't even be in this kind of situation, even hypothetically."
    new "Muhtemelen varsayımsal olarak bile böyle bir durumda olmazdın."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:333
    old "Just when you are about to delve deeper into self-reflection, the committee walks into the lecture hall."
    new "Tam kendini daha derin sorgulamaya dalacakken komite amfiye giriyor."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:344
    old "Mommy, Astra and Jannet all gather around you to discuss your dizzying success."
    new "Anne, Astra ve Jannet baş döndürücü başarını konuşmak için etrafında toplanıyor."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:417
    old "You all head home together."
    new "Hep birlikte eve gidiyorsunuz."

    # game/scripts/sequences/360/astra_research_ending/dialogues.rpy:420
    old "Once there, you're left alone with Jannet."
    new "Oraya varınca Jannet'le baş başa kalıyorsun."

