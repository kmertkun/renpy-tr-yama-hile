translate turkish D_trish_sequence_01_mom_0a85be52:

    mom "Hadi, cesur ol tatlım."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:185
translate turkish D_trish_sequence_01_mom_fb41a6ae:

    player "{i}Sanırım biri ona tatlım dediğini duydu.. Ne utanç verici..{/i}"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:186
