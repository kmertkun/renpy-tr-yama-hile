    player "{i}Ah, inanamıyorum..{/i}"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:197
translate turkish D_trish_sequence_01_mom_55f52d4d:

    player "{i}Bu hale geldim. Crop top giyiyorum.. Tamam.{/i}"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:198
