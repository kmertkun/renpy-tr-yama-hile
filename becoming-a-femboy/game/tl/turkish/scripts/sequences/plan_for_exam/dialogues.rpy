    james "Arka bahçemde oturalım."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:502
translate turkish D_trish_sequence_01_james_date_8a8826bf:

    james "Sadece takılalım. Evden çok uzaklaşamamama neden olan bir sürü gündelik sorunum var."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:503
translate turkish D_trish_sequence_01_james_date_31f884f6:

    player @ confused "T-tamam, sorun değil."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:505
translate turkish D_trish_sequence_01_james_date_35be49dc:

    james "Buraya nasıl geldin? Uzun bir yolculuk muydu?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:506
translate turkish D_trish_sequence_01_james_date_e0624677:

    player @ happy "Hiç değil. Buraya uzak değil, yakında oturuyorum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:507
translate turkish D_trish_sequence_01_james_date_6f01328c:

    player @ confused "Yollarımızın hiç kesişmemiş olması çok garip."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:508
translate turkish D_trish_sequence_01_james_date_efb56b52:

    player "Caddenin karşısında oturuyorum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:509
translate turkish D_trish_sequence_01_james_date_c96b0e2a:

    james @ happy "Cidden mi? Astra da orada seninle mi yaşıyor?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:510
translate turkish D_trish_sequence_01_james_date_fce9e3c8:

    player "Evet, kelimenin tam anlamıyla yan odada .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:511
translate turkish D_trish_sequence_01_james_date_723457e0:

    james "Bir tür mucize. Gerçekten çok garip."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:519
translate turkish D_trish_sequence_01_james_date_backyard_eeb68fe0:

    james "Peki... kaç yaşında femboy olarak tespit edildin?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:520
translate turkish D_trish_sequence_01_james_date_backyard_10171729:

    player "18'inde .. Y-yeni yani .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:521
translate turkish D_trish_sequence_01_james_date_backyard_f6b95c6f:

    james "Ne ilginç! Bu kadar geç olduğunu hiç duymamıştım."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:522
translate turkish D_trish_sequence_01_james_date_backyard_138bba4e:

    player "Evet, evet .. Özel bir vaka olduğumu söylediler .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:523
translate turkish D_trish_sequence_01_james_date_backyard_242fc30f:

    james "Benimle randevuya bu kadar kolay razı olduğuna göre gerçekten özelsin."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:524
translate turkish D_trish_sequence_01_james_date_backyard_99d02b39:

    player "Ah, yapma ya, kes şunu."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:525
translate turkish D_trish_sequence_01_james_date_backyard_4b2aad4c:

    james "Bu yaşta bir \"erkek\" olarak alışılmış yaşam tarzını değiştirmek çok zor olmalı ..?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:526
translate turkish D_trish_sequence_01_james_date_backyard_8c8d51ae:

    player "Benim yaşımdaki bir erkek için hiç normal bir hayatım olmadı ki."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:527
translate turkish D_trish_sequence_01_james_date_backyard_940d109d:

    player "Yani, özel bir şey yok. Muhtemelen bir kızın olgunlaşabileceği şekilde .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:528
translate turkish D_trish_sequence_01_james_date_backyard_8d84fcb5:

    james "Sanırım anlıyorum. Ben bütün hayatımı kitap okuyarak geçiriyorum, benim de bir erkek için tipik bir çocukluğum olmadı."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:529
translate turkish D_trish_sequence_01_james_date_backyard_47db91dd:

    james "Ama seçimimi kendim yaptım, sen de hiçbir şeyden suçlu değilsin."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:530
translate turkish D_trish_sequence_01_james_date_backyard_2eace95e:

    player "Sorun değil, iyiyim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:531
translate turkish D_trish_sequence_01_james_date_backyard_65e4b81c:

    player "Durumum üzerinde çalışıyoruz .. Annem çalışıyor. Onun.. birinci sınıf bir doktor olduğunu söylüyorlar."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:532
translate turkish D_trish_sequence_01_james_date_backyard_5d44983c:

    player "En azından onun hakkında öyle diyorlar."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:533
translate turkish D_trish_sequence_01_james_date_backyard_07c5a62c:

    james "Harika, çok şanslısın."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:534
translate turkish D_trish_sequence_01_james_date_backyard_61047c44:

    james "Peki tercihlerin neler?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:535
translate turkish D_trish_sequence_01_james_date_backyard_bc29084d:

    james "Erkeklerden mi yoksa futanarilerden mi daha çok hoşlanıyorsun..?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:536
translate turkish D_trish_sequence_01_james_date_backyard_3e73c04c:

    player "Gerçekten söylemesi zor.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:537
translate turkish D_trish_sequence_01_james_date_backyard_22d01023:

    player "Gördüğün gibi seninle randevuya gelmeyi kabul ettim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:538
translate turkish D_trish_sequence_01_james_date_backyard_8fc8190f:

    player "Şu anda ben bile kiminle daha iyi olacağım konusunda pek fikre sahip değilim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:539
translate turkish D_trish_sequence_01_james_date_backyard_ed415ead:

    james "Benimle nasıl olduğunu denemek ister misin?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:550
translate turkish D_trish_sequence_01_james_kiss_agree_23af4d95:

    player "N-neden olmasın.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:551
translate turkish D_trish_sequence_01_james_kiss_agree_54661693:

    "Neler olduğunu anlamaya fırsat bulamadan, çocuğun seni öpmeye başladığını ve elinin kalçanda olduğunu hissettin .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:555
translate turkish D_trish_sequence_01_james_kiss_agree_b5ba1177:

    "Elini bacaklarının arasına itti, sana sik dediğin küçük şeyini yoklamaya başladı .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:556
translate turkish D_trish_sequence_01_james_kiss_agree_cfb9bafd:

    "Olan her şeyden çok tahrik oluyorsun ama aynı zamanda bu konuda ne düşünmen gerektiğini anlamıyorsun."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:560
translate turkish D_trish_sequence_01_james_kiss_agree_8d104c5f:

    "James çok ısrarcı çıktı ve ona pek karşı koymadın, gerçi koysaydın durup duracağını düşünüyordun."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:561
translate turkish D_trish_sequence_01_james_kiss_agree_89144c7b:

    "Olanlardan hoşlandığını hissetmesinin harika olduğu düşüncesi seni utandırmıyor."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:562
translate turkish D_trish_sequence_01_james_kiss_agree_80c198a1:

    "Benim için.. sorun olmaması gerekse de."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:566
translate turkish D_trish_sequence_01_james_kiss_agree_78cec30b:

    "Yine de bunda gey bir şey buluyorum.. Ne düşüneceğimi bilmiyorum.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:579
translate turkish D_trish_sequence_01_james_kiss_disagree_cae1340d:

    player "Böyle bir şeye hazır olduğumdan emin değilim.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:580
translate turkish D_trish_sequence_01_james_kiss_disagree_8291cf7a:

    james "Oh, sorun değil, zorlamıyorum. Ama belki yine görüşebiliriz.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:589
translate turkish D_trish_sequence_01_james_date_ending_0101b61b:

    james "Neyse, sanırım notlarımı istiyorsun?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:590
translate turkish D_trish_sequence_01_james_date_ending_8a4b03c2:

    player "E-evet, benimle paylaşabilir misin?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:591
translate turkish D_trish_sequence_01_james_date_ending_fab6c2e1:

    james "Sanırım olur .. işin bitince lütfen geri ver."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:605
translate turkish D_trish_sequence_01_ending_6ca94780:

    player "Buyur."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:606
translate turkish D_trish_sequence_01_ending_202c1d05:

    trish @ happy "Başardın mı? Yapabileceğini söylemiştim!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:607
translate turkish D_trish_sequence_01_ending_f5e8f6d3:

    player @ shy "Oh evet.. Ama ne pahasına."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:608
translate turkish D_trish_sequence_01_ending_12cde1a0:

    trish @ happy "Endişelenme, tek taşla iki kuş vurdun!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:609
translate turkish D_trish_sequence_01_ending_2447bec9:

    trish "Hem kendini kanıtladın .. hem de bizim için paha biçilmez bilgiler elde ettin."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:610
translate turkish D_trish_sequence_01_ending_0484ca13:

    player "Umarım hepsi boşuna değildir."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:611
translate turkish D_trish_sequence_01_ending_e65c77d5:

    trish "Dinle, buradakileri sınav soruları ile karşılaştırmak için biraz zamana ihtiyacım var.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:612
translate turkish D_trish_sequence_01_ending_d4d38a92:

    trish "Bu biraz zaman alabilir. Çözer çözmez sana hemen haber vereceğim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:613
translate turkish D_trish_sequence_01_ending_4ad8efba:

    trish "İşi hallettin ama nasıl hallettin?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:629
translate turkish D_trish_00_02_date_d8f5f25b:

    player "Randevuya çıktım."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:631
translate turkish D_trish_00_02_date_825b3e9f:

    trish "Düşündüğümden daha cesursun! Nasıldı?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:632
translate turkish D_trish_00_02_date_1bea2b6d:

    player "Genel olarak fena değildi .. Biraz .. Alışılmadıktı."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:633
translate turkish D_trish_00_02_date_2fbed68b:

    trish "Gözlerinden hoşuna gittiğini görebiliyorum! Peki, iyi miydi?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:634
translate turkish D_trish_00_02_date_5ceb6ffa:

    player "Ben .. bu konuda ne diyeceğimi bilmiyorum .. Öyle bir şey yapmadık."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:635
translate turkish D_trish_00_02_date_224653d7:

    trish "Belli ki bir şey saklıyorsun, benden saklayamazsın!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:636
translate turkish D_trish_00_02_date_3cf2638e:

    player @ humility "Tamam, tamam.. Beni öptü ve.. oraya dokundu.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:637
translate turkish D_trish_00_02_date_1f0daabc:

    trish "Oraya mı? Tam olarak nereye?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:638
translate turkish D_trish_00_02_date_1af8f542:

    player @ mad "Trish!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:639
translate turkish D_trish_00_02_date_b8b4012c:

    trish "Hadi ama, ben senin en iyi arkadaşınım. Neden benden saklıyorsun?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:640
translate turkish D_trish_00_02_date_7476507f:

    player "O.. bacaklarımın arasına dokundu.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:641
translate turkish D_trish_00_02_date_10ce21a9:

    trish @ happy "Oh, ne tatlı.. Bu sırada ne kadar çılgınca utandığını hayal edebiliyorum!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:642
translate turkish D_trish_00_02_date_4575c832:

    player @ humility "..."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:643
translate turkish D_trish_00_02_date_adee7228:

    trish "Tamam, tamam. Seni utandırmayacağım! Her halükârda harika bir arkadaşsın."

