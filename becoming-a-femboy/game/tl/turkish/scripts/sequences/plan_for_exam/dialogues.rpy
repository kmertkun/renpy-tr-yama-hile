translate turkish D_trish_00_02_no_date_adee7228:

    trish "Tamam, tamam. Seni utandırmayacağım! Her halükârda harika bir arkadaşsın."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:673
translate turkish D_trish_00_02_selfies_ff2351d7:

    player "Ona selfie'lerimi gönderdim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:675
translate turkish D_trish_00_02_selfies_afdb402e:

    trish "Şaka mı yapıyorsun? Hee, ne tatlı. Hatta kıskanılacak kadar."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:676
translate turkish D_trish_00_02_selfies_dc1d730f:

    player @ confused "Kıskanılacak mı?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:677
translate turkish D_trish_00_02_selfies_8af25cb7:

    trish "Tabii, çünkü bu fotoğrafları benim için çekmedin."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:678
translate turkish D_trish_00_02_selfies_65b3338a:

    trish "Her halükârda amatör performansını görmek istiyorum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:679
translate turkish D_trish_00_02_selfies_0193292d:

    player @ happy "T-tamam, sana da bir tane göndereceğim. Sonuçta sen benim arkadaşımsın!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:680
translate turkish D_trish_00_02_selfies_9a93de05:

    trish "Oh ne tatlı. Teşekkürler! Peki ne dersin? Senden hoşlandı mı?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:682
translate turkish D_trish_00_02_selfies_97bdc358:

    player "Bunu düşünmedim bile. Sadece notlar için yaptım."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:683
translate turkish D_trish_00_02_selfies_bded0884:

    trish @ happy "Hee, tabii ki. Sadece şaka yapıyorum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:684
translate turkish D_trish_00_02_selfies_0ddf9ead:

    trish "Ama yine de fotoğraflardan hoşlanmış olsa muhtemelen daha güzel olurdu .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:685
translate turkish D_trish_00_02_selfies_7931921a:

    player @ humility "Gerçekten umurumda değil, Trish."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:686
translate turkish D_trish_00_02_selfies_c345d367:

    player "{i}Ya da değil. Gerçekten bilmiyorum.{/i}"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:687
translate turkish D_trish_00_02_selfies_19781e4e:

    trish "Kendini kandırma tatlım. Gözlerinden mutlu olduğunu görebiliyorum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:688
translate turkish D_trish_00_02_selfies_1af8f542:

    player @ mad "Trish!"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:689
translate turkish D_trish_00_02_selfies_bfa045cd:

    trish "Rahat ol. Sadece şaka yapıyorum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:690
translate turkish D_trish_00_02_selfies_022becbd:

    trish @ happy "Harika iş, Austyn."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:701
translate turkish D_trish_00_02_trish_photos_54ef739a:

    player "Çektiğin fotoğrafı James'e göndereceğim.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:702
translate turkish D_trish_00_02_trish_photos_a791d9aa:

    trish @ happy "Ne büyük onur, hihi. Buna katılabildiğim için mutluyum."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:703
translate turkish D_trish_00_02_trish_photos_6024c25e:

    player @ happy "Evet, çok yardımcı oldun. Muhtemelen tek başıma yapamazdım."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:705
translate turkish D_trish_00_02_trish_photos_df08b4af:

    trish "Bence yapardın. Her halükârda en azından tavsiyelerle yardım edebilirdim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:706
translate turkish D_trish_00_02_trish_photos_7425ef7e:

    trish "Bir yorum yaptı mı?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:707
translate turkish D_trish_00_02_trish_photos_fe9de3cf:

    player "Sadece 'harika görünüyor' dedi."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:708
translate turkish D_trish_00_02_trish_photos_f255cbfa:

    trish @ mad "Cidden mi? Hepsi bu mu? Sırf cevap olsun diye verilmiş bir cevap gibi."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:709
translate turkish D_trish_00_02_trish_photos_6792ba5f:

    trish "Ne düşünüyorsun? Beğendi mi?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:710
translate turkish D_trish_00_02_trish_photos_ea282492:

    player @ sad "Dürüst olmak gerekirse söylemesi zor .. Beğendiğine inanmak istiyorum .."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:711
translate turkish D_trish_00_02_trish_photos_4afae92b:

    trish @ happy "Hee, ne tatlı. Ben şahsen çok beğendim."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:712
translate turkish D_trish_00_02_trish_photos_1f050515:

    trish "Kıçını telefonumun duvar kağıdı yapmaya bir adım kaldı."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:714
translate turkish D_trish_00_02_trish_photos_5be16eaa:

    player "Ne yapacaksın?! Benimle böyle şaka yapma.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:715
translate turkish D_trish_00_02_trish_photos_819acff9:

    trish "Birinin görmesinden mi korkuyorsun? O güzel kıçını görmesinden?"

# game/scripts/sequences/plan_for_exam/dialogues.rpy:716
translate turkish D_trish_00_02_trish_photos_d3568f0c:

    player "Ben.. daha çok birinin koridorda kıçımdan bahsettiğini duymasından korkuyorum.."

# game/scripts/sequences/plan_for_exam/dialogues.rpy:717
translate turkish D_trish_00_02_trish_photos_2f783cec:

