# game/scripts/characters/kim/dialogues.rpy:6
translate turkish D_kim_greeting_12e7a7ae:

    kim "Bir şeye mi ihtiyacın var, Ahududu?"

# game/scripts/characters/kim/dialogues.rpy:16
translate turkish D_kim_dialogue_about_scarlett_puzzle_ce27234e:

    "Scarlett'ın şifresini nasıl çözeceğini bilemiyorsun."

# game/scripts/characters/kim/dialogues.rpy:17
translate turkish D_kim_dialogue_about_scarlett_puzzle_9ba7f84a:

    "Belki Kim kadar zeki bir öğretmen çözmene yardımcı olabilir."

# game/scripts/characters/kim/dialogues.rpy:18
translate turkish D_kim_dialogue_about_scarlett_puzzle_88fc3f86:

    kim "Tam olarak neden bahsediyorsun?"

# game/scripts/characters/kim/dialogues.rpy:19
translate turkish D_kim_dialogue_about_scarlett_puzzle_30c3e62d:

    player "Ah, bilirsin, alışılmadık bir görevle karşılaştım..."

# game/scripts/characters/kim/dialogues.rpy:20
translate turkish D_kim_dialogue_about_scarlett_puzzle_4c160760:

    kim "Bir görev mi? Boş zamanlarında gerçekten ders mi çalışıyorsun?"

# game/scripts/characters/kim/dialogues.rpy:21
translate turkish D_kim_dialogue_about_scarlett_puzzle_9f80c5d7:

    kim "Buna inanmamı mı bekliyorsun?"

# game/scripts/characters/kim/dialogues.rpy:22
translate turkish D_kim_dialogue_about_scarlett_puzzle_426f1e8b:

    player "Hayır, hayır, kesinlikle değil."

# game/scripts/characters/kim/dialogues.rpy:23
translate turkish D_kim_dialogue_about_scarlett_puzzle_7c1cfea9:

    kim "Şey, çalışmalısın..."

# game/scripts/characters/kim/dialogues.rpy:24
translate turkish D_kim_dialogue_about_scarlett_puzzle_fdfae1f5:

    player "Ah... Şey... Hayır. Görev derken bir oyundaki görevi kastediyorum."

# game/scripts/characters/kim/dialogues.rpy:25
translate turkish D_kim_dialogue_about_scarlett_puzzle_1d462d7c:

    kim "Oh, bilgisayar oyunları mı?"

# game/scripts/characters/kim/dialogues.rpy:26
translate turkish D_kim_dialogue_about_scarlett_puzzle_5b587762:

    player "E-evet, aynen öyle."

# game/scripts/characters/kim/dialogues.rpy:27
translate turkish D_kim_dialogue_about_scarlett_puzzle_03b9a052:

    kim "Başarısız olmana şaşmamalı. Artık oyunlarda bile başaramıyorsun..."

# game/scripts/characters/kim/dialogues.rpy:28
translate turkish D_kim_dialogue_about_scarlett_puzzle_71cf70e0:

    kim "Bir yerde sürekli mastürbasyonun zekanı düşürebileceğini okumuştum..."

# game/scripts/characters/kim/dialogues.rpy:29
translate turkish D_kim_dialogue_about_scarlett_puzzle_3032a84f:

    player "Affedersin, yardım etmeni gerçekten istiyorum."

# game/scripts/characters/kim/dialogues.rpy:30
translate turkish D_kim_dialogue_about_scarlett_puzzle_fd16e1ad:

    kim "Dinliyorum. Bu bulmacanın olayı ne?"

# game/scripts/characters/kim/dialogues.rpy:31
translate turkish D_kim_dialogue_about_scarlett_puzzle_44940497:

    player "Şey, elimdeki tek şey anlaşılmaz bir harf dizisi, Sezar ve 4 sayısı."

# game/scripts/characters/kim/dialogues.rpy:32
translate turkish D_kim_dialogue_about_scarlett_puzzle_032fb572:

    kim "Hmm... Akla gelen ilk şey Sezar şifresi. 4 anahtar olmak üzere."

# game/scripts/characters/kim/dialogues.rpy:33
translate turkish D_kim_dialogue_about_scarlett_puzzle_1aadf0d7:

    player "Sezar şifresi mi? Anahtar mı?"

# game/scripts/characters/kim/dialogues.rpy:34
translate turkish D_kim_dialogue_about_scarlett_puzzle_78fbe892:

    kim "Ah, anlıyorum... Şey, Sezar şifresi bir tür yer değiştirme şifresidir."

# game/scripts/characters/kim/dialogues.rpy:35
translate turkish D_kim_dialogue_about_scarlett_puzzle_0c17c222:

    kim "Tahmin edebileceğin gibi adını bizzat Gaius Julius Caesar'dan alır."

# game/scripts/characters/kim/dialogues.rpy:36
translate turkish D_kim_dialogue_about_scarlett_puzzle_6d6f8482:

    kim "Komutanlarıyla haberleşmek için kullanırdı."

# game/scripts/characters/kim/dialogues.rpy:37
translate turkish D_kim_dialogue_about_scarlett_puzzle_46a959d4:

    kim "Anahtar, alfabede kaydırma miktarıdır."

# game/scripts/characters/kim/dialogues.rpy:38
translate turkish D_kim_dialogue_about_scarlett_puzzle_43a7de1d:

    kim "Diyelim ki anahtar 4 ise, şifrelenmiş kelimede A harfi şu harfe dönüşmeli..."

# game/scripts/characters/kim/dialogues.rpy:39
translate turkish D_kim_dialogue_about_scarlett_puzzle_c71ce57b:

    player "E harfi mi?"

# game/scripts/characters/kim/dialogues.rpy:40
translate turkish D_kim_dialogue_about_scarlett_puzzle_6f7f573f:

    kim "Doğru, hepsini çözmüşsün."

